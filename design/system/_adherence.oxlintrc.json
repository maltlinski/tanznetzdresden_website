{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/social/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Open Sans|Work Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Open Sans, Work Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:magenta|purple|cyan|outline)$/]",
        "message": "<Badge> variant must be one of 'magenta' | 'purple' | 'cyan' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|marker|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, marker, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|accent|accentSide|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, accent, accentSide, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|tint|purple|cyan)$/]",
        "message": "<Card> tone must be one of 'paper' | 'tint' | 'purple' | 'cyan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:magenta|cyan|purple|none)$/]",
        "message": "<Card> accent must be one of 'magenta' | 'cyan' | 'purple' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accentSide'] > Literal[value!=/^(?:top|left|right|bottom)$/]",
        "message": "<Card> accentSide must be one of 'top' | 'left' | 'right' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|value|onChange|placeholder|type|disabled|invalid|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, value, onChange, placeholder, type, disabled, invalid, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeilBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|height|flip|style|key|ref|className|style|children)$/]",
        "message": "<KeilBar> doesn't accept that prop. Declared props: variant, color, height, flip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeilBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bar|corner)$/]",
        "message": "<KeilBar> variant must be one of 'bar' | 'corner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:part|color|width|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: part, color, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='part'] > Literal[value!=/^(?:full|mark|word)$/]",
        "message": "<Logo> part must be one of 'full' | 'mark' | 'word'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|logoPart|logoWidth|right|rule|height|style|key|ref|className|style|children)$/]",
        "message": "<PageBand> doesn't accept that prop. Declared props: tone, logoPart, logoWidth, right, rule, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|cyan)$/]",
        "message": "<PageBand> tone must be one of 'purple' | 'cyan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageBand'] > JSXAttribute[name.name='logoPart'] > Literal[value!=/^(?:full|mark|word)$/]",
        "message": "<PageBand> logoPart must be one of 'full' | 'mark' | 'word'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|marker|markerColor|size|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, color, marker, markerColor, size, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
