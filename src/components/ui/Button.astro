---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  marker?: boolean;
  type?: 'button' | 'submit';
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'type'>;

const { href, variant = 'primary', size = 'md', marker = false, type = 'button', class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size !== 'md' && `btn--${size}`, marker && 'btn--marker', className];
---
{href
  ? <a href={href} class:list={classes} {...rest}><slot /></a>
  : <button type={type} class:list={classes} {...(rest as Record<string, unknown>)}><slot /></button>}
