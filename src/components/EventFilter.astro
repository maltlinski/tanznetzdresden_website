---
/** Filter-Chips für eine EventList (Kategorie). */
import { categoryLabel, eventCategories, type Termin } from '../lib/content';
import { getLang, tr } from '../lib/i18n';

interface Props {
  events: Termin[];
  /** id der EventList */
  target: string;
}
const { events, target } = Astro.props;
const lang = getLang(Astro);
const t = tr(lang, {
  de: { group: 'Termine nach Kategorie filtern', unit: 'Termine', shown: 'Termine angezeigt' },
  en: { group: 'Filter events by category', unit: 'events', shown: 'events shown' },
});
const filters: { value: 'Alle' | (typeof eventCategories)[number]; count: number }[] = [
  { value: 'Alle', count: events.length },
  ...eventCategories.map((c) => ({ value: c, count: events.filter((e) => e.data.category === c).length })),
];
---
<div class="chips" role="group" aria-label={t.group} aria-controls={target} data-event-filter={target} data-msg-shown={t.shown}>
  {filters.map((f, i) => (
    <button type="button" class="chip" data-value={f.value} aria-pressed={i === 0 ? 'true' : 'false'}>
      {categoryLabel[lang][f.value]}<span class="chip__count"><span class="visually-hidden">(</span>{f.count}<span class="visually-hidden"> {t.unit})</span></span>
    </button>
  ))}
</div>
<p class="visually-hidden" role="status" data-event-status={target}></p>

<script>
  import { Flip } from 'gsap/Flip';
  import { gsap, ScrollTrigger, EASE, motionOk } from '../scripts/gsap';

  gsap.registerPlugin(Flip);
  const motion = motionOk();

  document.querySelectorAll<HTMLElement>('[data-event-filter]').forEach((group) => {
    const id = group.dataset.eventFilter ?? '';
    const list = document.getElementById(id);
    const status = document.querySelector<HTMLElement>(`[data-event-status="${id}"]`);
    if (!list) return;
    group.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-value]');
      if (!btn) return;
      const value = btn.dataset.value;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      // Liste gleitet in die neue Ordnung (GSAP Flip): bleibende Termine rücken nach, neue laufen ein
      const items = [...list.querySelectorAll<HTMLElement>('.event, [data-month], [data-empty]')];
      const state = motion ? Flip.getState(items) : null;
      let shown = 0;
      list.querySelectorAll<HTMLElement>('.event').forEach((li) => {
        const show = value === 'Alle' || li.dataset.cat === value;
        li.hidden = !show;
        if (show) shown++;
      });
      // Monatsüberschriften ohne sichtbare Termine ausblenden
      list.querySelectorAll<HTMLElement>('[data-month]').forEach((h) => {
        let n = h.nextElementSibling as HTMLElement | null;
        let any = false;
        while (n && !n.hasAttribute('data-month') && n.classList.contains('event')) {
          if (!n.hidden) any = true;
          n = n.nextElementSibling as HTMLElement | null;
        }
        h.hidden = !any;
      });
      const empty = list.querySelector<HTMLElement>('[data-empty]');
      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = `${shown} ${group.dataset.msgShown ?? ''}`;
      if (state) {
        gsap.killTweensOf(items);
        Flip.from(state, {
          targets: items,
          duration: 0.6,
          ease: EASE,
          stagger: 0.02,
          onEnter: (els) => gsap.fromTo(els, { opacity: 0, x: -32 }, { opacity: 1, x: 0, duration: 0.6, ease: EASE, stagger: 0.04, clearProps: 'transform,opacity' }),
          onLeave: (els) => gsap.to(els, { opacity: 0, duration: 0.2 }),
          onComplete: () => ScrollTrigger.refresh(),
        });
      }
    });
  });
</script>
