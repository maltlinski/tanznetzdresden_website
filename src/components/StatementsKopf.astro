---
/**
 * Kopf der Netzwerk-Seite: Statements aus dem Netz als Diashow über die ganze Breite, darunter ein lila Band mit
 * Kicker, Headline, Fotonachweis und Steuerung. Der Kopf beginnt unter der Kopfleiste und ist so hoch wie die
 * Köpfe der anderen Seiten (--buehne-h), unten der Keil; im Querformat reicht das Foto nach oben unter die dann
 * halbdurchsichtige Leiste (src/scripts/unter-leiste.ts, ohne dass sich der Ausschnitt verschiebt). Auf Bildschirmen breiter als 4:3 füllt das Foto alles über
 * dem Band (oben und unten etwas abgeschnitten), sonst steht es ganz (16:9) und das Band füllt den Rest.
 * Die Statements stehen in src/content/netzwerk/statements.yaml (Redaktion → Statements).
 *
 * Bewegung (src/scripts/statements-kopf.ts): Start bei einem zufälligen Statement, alle 7 s das nächste mit
 * Überblenden; Pause beim Zeigen mit der Maus, beim Fokus und über den Knopf; Wischen auf dem Handy. Bei „Bewegung
 * reduzieren“ läuft nichts von selbst. Ohne JavaScript steht das erste Statement.
 */
import { getImage } from 'astro:assets';
import Tag from './ui/Tag.astro';
import KeilBar from './ui/KeilBar.astro';
import { getStatements } from '../lib/content';
import { tr, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  kicker: string;
  title: string;
  accent?: string;
  /** kleine Zeile neben dem Zähler */
  stimmen: string;
  /** vor dem Fotonachweis */
  foto: string;
}
const { lang, kicker, title, accent, stimmen, foto } = Astro.props;
const statements = await getStatements();
const t = tr(lang, {
  de: { region: 'Statements aus dem Netzwerk', zurueck: 'Vorheriges Statement', weiter: 'Nächstes Statement', pause: 'Diashow anhalten', start: 'Diashow fortsetzen', von: 'von' },
  en: { region: 'Statements from the network', zurueck: 'Previous statement', weiter: 'Next statement', pause: 'Pause slideshow', start: 'Resume slideshow', von: 'of' },
});
const dias = await Promise.all(
  statements.map(async (s) => {
    const img = await getImage({ src: s.data.bild, widths: [640, 960, 1280, 1600, 1920], format: 'webp', quality: 80 });
    const wer = [s.data.name, s.data.rolle].filter(Boolean).join(', ');
    return { id: s.id, img, foto: s.data.foto ?? '', alt: `„${s.data.zitat}“ – ${wer}${s.data.foto ? ` (Foto: ${s.data.foto})` : ''}`, sprache: s.data.sprache };
  }),
);
const zwei = (n: number) => String(n).padStart(2, '0');
---
<section class="nk" data-nk data-kopf-auftritt>
  {dias.length > 0 && (
    <div class="nk__buehne" role="region" aria-roledescription={lang === 'en' ? 'carousel' : 'Diashow'} aria-label={t.region} data-nk-buehne>
      {dias.map((d, i) => (
        <figure
          class:list={['nk__dia', i === 0 && 'is-aktiv']}
          role="group"
          aria-roledescription="Statement"
          aria-label={`${i + 1} ${t.von} ${dias.length}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          data-nk-dia
          data-foto={d.foto}
        >
          <img
            src={d.img.src}
            srcset={d.img.srcSet.attribute}
            sizes="100vw"
            alt={d.alt}
            lang={d.sprache !== lang ? d.sprache : undefined}
            width="1920"
            height="1080"
            decoding="async"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </figure>
      ))}
      <script is:inline>
        // zufälliger Start noch vor dem ersten Zeichnen (die Diashow selbst: statements-kopf.ts)
        (function () {
          var b = document.currentScript.parentElement, d = b.querySelectorAll('[data-nk-dia]'), i = Math.floor(Math.random() * d.length);
          b.dataset.start = i;
          d[i].querySelector('img').loading = 'eager';
          d.forEach(function (x, k) { x.classList.toggle('is-aktiv', k === i); if (k === i) x.removeAttribute('aria-hidden'); else x.setAttribute('aria-hidden', 'true'); });
        })();
      </script>
    </div>
  )}
  <div class="wrap nk__band">
    <div class="nk__text">
      <Tag color="cyan" class="kopf__kicker">{kicker}</Tag>
      <h1 class="nk__titel">{title}{accent && <><br /> <em>{accent}</em></>}</h1>
    </div>
    {dias.length > 0 && (
      <div class="nk__steuer" data-kopf-folgt>
        <span class="nk__foto" aria-hidden="true" data-nk-foto-zeile hidden>{foto} · <span data-nk-foto></span></span>
        {dias.length > 1 && (
          <div class="nk__leiste" data-nk-steuer hidden>
            <span class="nk__stimmen">{stimmen}</span>
            <span class="nk__zahl" aria-hidden="true"><span data-nk-nr>01</span> / {zwei(dias.length)}</span>
            <div class="nk__knoepfe">
              <button type="button" class="nk__knopf" data-nk-zurueck aria-label={t.zurueck}><span aria-hidden="true">←</span></button>
              <button type="button" class="nk__knopf" data-nk-pause aria-label={t.pause} data-pause={t.pause} data-start={t.start} aria-pressed="false">
                <span class="nk__pause" aria-hidden="true"></span>
              </button>
              <button type="button" class="nk__knopf" data-nk-weiter aria-label={t.weiter}><span aria-hidden="true">→</span></button>
            </div>
            <div class="nk__fortschritt" aria-hidden="true"><span data-nk-balken></span></div>
          </div>
        )}
      </div>
    )}
  </div>
  <KeilBar class="nk__keil" />
</section>

<script>
  import { initKopfAuftritt } from '../scripts/kopf-auftritt';
  import { statementsKopf } from '../scripts/statements-kopf';
  import { unterLeiste } from '../scripts/unter-leiste';
  unterLeiste('[data-nk]');
  statementsKopf(document.querySelector<HTMLElement>('[data-nk]'));
  initKopfAuftritt();
</script>

<style>
  /* so hoch wie die anderen Köpfe; Foto oben, Band unten, Keil am unteren Rand */
  .nk { position: relative; display: flex; flex-direction: column; min-height: var(--buehne-h); background: var(--purple); color: #fff; overflow: hidden; }
  .nk__buehne { position: relative; flex: none; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; touch-action: pan-y; }
  .nk__dia { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.4s var(--ease-out); }
  .nk__dia.is-aktiv { opacity: 1; z-index: 1; }
  .nk__dia img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
  /* Querformat (breiter als 4:3): der Kopf hat genau die Höhe der anderen Köpfe, das Foto füllt alles über dem Band */
  @media (min-width: 900px) and (min-aspect-ratio: 4/3) {
    .nk { height: var(--buehne-h); overflow: visible; }
    .nk__buehne { flex: 1 1 auto; min-height: 0; aspect-ratio: auto; overflow: visible; clip-path: inset(calc(-1 * var(--kopfleiste-h)) 0 0); }
    .nk__titel br { display: none; }
    /*
     * Das Foto reicht nach oben unter die (halbdurchsichtige) Kopfleiste, ohne sich zu verschieben: Der Ausschnitt
     * unter der Leiste ist derselbe wie ohne Verlängerung (mittig im Bereich unter der Leiste), darüber geht das Foto
     * einfach weiter. Reicht es dafür nicht, rückt es so weit, dass die Fläche unter der Leiste gefüllt ist.
     * cqw/cqh: Maße der Folie (Bereich unter der Leiste plus Leiste).
     */
    .nk__dia { inset: calc(-1 * var(--kopfleiste-h)) 0 0; container-type: size; }
    .nk__dia img {
      --breit: max(100cqw, 100cqh * 16 / 9);
      position: absolute; left: 50%; width: var(--breit); max-width: none; height: auto; aspect-ratio: 16 / 9; transform: translateX(-50%);
      top: clamp(100cqh - var(--breit) * 9 / 16, var(--kopfleiste-h) + (100cqh - var(--kopfleiste-h) - var(--breit) * 9 / 16) / 2, 0px);
    }
    /* Kopfleiste über dem Foto: lila Schleier, solange die Seite ganz oben steht (helle Fotos bleiben lesbar) */
    :global(.js body:has(.nk)) :global(.site-header:not(.ist-gescrollt):not(.is-open)) {
      background-color: color-mix(in srgb, var(--purple) 62%, transparent); border-bottom-color: transparent;
      -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    }
  }

  .nk__band {
    position: relative; flex: none; width: 100%; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
    gap: 12px 40px; padding-block: clamp(12px, 1.2vw, 18px) calc(var(--kopf-unten) + 4px);
  }
  @media (max-width: 899px), (max-aspect-ratio: 1332/1000) {
    /* Hochformat: Foto ganz, das Band füllt den Rest bis zur Höhe der anderen Köpfe (Text direkt unter dem Foto) */
    .nk__band { flex: 1 0 auto; align-items: flex-start; align-content: flex-start; }
  }
  .nk__text { flex: 1 1 420px; min-width: 0; }
  /* schmales Band: kleine Headline, das Foto bekommt den Platz */
  .nk__titel {
    margin: 8px 0 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 2.8vw, 46px);
    line-height: 1; letter-spacing: -0.035em; text-wrap: balance; hyphens: auto;
  }
  .nk__titel em { font-style: normal; color: var(--magenta); }
  .nk :global(.nk__keil) { position: absolute; left: 0; bottom: 0; width: 34%; z-index: 2; }

  .nk__steuer { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; margin-left: auto; }
  .nk__foto { font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-dark-soft); }
  .nk__foto[hidden], .nk__leiste[hidden] { display: none; }
  /* eine Zeile: Stimmen aus dem Netz · Zähler · Knöpfe, darunter der Fortschritt */
  .nk__leiste { display: grid; grid-template-columns: auto auto auto; align-items: center; gap: 8px 16px; }
  .nk__stimmen, .nk__zahl { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-dark-soft); }
  .nk__zahl { justify-self: end; color: #fff; }
  .nk__knoepfe { display: flex; justify-content: flex-end; }
  .nk__knopf {
    display: grid; place-items: center; width: 38px; height: 38px; padding: 0; border: 1.5px solid rgba(255, 255, 255, 0.55); border-radius: 0;
    background: transparent; color: #fff; font: inherit; font-size: 18px; cursor: pointer; transition: border-color var(--dur-base), color var(--dur-base);
  }
  .nk__knopf + .nk__knopf { border-left: 0; }
  .nk__knopf:hover { border-color: var(--cyan); color: var(--cyan); }
  .nk__knopf:focus-visible { outline: 3px solid var(--cyan); outline-offset: 2px; }
  /* Pause: zwei Balken; angehalten: Dreieck */
  .nk__pause { width: 12px; height: 14px; border-left: 4px solid currentColor; border-right: 4px solid currentColor; }
  .nk__knopf[aria-pressed='true'] .nk__pause { width: 0; height: 0; border-style: solid; border-width: 7px 0 7px 12px; border-color: transparent transparent transparent currentColor; }
  .nk__fortschritt { grid-column: 1 / -1; height: 2px; background: rgba(255, 255, 255, 0.2); }
  .nk__fortschritt span { display: block; height: 100%; background: var(--magenta); transform: scaleX(0); transform-origin: 0 50%; }
  @media (max-width: 640px) {
    .nk__steuer { width: 100%; align-items: stretch; }
    .nk__leiste { grid-template-columns: 1fr auto; }
    .nk__knoepfe { grid-column: 1 / -1; }
  }
</style>
