---
/**
 * KEEP UP · Dozent:innen als Kartenstapel zum Durchblättern: Pfeile, Punkte, Wischen oder Pfeiltasten.
 * Die nächste Karte kommt von rechts und legt sich auf den Stapel, die darunter rücken nach links (GSAP).
 * Ohne JavaScript stehen die Karten untereinander, bei „Bewegung reduzieren“ wechseln sie ohne Animation.
 */
import { Image } from 'astro:assets';
import Tag from '../ui/Tag.astro';
import { getLang, tr } from '../../lib/i18n';
import { todayKey, weekLabel, type Dozentin } from '../../lib/keep-up';
import { keepUp, stapelBewegung } from '../../settings/keep-up';

interface Props {
  dozentinnen: Dozentin[];
}
const { dozentinnen } = Astro.props;
const lang = getLang(Astro);
const s = keepUp[lang];
const t = tr(lang, {
  de: {
    kicker: 'Dozent:innen', h: 'Wer unterrichtet', week: 'Nächste Trainingswoche', tba: 'folgt', toCal: 'Termine im Kalender →', profile: 'Profil →',
    deck: 'Karussell', slide: 'Karte', of: 'von', prev: 'Vorherige Dozent:in', next: 'Nächste Dozent:in', pick: 'Dozent:in wählen',
  },
  en: {
    kicker: 'Teachers', h: 'Who teaches', week: 'Next teaching week', tba: 'to be announced', toCal: 'Dates in the calendar →', profile: 'Profile →',
    deck: 'carousel', slide: 'card', of: 'of', prev: 'Previous teacher', next: 'Next teacher', pick: 'Choose a teacher',
  },
});
const today = todayKey();
const themes = ['purple', 'white', 'cyan'] as const;
const total = String(dozentinnen.length).padStart(2, '0');
---
<section id="dozentinnen" class="dz surface-tint" aria-labelledby="dozentinnen-h">
  <div class="wrap section-head dz__head">
    <div data-reveal>
      <Tag>{t.kicker} · {s.saison}</Tag>
      <h2 id="dozentinnen-h" class="h2">{t.h}</h2>
    </div>
    <p class="dz__intro">{s.stapelText}</p>
  </div>

  <div class="stack" data-stack data-motion={stapelBewegung} aria-roledescription={t.deck} aria-label={t.h} role="region">
    <div class="stack__stage" data-stage>
      <div class="stack__inner">
        {dozentinnen.map((d, i) => {
          const next = d.weeks.find((w) => w[1] >= today);
          return (
            <article
              class:list={['card', `card--${themes[i % themes.length]}`]}
              id={`dozentin-${d.id}`}
              role="group"
              aria-roledescription={t.slide}
              aria-label={`${i + 1} ${t.of} ${dozentinnen.length}: ${d.name}`}
              data-card
            >
              <div class="card__photo">
                {typeof d.photo === 'string'
                  ? <Image src={d.photo} alt="" inferSize widths={[400, 640, 900]} sizes="(min-width: 760px) 520px, 100vw" />
                  : <Image src={d.photo} alt="" widths={[400, 640, 900]} sizes="(min-width: 760px) 520px, 100vw" />}
              </div>
              <div class="card__body">
                <div class="card__top">
                  <span class="card__style"><span class="card__sq" aria-hidden="true"></span>{d.stil}</span>
                  <span class="card__n">{String(i + 1).padStart(2, '0')} / {total}</span>
                </div>
                <div class="card__main">
                  <h3 class="card__name" id={`dozentin-${d.id}-h`}>{d.name}</h3>
                  <p class="card__text">{d.text}</p>
                </div>
                <div class="card__foot">
                  <div class="card__week">
                    <span class="card__k">{t.week}</span>
                    <span class="card__range" data-weeks={JSON.stringify(d.weeks)} data-tba={t.tba} data-lang={lang}>{next ? weekLabel(lang, next) : t.tba}</span>
                  </div>
                  <div class="card__links">
                    <a href="#kalender" class="card__link" data-cal-filter={d.id}>{t.toCal}</a>
                    <a href={d.profile} class="card__link">{t.profile}</a>
                  </div>
                </div>
              </div>
              <span class="card__shade" aria-hidden="true" data-shade></span>
            </article>
          );
        })}
      </div>
    </div>
    <div class="deck__controls">
      <button type="button" class="deck__arrow" aria-label={t.prev} data-deck-prev>←</button>
      <div class="deck__dots" role="group" aria-label={t.pick}>
        {dozentinnen.map((d, i) => (
          <button type="button" class="deck__dot" aria-label={d.name} aria-current={i === 0 ? 'true' : undefined} data-deck-dot={i}><span></span></button>
        ))}
      </div>
      <button type="button" class="deck__arrow" aria-label={t.next} data-deck-next>→</button>
      <span class="deck__count" aria-hidden="true" data-deck-count>01 / {total}</span>
    </div>
    <p class="visually-hidden" aria-live="polite" data-deck-status></p>
  </div>
</section>

<script>
  import { gsap, EASE, motionOk } from '../../scripts/gsap';

  const wrap = document.querySelector<HTMLElement>('[data-stack]');
  if (wrap) {
    const cards = [...wrap.querySelectorAll<HTMLElement>('[data-card]')];
    const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin' }).format(new Date());

    // „Nächste Trainingswoche“ ab heute (die Seite kann älter sein als der heutige Tag)
    wrap.querySelectorAll<HTMLElement>('[data-weeks]').forEach((el) => {
      const weeks = JSON.parse(el.dataset.weeks ?? '[]') as [string, string][];
      const w = weeks.find(([, end]) => end >= today);
      const d = (s: string) => new Date(`${s}T00:00:00Z`);
      const f = new Intl.DateTimeFormat(el.dataset.lang === 'en' ? 'en-GB' : 'de-DE', { day: 'numeric', month: 'short', timeZone: 'UTC' });
      el.textContent = w ? f.formatRange(d(w[0]), d(w[1])) : (el.dataset.tba ?? '');
    });

    // „Termine im Kalender →“: Kalender auf diese Dozent:in filtern, das Hinscrollen übernimmt der Link
    wrap.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLElement>('[data-cal-filter]');
      if (a) document.dispatchEvent(new CustomEvent('keepup:filter', { detail: a.dataset.calFilter }));
    });

    if (cards.length > 1) initDeck(wrap, cards);
  }

  function initDeck(wrap: HTMLElement, cards: HTMLElement[]) {
    wrap.classList.add('is-deck');
    const stage = wrap.querySelector<HTMLElement>('[data-stage]')!;
    const dots = [...wrap.querySelectorAll<HTMLButtonElement>('[data-deck-dot]')];
    const prevBtn = wrap.querySelector<HTMLButtonElement>('[data-deck-prev]')!;
    const nextBtn = wrap.querySelector<HTMLButtonElement>('[data-deck-next]')!;
    const count = wrap.querySelector<HTMLElement>('[data-deck-count]');
    const status = wrap.querySelector<HTMLElement>('[data-deck-status]');
    const fan = wrap.dataset.motion === 'fächer';
    const motion = motionOk();
    const total = String(cards.length).padStart(2, '0');
    const tilt = (i: number) => (i % 2 ? 1 : -1);
    let current = 0;

    /** Lage jeder Karte: oben die aktuelle, darunter nach links versetzt die vorigen, rechts außerhalb die nächsten. */
    function place(i: number) {
      const depth = current - i;
      if (depth < 0) return { xPercent: 112, x: 0, y: 0, scale: 1, rotation: fan ? 7 : 0, shade: 0, zIndex: i + 1 };
      const d = Math.min(depth, 4);
      return {
        xPercent: 0,
        x: -d * 18,
        y: d * 6,
        scale: 1 - d * 0.04,
        rotation: fan ? tilt(i) * (depth ? 1.2 + d * 1.1 : 1) : 0,
        shade: Math.min(d * 0.18, 0.6),
        zIndex: i + 1,
      };
    }

    function render(animate: boolean) {
      cards.forEach((card, i) => {
        const p = place(i);
        // Nur die oberste Karte ist bedienbar
        card.inert = i !== current;
        card.setAttribute('aria-hidden', String(i !== current));
        const props = { xPercent: p.xPercent, x: p.x, y: p.y, scale: p.scale, rotation: p.rotation, zIndex: p.zIndex };
        const shade = card.querySelector('[data-shade]');
        const shown = i <= current ? 1 : 0;
        if (animate && motion) {
          // während der Bewegung sichtbar, danach verschwinden die Karten rechts außerhalb
          gsap.to(card, { ...props, autoAlpha: 1, duration: 0.85, ease: EASE, overwrite: 'auto', onComplete: () => gsap.set(card, { autoAlpha: shown }) });
          gsap.to(shade, { opacity: p.shade, duration: 0.6, ease: 'none', overwrite: 'auto' });
        } else {
          gsap.set(card, { ...props, autoAlpha: shown });
          gsap.set(shade, { opacity: p.shade });
        }
      });
      dots.forEach((d, i) => (i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === cards.length - 1;
      if (count) count.textContent = `${String(current + 1).padStart(2, '0')} / ${total}`;
    }

    function go(i: number, announce = true) {
      i = Math.max(0, Math.min(cards.length - 1, i));
      if (i === current) return;
      current = i;
      render(true);
      const focused = document.activeElement;
      if ((focused === prevBtn && prevBtn.disabled) || (focused === nextBtn && nextBtn.disabled)) (prevBtn.disabled ? nextBtn : prevBtn).focus();
      if (announce && status) status.textContent = cards[i].getAttribute('aria-label') ?? '';
    }

    prevBtn.addEventListener('click', () => go(current - 1));
    nextBtn.addEventListener('click', () => go(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    wrap.addEventListener('keydown', (e) => {
      if ((e.target as Element).closest('input, textarea')) return;
      if (e.key === 'ArrowRight') go(current + 1);
      else if (e.key === 'ArrowLeft') go(current - 1);
      else if (e.key === 'Home') go(0);
      else if (e.key === 'End') go(cards.length - 1);
      else return;
      e.preventDefault();
    });

    // Wischen (Finger oder Maus): nach links = nächste Karte, nach rechts = vorige
    let startX = 0;
    let startY = 0;
    let dragging = false;
    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || (e.target as Element).closest('a, button')) return;
      startX = e.clientX;
      startY = e.clientY;
      dragging = true;
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) < 8 || Math.abs(dx) < Math.abs(e.clientY - startY)) return;
      if (!stage.hasPointerCapture(e.pointerId)) stage.setPointerCapture(e.pointerId);
      if (motion) gsap.set(cards[current], { x: dx * 0.35 });
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      const dx = e.clientX - startX;
      if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
      if (dx < -50 && current < cards.length - 1) go(current + 1);
      else if (dx > 50 && current > 0) go(current - 1);
      else if (motion) gsap.to(cards[current], { x: 0, duration: 0.4, ease: EASE });
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);

    // Links auf eine Karte (#dozentin-…, z. B. „Zur Dozent:in →“ im Kalender) schlagen sie auf
    const openFromHash = (hash: string) => {
      const i = cards.findIndex((c) => `#${c.id}` === decodeURIComponent(hash));
      if (i >= 0) go(i, false);
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#dozentin-"]');
      if (a) openFromHash(a.hash);
    }, true);

    render(false);
    if (location.hash.startsWith('#dozentin-')) openFromHash(location.hash);

    // Auftritt: der Stapel fächert sich auf, wenn er ins Bild kommt
    if (motion) {
      gsap.from(cards[current], {
        xPercent: 30, opacity: 0, rotation: fan ? 6 : 0, duration: 1, ease: EASE, clearProps: 'opacity',
        scrollTrigger: { trigger: wrap, start: 'top 80%', once: true },
      });
    }
  }
</script>

<style>
  .dz { background: var(--tint); padding-top: var(--section-y); scroll-margin-top: var(--header-h); }
  .dz__head { margin-bottom: 48px; }
  .dz__intro { max-width: 420px; margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }

  /* Ohne Stapel: Karten untereinander */
  .stack { padding: 0 var(--gutter) var(--section-y); }
  .stack__inner { max-width: 1080px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; }
  .card { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); scroll-margin-top: calc(var(--header-h) + 24px); }
  .card:focus { outline: none; }
  .card:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .card--purple { background: var(--purple); color: #fff; --k: var(--cyan); --body: rgba(255, 255, 255, 0.86); --line: rgba(255, 255, 255, 0.2); }
  .card--white { background: var(--paper); color: var(--purple); --k: var(--ink-muted); --body: var(--ink-soft); --line: var(--rule); }
  .card--cyan { background: var(--cyan); color: var(--purple); --k: var(--purple); --body: var(--purple); --line: rgba(46, 26, 77, 0.25); }
  .card__photo { position: relative; min-height: 0; padding: clamp(14px, 2vw, 24px) 0 clamp(14px, 2vw, 24px) clamp(14px, 2vw, 24px); }
  .card__photo :global(img) {
    width: 100%; height: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 22%;
    clip-path: var(--keil-corner);
  }
  .card__body { min-height: 0; padding: clamp(20px, 3vw, 44px); display: flex; flex-direction: column; justify-content: space-between; gap: 20px; overflow: hidden; }
  .card__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .card__style, .card__n {
    font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--k);
  }
  .card__style { display: flex; align-items: center; gap: 12px; }
  .card__n { white-space: nowrap; }
  .card__sq { width: 10px; height: 10px; background: var(--magenta); flex: none; }
  .card__name {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(34px, 4.6vw, 68px); line-height: 0.94;
    letter-spacing: -0.035em; margin: 0 0 20px; text-wrap: balance; color: inherit;
  }
  .card__text { margin: 0; max-width: 440px; font-size: clamp(14px, 1.3vw, 17px); line-height: 1.6; color: var(--body); text-wrap: pretty; }
  .card__foot {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px;
    padding-top: 18px; border-top: 1px solid var(--line);
  }
  .card__week { display: flex; flex-direction: column; gap: 4px; }
  .card__k { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--k); }
  .card__range { font-family: var(--font-display); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; }
  .card__links { display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .card__link {
    padding-bottom: 3px; border-bottom: 1.5px solid var(--magenta); font-family: var(--font-mono); font-size: 11px;
    font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: inherit;
  }
  .card--purple .card__link:hover { color: var(--cyan); }
  .card--white .card__link:hover { color: var(--magenta-2); }
  .card--cyan .card__link:hover { border-bottom-color: var(--purple); }
  .card__shade { position: absolute; inset: 0; background: var(--purple); opacity: 0; pointer-events: none; }

  /* Stapel zum Durchblättern (siehe Skript) */
  .stack.is-deck { padding: 0 var(--gutter) var(--section-y); }
  .is-deck .stack__stage { max-width: 1080px; margin: 0 auto; padding-left: 72px; touch-action: pan-y; user-select: none; }
  .is-deck .stack__inner { position: relative; height: clamp(480px, 68svh, 620px); display: block; }
  .is-deck .card { position: absolute; inset: 0; transform-origin: 50% 100%; grid-auto-rows: minmax(0, 1fr); }
  .is-deck .card__photo :global(img) { aspect-ratio: auto; pointer-events: none; -webkit-user-drag: none; }
  .dz { overflow: hidden; }

  .deck__controls { display: none; }
  .is-deck .deck__controls {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px;
    max-width: 1080px; margin: 32px auto 0; padding-left: 72px;
  }
  .deck__arrow {
    width: 44px; height: 44px; border: 1.5px solid var(--purple); background: var(--paper); color: var(--purple);
    font-family: var(--font-display); font-size: 20px; cursor: pointer; border-radius: 0;
    transition: border-color var(--dur-base), color var(--dur-base);
  }
  .deck__arrow:hover:not(:disabled) { border-color: var(--magenta); color: var(--magenta-2); }
  .deck__arrow:disabled { border-color: var(--rule); color: var(--ink-muted); cursor: default; }
  .deck__dots { display: flex; gap: 2px; }
  .deck__dot { width: 28px; height: 28px; display: grid; place-items: center; padding: 0; border: 0; background: none; cursor: pointer; }
  .deck__dot span { width: 10px; height: 10px; background: var(--ink-muted); transition: background var(--dur-base), width var(--dur-slow) var(--ease-out); }
  .deck__dot:hover span { background: var(--purple); }
  .deck__dot[aria-current='true'] span { width: 22px; background: var(--magenta); }
  .deck__count { margin-left: auto; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.18em; color: var(--purple); }

  @media (max-width: 760px) {
    .card { grid-template-columns: minmax(0, 1fr); }
    .card__photo { padding: 14px 14px 0; }
    .card__photo :global(img) { aspect-ratio: 4 / 3; }
    .is-deck .stack__stage, .is-deck .deck__controls { padding-left: 36px; }
    .is-deck .stack__inner { height: clamp(500px, 78svh, 660px); }
    .is-deck .card { display: flex; flex-direction: column; }
    .is-deck .card__photo { flex: 0 0 38%; }
    .is-deck .card__body { flex: 1 1 auto; padding: 18px 18px 20px; gap: 12px; }
    .is-deck .card__name { margin-bottom: 10px; font-size: clamp(28px, 8vw, 40px); }
    .is-deck .card__text { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
    .deck__dot { width: 24px; height: 24px; }
    .card__foot { padding-top: 12px; }
    .card__range { font-size: 18px; }
  }
</style>
