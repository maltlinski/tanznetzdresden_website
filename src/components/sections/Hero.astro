---
import { getImage } from 'astro:assets';
import Tag from '../ui/Tag.astro';
import Button from '../ui/Button.astro';
import KeilBar from '../ui/KeilBar.astro';
import { getVerein } from '../../lib/settings';
import { getLang, tr, url } from '../../lib/i18n';
import { heroFotos, knoten, netzAuslauf } from '../../settings/hero';
import type { HeroPhoto } from '../../scripts/hero-net';

// Fotos aus src/settings/hero.ts. Originalgröße behalten: das Skript schneidet nach Pixeln aus.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const photos: HeroPhoto[] = await Promise.all(
  heroFotos.map(async (f) => {
    const file = files[`../../assets/photos/${f.datei}`];
    if (!file) throw new Error(`src/settings/hero.ts: Foto „${f.datei}“ fehlt in src/assets/photos/`);
    const img = await getImage({ src: file.default, format: 'webp', quality: 82 });
    return { src: img.src, s: f.ausschnitt, d: f.ziel, box: f.koerper, floorY: f.boden };
  }),
);

const lang = getLang(Astro);
const verein = getVerein(lang);
const stats = verein.stats.map((s) => ({ n: s.value, l: s.label }));
const t = tr(lang, {
  de: {
    kicker: `Freie Tanzszene · Dresden · seit ${verein.founded}`, l1: 'Eine Stadt.', l2: 'Ein Netz.',
    lead: 'TanzNetzDresden verbindet über 70 Tanzschaffende der freien Szene. Wir organisieren Training, Bühnenformate, Diskurs und Residenzen und machen den zeitgenössischen Tanz in Dresden sichtbar.',
    cta: 'Nächste Termine', who: 'Wer im Netz tanzt →', replay: 'Netz neu knüpfen',
  },
  en: {
    kicker: `Independent dance · Dresden · since ${verein.founded}`, l1: 'One city.', l2: 'One network.',
    lead: "TanzNetzDresden connects more than 70 dance artists of the independent scene. We organise training, stage formats, discourse and residencies and make contemporary dance in Dresden visible.",
    cta: 'Upcoming events', who: 'Who dances in the network →', replay: 'Re-knot the net',
  },
});
---
<section id="top" class="hero" aria-labelledby="hero-title" data-hero>
  <canvas
    class="hero__canvas"
    data-hero-canvas
    data-photos={JSON.stringify(photos)}
    data-nodes={knoten}
    data-fade={netzAuslauf}
    aria-hidden="true"
  ></canvas>
  <div class="hero__content wrap">
    <div class="hero__text">
      <div data-rise="0.1"><Tag color="cyan" class="hero__tag">{t.kicker}</Tag></div>
      <h1 id="hero-title" class="hero__title" data-hero-title>
        <span data-sweep="0.3" data-bar="var(--cyan)">{t.l1}</span><br /><em data-sweep="0.55" data-bar="var(--magenta)">{t.l2}</em>
      </h1>
      <p class="hero__lead" data-rise="0.95">{t.lead}</p>
      <div class="hero__actions" data-rise="1.15">
        <Button href={url(lang, 'home', '#termine')} variant="secondary" size="lg" marker>{t.cta}</Button>
        <a href={url(lang, 'home', '#netzwerk')} class="mono-link underline-link">{t.who}</a>
      </div>
    </div>
  </div>
  <div class="hero__floor" data-hero-floor>
    <div class="hero__floor-inner">
      {stats.map((s, i) => (
        <div class="stat" data-rise={(1.4 + i / 10).toFixed(1)}><span class="stat__n">{s.n}</span><span class="stat__l">{s.l}</span></div>
      ))}
      <button type="button" class="replay" data-hero-replay data-rise="1.7">{t.replay}</button>
    </div>
  </div>
  <KeilBar class="hero__keil" />
</section>

<script>
  import { HeroNet, type HeroPhoto } from '../../scripts/hero-net';
  import { introText } from '../../scripts/intro-text';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (root && canvas) {
    introText(root);
    const hero = new HeroNet({
      canvas,
      floor: root.querySelector<HTMLElement>('[data-hero-floor]'),
      title: root.querySelector<HTMLElement>('[data-hero-title]'),
      photos: JSON.parse(canvas.dataset.photos ?? '[]') as HeroPhoto[],
      nodeCount: Number(canvas.dataset.nodes) || 110,
      netFade: Number(canvas.dataset.fade ?? 1),
      interactive: true,
    });
    const run = () => hero.start();
    // Wait for the display font so the headline width (photo anchor) is final.
    document.fonts?.ready.then(run, run) ?? run();
    root.querySelector('[data-hero-replay]')?.addEventListener('click', () => {
      introText(root);
      hero.replay();
    });
  }
</script>

<style>
  .hero {
    position: relative; background: var(--purple); color: #fff;
    min-height: clamp(620px, 88vh, 940px); min-height: clamp(620px, 88svh, 940px);
    display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden;
  }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__content { position: relative; z-index: 1; width: 100%; pointer-events: none; padding-top: clamp(40px, 8vh, 96px); }
  .hero__text { max-width: min(640px, 100%); padding-bottom: clamp(36px, 6vh, 72px); }
  .hero__text :global(.hero__tag) { margin-bottom: 26px; }
  .hero__title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(56px, 7.8vw, 124px);
    line-height: 0.9; letter-spacing: -0.035em; margin: 0 0 30px; color: #fff;
  }
  .hero__title em { font-style: normal; color: var(--magenta); }
  .hero__lead {
    font-size: clamp(16px, 1.5vw, 20px); line-height: 1.55; color: rgba(255, 255, 255, 0.88);
    max-width: 460px; margin: 0 0 34px; text-wrap: pretty;
  }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; pointer-events: auto; }
  .hero__floor { position: relative; z-index: 1; border-top: 1px solid var(--on-dark-rule); }
  .hero__floor-inner {
    max-width: var(--wrap); margin: 0 auto; padding: 18px var(--gutter) 26px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 14px 44px;
  }
  .stat { display: flex; align-items: baseline; gap: 10px; }
  .stat__n { font-family: var(--font-display); font-weight: 800; font-size: 26px; color: var(--cyan); letter-spacing: -0.02em; }
  .stat__l {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--on-dark-soft);
  }
  .replay {
    margin-left: auto; display: flex; align-items: center; gap: 10px; background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.4); color: #fff; padding: 9px 14px;
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; cursor: pointer; border-radius: 0;
    transition: border-color var(--dur-base), color var(--dur-base);
  }
  .replay::before { content: ''; width: 8px; height: 8px; background: var(--magenta); }
  .replay:hover { border-color: var(--magenta); color: var(--cyan); }
  .hero :global(.hero__keil) { position: absolute; left: 0; bottom: 0; width: 34%; z-index: 2; }
</style>
