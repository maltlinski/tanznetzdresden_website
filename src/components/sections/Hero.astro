---
/**
 * Hero der Startseite (Entwurf v5): drei Bühnenfotos, das Netz, oben „Tanz für …“ (Überschrift der Seite),
 * in der Mitte der nächste Termin, unten drei Einstiege (Tanz sehen, Mittrainieren, Teil des Netzes werden).
 * Einstellungen: src/settings/hero.ts
 */
import { getImage } from 'astro:assets';
import KeilBar from '../ui/KeilBar.astro';
import { getVerein } from '../../lib/settings';
import { getUpcoming } from '../../lib/content';
import { dateParts } from '../../lib/dates';
import { getLang, loc, tr, url } from '../../lib/i18n';
import { heroFotos, claim, wortPause, knoten, scrollWegziehen } from '../../settings/hero';
import type { HeroPhoto } from '../../scripts/hero-net';

// Originalgröße behalten: der Ausschnitt in src/settings/hero.ts ist in Originalpixeln angegeben.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const photos: HeroPhoto[] = await Promise.all(
  heroFotos.map(async (f) => {
    const file = files[`../../assets/photos/${f.datei}`];
    if (!file) throw new Error(`src/settings/hero.ts: Foto „${f.datei}“ fehlt in src/assets/photos/`);
    const img = await getImage({ src: file.default, format: 'webp', quality: 80 });
    return { src: img.src, s: f.ausschnitt, floor: f.boden };
  }),
);

const lang = getLang(Astro);
const verein = getVerein(lang);
const words = claim[lang].woerter;
// Die nächsten Termine: der Browser zeigt den ersten, der noch nicht vorbei ist.
const next = (await getUpcoming(3)).map((e) => {
  const d = dateParts(e.data.start, lang);
  return {
    href: url(lang, 'termine', `${e.id}/`),
    end: (e.data.end ?? e.data.start).replace(' ', 'T'),
    day: d.day,
    dm: `${d.dow} · ${d.month}`,
    long: d.long,
    title: loc(e.data, 'title', lang),
    where: `${e.data.venue} · ${loc(e.data, 'timeLabel', lang) ?? d.time}`,
  };
});
const t = tr(lang, {
  de: {
    replay: 'Netz neu knüpfen', next: 'Upcoming', nextLabel: 'Nächster Termin', wege: 'Einstiege',
    sehen: ['Zuschauen', 'Tanz sehen'], trainieren: ['Trainieren', 'Mittrainieren'], mitmachen: ['Mitmachen', 'Teil des Netzes werden'],
  },
  en: {
    replay: 'Re-knot the net', next: 'Upcoming', nextLabel: 'Next event', wege: 'Ways in',
    sehen: ['Watch', 'See dance'], trainieren: ['Train', 'Train with us'], mitmachen: ['Join', 'Become part of the network'],
  },
});
const wege = [
  { href: url(lang, 'home', '#termine'), k: t.sehen[0], t: t.sehen[1] },
  { href: url(lang, 'profitraining'), k: t.trainieren[0], t: t.trainieren[1] },
  { href: url(lang, 'home', '#mitglied'), k: t.mitmachen[0], t: t.mitmachen[1] },
];
---
<section id="top" class="hero" aria-label={verein.name} data-hero>
  <canvas
    class="hero__canvas"
    data-hero-canvas
    data-photos={JSON.stringify(photos)}
    data-nodes={knoten}
    data-scroll={scrollWegziehen ? '1' : '0'}
    aria-hidden="true"
  ></canvas>

  <button type="button" class="replay" data-hero-replay>{t.replay}</button>

  {words.length > 0 ? (
    <h1 class="claim" data-claim data-words={JSON.stringify(words)} data-pause={wortPause}>
      <span class="visually-hidden">{verein.name}: {claim[lang].lead} {words.join(', ')}</span>
      <span class="claim__lead" aria-hidden="true" data-claim-lead>{claim[lang].lead}</span>
      <span class="claim__mask" aria-hidden="true"><span class="claim__word" data-claim-word>{words[0]}</span></span>
    </h1>
  ) : (
    <h1 class="visually-hidden">{verein.name}</h1>
  )}

  {next.map((e, i) => (
    <a
      href={e.href}
      class="up"
      data-hero-up
      data-end={e.end}
      hidden={i > 0}
    >
      <span class="up__kicker" aria-hidden="true"><span class="up__sq"></span>{t.next}<span class="up__line"></span></span>
      <span class="visually-hidden">{t.nextLabel}: {e.long},</span>
      <span class="up__row">
        <span class="up__day" aria-hidden="true">{e.day}</span>
        <span class="up__text">
          <span class="up__dm" aria-hidden="true">{e.dm}</span>
          <span class="up__title">{e.title}</span>
        </span>
      </span>
      <span class="up__where">{e.where}<span class="up__arrow" aria-hidden="true">→</span><span class="up__bar" aria-hidden="true"></span></span>
    </a>
  ))}

  <nav class="hero__floor" aria-label={t.wege} data-hero-floor>
    <ul class="hero__floor-inner">
      {wege.map((w) => (
        <li><a class="weg" href={w.href}><span class="weg__k">{w.k}</span><span class="weg__t">{w.t}<span class="weg__pfeil" aria-hidden="true">→</span></span></a></li>
      ))}
    </ul>
  </nav>
  <KeilBar class="hero__keil" />
</section>

<script>
  import { HeroNet, type HeroPhoto } from '../../scripts/hero-net';
  import { zeichenHinein, zeichenHinaus } from '../../scripts/split-text';

  const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canAnimate = !reduced && 'animate' in Element.prototype;
  const root = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');

  // Nächster Termin: den ersten zeigen, der noch nicht vorbei ist (die Seite wird nur einmal am Tag gebaut).
  const ups = [...(root?.querySelectorAll<HTMLElement>('[data-hero-up]') ?? [])];
  const now = Date.now();
  const up = ups.find((a) => new Date(a.dataset.end ?? '').getTime() >= now) ?? null;
  ups.forEach((a) => (a.hidden = a !== up));

  // „Tanz für …“: Wörter wechseln Buchstabe für Buchstabe (SplitText), nach einer Runde bleibt das erste stehen.
  function runClaim(el: HTMLElement) {
    const word = el.querySelector<HTMLElement>('[data-claim-word]');
    const lead = el.querySelector<HTMLElement>('[data-claim-lead]');
    const words = JSON.parse(el.dataset.words ?? '[]') as string[];
    const pause = Number(el.dataset.pause || 4) * 1000;
    if (!word || !canAnimate) return;
    lead?.animate([{ opacity: 0, transform: 'translateX(-64px)' }, { opacity: 1, transform: 'none' }], { duration: 900, delay: 250, easing: EASE, fill: 'backwards' });
    let split = zeichenHinein(word, 0.55);
    if (words.length < 2) return;
    let i = 0;
    const tick = async () => {
      if (document.hidden) return void setTimeout(tick, 500);
      await zeichenHinaus(split);
      i = (i + 1) % words.length;
      word.textContent = words[i];
      split = zeichenHinein(word);
      if (i !== 0) setTimeout(tick, 900 + pause);
    };
    setTimeout(tick, 1400 + pause);
  }

  if (root && canvas) {
    const claimEl = root.querySelector<HTMLElement>('[data-claim]');
    if (claimEl) runClaim(claimEl);
    if (up && canAnimate) {
      up.animate([{ opacity: 0, translate: '0 32px' }, { opacity: 1, translate: '0 0' }], { duration: 900, delay: 2100, easing: EASE, fill: 'backwards' });
    }

    const hero = new HeroNet({
      canvas,
      floor: root.querySelector<HTMLElement>('[data-hero-floor]'),
      focus: up,
      photos: JSON.parse(canvas.dataset.photos ?? '[]') as HeroPhoto[],
      nodeCount: Number(canvas.dataset.nodes) || 100,
      scrollWipe: canvas.dataset.scroll === '1',
      interactive: true,
    });
    if (up) {
      const on = () => hero.setHover(true);
      const off = () => hero.setHover(false);
      up.addEventListener('pointerenter', on);
      up.addEventListener('pointerleave', off);
      up.addEventListener('focus', on);
      up.addEventListener('blur', off);
    }
    const run = () => hero.start();
    // Wait for the display font so the Upcoming field has its final size.
    document.fonts?.ready.then(run, run) ?? run();
    root.querySelector('[data-hero-replay]')?.addEventListener('click', () => hero.replay());
  }
</script>

<style>
  .hero {
    position: relative; background: var(--purple); color: #fff; overflow: hidden;
    height: clamp(560px, calc(100vh - 72px), 940px); height: clamp(560px, calc(100svh - 72px), 940px);
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .replay {
    position: absolute; z-index: 2; top: 20px; right: var(--gutter);
    display: flex; align-items: center; gap: 10px; background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.4); color: #fff; padding: 9px 14px;
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; cursor: pointer; border-radius: 0;
    transition: border-color var(--dur-base), color var(--dur-base);
  }
  .replay::before { content: ''; width: 8px; height: 8px; background: var(--magenta); }
  .replay:hover { border-color: var(--magenta); color: var(--cyan); }

  .claim {
    position: absolute; z-index: 3; left: var(--gutter); right: var(--gutter); top: clamp(28px, 6vh, 72px);
    margin: 0; pointer-events: none; font-family: var(--font-display); font-weight: 800;
    font-size: clamp(40px, 7vw, 112px); line-height: 0.92; letter-spacing: -0.035em; color: #fff;
  }
  .claim__lead { display: block; }
  .claim__mask { display: block; overflow: hidden; padding: 0 0.06em 0.08em 0; margin-left: -0.04em; }
  .claim__word { display: inline-block; padding-left: 0.04em; color: var(--magenta); overflow-wrap: anywhere; }

  .up {
    position: absolute; z-index: 3; left: 50%; top: 62%; transform: translate(-50%, -50%);
    max-width: calc(100% - 40px); display: flex; flex-direction: column; align-items: flex-start; color: #fff;
  }
  .up[hidden] { display: none; }
  .up:hover { color: #fff; }
  .up__kicker {
    display: flex; align-items: center; gap: 14px; font-family: var(--font-mono); font-size: 16px; font-weight: 700;
    letter-spacing: 0.24em; text-transform: uppercase; white-space: nowrap;
  }
  .up__sq { width: 14px; height: 14px; background: var(--magenta); flex: none; }
  .up__line { width: 36px; height: 2px; background: var(--magenta); transition: width 550ms var(--ease-out); }
  .up__row { display: flex; align-items: flex-end; gap: 24px; margin-top: 20px; }
  .up__day {
    font-family: var(--font-display); font-weight: 800; flex: none; font-size: clamp(88px, 14vw, 220px);
    line-height: 0.78; letter-spacing: -0.05em;
  }
  .up__text {
    min-width: 0; display: flex; flex-direction: column; gap: 6px; padding-bottom: 4px;
    transition: transform 550ms var(--ease-out);
  }
  .up__dm {
    font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; font-size: 15px;
    letter-spacing: 0.2em; color: var(--cyan);
  }
  .up__title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(30px, 4vw, 60px); line-height: 0.95;
    letter-spacing: -0.035em; text-wrap: balance;
  }
  .up__where {
    position: relative; margin-top: 22px; padding-bottom: 10px; display: flex; align-items: center; gap: 14px;
    font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; font-size: 14px; letter-spacing: 0.16em;
  }
  .up__arrow { font-family: var(--font-display); font-size: 26px; color: var(--magenta); transition: transform 550ms var(--ease-out); }
  .up__bar {
    position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--magenta);
    transform: scaleX(0); transform-origin: 0 50%; transition: transform 600ms var(--ease-out);
  }
  .up:hover .up__line, .up:focus-visible .up__line { width: 56px; }
  .up:hover .up__text, .up:hover .up__arrow,
  .up:focus-visible .up__text, .up:focus-visible .up__arrow { transform: translateX(6px); }
  .up:hover .up__bar, .up:focus-visible .up__bar { transform: scaleX(1); }

  .hero__floor { position: relative; z-index: 1; border-top: 1px solid var(--on-dark-rule); background: color-mix(in srgb, var(--purple) 90%, transparent); }
  .hero__floor-inner {
    max-width: var(--wrap); margin: 0 auto; padding: 0 var(--gutter); list-style: none;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); column-gap: 24px;
  }
  .weg { display: flex; flex-direction: column; gap: 6px; padding: 20px clamp(16px, 2vw, 28px) 26px 0; color: #fff; transition: color var(--dur-base); }
  .weg:hover { color: var(--cyan); }
  .weg__k { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); }
  .weg__t {
    display: flex; align-items: baseline; gap: 12px; font-family: var(--font-display); font-weight: 800;
    font-size: clamp(20px, 1.9vw, 26px); line-height: 1.05; letter-spacing: -0.02em;
  }
  .weg__pfeil { color: var(--magenta); transition: transform var(--dur-slow) var(--ease-out); }
  .weg:hover .weg__pfeil, .weg:focus-visible .weg__pfeil { transform: translateX(6px); }
  .hero :global(.hero__keil) { position: absolute; left: 0; bottom: 0; width: 34%; z-index: 2; }

  @media (min-width: 640px) {
    .claim__word { white-space: nowrap; overflow-wrap: normal; }
  }
  @media (max-width: 639px) {
    /* kein Platz neben der Überschrift; ohne Maus ist das Netz ohnehin ruhig */
    .replay { display: none; }
    /* Einstiege kompakt untereinander, der Termin steht direkt darüber */
    .hero__floor-inner { padding-bottom: 18px; }
    .weg { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--on-dark-rule); }
    .weg__t { font-size: 19px; }
    .up { position: relative; z-index: 3; left: auto; top: auto; transform: none; max-width: none; margin: 0 var(--gutter) 22px; }
    .up__row { gap: 16px; }
    .up__kicker { font-size: 13px; }
    .up__where { font-size: 12px; }
  }
</style>
