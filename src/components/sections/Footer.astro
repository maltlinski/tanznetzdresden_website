---
import Logo from '../ui/Logo.astro';
import ProtectedEmail from '../ProtectedEmail.astro';
import Funding from '../Funding.astro';
import { getVerein } from '../../lib/settings';
import { href } from '../../lib/url';
import { getLang, tr, url } from '../../lib/i18n';

const lang = getLang(Astro);
const v = getVerein(lang);
const year = new Date().getFullYear();
const a = v.address;
const t = tr(lang, {
  de: {
    home: 'TanzNetzDresden – zur Startseite', blurb: `Selbstorganisiertes Netzwerk der freien Tanzszene in Dresden. Seit ${v.founded}, seit 2020 als gemeinnütziger Verein.`,
    contact: 'Kontakt', writeMail: 'E-Mail schreiben', club: 'Verein', about: 'Über uns', board: 'Vorstand & Team', ags: 'Arbeitsgruppen', network: 'Netzwerk & Profile',
    join: 'Mitglied werden', donate: 'Spenden', contactPress: 'Kontakt & Presse', transparency: 'Transparenz', intern: 'Interner Bereich', follow: 'Folgen', newsletter: 'Newsletter',
    ics: 'Kalender abonnieren (.ics)', partners: 'Partner', legal: 'Rechtliches', imprint: 'Impressum', privacy: 'Datenschutz', a11y: 'Barrierefreiheit',
    easy: 'Leichte Sprache', cookies: 'Cookie-Einstellungen',
  },
  en: {
    home: 'TanzNetzDresden – home', blurb: `Self-organised network of Dresden's independent dance scene. Since ${v.founded}, a registered non-profit association since 2020.`,
    contact: 'Contact', writeMail: 'Send an email', club: 'Association', about: 'About us', board: 'Board & team', ags: 'Working groups', network: 'Network & profiles',
    join: 'Become a member', donate: 'Donate', contactPress: 'Contact & press', transparency: 'Transparency', intern: 'Members area', follow: 'Follow', newsletter: 'Newsletter',
    ics: 'Subscribe to calendar (.ics)', partners: 'Partners', imprint: 'Legal notice', privacy: 'Privacy', a11y: 'Accessibility',
    easy: 'Leichte Sprache (German)', cookies: 'Cookie settings',
  },
});
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__cols">
      <div class="site-footer__brand">
        <a href={url(lang, 'home')} class="site-footer__logo" aria-label={t.home}><Logo /></a>
        <p>{t.blurb}</p>
      </div>
      <div class="site-footer__col">
        <h2 class="site-footer__h">{t.contact}</h2>
        <address>{a.street}<br />{a.zip} {a.city}</address>
        <ProtectedEmail email={v.emails.kontakt} label={t.writeMail} />
        <a href={`tel:${v.phone.replace(/\s/g, '')}`}>{v.phone}</a>
      </div>
      <nav class="site-footer__col" aria-label={t.club}>
        <h2 class="site-footer__h">{t.club}</h2>
        <a href={url(lang, 'verein')}>{t.about}</a>
        <a href={url(lang, 'verein', '#vorstand')}>{t.board}</a>
        <a href={url(lang, 'verein', '#arbeitsgruppen')}>{t.ags}</a>
        <a href={url(lang, 'netzwerk')}>{t.network}</a>
        <a href={url(lang, 'mitglied')}>{t.join}</a>
        <a href={url(lang, 'spenden')}>{t.donate}</a>
        <a href={url(lang, 'kontakt')}>{t.contactPress}</a>
        <a href={url(lang, 'transparenz')}>{t.transparency}</a>
        <a href={url(lang, 'intern')}>{t.intern}</a>
      </nav>
      <div class="site-footer__col">
        <h2 class="site-footer__h">{t.follow}</h2>
        <a href={v.social.instagram} rel="noopener" target="_blank">Instagram · @tanznetzdresden</a>
        {v.social.telegram && <a href={v.social.telegram} rel="noopener" target="_blank">Telegram · KEEP UP</a>}
        <a href={url(lang, 'home', '#newsletter')}>{t.newsletter}</a>
        <a href={href('termine.ics')}>{t.ics}</a>
      </div>
    </div>
    <Funding />
    <div class="site-footer__partners">
      <span class="site-footer__partners-h">{t.partners}</span>
      <p>{v.partners.join(' · ')}</p>
    </div>
    <div class="site-footer__legal">
      <span>© {year} {v.legalName}</span>
      <a href={url(lang, 'impressum')} class="site-footer__legal-first">{t.imprint}</a>
      <a href={url(lang, 'datenschutz')}>{t.privacy}</a>
      <a href={url(lang, 'barrierefreiheit')}>{t.a11y}</a>
      <a href={url('de', 'leichteSprache')} lang="de">{t.easy}</a>
      <button type="button" data-consent-open>{t.cookies}</button>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--purple); color: #fff; }
  .site-footer__inner { max-width: var(--wrap); margin: 0 auto; padding: clamp(56px, 7vw, 88px) var(--gutter) 28px; }
  .site-footer__cols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px 48px;
    padding-bottom: 48px; border-bottom: 1px solid var(--on-dark-rule);
  }
  .site-footer__brand { grid-column: span 2; min-width: 0; max-width: 100%; }
  .site-footer__logo { display: block; width: 240px; max-width: 100%; color: #fff; }
  .site-footer__logo:hover { color: #fff; }
  .site-footer__brand p { margin: 22px 0 0; max-width: 340px; font-size: 14px; line-height: 1.6; color: var(--on-dark-soft); }
  .site-footer__col { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.6; }
  .site-footer__h {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--cyan); margin: 0 0 6px;
  }
  .site-footer__col address { font-style: normal; color: rgba(255, 255, 255, 0.86); }
  .site-footer__col a, .site-footer__col :global(.protected-email) { color: #fff; }
  .site-footer__col a:hover { color: var(--cyan); }
  .site-footer__partners {
    display: flex; flex-wrap: wrap; gap: 14px 40px; padding: 28px 0;
    border-bottom: 1px solid var(--on-dark-rule); align-items: baseline;
  }
  .site-footer__partners-h {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: rgba(255, 255, 255, 0.7);
  }
  .site-footer__partners p { margin: 0; font-size: 13.5px; line-height: 1.7; color: rgba(255, 255, 255, 0.86); flex: 1 1 480px; }
  .site-footer__legal {
    display: flex; flex-wrap: wrap; gap: 12px 28px; padding-top: 22px; font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.7);
  }
  .site-footer__legal a, .site-footer__legal button {
    color: rgba(255, 255, 255, 0.7); background: none; border: 0; padding: 0; cursor: pointer;
    font: inherit; letter-spacing: inherit; text-transform: inherit;
  }
  .site-footer__legal a:hover, .site-footer__legal button:hover { color: var(--cyan); }
  .site-footer__legal-first { margin-left: auto; }
  @media (max-width: 520px) {
    .site-footer__brand { grid-column: auto; }
    .site-footer__legal-first { margin-left: 0; }
  }
</style>
