---
/** Startseite: Einleitung unter dem Hero mit der Überschrift der Seite (Entwurf v2). */
import Tag from '../ui/Tag.astro';
import Button from '../ui/Button.astro';
import { getVerein } from '../../lib/settings';
import { getLang, tr, url } from '../../lib/i18n';

const lang = getLang(Astro);
const verein = getVerein(lang);
const t = tr(lang, {
  de: {
    kicker: `Freie Tanzszene · Dresden · seit ${verein.founded}`, l1: 'Eine Stadt.', l2: 'Ein Netz.',
    lead: 'TanzNetzDresden verbindet über 70 Tanzschaffende der freien Szene. Wir organisieren Training, Bühnenformate, Diskurs und Residenzen und machen den zeitgenössischen Tanz in Dresden sichtbar.',
    cta: 'Nächste Termine', who: 'Wer im Netz tanzt →',
  },
  en: {
    kicker: `Independent dance · Dresden · since ${verein.founded}`, l1: 'One city.', l2: 'One network.',
    lead: 'TanzNetzDresden connects more than 70 dance artists of the independent scene. We organise training, stage formats, discourse and residencies and make contemporary dance in Dresden visible.',
    cta: 'Upcoming events', who: 'Who dances in the network →',
  },
});
---
<section id="intro" class="intro" aria-labelledby="intro-title" data-intro>
  <div class="wrap">
    <div class="intro__tag" data-rise="0"><Tag>{t.kicker}</Tag></div>
    <div class="intro__grid">
      <h1 id="intro-title" class="intro__title">
        <span data-sweep="0.1" data-bar="var(--cyan)">{t.l1}</span><br /><em data-sweep="0.35" data-bar="var(--magenta)">{t.l2}</em>
      </h1>
      <div>
        <p class="intro__lead" data-rise="0.7">{t.lead}</p>
        <div class="intro__actions" data-rise="0.85">
          <Button href={url(lang, 'home', '#termine')} size="lg" marker>{t.cta}</Button>
          <a href={url(lang, 'home', '#netzwerk')} class="mono-link intro__who">{t.who}</a>
        </div>
      </div>
    </div>
    <div class="intro__stats">
      {verein.stats.map((s, i) => (
        <div class="stat" data-rise={(1 + i / 10).toFixed(1)}><span class="stat__n">{s.value}</span><span class="stat__l">{s.label}</span></div>
      ))}
    </div>
  </div>
</section>

<script>
  import { introText } from '../../scripts/intro-text';

  // Auftritt, sobald die Einleitung ins Bild kommt.
  const root = document.querySelector<HTMLElement>('[data-intro]');
  if (root && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        introText(root);
      },
      { threshold: 0.2 },
    );
    io.observe(root);
  }
</script>

<style>
  .intro { scroll-margin-top: var(--header-h); padding: clamp(72px, 10vw, 136px) 0 clamp(16px, 2vw, 24px); }
  .intro__tag { margin-bottom: 28px; }
  .intro__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 32px clamp(32px, 6vw, 96px); align-items: end;
  }
  .intro__title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(56px, 7.8vw, 124px);
    line-height: 0.9; letter-spacing: -0.035em; margin: 0; color: var(--purple);
  }
  .intro__title span, .intro__title em { display: inline-block; position: relative; }
  .intro__title em { font-style: normal; color: var(--magenta); }
  .intro__lead {
    font-size: clamp(16px, 1.5vw, 20px); line-height: 1.55; color: var(--ink-soft);
    max-width: 480px; margin: 0 0 30px; text-wrap: pretty;
  }
  .intro__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; }
  .intro__who { color: var(--purple); border-bottom: 1.5px solid var(--magenta); padding-bottom: 4px; }
  .intro__who:hover { color: var(--magenta); }
  .intro__stats {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px 44px;
    margin-top: clamp(56px, 7vw, 96px); padding-top: 20px; border-top: 1px solid var(--rule);
  }
  .stat { display: flex; align-items: baseline; gap: 10px; }
  .stat__n { font-family: var(--font-display); font-weight: 800; font-size: 26px; color: var(--magenta); letter-spacing: -0.02em; }
  .stat__l {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink-soft);
  }
</style>
