---
/**
 * Startseite (Entwurf v5): „Eine Stadt. Ein Netz.“ – wer wir sind (links) und wer im Netz tanzt (rechts):
 * Namen mit Profil, versetzt in Zweierreihen. Die erste Zahl unter Verein → Zahlen steht oben rechts.
 */
import Tag from '../ui/Tag.astro';
import KeilBar from '../ui/KeilBar.astro';
import { getVerein } from '../../lib/settings';
import { getProfiles } from '../../lib/profiles';
import { getLang, tr, url } from '../../lib/i18n';

const lang = getLang(Astro);
const verein = getVerein(lang);
const zahl = verein.stats[0];
const people = (await getProfiles()).filter((p) => p.featured).slice(0, 16);
const t = tr(lang, {
  de: {
    kicker: `Freie Tanzszene · Dresden · seit ${verein.founded}`, l1: 'Eine Stadt.', l2: 'Ein Netz.',
    lead: 'TanzNetzDresden verbindet über 70 Tanzschaffende der freien Szene. Wir organisieren Training, Bühnenformate, Diskurs und Residenzen und machen den zeitgenössischen Tanz in Dresden sichtbar.',
    team: 'Vorstand & AGs →', partner: 'Partner →', who: 'Wer im Netz tanzt', all: zahl ? `Alle ${zahl.value} Profile →` : 'Alle Profile →',
  },
  en: {
    kicker: `Independent dance · Dresden · since ${verein.founded}`, l1: 'One city.', l2: 'One network.',
    lead: 'TanzNetzDresden connects more than 70 dance artists of the independent scene. We organise training, stage formats, discourse and residencies and make contemporary dance in Dresden visible.',
    team: 'Board & working groups →', partner: 'Partners →', who: 'Who dances in the network', all: zahl ? `All ${zahl.value} profiles →` : 'All profiles →',
  },
});
// versetzte Zweierreihen wie im Entwurf
const VERSATZ = [0, 32, 12, 48, 20, 4, 38];
const reihen: (typeof people)[] = [];
for (let i = 0; i < people.length; i += 2) reihen.push(people.slice(i, i + 2));
---
<section id="netz" class="netz" aria-labelledby="netz-h" data-netz>
  <KeilBar color="var(--cyan)" flip class="netz__keil" />
  <div class="wrap netz__grid">
    <div>
      <div class="netz__tag" data-rise><Tag color="cyan">{t.kicker}</Tag></div>
      <h2 id="netz-h" class="netz__h">
        <span data-sweep="0.1">{t.l1}</span><br /><span class="netz__l2" data-sweep="0.35">{t.l2}</span>
      </h2>
      <p class="netz__lead">{t.lead}</p>
      <div class="netz__links">
        <a href={url(lang, 'verein', '#vorstand')}>{t.team}</a>
        <a href={url(lang, 'kooperationen')}>{t.partner}</a>
      </div>
    </div>
    <div id="netzwerk" class="netz__wer">
      <div class="netz__wer-kopf">
        <h3 class="netz__k">{t.who}</h3>
        {zahl && <span class="netz__zahl">{zahl.value} {zahl.label}</span>}
      </div>
      <ul class="netz__namen">
        {reihen.map((r, i) => (
          <li style={`--versatz: ${VERSATZ[i % VERSATZ.length]}px`}>
            {r.map((p) => (
              <a href={url(lang, 'netzwerk', `${p.id}/`)}><span data-name>{p.name}</span><span class="netz__punkt" aria-hidden="true" /></a>
            ))}
          </li>
        ))}
      </ul>
      <a class="netz__alle" href={url(lang, 'netzwerk')}>{t.all}</a>
    </div>
  </div>
</section>

<script>
  import { aufstieg } from '../../scripts/split-text';
  import { gsap, EASE, motionOk } from '../../scripts/gsap';

  const root = document.querySelector<HTMLElement>('[data-netz]');
  if (root) {
    aufstieg(root);
    // Kicker, Text und Links gleiten nach der Überschrift von links herein
    if (motionOk() && 'IntersectionObserver' in window) {
      const els = [...root.querySelectorAll<HTMLElement>('[data-rise], .netz__lead, .netz__links')];
      const io = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        els.forEach((el, i) =>
          el.animate([{ opacity: 0, transform: 'translateX(-48px)' }, { opacity: 1, transform: 'none' }], {
            duration: 900, delay: [0, 700, 850][i] ?? 0, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards',
          }),
        );
      }, { threshold: 0.2 });
      io.observe(root);
    }

    // Namen Reihe für Reihe einblenden, das Quadrat dahinter setzt kurz danach ein
    const namen = root.querySelector<HTMLElement>('.netz__namen');
    if (namen && motionOk()) {
      gsap
        .timeline({ scrollTrigger: { trigger: namen, start: 'top 85%', once: true }, defaults: { ease: EASE } })
        .from(namen.querySelectorAll('[data-name]'), { x: -40, opacity: 0, duration: 0.8, stagger: 0.06, clearProps: 'transform,opacity' })
        .from(namen.querySelectorAll('.netz__punkt'), { scale: 0, duration: 0.5, stagger: 0.06, clearProps: 'transform' }, 0.25);
    }
  }
</script>

<style>
  .netz { position: relative; background: var(--purple); color: #fff; padding: clamp(72px, 9vw, 120px) 0 clamp(56px, 7vw, 88px); overflow: hidden; }
  .netz :global(.netz__keil) { position: absolute; right: 0; top: 0; width: 40%; }
  .netz__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 48px clamp(32px, 6vw, 96px); align-items: start; }
  .netz__tag { margin-bottom: 24px; }
  .netz__h { margin: 0 0 30px; font-family: var(--font-display); font-weight: 800; font-size: clamp(52px, 7vw, 104px); line-height: 0.9; letter-spacing: -0.035em; color: #fff; }
  .netz__h span { display: inline-block; position: relative; }
  .netz__l2 { color: var(--cyan); }
  .netz__lead { max-width: 500px; margin: 0 0 28px; font-size: clamp(16px, 1.4vw, 18px); line-height: 1.6; color: rgba(255, 255, 255, 0.88); text-wrap: pretty; }
  .netz__links { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .netz__links a {
    font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: #fff; border-bottom: 1.5px solid var(--magenta); padding-bottom: 4px;
  }
  .netz__links a:hover { color: var(--cyan); }
  .netz__wer { border-top: 3px solid var(--magenta); padding-top: 22px; }
  .netz__wer-kopf { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; margin-bottom: 20px; }
  .netz__k, .netz__zahl { margin: 0; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .netz__k { color: var(--cyan); }
  .netz__zahl { color: rgba(255, 255, 255, 0.78); }
  .netz__namen { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 6px 0; list-style: none; }
  /* Zweierreihen, jede leicht versetzt eingerückt */
  .netz__namen li { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; padding-left: var(--versatz, 0); }
  .netz__namen a {
    display: flex; align-items: center; gap: 18px; font-family: var(--font-display); font-weight: 700; font-size: clamp(20px, 2vw, 27px);
    line-height: 1.25; letter-spacing: -0.02em; color: #fff; white-space: nowrap; transition: color var(--dur-base);
  }
  .netz__namen [data-name] { display: inline-block; }
  .netz__punkt { width: 7px; height: 7px; background: var(--magenta); flex: none; }
  .netz__namen a:hover { color: var(--cyan); }
  .netz__alle { display: inline-block; margin-top: 24px; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); }
  .netz__alle:hover { color: #fff; }
</style>
