---
import { Image } from 'astro:assets';
import Tag from '../ui/Tag.astro';
import { getFormate } from '../../lib/content';

const items = (await getFormate()).map((f, i) => ({ ...f.data, id: f.id, n: String(i + 1).padStart(2, '0') }));
---
<section id="formate" class="section formate surface-tint" aria-labelledby="formate-h">
  <div class="wrap">
    <div class="section-head">
      <div data-reveal>
        <Tag>Was wir machen</Tag>
        <h2 id="formate-h" class="h2">Formate &amp; Reihen</h2>
      </div>
      <p class="formate__intro">Getragen von Arbeitsgruppen aus dem Netzwerk. Jedes Format hat eine eigene AG, die es plant und weiterentwickelt.</p>
    </div>

    <div class="formate__grid" data-formats>
      <ul class="formats">
        {items.map((f, i) => (
          <li class:list={['format', i === 0 && 'is-active']} data-index={i}>
            <span class="format__n">{f.n}</span>
            <div class="format__body">
              <button type="button" class="format__head" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`format-d-${i}`}>
                <span class="format__mk" aria-hidden="true"></span>
                <h3 class="format__t">{f.title}</h3>
              </button>
              <p class="format__d" id={`format-d-${i}`}>{f.summary}</p>
            </div>
            <span class="format__since">{f.since}</span>
          </li>
        ))}
      </ul>

      <div class="format-photo" aria-hidden="true">
        <div class="format-photo__frame">
          {items.map((f, i) => (
            <Image
              src={f.image}
              alt=""
              widths={[400, 640, 900, 1200]}
              sizes="(min-width: 1000px) 560px, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              class:list={['format-photo__img', i === 0 && 'is-active']}
              data-index={i}
            />
          ))}
          <div class="format-photo__sq"></div>
          <div class="format-photo__cap">
            <span class="format-photo__meta" data-format-meta>{items[0].n} · {items[0].since}</span>
            <span class="format-photo__t" data-format-title>{items[0].title}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-formats]');
  if (root) {
    const rows = [...root.querySelectorAll<HTMLElement>('.format')];
    const imgs = [...root.querySelectorAll<HTMLElement>('.format-photo__img')];
    const meta = root.querySelector<HTMLElement>('[data-format-meta]');
    const title = root.querySelector<HTMLElement>('[data-format-title]');
    let active = 0;

    const pick = (i: number) => {
      if (i === active) return;
      active = i;
      rows.forEach((row, j) => {
        row.classList.toggle('is-active', j === i);
        row.querySelector('.format__head')?.setAttribute('aria-expanded', String(j === i));
      });
      imgs.forEach((img, j) => img.classList.toggle('is-active', j === i));
      const row = rows[i];
      if (meta) meta.textContent = `${row.querySelector('.format__n')?.textContent} · ${row.querySelector('.format__since')?.textContent}`;
      if (title) title.textContent = row.querySelector('.format__t')?.textContent ?? '';
    };

    const canHover = matchMedia('(hover: hover)').matches;
    rows.forEach((row, i) => {
      if (canHover) row.addEventListener('mouseenter', () => pick(i));
      row.addEventListener('click', () => pick(i));
      row.querySelector('.format__head')?.addEventListener('focus', () => pick(i));
    });
  }
</script>

<style>
  .formate { background: var(--tint); }
  .formate .section-head { gap: 20px 40px; margin-bottom: 40px; }
  .formate__intro { max-width: 420px; margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  .formate__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 40px clamp(32px, 5vw, 72px); align-items: start;
  }
  .formats { border-bottom: 1px solid var(--rule); list-style: none; margin: 0; padding: 0; }
  .format {
    display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 16px; align-items: baseline;
    padding: 22px 0; border-top: 1px solid var(--rule); cursor: pointer;
  }
  .format__n { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; color: var(--ink-muted); }
  .format__body { min-width: 0; }
  .format__head {
    display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
    background: none; border: 0; padding: 0; margin: 0; cursor: pointer; color: inherit;
  }
  .format__mk { flex: none; width: 0; height: 14px; margin-right: -14px; background: var(--magenta); transition: width 420ms var(--ease-out), margin 420ms var(--ease-out); }
  .format__t {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1; letter-spacing: -0.03em; margin: 0; color: var(--purple); transition: color 200ms;
  }
  .format__d { margin: 14px 0 4px; max-width: 480px; font-size: 15px; line-height: 1.6; color: var(--ink-soft); text-wrap: pretty; }
  .format__since {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-soft); white-space: nowrap;
  }
  .format.is-active .format__mk { width: 14px; margin-right: 0; }
  .format.is-active .format__t { color: var(--magenta); }
  /* Without JS every description stays readable. */
  :global(.js) .format:not(.is-active) .format__d { display: none; }

  .format-photo { position: sticky; top: 96px; }
  .format-photo__frame {
    position: relative; aspect-ratio: 4 / 5; max-height: 72vh; width: 100%; background: var(--purple);
    overflow: hidden; clip-path: var(--keil-corner);
  }
  .format-photo__frame :global(.format-photo__img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 620ms var(--ease-out);
  }
  .format-photo__frame :global(.format-photo__img.is-active) { clip-path: inset(0 0 0 0); z-index: 1; }
  .format-photo__sq { position: absolute; z-index: 2; top: 0; left: 0; width: 38px; height: 38px; background: var(--magenta); }
  .format-photo__cap {
    position: absolute; z-index: 2; left: 0; bottom: 0; right: 12%; background: rgba(46, 26, 77, 0.9);
    padding: 18px 22px; display: flex; flex-direction: column; gap: 6px;
  }
  .format-photo__meta {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--cyan);
  }
  .format-photo__t { font-family: var(--font-display); font-weight: 800; font-size: 24px; letter-spacing: -0.02em; color: #fff; }

  @media (max-width: 960px) {
    .format-photo { position: relative; top: 0; order: -1; }
    .format-photo__frame { aspect-ratio: 3 / 2; }
  }
</style>
