---
/**
 * Startseite (Entwurf v5): „Formate & Reihen“ als Streifen zum Wischen, mit Pfeilen zum Blättern.
 * Formate mit eigener Seite (Feld `seite`, z. B. KEEP UP → Profitraining) sind ganz verlinkt.
 */
import { Image } from 'astro:assets';
import Tag from '../ui/Tag.astro';
import { getFormate } from '../../lib/content';
import { getLang, loc, tr, url } from '../../lib/i18n';

const lang = getLang(Astro);
const t = tr(lang, {
  de: { kicker: 'Was wir machen', h: 'Formate & Reihen', prev: 'Vorherige Formate', next: 'Weitere Formate', list: 'Formate' },
  en: { kicker: 'What we do', h: 'Formats & series', prev: 'Previous formats', next: 'More formats', list: 'Formats' },
});
const items = (await getFormate()).map((f, i) => ({
  ...f.data,
  id: f.id,
  n: String(i + 1).padStart(2, '0'),
  title: loc(f.data, 'title', lang),
  since: loc(f.data, 'since', lang),
  summary: loc(f.data, 'summary', lang),
  alt: loc(f.data, 'alt', lang),
  page: f.data.seite ? url(lang, f.data.seite) : undefined,
}));
---
<section id="formate" class="formate surface-tint" aria-labelledby="formate-h" data-formats>
  <div class="wrap formate__kopf">
    <div>
      <Tag>{t.kicker}</Tag>
      <h2 id="formate-h" class="h2" data-split>{t.h}</h2>
    </div>
    <div class="formate__pfeile">
      <button type="button" class="formate__pfeil" aria-label={t.prev} aria-controls="formate-streifen" data-strip-prev>←</button>
      <button type="button" class="formate__pfeil formate__pfeil--voll" aria-label={t.next} aria-controls="formate-streifen" data-strip-next>→</button>
    </div>
  </div>
  <ul class="streifen" id="formate-streifen" aria-label={t.list} data-strip>
    {items.map((f) => {
      const El = f.page ? 'a' : 'article';
      return (
        <li class="streifen__el">
          <El class:list={['karte', f.page && 'karte--link']} href={f.page} data-format={f.id}>
            <span class="karte__bild">
              <Image src={f.image} alt={f.alt} widths={[340, 520, 680]} sizes="(min-width: 1300px) 340px, (min-width: 1000px) 26vw, 280px" />
            </span>
            <span class="karte__text">
              <span class="karte__meta">{f.n} · {f.since}</span>
              <h3 class="karte__t">{f.title}{f.page && <span class="karte__pfeil" aria-hidden="true"> →</span>}</h3>
              <span class="karte__d">{f.summary}</span>
            </span>
          </El>
        </li>
      );
    })}
  </ul>
</section>

<script>
  import { gsap, EASE, motionOk } from '../../scripts/gsap';

  const root = document.querySelector<HTMLElement>('[data-formats]');
  const strip = root?.querySelector<HTMLElement>('[data-strip]');
  const prev = root?.querySelector<HTMLButtonElement>('[data-strip-prev]');
  const next = root?.querySelector<HTMLButtonElement>('[data-strip-next]');
  if (root && strip && prev && next) {
    const schritt = () => (strip.querySelector('li')?.getBoundingClientRect().width ?? 320) + 20;
    const ruhig = !motionOk();
    prev.addEventListener('click', () => strip.scrollBy({ left: -schritt(), behavior: ruhig ? 'auto' : 'smooth' }));
    next.addEventListener('click', () => strip.scrollBy({ left: schritt(), behavior: ruhig ? 'auto' : 'smooth' }));
    // Pfeile am Anfang bzw. Ende sperren
    const pruefen = () => {
      prev.disabled = strip.scrollLeft < 4;
      next.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
    };
    strip.addEventListener('scroll', pruefen, { passive: true });
    addEventListener('resize', pruefen);
    pruefen();

    if (!ruhig) {
      gsap.from(strip.querySelectorAll('.streifen__el'), {
        x: -48, opacity: 0, duration: 0.9, ease: EASE, stagger: 0.08, clearProps: 'transform,opacity',
        scrollTrigger: { trigger: strip, start: 'top 85%', once: true },
      });
    }
  }
</script>

<style>
  .formate { background: var(--tint); padding: clamp(64px, 8vw, 104px) 0; }
  .formate__kopf { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px; margin-bottom: 32px; }
  .formate__kopf :global(.tag) { margin-bottom: 14px; }
  .formate .h2 { font-size: clamp(36px, 4.4vw, 56px); }
  .formate__pfeile { display: flex; gap: 8px; }
  .formate__pfeil {
    width: 48px; height: 48px; border: 1.5px solid var(--purple); border-radius: 0; background: transparent; color: var(--purple);
    font-family: var(--font-display); font-size: 22px; cursor: pointer; transition: background var(--dur-base), border-color var(--dur-base), color var(--dur-base);
  }
  .formate__pfeil:hover:not(:disabled) { border-color: var(--magenta); color: var(--magenta-2); }
  .formate__pfeil--voll { background: var(--purple); color: #fff; }
  .formate__pfeil--voll:hover:not(:disabled) { background: var(--magenta); color: #fff; }
  .formate__pfeil:disabled { opacity: 0.35; cursor: default; }

  .streifen {
    --rand: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: var(--rand);
    margin: 0; padding: 0 var(--rand) 8px; list-style: none; scrollbar-width: none;
  }
  .streifen::-webkit-scrollbar { display: none; }
  .streifen__el { flex: 0 0 clamp(260px, 26vw, 340px); scroll-snap-align: start; display: flex; }
  .karte { flex: 1; display: flex; flex-direction: column; background: #fff; border-top: 3px solid var(--magenta); color: var(--purple); }
  .karte--link:hover { color: var(--magenta-2); }
  .karte__bild { position: relative; display: block; aspect-ratio: 4 / 3; background: var(--purple); overflow: hidden; clip-path: polygon(0 0, 100% 0, 100% 84%, 88% 100%, 0 100%); }
  .karte__bild :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 900ms var(--ease-out); }
  .karte--link:hover .karte__bild :global(img) { transform: scale(1.04); }
  .karte__text { display: flex; flex-direction: column; gap: 10px; padding: 20px 22px 24px; }
  .karte__meta { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); }
  .karte__t { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 26px; line-height: 1.05; letter-spacing: -0.025em; color: inherit; transition: color var(--dur-base); }
  .karte__pfeil { color: var(--magenta); }
  .karte__d { font-size: 14.5px; line-height: 1.55; color: var(--ink-soft); text-wrap: pretty; }
</style>
