---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import type { Alternates } from '../../layouts/Base.astro';
import { getLang, langNames, tr, url } from '../../lib/i18n';

interface Props {
  alternates?: Alternates;
  /** Fortschrittsbalken unter dem Kopf (Startseite: läuft ab dem Ende des Hero) */
  fortschritt?: boolean;
}
const { alternates = {}, fortschritt = false } = Astro.props;
const lang = getLang(Astro);
const other = lang === 'de' ? 'en' : 'de';
const otherUrl = alternates[other] ?? url(other, 'home');
const t = tr(lang, {
  de: { home: 'TanzNetzDresden – zur Startseite', menu: 'Menü', mainNav: 'Hauptnavigation', intern: 'Login', internBereich: 'Interner Bereich', join: 'Mitglied werden', calendar: 'Kalender', news: 'News', formats: 'Formate', training: 'Training', about: 'Über uns', donate: 'Spenden', switchTo: 'Switch to English' },
  en: { home: 'TanzNetzDresden – home', menu: 'Menu', mainNav: 'Main navigation', intern: 'Login', internBereich: 'Members area', join: 'Become a member', calendar: 'Calendar', news: 'News', formats: 'Formats', training: 'Training', about: 'About', donate: 'Donate', switchTo: 'Auf Deutsch wechseln' },
});
// Reihenfolge wie im Entwurf Startseite v5 (+ Spenden aus dem Spenden-Entwurf); das Netzwerk steht unter „Über uns“
const nav = [
  { href: url(lang, 'termine'), label: t.calendar },
  { href: url(lang, 'home', '#formate'), label: t.formats },
  { href: url(lang, 'profitraining'), label: t.training },
  { href: url(lang, 'news'), label: t.news },
  // Profile gehören zum Netzwerk und damit zu „Über uns“
  { href: url(lang, 'verein'), label: t.about, auch: url(lang, 'netzwerk') },
  { href: url(lang, 'spenden'), label: t.donate },
];
---
<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href={url(lang, 'home')} class="site-header__logo" aria-label={t.home} data-logo>
      <Logo part="mark" />
      <span class="site-header__rainbow" aria-hidden="true" data-rainbow></span>
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span>{t.menu}</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
    </button>
    <div class="site-header__right" id="site-menu" data-menu>
      <nav class="site-nav" aria-label={t.mainNav}>
        {nav.map((item) => <a class="mono-link" href={item.href} data-nav-link data-nav-auch={item.auch}>{item.label}</a>)}
        <span class="site-nav__strich" aria-hidden="true" data-nav-strich></span>
      </nav>
      <a class="mono-link site-header__login" href={url(lang, 'intern')} data-nav-link data-login>{t.intern}</a>
      <a class="mono-link site-header__lang" href={otherUrl} hreflang={other} lang={other} title={t.switchTo}>
        <span class="visually-hidden">{langNames[other]}</span><span aria-hidden="true">{other.toUpperCase()}</span>
      </a>
      <Button href={url(lang, 'mitglied')} variant="secondary" size="sm" marker>{t.join}</Button>
    </div>
  </div>
  {fortschritt && <span class="site-header__fortschritt" aria-hidden="true" data-fortschritt></span>}
</header>

<!-- Blende beim Klick auf „Login“ (scripts/blende.ts), im internen Bereich läuft sie weiter -->
<div class="login-blende" aria-hidden="true" hidden data-login-blende>
  <span class="login-blende__naht" data-blende-naht></span>
  <span class="login-blende__flaeche" data-blende-flaeche></span>
  <span class="login-blende__mitte">
    <span class="login-blende__logo" data-blende-logo><Logo part="mark" /></span>
    <span class="login-blende__tag" data-blende-tag>{t.internBereich}</span>
  </span>
</div>

<script>
  import { blendeEin } from '../../scripts/blende';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  // „Login“: Blende zuziehen, dann in den internen Bereich (ohne Blende bei „Bewegung reduzieren“)
  const blende = document.querySelector<HTMLElement>('[data-login-blende]');
  header?.querySelector<HTMLAnchorElement>('[data-login]')?.addEventListener('click', (e) => {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || !blende) return;
    if (blendeEin(blende, (e.currentTarget as HTMLAnchorElement).href)) e.preventDefault();
  });
  // Zurück aus dem internen Bereich (Seite aus dem Zwischenspeicher): Blende wieder weg
  addEventListener('pageshow', (e) => {
    if (!e.persisted || !blende) return;
    blende.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    blende.hidden = true;
  });

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  header?.querySelectorAll('[data-menu] a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Regenbogen läuft einmal durch das Zeichen, wenn man es berührt oder per Tastatur ansteuert.
  const logo = header?.querySelector<HTMLElement>('[data-logo]');
  const rainbow = logo?.querySelector<HTMLElement>('[data-rainbow]');
  let sweep: Animation | undefined;
  const runRainbow = () => {
    if (!rainbow?.animate || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (sweep?.playState === 'running') return;
    sweep = rainbow.animate([{ backgroundPosition: '100% 0' }, { backgroundPosition: '0% 0' }], {
      duration: 950,
      easing: 'cubic-bezier(0.45, 0, 0.25, 1)',
    });
  };
  logo?.addEventListener('pointerenter', runRainbow);
  logo?.addEventListener('focus', runRainbow);

  // Fortschritt (Startseite): läuft vom Ende des Hero bis zum Seitenende
  const balken = header?.querySelector<HTMLElement>('[data-fortschritt]');
  if (balken) {
    let raf = 0;
    const messen = () => {
      raf = 0;
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      const start = hero ? hero.offsetTop + hero.offsetHeight - (header?.offsetHeight ?? 0) : 0;
      const weg = document.documentElement.scrollHeight - innerHeight - start;
      const q = weg > 0 ? Math.max(0, Math.min(1, (scrollY - start) / weg)) : 0;
      balken.style.transform = `scaleX(${q.toFixed(4)})`;
    };
    const planen = () => (raf ||= requestAnimationFrame(messen));
    addEventListener('scroll', planen, { passive: true });
    addEventListener('resize', planen);
    messen();
  }

  // Aktiven Menüpunkt markieren: Unterseiten per Pfad, Startseite per sichtbarem Abschnitt.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  links.forEach((a) => {
    const auch = a.dataset.navAuch;
    if (!a.hash && a.pathname.length > 1 && (location.pathname.startsWith(a.pathname) || (auch && location.pathname.startsWith(auch)))) {
      a.setAttribute('aria-current', 'page');
    }
  });

  // Ein Strich unter dem aktiven Menüpunkt, der beim Wechsel hinübergleitet – auch über den Seitenwechsel:
  // Beim Klick merken wir uns, wo er stand, und die neue Seite lässt ihn von dort aus weiterlaufen.
  const navEl = header?.querySelector<HTMLElement>('.site-nav');
  const strich = navEl?.querySelector<HTMLElement>('[data-nav-strich]');
  const STRICH_KEY = 'tndd-strich';
  type Lage = { x: number; w: number };
  const navLinks = links.filter((a) => navEl?.contains(a));
  const lageVon = (a: HTMLElement): Lage => ({ x: a.offsetLeft, w: a.offsetWidth });
  const strichLage = (): Lage | null => (strich?.classList.contains('is-da') ? { x: Number(strich.dataset.x), w: Number(strich.dataset.w) } : null);
  const zeichnen = (l: Lage) => {
    if (!strich) return;
    strich.dataset.x = String(l.x);
    strich.dataset.w = String(l.w);
    strich.style.transform = `translateX(${l.x}px)`;
    strich.style.width = `${l.w}px`;
  };
  // Von einer Lage zur anderen; ohne Ausgangslage wächst er aus der Mitte des Ziels
  const strichZu = (ziel: Lage | null, von: Lage | null) => {
    if (!strich) return;
    const ruhig = matchMedia('(prefers-reduced-motion: reduce), (max-width: 1100px)').matches || !strich.animate;
    strich.getAnimations().forEach((a) => a.cancel());
    const start = von ?? (ziel && { x: ziel.x + ziel.w / 2, w: 0 });
    if (!ziel) {
      strich.classList.remove('is-da');
      if (von && !ruhig) {
        strich.animate([{ transform: `translateX(${von.x}px)`, width: `${von.w}px`, opacity: 1 }, { transform: `translateX(${von.x + von.w / 2}px)`, width: '0px', opacity: 1 }], { duration: 450, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
      }
      return;
    }
    zeichnen(ziel);
    strich.classList.add('is-da');
    if (ruhig || !start || (start.x === ziel.x && start.w === ziel.w)) return;
    strich.animate(
      [{ transform: `translateX(${start.x}px)`, width: `${start.w}px` }, { transform: `translateX(${ziel.x}px)`, width: `${ziel.w}px` }],
      { duration: 650, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
    );
  };
  const aktiverLink = () => navLinks.find((a) => a.hasAttribute('aria-current'));
  const strichZumAktiven = (animiert: boolean) => {
    const a = aktiverLink();
    const ziel = a ? lageVon(a) : null;
    if (animiert) strichZu(ziel, strichLage());
    else if (ziel) zeichnen(ziel);
  };

  if (navEl && strich) {
    navEl.classList.add('hat-strich');
    // gemerkte Lage von der vorigen Seite (nur kurz gültig, damit „Zurück“ später nichts Altes abspielt)
    let vorher: Lage | null = null;
    try {
      const roh = sessionStorage.getItem(STRICH_KEY);
      sessionStorage.removeItem(STRICH_KEY);
      const g = roh ? JSON.parse(roh) : null;
      if (g && Date.now() - g.t < 10000) vorher = { x: g.x, w: g.w };
    } catch {}
    const loslegen = () => {
      const a = aktiverLink();
      strichZu(a ? lageVon(a) : null, vorher);
    };
    // erst messen, wenn die Schrift steht, sonst stimmen Breite und Lage nicht
    (document.fonts?.ready ?? Promise.resolve()).then(loslegen);
    // jeder Link im Kopf nimmt die Lage mit (auch Logo und „Mitglied werden“: dort zieht sich der Strich zurück)
    header?.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) =>
      a.addEventListener('click', () => {
        const l = strichLage();
        try {
          if (l) sessionStorage.setItem(STRICH_KEY, JSON.stringify({ ...l, t: Date.now() }));
        } catch {}
      }),
    );
    addEventListener('resize', () => strichZumAktiven(false));
  }

  const targets = links
    .filter((a) => a.hash && a.pathname === location.pathname)
    .map((a) => document.querySelector<HTMLElement>(a.hash))
    .filter((el): el is HTMLElement => !!el);
  if ('IntersectionObserver' in window && targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.hash && a.toggleAttribute('aria-current', a.hash === `#${e.target.id}`));
          strichZumAktiven(true);
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 30; background: var(--purple);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .site-header__fortschritt {
    position: absolute; left: 0; right: 0; bottom: -3px; height: 3px; background: var(--magenta);
    transform: scaleX(0); transform-origin: 0 50%; pointer-events: none;
  }
  .site-header__inner {
    max-width: var(--wrap); margin: 0 auto; padding: 18px var(--gutter);
    display: flex; align-items: center; flex-wrap: wrap; gap: 16px 40px;
  }
  .site-header__logo { position: relative; display: flex; align-items: center; color: #fff; width: 76px; }
  .site-header__logo:hover { color: #fff; }
  .site-header__rainbow {
    position: absolute; inset: 0; pointer-events: none;
    background-image: var(--logo-rainbow); background-size: 300% 100%; background-position: 100% 0;
    -webkit-mask: url('../../../design/system/assets/logo/tndd-mark.svg') center / 100% 100% no-repeat;
    mask: url('../../../design/system/assets/logo/tndd-mark.svg') center / 100% 100% no-repeat;
  }
  .site-header__right {
    margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end;
    gap: 12px clamp(16px, 2.4vw, 36px);
  }
  .site-nav { display: flex; flex-wrap: wrap; gap: 6px clamp(14px, 2vw, 28px); }
  .site-nav a, .site-header__login {
    color: #fff; padding: 6px 0; border-bottom: 1.5px solid transparent;
    transition: color var(--dur-base), border-color var(--dur-base);
  }
  .site-nav a:hover, .site-header__login:hover { color: var(--cyan); }
  .site-nav a[aria-current], .site-header__login[aria-current] { border-bottom-color: var(--magenta); }
  /* mit JavaScript übernimmt ein gleitender Strich die Unterstreichung (nur in der Zeile, nicht im Menü) */
  .site-nav { position: relative; }
  .site-nav__strich {
    position: absolute; left: 0; bottom: 0; width: 0; height: 1.5px; background: var(--magenta);
    opacity: 0; pointer-events: none;
  }
  @media (min-width: 1101px) {
    .site-nav.hat-strich a[aria-current] { border-bottom-color: transparent; }
    .site-nav__strich.is-da { opacity: 1; }
  }

  .login-blende { position: fixed; inset: 0; z-index: 200; overflow: hidden; pointer-events: auto; }
  .login-blende[hidden] { display: none; }
  .login-blende__naht, .login-blende__flaeche {
    position: absolute; top: 0; bottom: 0; left: 0; width: calc(100% + 14vw); transform: translateX(-100%);
    clip-path: polygon(0 0, 100% 0, calc(100% - 14vw) 100%, 0 100%);
  }
  .login-blende__naht { background: var(--magenta); }
  .login-blende__flaeche { background: var(--purple); }
  .login-blende__mitte { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; }
  .login-blende__logo { display: block; width: min(320px, 50vw); color: #fff; opacity: 0; }
  .login-blende__tag { font-family: var(--font-mono); font-size: 13px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cyan); white-space: nowrap; opacity: 0; }
  .site-header__lang {
    color: #fff; padding: 5px 8px; border: 1.5px solid rgba(255, 255, 255, 0.4);
    transition: border-color var(--dur-base), color var(--dur-base);
  }
  .site-header__lang:hover { border-color: var(--magenta); color: var(--cyan); }

  .menu-toggle {
    display: none; margin-left: auto; align-items: center; gap: 12px; background: transparent; border: 0;
    color: #fff; cursor: pointer; padding: 8px 0; font-family: var(--font-mono); font-size: 12px;
    font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .menu-toggle__icon { display: grid; gap: 5px; width: 22px; }
  .menu-toggle__icon span { height: 2px; background: currentColor; transition: transform var(--dur-slow) var(--ease-out), width var(--dur-slow); }
  .menu-toggle__icon span:last-child { width: 14px; background: var(--magenta); }

  /* Unterhalb 1100px passt die Navigation nicht mehr in eine Zeile → Menü */
  @media (max-width: 1100px) {
    .site-header__inner { padding-block: 14px; }
    .site-header__logo { width: 64px; }
    .menu-toggle { display: inline-flex; }
    .site-header__right {
      display: none; width: 100%; margin: 0; flex-direction: column; align-items: flex-start; gap: 18px;
      padding: 8px 0 18px; border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    .site-nav { flex-direction: column; gap: 2px; padding-top: 10px; }
    .site-nav a { font-family: var(--font-display); font-size: 30px; font-weight: 800; letter-spacing: -0.02em; text-transform: none; }
    .site-header.is-open .site-header__right { display: flex; }
    .site-header.is-open .menu-toggle__icon span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .site-header.is-open .menu-toggle__icon span:last-child { width: 22px; transform: translateY(-3.5px) rotate(-45deg); }
  }
</style>
