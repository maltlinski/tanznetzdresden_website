---
import Tag from '../ui/Tag.astro';
import EventList from '../EventList.astro';
import EventFilter from '../EventFilter.astro';
import { getUpcoming } from '../../lib/content';
import { href } from '../../lib/url';
import { getLang, tr, url } from '../../lib/i18n';

const events = await getUpcoming(6);
const lang = getLang(Astro);
const t = tr(lang, {
  de: { kicker: 'Tanzkalender', h: 'Nächste Termine', all: 'Ganzer Kalender →', ics: 'Kalender abonnieren (.ics)', submit: 'Termin einreichen' },
  en: { kicker: 'Dance calendar', h: 'Upcoming events', all: 'Full calendar →', ics: 'Subscribe to calendar (.ics)', submit: 'Submit an event' },
});
---
<section id="termine" class="section" aria-labelledby="termine-h">
  <div class="wrap">
    <div class="section-head">
      <div data-reveal>
        <Tag>{t.kicker}</Tag>
        <h2 id="termine-h" class="h2">{t.h}</h2>
      </div>
      <EventFilter events={events} target="home-events" />
    </div>

    <EventList events={events} id="home-events" />

    <div class="events-links">
      <a class="mono-link" href={url(lang, 'termine')}>{t.all}</a>
      <a class="mono-link" href={href('termine.ics')}>{t.ics}</a>
      <a class="mono-link" href={url(lang, 'kontakt', '#termin-einreichen')}>{t.submit}</a>
    </div>
  </div>
</section>

<style>
  .events-links { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 28px; }
  .events-links a { letter-spacing: 0.14em; color: var(--ink-soft); }
  .events-links a:hover { color: var(--magenta); }
  .events-links a:first-child { color: var(--magenta); }
  .events-links a:first-child:hover { color: var(--purple); }
</style>
