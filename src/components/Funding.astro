---
/**
 * Förderhinweis (Publizitätspflicht laut Zuwendungsbescheiden).
 * Förderer stehen in src/settings/verein.json → funders, die Logos in
 * src/assets/foerderer/. Logos stehen auf Weiß – so verlangen es die meisten
 * Gestaltungsvorgaben, und farbige Logos bleiben lesbar.
 * Pflichttexte (notice) werden als echter Text ausgegeben, nicht im Bild.
 */
import { Image } from 'astro:assets';
import { getVerein } from '../lib/settings';
import { getLang, tr } from '../lib/i18n';

const lang = getLang(Astro);
const v = getVerein(lang);
const t = tr(lang, { de: { heading: 'Gefördert durch', newTab: 'öffnet in neuem Tab' }, en: { heading: 'Funded by', newTab: 'opens in a new tab' } });

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/foerderer/*.{svg,png,jpg,jpeg,webp}', { eager: true });
const logoFor = (file: string) => (file ? logoFiles[`../assets/foerderer/${file}`]?.default : undefined);
const funders = v.funders.map((f) => ({ ...f, image: logoFor(f.logo) }));
const notices = funders.map((f) => f.notice).filter(Boolean);
---
{funders.length > 0 && (
  <section class="funding" aria-labelledby="funding-h">
    <div class="funding__inner">
      <h2 id="funding-h" class="funding__h">{t.heading}</h2>
      <ul class="funding__list">
        {funders.map((f) => (
          <li>
            <a href={f.url} rel="noopener" target="_blank" class="funding__item" title={f.name}>
              {f.image ? (
                <Image
                  src={f.image}
                  alt={f.name}
                  height={f.height}
                  densities={[1, 2]}
                  class="funding__logo"
                  loading="lazy"
                />
              ) : (
                <span class="funding__name">{f.name}</span>
              )}
              <span class="visually-hidden"> ({t.newTab})</span>
            </a>
          </li>
        ))}
      </ul>
      {(notices.length > 0 || v.fundingText) && (
        <div class="funding__notices">
          {v.fundingText && <p>{v.fundingText}</p>}
          {notices.map((n) => <p>{n}</p>)}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .funding { background: #fff; color: var(--ink); border-bottom: 1px solid var(--rule); }
  .funding__inner {
    max-width: var(--wrap); margin: 0 auto; padding: 28px var(--gutter) 24px;
    display: grid; grid-template-columns: auto 1fr; gap: 16px 40px; align-items: center;
  }
  .funding__h {
    margin: 0; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--magenta-2); white-space: nowrap;
  }
  .funding__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 20px 44px; }
  .funding__item { display: inline-flex; align-items: center; color: inherit; transition: opacity var(--dur-base); }
  .funding__item:hover { opacity: 0.75; }
  .funding__item :global(.funding__logo) { display: block; max-width: none; }
  .funding__name { font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--purple); border-bottom: 1.5px solid var(--magenta); }
  .funding__notices { grid-column: 2; display: grid; gap: 4px; max-width: 760px; font-size: 12.5px; line-height: 1.5; color: var(--ink-soft); }
  .funding__notices p { margin: 0; }
  @media (max-width: 760px) {
    .funding__inner { grid-template-columns: 1fr; }
    .funding__notices { grid-column: 1; }
    .funding__list { gap: 18px 28px; }
  }
</style>
