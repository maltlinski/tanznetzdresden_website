---
/**
 * Intern → KEEP UP und Kalender: Daten aus dem Build für die Seiten im Browser (Dozent:innen, Fotos der Website
 * für „Aus Mediathek“, Standardort; mit `kalender` auch Termine aus Dateien, Formate, Personen, Orte und die
 * Abo-Adresse) und die gemeinsame Meldung unten links. Gemeinsame Stile der KEEP UP-Seiten.
 */
import { getImage } from 'astro:assets';
import { getKeepUp } from '../../lib/keep-up';
import { getVerein } from '../../lib/settings';
import { getDateiTermine, getFormate, getOrte } from '../../lib/content';
import { getProfiles } from '../../lib/profiles';
import { getLang, url } from '../../lib/i18n';
import { href } from '../../lib/url';
import type { KalenderDaten, KeepUpDaten } from '../../scripts/intern/keep-up';

interface Props {
  /** zusätzlich die Daten für Intern → Kalender */
  kalender?: boolean;
}
const { kalender = false } = Astro.props;
// Meine Trainings und der Editor gibt es auch auf Englisch (/en/intern/keep-up/…)
const lang = getLang(Astro);

const { dozentinnen } = await getKeepUp(lang);
const verein = getVerein(lang);
const dateien = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const klein = async (src: ImageMetadata | string) => (typeof src === 'string' ? src : (await getImage({ src, width: 160, height: 160, fit: 'cover' })).src);

const daten: KeepUpDaten = {
  dozentinnen: await Promise.all(
    dozentinnen.map(async (d) => ({ id: d.id, name: d.name, stil: d.stil, foto: d.placeholder ? '' : await klein(d.photo) })),
  ),
  fotos: await Promise.all(
    Object.entries(dateien)
      .sort(([a], [b]) => a.localeCompare(b))
      .map(async ([pfad, m]) => ({ bild: pfad.replace('../../', ''), src: (await getImage({ src: m.default, width: 480 })).src, alt: '' })),
  ),
  ort: verein.training.place,
  website: url(lang, 'profitraining', '#kalender'),
};

if (kalender) {
  const dateiTermine = (await getDateiTermine()).map((t) => {
    const [datum, von] = t.data.start.split(' ');
    return {
      datei: true as const, slug: t.id, titel: t.data.title, titel_en: t.data.title_en ?? '', datum, von, bis: t.data.end?.split(' ')[1] ?? null,
      zeit_text: t.data.timeLabel ?? '', ort: t.data.venue, kategorie: t.data.category, kurz: t.data.teaser, kurz_en: t.data.teaser_en ?? '',
      text: t.body?.trim() ?? '', link: t.data.link ?? '', format: t.data.format?.id ?? '', personen: t.data.people, news: t.data.news ?? '',
    };
  });
  const k: KalenderDaten = {
    dateiTermine,
    formate: (await getFormate()).map((f) => ({ id: f.id, titel: f.data.title })),
    personen: (await getProfiles()).map((p) => ({ id: p.id, name: p.name })).sort((a, b) => a.name.localeCompare(b.name, 'de')),
    orte: [...new Set([verein.training.place, ...dateiTermine.map((t) => t.ort), ...(await getOrte()).map((o) => o.data.name)])].filter(Boolean),
    abo: new URL(href('termine.ics'), Astro.site ?? 'https://tanznetzdresden.de').href,
  };
  daten.kalender = k;
}
const json = JSON.stringify(daten).replace(/</g, '\\u003c');
---
<script type="application/json" data-ku-daten set:html={json} />
<div class="ku-toast" role="status" data-ku-toast hidden>
  <span class="ku-toast__sq" aria-hidden="true"></span>
  <span data-ku-toast-text></span>
  <button type="button" class="ku-toast__knopf" data-ku-toast-knopf hidden></button>
</div>

<style is:global>
  /* Gemeinsam für Intern → KEEP UP */
  .ku-kopf { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 32px; margin-bottom: 28px; }
  .ku-kopf__titel { display: flex; flex-direction: column; gap: 14px; }
  .ku-kopf .i-h1 { margin: 0; }
  .ku-badge { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 7px; white-space: nowrap; }
  .ku-badge--outline { background: transparent; color: var(--ink-soft); box-shadow: none; outline: 1.5px solid var(--rule); outline-offset: -1.5px; }
  .ku-badge--magenta { background: var(--magenta); color: #fff; }
  .ku-avatar {
    position: relative; flex: none; width: 36px; height: 36px; overflow: hidden; display: flex; align-items: center; justify-content: center;
    background: var(--purple); color: var(--cyan); font-family: var(--font-display); font-weight: 800; font-size: 13px;
  }
  .ku-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ku-avatar--workshop { background: var(--magenta-2); color: #fff; }
  .ku-hinweis {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px;
    padding: 20px 22px; margin-bottom: 28px; background: var(--purple); color: #fff;
  }
  .ku-hinweis__text { display: flex; align-items: flex-start; gap: 14px; min-width: 0; flex: 1 1 360px; }
  .ku-hinweis__sq { flex: none; width: 12px; height: 12px; margin-top: 6px; background: var(--magenta); }
  .ku-hinweis__titel { display: block; font-family: var(--font-display); font-weight: 700; font-size: 19px; line-height: 1.2; letter-spacing: -0.01em; }
  .ku-hinweis__namen { display: block; margin-top: 6px; font-size: 14px; line-height: 1.5; color: rgba(255, 255, 255, 0.86); }
  .ku-checks { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .ku-check {
    display: flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted);
  }
  .ku-check::before { content: ''; width: 9px; height: 9px; flex: none; border: 1.5px solid var(--ink-muted); }
  .ku-check.is-ok { color: var(--purple); }
  .ku-check.is-ok::before { background: var(--magenta); border-color: var(--magenta); }
  .ku-label { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); }
  .ku-ghost {
    display: inline-flex; align-items: center; gap: 9px; padding: 12px 18px; border: 1.5px solid var(--purple); background: transparent; color: var(--purple);
    font-family: var(--font-body); font-weight: 600; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer;
  }
  .ku-ghost:hover { border-color: var(--magenta); color: var(--magenta-2); }
  .ku-ghost--sm { padding: 8px 12px; font-size: 11px; }
  .ku-linie {
    padding: 0 0 3px; border: 0; border-bottom: 1.5px solid var(--magenta); background: none; cursor: pointer; color: var(--purple);
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .ku-linie:hover { color: var(--magenta-2); }
  .ku-toast {
    position: fixed; left: 244px; bottom: 24px; z-index: 70; max-width: min(560px, calc(100vw - 48px));
    display: flex; align-items: center; gap: 16px; padding: 14px 16px 14px 18px; background: var(--purple); color: #fff; font-size: 14.5px; line-height: 1.45;
  }
  .ku-toast[hidden] { display: none; }
  .ku-toast__sq { flex: none; width: 10px; height: 10px; background: var(--magenta); }
  .ku-toast__knopf {
    flex: none; padding: 0 0 3px; border: 0; border-bottom: 1.5px solid var(--magenta); background: none; color: var(--cyan); cursor: pointer;
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .ku-toast__knopf:hover { color: #fff; }
  @media (max-width: 900px) { .ku-toast { left: 16px; right: 16px; bottom: 16px; } }
</style>
