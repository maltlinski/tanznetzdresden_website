---
/**
 * Terminliste mit Kategorie-Filter. Wird auf der Startseite (gekürzt) und
 * unter /termine (vollständig, nach Monaten) verwendet.
 */
import Badge from './ui/Badge.astro';
import { badgeVariant, categoryLabel, type Termin } from '../lib/content';
import { dateParts } from '../lib/dates';
import { getLang, loc, url } from '../lib/i18n';
import { texte } from '../lib/texte';

interface Props {
  events: Termin[];
  /** Überschriften je Monat einfügen */
  groupByMonth?: boolean;
  /** Id, über die der Filter (FilterChips) die Liste findet */
  id: string;
  /** schmale Liste ohne Kurzbeschreibung (Startseite neben den News) */
  kompakt?: boolean;
  /** höchstens so viele Termine zeigen (auch nach dem Filtern) */
  max?: number;
}
const { events, groupByMonth = false, id, kompakt = false, max } = Astro.props;

const lang = getLang(Astro);
const t = texte(lang, 'termine', 'liste');
const rows = events.map((e) => ({
  ...e.data,
  id: e.id,
  ...dateParts(e.data.start, lang),
  title: loc(e.data, 'title', lang),
  teaser: loc(e.data, 'teaser', lang),
  timeLabel: loc(e.data, 'timeLabel', lang),
}));
let lastMonth = '';
---
<ul class:list={['events', kompakt && 'events--kompakt']} id={id} data-event-list data-max={max}>
  {rows.map((e, i) => {
    const heading = groupByMonth && e.monthLong !== lastMonth ? (lastMonth = e.monthLong) : null;
    return (
      <>
        {heading && <li class="events__month" data-month>{heading}</li>}
        <li class="event" id={groupByMonth ? e.id : undefined} data-cat={e.category} data-end={(e.end ?? e.start).replace(' ', 'T')} hidden={max !== undefined && i >= max}>
          <a href={url(lang, 'termine', `${e.id}/`)}>
            <time class="event__date" datetime={e.iso}>
              <span class="event__dow" aria-hidden="true">{e.dow}</span>
              <span class="event__dm" aria-hidden="true"><span class="event__day">{e.day}</span><span class="event__mo">{e.month}</span></span>
              <span class="visually-hidden">{e.long}</span>
            </time>
            <div class="event__body">
              <h3 class="event__title">{e.title}</h3>
              <p class="event__meta">{e.venue} · {e.timeLabel ?? e.time}{!kompakt && ` · ${e.teaser}`}</p>
            </div>
            <div class="event__side">
              <Badge variant={badgeVariant[e.category]}>{categoryLabel[lang][e.category]}</Badge>
              {!kompakt && <span class="event__arrow" aria-hidden="true">→</span>}
            </div>
          </a>
        </li>
      </>
    );
  })}
  <li class="events__empty" data-empty hidden>{t.empty}</li>
</ul>

<script>
  import { gsap, ScrollTrigger, EASE, motionOk } from '../scripts/gsap';
  import { begrenzen } from '../scripts/event-list';

  // Vergangene Termine ausblenden, auch wenn die Seite seit dem letzten Build nicht neu gebaut wurde.
  const now = Date.now();
  document.querySelectorAll<HTMLElement>('[data-event-list] .event[data-end]').forEach((li) => {
    const end = Date.parse(li.dataset.end ?? '');
    if (end && end + 3 * 3600_000 < now) li.remove();
  });
  // dann rücken spätere nach (Listen mit Höchstzahl)
  document.querySelectorAll<HTMLElement>('[data-event-list][data-max]').forEach(begrenzen);

  // Termine laufen beim Scrollen gruppenweise von links ein, das Datum steigt kurz nach
  if (motionOk()) {
    document.querySelectorAll<HTMLElement>('[data-event-list]').forEach((list) => {
      const rows = [...list.querySelectorAll<HTMLElement>('.event, .events__month')];
      gsap.set(rows, { opacity: 0, x: -40 });
      ScrollTrigger.batch(rows, {
        start: 'top 92%',
        once: true,
        onEnter: (batch) => {
          gsap.to(batch, { opacity: 1, x: 0, duration: 0.8, ease: EASE, stagger: 0.07, clearProps: 'transform,opacity' });
          const days = batch.flatMap((r) => [...r.querySelectorAll('.event__day')]);
          gsap.from(days, { yPercent: 60, opacity: 0, duration: 0.7, ease: EASE, stagger: 0.07, delay: 0.12, clearProps: 'transform,opacity' });
        },
      });
    });
  }
</script>

<style>
  .events { border-bottom: 1px solid var(--rule); list-style: none; margin: 0; padding: 0; }
  .events__month {
    padding: 36px 12px 14px; font-family: var(--font-mono); font-size: 12px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--magenta);
  }
  .events__empty { padding: 24px 12px; border-top: 1px solid var(--rule); color: var(--ink-soft); }
  .event { scroll-margin-top: calc(var(--header-h) + 16px); }
  .event:target a { background: var(--magenta-tint); }
  .event a {
    display: grid; grid-template-columns: minmax(84px, 120px) minmax(0, 1fr) auto;
    gap: clamp(16px, 3vw, 40px); align-items: center; padding: 24px 12px;
    border-top: 1px solid var(--rule); color: var(--purple); transition: background 200ms;
  }
  .event a:hover { background: var(--tint); color: var(--purple); }
  .event a:hover .event__arrow { transform: translateX(6px); color: var(--magenta); }
  .event__date { display: flex; flex-direction: column; gap: 4px; }
  .event__dow {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink-muted);
  }
  .event__dm { display: flex; align-items: baseline; gap: 8px; }
  .event__day {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(34px, 3.6vw, 46px);
    line-height: 0.9; letter-spacing: -0.03em; color: var(--magenta);
  }
  .event__mo {
    font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--purple);
  }
  .event__body { min-width: 0; }
  .event__title {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(20px, 2vw, 26px);
    letter-spacing: -0.015em; line-height: 1.15; color: var(--purple); margin: 0 0 6px;
  }
  .event__meta { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); }
  .event__side { display: flex; align-items: center; gap: 20px; }
  .event__arrow {
    font-family: var(--font-display); font-size: 22px; color: var(--purple);
    transition: transform var(--dur-slow) var(--ease-out), color var(--dur-base);
  }
  .events--kompakt .event a { grid-template-columns: 76px minmax(0, 1fr) auto; gap: clamp(14px, 2.4vw, 28px); padding: 20px 10px; }
  .events--kompakt .event__day { font-size: 38px; }
  .events--kompakt .event__mo { font-size: 11px; letter-spacing: 0.18em; }
  .events--kompakt .event__title { font-size: clamp(19px, 1.7vw, 23px); margin-bottom: 5px; }
  .events--kompakt .event__meta { font-size: 14px; }
  @media (max-width: 560px) {
    .event a, .events--kompakt .event a { grid-template-columns: 72px minmax(0, 1fr); padding: 20px 4px; }
    .event__side { grid-column: 2; }
    .event__arrow { display: none; }
  }
</style>
