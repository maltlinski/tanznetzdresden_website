---
/**
 * Standard-Seitenrahmen: Header, Inhalt, Footer.
 * `route` (+ `rest`) sagt, welche Seite das ist – daraus entstehen der
 * Sprachumschalter und die hreflang-Angaben.
 */
import Base, { type Alternates } from './Base.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import { routes, url, type RouteKey } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  route?: RouteKey;
  /** Zusatz hinter der Route, z. B. Profil-Kürzel "alba-t-alvarez/" */
  rest?: string;
  ogImage?: ImageMetadata;
  /** Fortschrittsbalken unter dem Kopf (Startseite) */
  fortschritt?: boolean;
}
const { route, rest = '', fortschritt = false, ...props } = Astro.props;
const alternates: Alternates = route
  ? { de: url('de', route, rest), en: routes[route].en === null ? null : url('en', route, rest) }
  : {};
---
<Base {...props} alternates={alternates}>
  <slot name="head" slot="head" />
  <Header alternates={alternates} fortschritt={fortschritt} />
  <main id="inhalt" tabindex="-1">
    <slot />
  </main>
  <Footer />
</Base>
