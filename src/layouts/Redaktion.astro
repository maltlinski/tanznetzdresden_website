---
/**
 * Redaktion (Presse, Vorstand, Admin): derselbe Rahmen wie der ganze interne Bereich (layouts/Intern.astro),
 * die Punkte der Redaktion stehen dort in der Seitenleiste unter „Redaktion“.
 */
import Intern from './Intern.astro';

interface Props {
  title: string;
  current: 'beitraege' | 'medien' | 'inhalte' | 'freigaben';
  /** Arbeitsfläche ohne Innenabstand (Editor mit eigener Kopfleiste) */
  voll?: boolean;
}
const { title, current, voll = false } = Astro.props;
---
<Intern title={`${title} · Redaktion`} current={current} voll={voll}><slot /></Intern>
