---
import { getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import ProtectedEmail from '../../components/ProtectedEmail.astro';
import { verein } from '../../lib/settings';

const entry = await getEntry('seiten', 'impressum');
if (!entry) throw new Error('src/content/seiten/impressum.md fehlt');
const { Content } = await render(entry);
const a = verein.address;
const r = verein.register;
---
<Page title="Impressum" description={entry.data.description}>
  <PageIntro kicker="Rechtliches" title="Impressum" />
  <section class="section">
    <div class="wrap">
      <Prose>
        <h2>Angaben gemäß § 5 DDG</h2>
        <p>
          <strong>{verein.legalName}</strong><br />
          {a.street}<br />{a.zip} {a.city}
        </p>
        <p>
          Vertreten durch den Vorstand: {r.representatives}<br />
          {r.representationNote}
        </p>
        <p>Eingetragen im Vereinsregister<br />Registergericht: {r.court}<br />Registernummer: {r.number}</p>
        <p>{r.taxNote}</p>

        <h2>Kontakt</h2>
        <p>
          Telefon: <a href={`tel:${verein.phone.replace(/\s/g, '')}`}>{verein.phone}</a><br />
          E-Mail: <ProtectedEmail email={verein.emails.kontakt} label="Adresse anzeigen" />
        </p>

        <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
        <p>{r.contentResponsible}</p>

        <Content />
        {entry.data.updated && <p class="updated">Stand: {new Date(entry.data.updated).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</p>}
      </Prose>
    </div>
  </section>
</Page>

<style>
  .updated { margin-top: 3em; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted); }
</style>
