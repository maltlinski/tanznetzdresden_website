---
import Page from '../../layouts/Page.astro';
import PageIntro from '../../components/PageIntro.astro';
import EventList from '../../components/EventList.astro';
import EventFilter from '../../components/EventFilter.astro';
import { getUpcoming } from '../../lib/content';
import { href } from '../../lib/url';

const events = await getUpcoming();
---
<Page title="Tanzkalender" description="Alle kommenden Termine der freien Tanzszene Dresden: Bühne, Training und Diskurs.">
  <PageIntro kicker="Tanzkalender" title="Was läuft" accent="im Netz." lead="Aufführungen, Training und Gespräche aus dem Netzwerk. Abonniere den Kalender, dann landen neue Termine automatisch in deiner Kalender-App." >
    <div class="cal-actions">
      <a class="btn btn--secondary btn--marker" href={href('termine.ics')}>Kalender abonnieren (.ics)</a>
      <a class="mono-link underline-link" href={href('kontakt/#termin-einreichen')}>Termin einreichen →</a>
    </div>
  </PageIntro>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Kommende Termine</h2>
        <EventFilter events={events} target="all-events" />
      </div>
      <EventList events={events} id="all-events" groupByMonth />
    </div>
  </section>
</Page>

<script>
  // #kategorie-training o. ä. in der URL wählt den passenden Filter vor.
  const m = location.hash.match(/^#kategorie-(\w+)/);
  if (m) {
    const want = m[1].toLowerCase();
    document.querySelectorAll<HTMLButtonElement>('[data-event-filter] button').forEach((b) => {
      if ((b.dataset.value ?? '').toLowerCase().replace('ü', 'u') === want.replace('ü', 'u')) b.click();
    });
  }
</script>

<style>
  .cal-actions { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; margin-top: 32px; }
</style>
