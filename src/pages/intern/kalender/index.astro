---
/**
 * Intern → Kalender: Presse, Vorstand und Admin tragen hier alles ein, was im Tanzkalender der Website steht.
 *  - Termine (Bühne, Training, Diskurs): Tabelle kalender_termine, die Website baut danach neu (docs/kalender.md).
 *  - KEEP UP: Trainingswochen und Workshops planen (Entwurf design/entwuerfe/2026-10-keep-up/), die Dozent:in
 *    beschreibt ihr Training selbst (Intern → Meine Trainings), man kann sie erinnern (docs/keep-up.md).
 * Pro Woche eine Zeile mit den Tagen und den Einträgen. Ein Klick auf einen Tag trägt dort einen Termin ein, ein Klick
 * auf einen Eintrag öffnet ihn. Termine, die noch als Datei vorliegen, stehen mit drin und lassen sich übernehmen.
 * Der Google Kalender des Vereins kann /termine.ics abonnieren (Hinweis unten auf der Seite).
 */
import Intern from '../../../layouts/Intern.astro';
import KeepUpDaten from '../../../components/intern/KeepUpDaten.astro';
---
<Intern title="Kalender" current="kalender">
  <KeepUpDaten kalender />
  <div class="ku-kopf">
    <div class="ku-kopf__titel">
      <span class="tag">Website · Tanzkalender</span>
      <h1 class="i-h1">Kalender</h1>
    </div>
    <div class="kal-neu" data-neu-box hidden>
      <button type="button" class="ku-ghost" data-neu-keepup>KEEP UP einplanen</button>
      <button type="button" class="btn btn--primary btn--marker" data-neu-termin>Termin eintragen</button>
    </div>
  </div>
  <p class="kal-lead">Alles, was hier steht, erscheint im Tanzkalender auf der Website und im Kalender-Abo. KEEP UP-Trainings beschreiben die Dozent:innen selbst.</p>

  <p class="i-msg" role="alert" data-msg hidden></p>

  <div class="ku-hinweis" data-erinnern-box hidden>
    <div class="ku-hinweis__text">
      <span class="ku-hinweis__sq" aria-hidden="true"></span>
      <span>
        <span class="ku-hinweis__titel" data-erinnern-titel></span>
        <span class="ku-hinweis__namen" data-erinnern-namen></span>
      </span>
    </div>
    <button type="button" class="btn btn--secondary btn--sm" data-erinnern-alle></button>
  </div>

  <div data-plan hidden>
    <div class="pl-leiste">
      <div class="pl-filter" role="group" aria-label="Einträge filtern" data-filter></div>
      <div class="pl-monat">
        <button type="button" class="pl-pfeil" aria-label="Vorheriger Monat" data-monat="-1">←</button>
        <span class="pl-monat__name" aria-live="polite" data-monat-name></span>
        <button type="button" class="pl-pfeil" aria-label="Nächster Monat" data-monat="1">→</button>
      </div>
    </div>
    <div class="pl-wochen" data-wochen></div>
    <div class="pl-legende" aria-hidden="true">
      <span><span class="pl-legende__mk pl-legende__mk--buehne"></span>Bühne</span>
      <span><span class="pl-legende__mk pl-legende__mk--diskurs"></span>Diskurs</span>
      <span><span class="pl-legende__mk pl-legende__mk--training"></span>Training / KEEP UP</span>
      <span><span class="pl-legende__mk pl-legende__mk--workshop"></span>KEEP UP-Workshop</span>
      <span><span class="pl-legende__mk pl-legende__mk--heute"></span>Heute</span>
      <span class="pl-legende__tipp">Tag anklicken zum Eintragen</span>
    </div>

    <details class="kal-abo">
      <summary>Im Google Kalender abonnieren</summary>
      <div class="kal-abo__inhalt">
        <p>Der Google Kalender des Vereins kann diesen Kalender abonnieren. Dann steht alles, was hier eingetragen ist, auch dort (ohne Entwürfe):</p>
        <ol>
          <li>In Google Kalender links bei „Weitere Kalender“ auf <strong>+</strong> klicken, dann <strong>Per URL</strong>.</li>
          <li>Diese Adresse einfügen und <strong>Kalender hinzufügen</strong>:</li>
        </ol>
        <div class="kal-abo__zeile">
          <label class="visually-hidden" for="kal-abo-url">Adresse des Kalender-Abos</label>
          <input id="kal-abo-url" readonly data-abo-url />
          <button type="button" class="ku-ghost ku-ghost--sm" data-abo-kopieren>Adresse kopieren</button>
        </div>
        <p class="i-hint">Google holt Abos selbst alle paar Stunden neu. Nur KEEP UP: dieselbe Adresse mit <code>profitraining.ics</code> statt <code>termine.ics</code>.</p>
      </div>
    </details>
  </div>

  <dialog class="pl-schublade" aria-labelledby="pl-titel" data-schublade>
    <form method="dialog" class="pl-schublade__form" data-form novalidate>
      <div class="pl-schublade__kopf">
        <div>
          <span class="tag" data-s-tag></span>
          <h2 id="pl-titel" class="pl-schublade__h" data-s-titel></h2>
        </div>
        <button type="button" class="pl-zu" aria-label="Schließen" data-zu>×</button>
      </div>
      <div class="pl-schublade__inhalt">
        <fieldset class="pl-feld" data-s-teil data-s-typ>
          <legend class="pl-feld__l">Was?</legend>
          <div class="pl-seg">
            <button type="button" data-typ="termin" aria-pressed="true">Termin</button>
            <button type="button" data-typ="keepup" aria-pressed="false">KEEP UP</button>
          </div>
        </fieldset>

        <!-- Termin -->
        <div class="kal-modus" data-modus="termin">
          <p class="kal-datei" data-t-datei hidden>
            Dieser Termin steht als Datei auf der Website. Mit <strong>Speichern</strong> übernimmst du ihn in den Kalender;
            danach gilt diese Fassung. <a data-t-datei-link>In Website-Inhalte ansehen →</a>
          </p>
          <div class="i-field" data-s-teil>
            <label for="t-titel">Titel</label>
            <input id="t-titel" maxlength="120" placeholder="z. B. Studio Round #10" data-t="titel" />
          </div>
          <div class="kal-drei" data-s-teil>
            <div class="i-field"><label for="t-datum">Datum</label><input id="t-datum" type="date" data-t="datum" /></div>
            <div class="i-field"><label for="t-von">Beginn</label><input id="t-von" type="time" data-t="von" /></div>
            <div class="i-field"><label for="t-bis">Ende <span class="kal-opt">optional</span></label><input id="t-bis" type="time" data-t="bis" /></div>
          </div>
          <fieldset class="pl-feld" data-s-teil>
            <legend class="pl-feld__l">Kategorie</legend>
            <div class="pl-seg pl-seg--drei" data-t-kategorie>
              <button type="button" data-kat="Bühne" aria-pressed="false">Bühne</button>
              <button type="button" data-kat="Training" aria-pressed="false">Training</button>
              <button type="button" data-kat="Diskurs" aria-pressed="false">Diskurs</button>
            </div>
          </fieldset>
          <div class="i-field" data-s-teil>
            <label for="t-ort">Ort</label>
            <input id="t-ort" maxlength="160" list="t-orte" data-t="ort" />
            <datalist id="t-orte" data-t-orte></datalist>
          </div>
          <div class="i-field" data-s-teil>
            <label for="t-kurz">Kurzbeschreibung <span class="kal-zahl" data-t-zahl></span></label>
            <textarea id="t-kurz" rows="3" maxlength="400" placeholder="Ein, zwei Sätze. Steht im Kalender und auf der Startseite." data-t="kurz"></textarea>
          </div>
          <div class="i-field" data-s-teil>
            <label for="t-link">Link zu Tickets oder Anmeldung <span class="kal-opt">optional</span></label>
            <input id="t-link" type="url" placeholder="https://" data-t="link" />
          </div>
          <details class="kal-mehr" data-s-teil data-t-mehr>
            <summary>Mehr Angaben <span class="kal-opt">optional</span></summary>
            <div class="kal-mehr__inhalt">
              <div class="i-field">
                <label for="t-text">Text für die Terminseite</label>
                <textarea id="t-text" rows="5" maxlength="8000" placeholder="Leerzeile = neuer Absatz. **fett**, [Link](https://…)" data-t="text"></textarea>
              </div>
              <div class="i-field">
                <label for="t-personen">Mitwirkende aus dem Netzwerk</label>
                <div class="kal-chips" data-t-personen></div>
                <input id="t-personen" list="t-personen-liste" placeholder="Name eintippen, Enter" data-t-person-neu />
                <datalist id="t-personen-liste" data-t-personen-liste></datalist>
                <span class="i-hint">Der Termin erscheint dann auch auf ihrem Profil.</span>
              </div>
              <div class="kal-zwei">
                <div class="i-field">
                  <label for="t-format">Gehört zum Format</label>
                  <select id="t-format" data-t="format"></select>
                </div>
                <div class="i-field">
                  <label for="t-zeit">Uhrzeit anders anzeigen</label>
                  <input id="t-zeit" maxlength="60" placeholder="z. B. Einlass 19:00" data-t="zeit_text" />
                </div>
              </div>
              <div class="kal-zwei" data-t-eintritt-box>
                <div class="i-field">
                  <label for="t-eintritt">Eintritt</label>
                  <input id="t-eintritt" maxlength="80" placeholder="z. B. Eintritt frei" data-t="eintritt" />
                </div>
                <div class="i-field">
                  <label for="t-eintritt-en">Eintritt auf Englisch</label>
                  <input id="t-eintritt-en" maxlength="80" placeholder="z. B. Free admission" data-t="eintritt_en" />
                </div>
              </div>
              <div class="i-field">
                <label for="t-titel-en">Titel auf Englisch</label>
                <input id="t-titel-en" maxlength="120" data-t="titel_en" />
              </div>
              <div class="i-field">
                <label for="t-kurz-en">Kurzbeschreibung auf Englisch</label>
                <textarea id="t-kurz-en" rows="2" maxlength="400" data-t="kurz_en"></textarea>
              </div>
            </div>
          </details>
          <label class="i-check" data-s-teil>
            <input type="checkbox" data-t-sichtbar />
            <span>Auf der Website zeigen <span class="i-hint">(sonst Entwurf, nur hier zu sehen)</span></span>
          </label>
        </div>

        <!-- KEEP UP -->
        <div class="kal-modus" data-modus="keepup">
          <fieldset class="pl-feld" data-s-teil>
            <legend class="pl-feld__l">Art</legend>
            <div class="pl-seg" data-s-art>
              <button type="button" data-art="training" aria-pressed="true">Profitraining</button>
              <button type="button" data-art="workshop" aria-pressed="false">Workshop</button>
            </div>
          </fieldset>
          <fieldset class="pl-feld" data-s-teil>
            <legend class="pl-feld__l">Dozent:in</legend>
            <div class="pl-personen" data-s-personen></div>
          </fieldset>
          <fieldset class="pl-feld" data-s-teil>
            <legend class="pl-feld__l">Woche</legend>
            <div class="pl-woche">
              <button type="button" class="pl-pfeil" aria-label="Woche zurück" data-s-woche="-7">←</button>
              <span class="pl-woche__name" aria-live="polite" data-s-woche-name></span>
              <button type="button" class="pl-pfeil" aria-label="Woche vor" data-s-woche="7">→</button>
            </div>
            <div class="pl-tage" data-s-tage></div>
            <p class="pl-konflikt" data-s-konflikt hidden></p>
          </fieldset>
          <div class="pl-zwei" data-s-teil>
            <div class="i-field">
              <label for="pl-zeit">Uhrzeit</label>
              <input id="pl-zeit" maxlength="40" data-s-zeit />
            </div>
            <div class="i-field">
              <label for="pl-ort">Ort</label>
              <input id="pl-ort" maxlength="120" data-s-ort />
            </div>
          </div>
          <div class="i-field" data-s-teil>
            <label for="pl-notiz">Notiz an die Dozent:in</label>
            <textarea id="pl-notiz" rows="3" maxlength="1000" placeholder="Nur intern sichtbar, z. B. Frist oder Raumhinweis" data-s-notiz></textarea>
          </div>
          <div class="pl-beschreibung" data-s-teil data-s-beschreibung hidden>
            <div class="pl-beschreibung__kopf"><span class="pl-feld__l">Beschreibung</span><span data-s-status></span></div>
            <p data-s-text></p>
            <div class="pl-beschreibung__aktionen">
              <button type="button" class="ku-linie" data-s-erinnern></button>
              <a class="ku-linie" data-s-oeffnen>Beschreibung öffnen →</a>
            </div>
          </div>
        </div>
        <p class="i-msg" role="alert" data-s-msg hidden></p>
      </div>
      <div class="pl-schublade__fuss">
        <button type="submit" class="btn btn--primary btn--marker" data-s-speichern>Eintragen</button>
        <button type="button" class="ku-ghost" data-zu>Abbrechen</button>
        <button type="button" class="ku-linie" data-s-kopie hidden>Kopie anlegen</button>
        <button type="button" class="pl-loeschen" data-s-loeschen hidden>Löschen</button>
      </div>
    </form>
  </dialog>
</Intern>

<script>
  import { initIntern, errorText, showMessage } from '../../../scripts/intern/session';
  import { gsap, EASE, motionOk } from '../../../scripts/gsap';
  import { h } from '../../../scripts/intern/news/dom';
  import { neuBauenLassen } from '../../../scripts/intern/redaktion/api';
  import {
    daten, ladeTermine, heute, monatName, tagKurz, tagLang, zeitraum, tageText, wocheText, istVorbei, tageBis, artText, initialen,
    badge, toast, DS, DOWL, FEHLT, tabelleFehlt, SPALTEN, wochentag, type KalenderDaten,
  } from '../../../scripts/intern/keep-up';
  import { STANDARD, STATUS, status, plusTage, montag, tagDatum, ersterTag, kalenderwoche, zeitNorm, type KeepUpTermin } from '../../../lib/keep-up-plan';
  import { KURZ_MAX, slugAus, uhr, type KalenderTermin, type Kategorie } from '../../../lib/kalender-intern';
  import { href } from '../../../lib/url';

  const ctx = await initIntern(true);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const msg = $('[data-msg]');
  const alle = daten();
  const { dozentinnen, ort: standardOrt } = alle;
  const kal: KalenderDaten = alle.kalender ?? { dateiTermine: [], formate: [], personen: [], orte: [], abo: '' };
  const person = new Map(dozentinnen.map((d) => [d.id, d]));
  const nameVon = (id: string) => person.get(id)?.name ?? id;
  const profilName = new Map(kal.personen.map((p) => [p.id, p.name]));
  const bewegung = motionOk();
  const h0 = heute();
  const FEHLT_KALENDER = 'Termine eintragen geht, sobald die Migration supabase/migrations/20261026000000_kalender.sql ausgeführt ist (docs/kalender.md).';
  const T_BASIS = 'id,slug,titel,titel_en,datum,von,bis,zeit_text,ort,kategorie,kurz,kurz_en,text,link,format,personen,news,sichtbar';
  /** Eintritt gibt es erst mit der Migration 20261028000000_kalender_eintritt.sql; vorher ohne diese Spalten */
  let eintrittDa = true;
  let T_SPALTEN = `${T_BASIS},eintritt,eintritt_en`;

  /** Termin aus der Tabelle oder aus einer Datei (nur lesen, übernehmen) */
  type Datei = KalenderDaten['dateiTermine'][number];
  type Eintrag = { typ: 'termin'; t: KalenderTermin | Datei; tag: string } | { typ: 'keepup'; k: KeepUpTermin; tag: string };
  let ku: KeepUpTermin[] = [];
  let kt: KalenderTermin[] = [];
  let kalenderDa = true;
  let keepupDa = true;
  type Filter = 'alle' | 'termine' | 'keepup' | 'offen' | 'entwurf';
  let filter: Filter = 'alle';
  let [jahr, monat] = h0.split('-').map(Number) as [number, number];
  monat -= 1;

  const istDatei = (t: KalenderTermin | Datei): t is Datei => 'datei' in t;
  /** Dateien, die noch nicht in den Kalender übernommen sind */
  const dateien = () => kal.dateiTermine.filter((d) => !kt.some((t) => t.slug === d.slug));
  const zeitText = (t: { von: string; bis: string | null; zeit_text: string }) => t.zeit_text || [uhr(t.von), uhr(t.bis)].filter(Boolean).join('–');

  // ---------- Übersicht ----------
  function passt(e: Eintrag): boolean {
    if (filter === 'alle') return true;
    if (filter === 'termine') return e.typ === 'termin';
    if (filter === 'keepup') return e.typ === 'keepup';
    if (filter === 'offen') return e.typ === 'keepup' && status(e.k) === 'offen';
    return e.typ === 'termin' ? !istDatei(e.t) && !e.t.sichtbar : status(e.k) === 'entwurf';
  }

  function eintraegeDerWoche(mo: string): Eintrag[] {
    const bis = plusTage(mo, 6);
    const termine: Eintrag[] = [...kt, ...dateien()].filter((t) => t.datum >= mo && t.datum <= bis).map((t) => ({ typ: 'termin', t, tag: `${t.datum} ${uhr(t.von)}` }));
    const keepup: Eintrag[] = ku.filter((k) => k.woche === mo).map((k) => ({ typ: 'keepup', k, tag: `${ersterTag(k)} ${k.zeit}` }));
    return [...termine, ...keepup].sort((a, b) => a.tag.localeCompare(b.tag));
  }

  function zeichnen(auftritt = false) {
    const erster = `${jahr}-${String(monat + 1).padStart(2, '0')}-01`;
    const letzter = new Date(Date.UTC(jahr, monat + 1, 0)).toISOString().slice(0, 10);
    $('[data-monat-name]').textContent = monatName(jahr, monat);
    const wochen: string[] = [];
    for (let mo = montag(erster); mo <= letzter; mo = plusTage(mo, 7)) wochen.push(mo);
    const imBild = wochen.flatMap(eintraegeDerWoche);

    const merk = filter;
    const anzahl = (f: Filter) => { filter = f; const n = imBild.filter(passt).length; filter = merk; return n; };
    $('[data-filter]').replaceChildren(
      ...([['alle', 'Alle'], ['termine', 'Termine'], ['keepup', 'KEEP UP'], ['offen', 'Ohne Beschreibung'], ['entwurf', 'Entwürfe']] as const).map(([id, label]) =>
        h('button', { type: 'button', class: 'pl-chip', 'aria-pressed': String(filter === id), onclick: () => { filter = id; zeichnen(); } }, label, h('span', { text: String(anzahl(id)) })),
      ),
    );

    $('[data-wochen]').replaceChildren(
      ...wochen.map((mo) => {
        const eintraege = eintraegeDerWoche(mo);
        const zellen = DS.map((ds, i) => {
          const tag = i + 1;
          const datum = plusTage(mo, i);
          const kh = ku.filter((k) => k.woche === mo && k.tage.includes(tag));
          const th = eintraege.filter((x): x is Extract<Eintrag, { typ: 'termin' }> => x.typ === 'termin' && x.t.datum === datum);
          const cls = ['pl-tag', kh.some((k) => k.art === 'training') && 'pl-tag--training', kh.some((k) => k.art === 'workshop') && 'pl-tag--workshop',
            datum === h0 && 'is-heute', datum < h0 && 'is-vorbei', Number(datum.slice(5, 7)) !== monat + 1 && 'is-fremd'].filter(Boolean).join(' ');
          const namen = [...th.map((x) => x.t.titel), ...kh.map((k) => `KEEP UP ${nameVon(k.dozent)}`)];
          return h('button', {
            type: 'button', class: cls,
            'aria-label': `${DOWL[i]}, ${tagLang(datum)}${namen.length ? `: ${namen.join(', ')}` : ''}. Termin eintragen`,
            onclick: () => neuerTermin(datum),
          },
          h('span', { class: 'pl-tag__dow', text: ds }),
          h('span', { class: 'pl-tag__unten' },
            h('span', { class: 'pl-tag__nr', text: String(Number(datum.slice(8))) }),
            th.length ? h('span', { class: 'pl-tag__marks', 'aria-hidden': 'true' }, ...th.slice(0, 3).map((x) => h('span', { class: `pl-mk pl-mk--${x.t.kategorie === 'Bühne' ? 'buehne' : x.t.kategorie.toLowerCase()}` }))) : null,
          ));
        });
        return h('div', { class: 'pl-woche-zeile', 'data-woche': mo },
          h('div', { class: 'pl-raster' },
            h('div', { class: 'pl-kw' }, h('span', { class: 'pl-kw__nr', text: `KW ${kalenderwoche(mo)}` }), h('span', { class: 'pl-kw__tage', text: `${tagKurz(mo)} – ${Number(plusTage(mo, 6).slice(8))}.` })),
            ...zellen,
          ),
          h('div', { class: 'pl-bloecke' }, ...(eintraege.length ? eintraege.map(zeile) : [h('button', { type: 'button', class: 'pl-leer', onclick: () => neuerTermin(mo) }, '+ Eintragen')])),
        );
      }),
    );
    erinnernBox();
    if (auftritt && bewegung) gsap.from('[data-wochen] > *', { y: 18, opacity: 0, duration: 0.6, ease: EASE, stagger: 0.03, clearProps: 'transform,opacity' });
  }

  /** Eine Zeile rechts: Termin (Datum, Titel, Kategorie, Zeit, Ort) oder KEEP UP (Dozent:in, Tage, Status) */
  function zeile(e: Eintrag) {
    const blass = passt(e) ? '' : ' is-blass';
    if (e.typ === 'termin') {
      const t = e.t;
      const st = istDatei(t) ? badge('Datei', 'outline') : t.sichtbar ? badge('Online', 'cyan') : badge('Entwurf', 'purple');
      return h('button', { type: 'button', class: `pl-block pl-block--termin${blass}`, 'data-termin': t.slug, onclick: () => terminOeffnen(t) },
        h('span', { class: `kal-datum kal-datum--${t.kategorie === 'Bühne' ? 'buehne' : t.kategorie.toLowerCase()}`, 'aria-hidden': 'true' },
          h('span', { text: DS[wochentag(t.datum)] }), h('strong', { text: String(Number(t.datum.slice(8))) })),
        h('span', { class: 'pl-block__text' },
          h('span', { class: 'pl-block__name', text: t.titel }),
          h('span', { class: 'pl-block__meta', text: [t.kategorie, zeitText(t), t.ort].filter(Boolean).join(' · ') }),
        ),
        st,
      );
    }
    const t = e.k;
    const st = status(t);
    const d = tageBis(t, h0);
    const bald = !istVorbei(t, h0) && d <= 14 && st !== 'online' && st !== 'geaendert';
    return h('button', { type: 'button', class: `pl-block${blass}`, onclick: () => keepupOeffnen(t) },
      avatar(t.dozent, t.art),
      h('span', { class: 'pl-block__text' },
        h('span', { class: 'pl-block__name', text: `KEEP UP · ${nameVon(t.dozent)}` }),
        h('span', { class: `pl-block__meta${bald ? ' is-bald' : ''}`, text: [artText(t), tageText(t), t.zeit, bald ? (d <= 0 ? 'läuft' : d === 1 ? 'morgen' : `in ${d} Tagen`) : ''].filter(Boolean).join(' · ') }),
      ),
      badge(STATUS[st].label, STATUS[st].badge),
    );
  }

  function avatar(id: string, art: KeepUpTermin['art']) {
    const p = person.get(id);
    const el = h('span', { class: `ku-avatar${art === 'workshop' ? ' ku-avatar--workshop' : ''}`, 'aria-hidden': 'true', text: initialen(nameVon(id)) });
    if (p?.foto && art === 'training') el.append(h('img', { src: p.foto, alt: '' }));
    return el;
  }

  // KEEP UP: Termine in den nächsten 3 Wochen ohne veröffentlichte Beschreibung
  function erinnernBox() {
    const grenze = plusTage(h0, 21);
    const faellig = ku.filter((t) => !istVorbei(t, h0) && ersterTag(t) <= grenze && !t.veroeffentlicht).sort((a, b) => ersterTag(a).localeCompare(ersterTag(b)));
    const box = $('[data-erinnern-box]');
    box.hidden = !faellig.length;
    if (!faellig.length) return;
    $('[data-erinnern-titel]').textContent = `KEEP UP: ${faellig.length} ${faellig.length === 1 ? 'Training' : 'Trainings'} bis ${tagLang(grenze)} ohne veröffentlichte Beschreibung`;
    $('[data-erinnern-namen]').textContent = faellig.map((t) => `${nameVon(t.dozent)} (${zeitraum(t)})`).join(' · ');
    const knopf = $<HTMLButtonElement>('[data-erinnern-alle]');
    knopf.textContent = faellig.every((t) => t.erinnert_am) ? 'Erneut erinnern' : 'Alle erinnern';
    knopf.onclick = () => erinnern(faellig);
  }

  /** Erinnern: Mail im eigenen Mailprogramm an alle Dozent:innen mit Konto (keepup_kontakte), Datum merken */
  async function erinnern(liste: KeepUpTermin[]) {
    if (!ctx) return;
    const { data: kontakte } = await ctx.sb.rpc('keepup_kontakte');
    const mails = new Map(((kontakte ?? []) as { dozent: string; email: string | null }[]).filter((k) => k.email).map((k) => [k.dozent, k.email!]));
    const an = [...new Set(liste.map((t) => mails.get(t.dozent)).filter((m): m is string => !!m))];
    const ohne = [...new Set(liste.filter((t) => !mails.has(t.dozent)).map((t) => nameVon(t.dozent)))];
    if (an.length) {
      const link = new URL(href('intern/keep-up/meine/'), location.origin).href;
      const zeilen = liste.map((t) => `– ${zeitraum(t)}: ${artText(t)} (${nameVon(t.dozent)})`).join('\n');
      const text = `Hallo,\n\nfür diese KEEP UP-Termine fehlt noch die Beschreibung für die Website:\n\n${zeilen}\n\nDu kannst sie im internen Bereich unter Meine Trainings schreiben und veröffentlichen:\n${link}\n\nDanke!`;
      location.href = `mailto:?bcc=${an.map(encodeURIComponent).join(',')}&subject=${encodeURIComponent('KEEP UP: Bitte beschreib dein Training')}&body=${encodeURIComponent(text)}`;
    }
    const ids = liste.filter((t) => mails.has(t.dozent)).map((t) => t.id);
    if (ids.length) {
      const { error } = await ctx.sb.from('keepup_termine').update({ erinnert_am: h0 }).in('id', ids);
      if (!error) ku.forEach((t) => ids.includes(t.id) && (t.erinnert_am = h0));
    }
    zeichnen();
    if (ohne.length) toast(`Ohne Konto, bitte direkt erinnern: ${ohne.join(', ')}.`);
    else toast(an.length === 1 ? 'Die Mail ist vorbereitet.' : `Die Mail an ${an.length} Dozent:innen ist vorbereitet.`);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-monat]').forEach((b) =>
    b.addEventListener('click', () => {
      monat += Number(b.dataset.monat);
      if (monat < 0) { monat = 11; jahr--; }
      if (monat > 11) { monat = 0; jahr++; }
      zeichnen(true);
    }),
  );
  const zumMonat = (datum: string) => {
    const m = `${jahr}-${String(monat + 1).padStart(2, '0')}`;
    if (!datum.startsWith(m)) [jahr, monat] = [Number(datum.slice(0, 4)), Number(datum.slice(5, 7)) - 1];
  };
  /** Website neu bauen lassen (ohne Redaktion-Einrichtung kommt die Änderung mit dem nächtlichen Update) */
  const neuBauen = async () => ((await neuBauenLassen(ctx!.sb)) ? 'Die Website zeigt das in wenigen Minuten.' : 'Die Website zeigt das nach dem nächsten Update.');

  // ---------- Schublade ----------
  interface KeepUpEntwurf { id: string | null; art: KeepUpTermin['art']; dozent: string | null; woche: string; tage: number[]; zeit: string; ort: string; notiz: string }
  type TerminEntwurf = Omit<KalenderTermin, 'id'> & { id: string | null; datei: boolean };
  const dlg = $<HTMLDialogElement>('[data-schublade]');
  const panel = dlg.querySelector<HTMLElement>('[data-form]')!;
  const sMsg = $('[data-s-msg]');
  let typ: 'termin' | 'keepup' = 'termin';
  let e: KeepUpEntwurf;
  let te: TerminEntwurf;
  let loeschenBestaetigt = false;
  const tf = <T extends HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement = HTMLInputElement>(k: string) => dlg.querySelector<T>(`[data-t="${k}"]`)!;

  // Vorschläge für Ort, Personen, Formate
  $('[data-t-orte]').replaceChildren(...kal.orte.map((o) => h('option', { value: o })));
  $('[data-t-personen-liste]').replaceChildren(...kal.personen.map((p) => h('option', { value: p.name })));
  tf<HTMLSelectElement>('format').replaceChildren(h('option', { value: '', text: 'Kein Format' }), ...kal.formate.map((f) => h('option', { value: f.id, text: f.titel })));

  function leererTermin(datum: string): TerminEntwurf {
    return { id: null, datei: false, slug: '', titel: '', titel_en: '', datum, von: '19:00', bis: null, zeit_text: '', ort: '', kategorie: 'Bühne', kurz: '', kurz_en: '', text: '', link: '', format: '', personen: [], news: '', eintritt: '', eintritt_en: '', sichtbar: true };
  }
  function neuerTermin(datum?: string) {
    // ohne Datum: heute, wenn der heutige Monat zu sehen ist, sonst der Erste des Monats
    const sichtbar = `${jahr}-${String(monat + 1).padStart(2, '0')}-01`;
    te = leererTermin(datum ?? (h0.startsWith(sichtbar.slice(0, 7)) ? h0 : sichtbar));
    typ = 'termin';
    e = neuKeepUp(montag(te.datum));
    oeffneSchublade(true);
  }
  function terminOeffnen(t: KalenderTermin | Datei) {
    te = istDatei(t) ? { ...t, id: null, datei: true, sichtbar: true } : { ...t, von: uhr(t.von), bis: t.bis ? uhr(t.bis) : null, datei: false };
    e = neuKeepUp(montag(te.datum));
    typ = 'termin';
    oeffneSchublade(false);
  }
  function neuKeepUp(mo: string, tag?: number): KeepUpEntwurf {
    const art = tag === 6 || tag === 7 ? 'workshop' : 'training';
    return { id: null, art, dozent: null, woche: mo, tage: tag ? [tag] : [...STANDARD[art].tage], zeit: STANDARD[art].zeit, ort: standardOrt, notiz: '' };
  }
  function neuesKeepUp() {
    const sichtbar = `${jahr}-${String(monat + 1).padStart(2, '0')}-01`;
    e = neuKeepUp(montag(h0.startsWith(sichtbar.slice(0, 7)) ? h0 : sichtbar));
    te = leererTermin(h0);
    typ = 'keepup';
    oeffneSchublade(true);
  }
  function keepupOeffnen(t: KeepUpTermin) {
    e = { id: t.id, art: t.art, dozent: t.dozent, woche: t.woche, tage: [...t.tage], zeit: t.zeit, ort: t.ort, notiz: t.notiz };
    te = leererTermin(ersterTag(t));
    typ = 'keepup';
    oeffneSchublade(false);
  }

  function felderFuellen() {
    for (const k of ['titel', 'datum', 'von', 'ort', 'kurz', 'link', 'text', 'format', 'zeit_text', 'titel_en', 'kurz_en', 'eintritt', 'eintritt_en'] as const) tf(k).value = String(te[k] ?? '');
    tf('bis').value = te.bis ?? '';
    $<HTMLInputElement>('[data-t-sichtbar]').checked = te.sichtbar;
    ($('[data-t-mehr]') as HTMLDetailsElement).open = !!(te.text || te.personen.length || te.format || te.zeit_text || te.titel_en || te.kurz_en || te.eintritt || te.eintritt_en);
    ($('[data-s-zeit]') as HTMLInputElement).value = e.zeit;
    ($('[data-s-ort]') as HTMLInputElement).value = e.ort;
    ($('[data-s-notiz]') as HTMLTextAreaElement).value = e.notiz;
  }

  function oeffneSchublade(neu: boolean) {
    loeschenBestaetigt = false;
    showMessage(sMsg, '');
    $('[data-s-typ]').hidden = !neu;
    felderFuellen();
    schublade();
    dlg.showModal();
    if (typ === 'termin' && neu) tf('titel').focus();
    if (bewegung) {
      gsap.fromTo(panel, { xPercent: 100 }, { xPercent: 0, duration: 0.6, ease: EASE });
      gsap.fromTo(dlg.querySelectorAll(`[data-modus="${typ}"] [data-s-teil], [data-s-typ]`), { x: 40, opacity: 0 }, { x: 0, opacity: 1, duration: 0.6, ease: EASE, stagger: 0.04, delay: 0.08, clearProps: 'transform,opacity' });
    }
  }
  function schliessen() {
    if (!dlg.open) return;
    if (!bewegung) return dlg.close();
    gsap.to(panel, { xPercent: 100, duration: 0.3, ease: 'power3.in', onComplete: () => { dlg.close(); gsap.set(panel, { clearProps: 'transform' }); } });
  }
  dlg.querySelectorAll('[data-zu]').forEach((b) => b.addEventListener('click', schliessen));
  dlg.addEventListener('cancel', (ev) => { ev.preventDefault(); schliessen(); });
  dlg.addEventListener('click', (ev) => { if (ev.target === dlg) schliessen(); });
  dlg.querySelectorAll<HTMLButtonElement>('[data-typ]').forEach((b) =>
    b.addEventListener('click', () => {
      typ = b.dataset.typ as typeof typ;
      if (typ === 'keepup' && e.woche !== montag(te.datum) && !e.id) e = neuKeepUp(montag(te.datum));
      felderFuellen();
      schublade();
    }),
  );

  function schublade() {
    dlg.querySelectorAll<HTMLButtonElement>('[data-typ]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.typ === typ)));
    dlg.querySelectorAll<HTMLElement>('[data-modus]').forEach((m) => (m.hidden = m.dataset.modus !== typ));
    const del = $('[data-s-loeschen]');
    del.textContent = loeschenBestaetigt ? 'Wirklich löschen?' : 'Löschen';
    del.classList.toggle('is-scharf', loeschenBestaetigt);
    if (typ === 'termin') return terminSchublade();
    keepupSchublade();
  }

  function terminSchublade() {
    $('[data-s-tag]').textContent = te.datei ? 'Termin aus Datei' : te.id ? 'Termin bearbeiten' : 'Kalender';
    $('[data-s-titel]').textContent = te.titel.trim() || 'Neuer Termin';
    $('[data-t-datei]').hidden = !te.datei;
    ($('[data-t-datei-link]') as HTMLAnchorElement).href = `${href('intern/redaktion/eintrag/')}?b=termine&id=${encodeURIComponent(te.slug)}`;
    dlg.querySelectorAll<HTMLButtonElement>('[data-kat]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kat === te.kategorie)));
    const n = te.kurz.length;
    const zahl = $('[data-t-zahl]');
    zahl.textContent = `${n} / ${KURZ_MAX}`;
    zahl.classList.toggle('is-zuviel', n > KURZ_MAX);
    $('[data-t-personen]').replaceChildren(
      ...te.personen.map((id) => h('span', { class: 'kal-chip' }, profilName.get(id) ?? id,
        h('button', { type: 'button', 'aria-label': `${profilName.get(id) ?? id} entfernen`, text: '×', onclick: () => { te.personen = te.personen.filter((x) => x !== id); schublade(); } }))),
    );
    $('[data-s-speichern]').textContent = te.datei ? 'In den Kalender übernehmen' : te.id ? 'Speichern' : 'Eintragen';
    ($('[data-s-speichern]') as HTMLButtonElement).disabled = false;
    $('[data-s-kopie]').hidden = !te.id;
    $('[data-s-loeschen]').hidden = !te.id;
  }

  // Eingaben im Termin übernehmen
  for (const k of ['titel', 'datum', 'von', 'bis', 'ort', 'kurz', 'link', 'text', 'format', 'zeit_text', 'titel_en', 'kurz_en', 'eintritt', 'eintritt_en'] as const) {
    tf(k).addEventListener('input', () => {
      const v = tf(k).value;
      if (k === 'bis') te.bis = v || null;
      else (te as unknown as Record<string, string>)[k] = v;
      if (k === 'titel' || k === 'kurz') terminSchublade();
    });
  }
  $<HTMLInputElement>('[data-t-sichtbar]').addEventListener('change', (ev) => (te.sichtbar = (ev.currentTarget as HTMLInputElement).checked));
  dlg.querySelectorAll<HTMLButtonElement>('[data-kat]').forEach((b) => b.addEventListener('click', () => { te.kategorie = b.dataset.kat as Kategorie; terminSchublade(); }));
  const personNeu = $<HTMLInputElement>('[data-t-person-neu]');
  const personUebernehmen = () => {
    const p = kal.personen.find((x) => x.name.toLowerCase() === personNeu.value.trim().toLowerCase());
    if (!p) return false;
    if (!te.personen.includes(p.id)) te.personen = [...te.personen, p.id];
    personNeu.value = '';
    terminSchublade();
    return true;
  };
  personNeu.addEventListener('change', personUebernehmen);
  personNeu.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Enter') return;
    ev.preventDefault();
    if (!personUebernehmen() && personNeu.value.trim()) showMessage(sMsg, `„${personNeu.value.trim()}“ hat kein Profil auf der Website. Bitte aus der Liste wählen.`);
  });

  /** Was fehlt? (deutsche Meldung) */
  function terminPruefen(): string {
    if (!te.titel.trim()) return 'Bitte einen Titel eintragen.';
    if (!/^\d{4}-\d{2}-\d{2}$/.test(te.datum)) return 'Bitte ein Datum wählen.';
    if (!/^\d{2}:\d{2}/.test(te.von)) return 'Bitte den Beginn eintragen.';
    if (te.bis && uhr(te.bis) <= uhr(te.von)) return 'Das Ende liegt vor dem Beginn.';
    if (!te.ort.trim()) return 'Bitte einen Ort eintragen.';
    if (!te.kurz.trim()) return 'Bitte eine Kurzbeschreibung schreiben (ein, zwei Sätze).';
    if (te.kurz.length > KURZ_MAX) return `Die Kurzbeschreibung ist zu lang (höchstens ${KURZ_MAX} Zeichen).`;
    if (te.link && !/^https?:\/\/\S+$/.test(te.link.trim())) return 'Der Link muss mit https:// beginnen.';
    return '';
  }
  /** Freie Adresse für einen neuen Termin */
  function freierSlug(datum: string, titel: string) {
    const belegt = new Set([...kt.map((t) => t.slug), ...kal.dateiTermine.map((t) => t.slug)]);
    const basis = slugAus(datum, titel);
    let s = basis;
    for (let i = 2; belegt.has(s); i++) s = `${basis}-${i}`;
    return s;
  }

  async function terminSpeichern() {
    if (!ctx) return;
    const f = terminPruefen();
    if (f) return showMessage(sMsg, f);
    const felder = {
      slug: te.datei ? te.slug : te.id ? te.slug : freierSlug(te.datum, te.titel),
      titel: te.titel.trim(), titel_en: te.titel_en.trim(), datum: te.datum, von: uhr(te.von), bis: te.bis ? uhr(te.bis) : null,
      zeit_text: te.zeit_text.trim(), ort: te.ort.trim(), kategorie: te.kategorie, kurz: te.kurz.trim(), kurz_en: te.kurz_en.trim(),
      text: te.text.trim(), link: te.link.trim(), format: te.format, personen: te.personen, news: te.news, sichtbar: te.sichtbar,
      ...(eintrittDa ? { eintritt: (te.eintritt ?? '').trim(), eintritt_en: (te.eintritt_en ?? '').trim() } : {}),
    };
    const knopf = $<HTMLButtonElement>('[data-s-speichern]');
    knopf.disabled = true;
    const neu = !te.id;
    const res = te.id
      ? await ctx.sb.from('kalender_termine').update(felder).eq('id', te.id).select(T_SPALTEN).single()
      : await ctx.sb.from('kalender_termine').insert(felder).select(T_SPALTEN).single();
    knopf.disabled = false;
    if (res.error) return showMessage(sMsg, tabelleFehlt(res.error) || /kalender_termine/.test(res.error.message) ? FEHLT_KALENDER : errorText(res.error));
    const t = res.data as unknown as KalenderTermin;
    kt = kt.filter((x) => x.id !== t.id).concat(t);
    zumMonat(t.datum);
    schliessen();
    zeichnen();
    const hinweis = t.sichtbar ? await neuBauen() : 'Als Entwurf nur hier zu sehen.';
    toast(`${neu ? 'Eingetragen.' : 'Gespeichert.'} ${hinweis}`);
  }

  async function terminLoeschen() {
    if (!ctx || !te.id) return;
    const weg = kt.find((x) => x.id === te.id)!;
    const { error } = await ctx.sb.from('kalender_termine').delete().eq('id', te.id);
    if (error) return showMessage(sMsg, errorText(error));
    kt = kt.filter((x) => x.id !== weg.id);
    schliessen();
    zeichnen();
    const hinweis = weg.sichtbar ? await neuBauen() : '';
    toast(`Termin gelöscht. ${hinweis}`.trim(), {
      text: 'Rückgängig',
      klick: async () => {
        const { id: _id, ...zeile } = weg;
        const { data, error: f2 } = await ctx.sb.from('kalender_termine').insert(zeile).select(T_SPALTEN).single();
        if (f2) return toast(errorText(f2));
        kt.push(data as unknown as KalenderTermin);
        zeichnen();
        if (weg.sichtbar) void neuBauen();
      },
    });
  }

  // Kopie anlegen: gleicher Termin eine Woche später (z. B. für wiederkehrende Termine)
  $('[data-s-kopie]').addEventListener('click', () => {
    te = { ...te, id: null, datei: false, slug: '', datum: plusTage(te.datum, 7) };
    loeschenBestaetigt = false;
    felderFuellen();
    schublade();
    showMessage(sMsg, 'Kopie eine Woche später. Datum anpassen und eintragen.', 'ok');
    tf('datum').focus();
  });

  function keepupSchublade() {
    const t = e.id ? ku.find((x) => x.id === e.id) : undefined;
    $('[data-s-tag]').textContent = e.id ? 'KEEP UP bearbeiten' : 'KEEP UP einplanen';
    $('[data-s-titel]').textContent = e.dozent ? nameVon(e.dozent) : 'Wer unterrichtet?';
    dlg.querySelectorAll<HTMLButtonElement>('[data-art]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.art === e.art)));
    $('[data-s-personen]').replaceChildren(
      ...dozentinnen.map((d) =>
        h('button', { type: 'button', class: 'pl-person', 'aria-pressed': String(e.dozent === d.id), onclick: () => { e.dozent = d.id; schublade(); } },
          avatar(d.id, 'training'),
          h('span', { class: 'pl-person__text' }, h('span', { class: 'pl-person__name', text: d.name }), h('span', { class: 'pl-person__stil', text: d.stil })),
        ),
      ),
    );
    $('[data-s-woche-name]').textContent = wocheText(e.woche);
    $('[data-s-tage]').replaceChildren(
      ...DS.map((ds, i) => {
        const tag = i + 1;
        const an = e.tage.includes(tag);
        return h('button', {
          type: 'button', class: `pl-tagwahl${an ? ` is-an is-${e.art}` : ''}`, 'aria-pressed': String(an), 'aria-label': `${DOWL[i]}, ${tagLang(tagDatum(e.woche, tag))}`,
          onclick: () => { e.tage = an ? e.tage.filter((x) => x !== tag) : [...e.tage, tag].sort(); schublade(); },
        }, h('span', { class: 'pl-tag__dow', text: ds }), h('span', { class: 'pl-tag__nr', text: String(Number(tagDatum(e.woche, tag).slice(8))) }));
      }),
    );
    const konflikt = ku
      .filter((x) => x.id !== e.id && x.woche === e.woche && x.art === e.art)
      .map((x) => ({ x, tage: x.tage.filter((d) => e.tage.includes(d)) }))
      .filter((k) => k.tage.length);
    const k = $('[data-s-konflikt]');
    k.hidden = !konflikt.length;
    k.textContent = konflikt.map((c) => `Überschneidung: ${nameVon(c.x.dozent)} ist am ${c.tage.map((d) => DS[d - 1]).join(', ')} schon eingeplant.`).join(' ');

    const b = $('[data-s-beschreibung]');
    b.hidden = !t;
    if (t) {
      const st = status(t);
      $('[data-s-status]').replaceChildren(badge(STATUS[st].label, STATUS[st].badge));
      $('[data-s-text]').textContent = st === 'offen'
        ? `Noch nichts geschrieben.${t.erinnert_am ? ` Erinnert am ${tagLang(t.erinnert_am)}.` : ''}`
        : `${t.titel || 'Ohne Titel'}${t.erinnert_am && !t.veroeffentlicht ? ` · erinnert am ${tagLang(t.erinnert_am)}` : ''}`;
      const er = $<HTMLButtonElement>('[data-s-erinnern]');
      er.textContent = t.erinnert_am ? 'Erneut erinnern' : 'Erinnerung senden';
      er.hidden = !!t.veroeffentlicht;
      er.onclick = () => erinnern([t]);
      ($('[data-s-oeffnen]') as HTMLAnchorElement).href = `${href('intern/keep-up/beschreiben/')}?id=${t.id}&von=plan`;
    }
    $('[data-s-speichern]').textContent = e.id ? 'Speichern' : 'Einplanen';
    ($('[data-s-speichern]') as HTMLButtonElement).disabled = !e.dozent || !e.tage.length;
    $('[data-s-kopie]').hidden = true;
    $('[data-s-loeschen]').hidden = !e.id;
  }

  dlg.querySelectorAll<HTMLButtonElement>('[data-art]').forEach((b) =>
    b.addEventListener('click', () => {
      const art = b.dataset.art as KeepUpTermin['art'];
      if (art === e.art) return;
      e.art = art;
      e.tage = [...STANDARD[art].tage];
      e.zeit = STANDARD[art].zeit;
      ($('[data-s-zeit]') as HTMLInputElement).value = e.zeit;
      schublade();
    }),
  );
  dlg.querySelectorAll<HTMLButtonElement>('[data-s-woche]').forEach((b) =>
    b.addEventListener('click', () => { e.woche = plusTage(e.woche, Number(b.dataset.sWoche)); schublade(); }),
  );

  async function keepupSpeichern() {
    if (!ctx || !e.dozent || !e.tage.length) return;
    if (!keepupDa) return showMessage(sMsg, FEHLT);
    const felder = {
      art: e.art, dozent: e.dozent, woche: e.woche, tage: [...e.tage].sort(),
      zeit: zeitNorm(($('[data-s-zeit]') as HTMLInputElement).value) || STANDARD[e.art].zeit,
      ort: ($('[data-s-ort]') as HTMLInputElement).value.trim(),
      notiz: ($('[data-s-notiz]') as HTMLTextAreaElement).value.trim(),
    };
    const knopf = $<HTMLButtonElement>('[data-s-speichern]');
    knopf.disabled = true;
    const neu = !e.id;
    const res = e.id
      ? await ctx.sb.from('keepup_termine').update(felder).eq('id', e.id).select(SPALTEN).single()
      : await ctx.sb.from('keepup_termine').insert(felder).select(SPALTEN).single();
    knopf.disabled = false;
    if (res.error) return showMessage(sMsg, tabelleFehlt(res.error) ? FEHLT : errorText(res.error));
    const t = res.data as KeepUpTermin;
    ku = ku.filter((x) => x.id !== t.id).concat(t);
    if (!plusTage(e.woche, 6).startsWith(`${jahr}-${String(monat + 1).padStart(2, '0')}`)) zumMonat(e.woche);
    schliessen();
    zeichnen();
    const hinweis = await neuBauen();
    toast(neu ? `Eingeplant. ${nameVon(t.dozent)} sieht den Termin jetzt und kann ihn beschreiben.` : `Änderungen gespeichert. ${hinweis}`);
  }

  async function keepupLoeschen() {
    if (!ctx || !e.id) return;
    const weg = ku.find((x) => x.id === e.id)!;
    const { error } = await ctx.sb.from('keepup_termine').delete().eq('id', e.id);
    if (error) return showMessage(sMsg, errorText(error));
    ku = ku.filter((x) => x.id !== weg.id);
    schliessen();
    zeichnen();
    void neuBauen();
    toast('Termin gelöscht.', {
      text: 'Rückgängig',
      klick: async () => {
        const { veroeffentlicht_am: _a, ...zeile } = weg;
        const { data, error: f } = await ctx.sb.from('keepup_termine').insert({ ...zeile, veroeffentlicht: weg.veroeffentlicht ? {} : null }).select(SPALTEN).single();
        if (f) return toast(errorText(f));
        ku.push(data as KeepUpTermin);
        zeichnen();
        void neuBauen();
      },
    });
  }

  $('[data-form]').addEventListener('submit', (ev) => {
    ev.preventDefault();
    showMessage(sMsg, '');
    void (typ === 'termin' ? terminSpeichern() : keepupSpeichern());
  });
  $('[data-s-loeschen]').addEventListener('click', () => {
    if (!loeschenBestaetigt) {
      loeschenBestaetigt = true;
      return schublade();
    }
    void (typ === 'termin' ? terminLoeschen() : keepupLoeschen());
  });
  $('[data-neu-termin]').addEventListener('click', () => neuerTermin());
  $('[data-neu-keepup]').addEventListener('click', neuesKeepUp);

  // Abo-Adresse
  const abo = $<HTMLInputElement>('[data-abo-url]');
  abo.value = kal.abo;
  $('[data-abo-kopieren]').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(kal.abo);
      toast('Adresse kopiert.');
    } catch {
      abo.select();
    }
  });

  // ---------- Laden (am Ende, damit alle Funktionen oben schon stehen) ----------
  if (ctx && !ctx.isRedaktion) {
    showMessage(msg, 'Den Kalender pflegen Presse, Vorstand und Admin. Deine eigenen KEEP UP-Trainings findest du unter „Meine Trainings“.');
  } else if (ctx) {
    const termineLaden = async (): Promise<KalenderTermin[]> => {
      let { data, error } = await ctx.sb.from('kalender_termine').select(T_SPALTEN).order('datum');
      // Spalte fehlt (42703): Migration für den Eintritt noch nicht eingespielt – ohne sie weiter
      if (error?.code === '42703' && /eintritt/.test(error.message)) {
        eintrittDa = false;
        T_SPALTEN = T_BASIS;
        $('[data-t-eintritt-box]').hidden = true;
        ({ data, error } = await ctx.sb.from('kalender_termine').select(T_SPALTEN).order('datum'));
      }
      if (error) throw error;
      return (data ?? []) as unknown as KalenderTermin[];
    };
    const [a, b] = await Promise.allSettled([termineLaden(), ladeTermine(ctx.sb)]);
    if (a.status === 'fulfilled') kt = a.value;
    else kalenderDa = false;
    if (b.status === 'fulfilled') ku = b.value;
    else keepupDa = false;
    const fehlt = [!kalenderDa && FEHLT_KALENDER, !keepupDa && FEHLT].filter(Boolean).join(' ');
    if (fehlt) showMessage(msg, fehlt);
    $('[data-plan]').hidden = false;
    $('[data-neu-box]').hidden = false;
    $<HTMLButtonElement>('[data-neu-termin]').disabled = !kalenderDa;
    $<HTMLButtonElement>('[data-neu-keepup]').disabled = !keepupDa;
    zeichnen(true);
  }
</script>

