---
/**
 * Interner Bereich: Anmelden und danach „Mein Status“ (Entwurf Mitgliedsstatus, design/entwuerfe/2026-10-intern):
 * Mitgliedsausweis zum Umdrehen (Rückseite mit QR-Code zur Prüfseite), Angaben zur Mitgliedschaft,
 * Hinweis bei offenem Beitrag, Ausweis als PDF und – wenn eingerichtet – in Google Wallet.
 * Daten: Tabelle mitgliedschaften (supabase/migrations/20261022000000_mitgliedschaft.sql), gepflegt vom Vorstand.
 */
import { Image } from 'astro:assets';
import Intern from '../../layouts/Intern.astro';
import Logo from '../../components/ui/Logo.astro';
import ProtectedEmail from '../../components/ProtectedEmail.astro';
import { href } from '../../lib/url';
import { getVerein } from '../../lib/settings';
import { supabase } from '../../settings/supabase';
import buehne from '../../assets/photos/duo-silhouette-stage.jpg';

const v = getVerein('de');
const wallet = supabase.wallet;
const domain = new URL(Astro.site ?? 'https://tanznetzdresden.de').hostname.replace(/^www\./, '');
---
<Intern title="Mein Status" current="status" loginPage>
  <!-- Anmelden -->
  <div class="login" data-when="login">
    <div class="i-card">
      <h1 class="i-h1">Anmelden</h1>
      <p class="i-lead">Für Mitglieder:innen von TanzNetzDresden. Zugänge vergibt der Vorstand per Einladung.</p>

      <form class="i-form" data-login-form>
        <div class="i-field">
          <label for="login-email">E-Mail</label>
          <input id="login-email" name="email" type="email" autocomplete="username" required />
        </div>
        <div class="i-field" data-password-field>
          <label for="login-password">Passwort</label>
          <input id="login-password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <p class="i-msg" role="alert" data-login-msg hidden></p>
        <div class="login__actions">
          <button type="submit" class="btn btn--primary btn--marker" data-login-submit>Anmelden</button>
          <button type="button" class="i-linkbtn" data-mode-toggle>Stattdessen Login-Link per E-Mail</button>
          <button type="button" class="i-linkbtn" data-reset>Passwort vergessen?</button>
        </div>
      </form>
    </div>
    <aside class="login__aside">
      <h2>Noch kein Zugang?</h2>
      <p>Mitglieder:innen bekommen eine Einladung per E-Mail. Du bist Mitglied, hast aber keine bekommen? Melde dich beim Vorstand.</p>
      <a class="mono-link" href={href('kontakt/#vorstand')}>Vorstand kontaktieren →</a>
    </aside>
  </div>

  <!-- Mein Status -->
  <div class="ms" data-when="ready" data-ms data-status="leer">
    <p class="hinweis" data-freigaben hidden></p>

    <header class="ms-kopf">
      <span class="tag" data-ms-tag>Mitgliedschaft</span>
      <h1 class="i-h1">Mein Status</h1>
      <p class="ms-lead"><span data-ms-hallo></span> <span data-ms-lead></span></p>
    </header>

    <div class="ms-grid">
      <section class="ms-links" aria-label="Mitgliedsausweis">
        <div class="ausweis" data-blende-karte>
          <button type="button" class="ausweis__knopf" aria-label="Ausweis umdrehen" data-ausweis-dreh>
            <span class="ausweis__innen" data-ausweis>
              <span class="ausweis__seite ausweis__vorne" data-ausweis-vorne>
                <span class="av__logo"><Logo part="mark" /></span>
                <span class="av__titel"><span class="av__sq"></span>Mitgliedsausweis <span data-ms-jahr></span></span>
                <span class="av__foto"><img alt="" hidden data-ms-foto /><span class="av__ini" data-ms-initialen></span></span>
                <span class="av__wer">
                  <span class="av__name"><span data-ms-vorname></span><br /><span class="av__nach" data-ms-nachname></span></span>
                  <span class="av__art" data-ms-art-seit></span>
                </span>
                <span class="av__leiste"><span data-ms-nr></span><span data-ms-gueltig-kurz></span></span>
              </span>
              <span class="ausweis__seite ausweis__hinten" data-ausweis-hinten>
                <span class="ah__kopf"><span class="av__sq"></span>{v.legalName} · Mitgliedsausweis</span>
                <span class="ah__qr" data-ms-qr></span>
                <span class="ah__text">
                  <span class="ah__satz"><span data-ms-name></span> ist Mitglied im {v.legalName}</span>
                  <span class="ah__hilfe">Zum Prüfen den Code scannen. Er zeigt den aktuellen Status der Mitgliedschaft.</span>
                  <span class="ah__adresse">{v.address.street} · {v.address.zip} {v.address.city}<br />{domain}</span>
                </span>
                <span class="ah__linie"></span>
              </span>
              <span class="ausweis__stempel" data-ms-stempel hidden></span>
            </span>
          </button>
        </div>
        <div class="ms-seiten">
          <div class="ms-seg" role="group" aria-label="Seite des Ausweises">
            <button type="button" aria-pressed="true" data-seite="vorne">Vorderseite</button>
            <button type="button" aria-pressed="false" data-seite="hinten">Rückseite</button>
          </div>
          <span class="ms-klein" data-ms-erstellt></span>
        </div>
      </section>

      <section class="ms-rechts">
        <div class="ms-karte">
          <div class="ms-karte__kopf">
            <h2 class="ms-h2">Mitgliedschaft</h2>
            <span class="badge" data-ms-badge></span>
          </div>
          <dl class="ms-daten" data-ms-daten></dl>
        </div>

        <div class="ms-cta" data-ms-cta hidden>
          <p data-ms-cta-text></p>
          <span data-ms-cta-mail="offen" hidden><ProtectedEmail email={v.emails.kontakt} label="Zahlungsinfos anfragen" subject="Mitgliedsbeitrag" button class="ms-cta__mail" /></span>
          <span data-ms-cta-mail="abgelaufen" hidden><ProtectedEmail email={v.emails.vorstand} label="Mitgliedschaft verlängern" subject="Mitgliedschaft verlängern" button class="ms-cta__mail" /></span>
        </div>

        <div class="ms-handy">
          <span class="tag">Auf dem Handy</span>
          <p class="ms-text" data-ms-handy-text></p>
          <div class="ms-knoepfe" data-ms-handy-start>
            {wallet && (
              <button type="button" class="ms-wallet" data-ms-wallet>
                <span class="ms-wallet__icon" aria-hidden="true"></span><span data-ms-wallet-label>Zu Google Wallet hinzufügen</span>
              </button>
            )}
            <button type="button" class="ms-pdf" data-ms-pdf>Als PDF speichern</button>
          </div>
          {wallet && (
            <div class="ms-gespeichert" data-ms-gespeichert hidden>
              <div class="ms-gespeichert__kopf">
                <span class="badge badge--cyan">In Google Wallet hinzugefügt</span>
                <span class="ms-klein" data-ms-wallet-wann></span>
              </div>
              <p class="ms-text">Nach deiner nächsten Beitragszahlung holst du dir hier den Ausweis für das neue Jahr.</p>
              <div class="ms-links-zeile">
                <a class="mono-link" href="https://wallet.google.com" target="_blank" rel="noopener">In Google Wallet öffnen →</a>
                <button type="button" class="ms-textknopf" data-ms-pdf>Als PDF speichern</button>
                <button type="button" class="ms-textknopf ms-textknopf--leise" data-ms-wallet-zurueck>Zurücksetzen</button>
              </div>
            </div>
          )}
          <p class="ms-fuss">
            Name oder Foto falsch? <a href={href('intern/profil/')}>Profil bearbeiten</a> oder
            <ProtectedEmail email={v.emails.vorstand} label="Mitgliederverwaltung schreiben" subject="Mitgliedsausweis" />.
          </p>
        </div>
      </section>
    </div>

    {wallet && (
      <section class="ms-vorschau" data-ms-vorschau hidden>
        <div class="ms-vorschau__text">
          <span class="tag">Vorschau · Google Wallet</span>
          <h2 class="ms-vorschau__h">So erscheint dein Ausweis<br /><span>auf dem Handy.</span></h2>
          <p class="ms-text">Der Ausweis liegt offline in deiner Wallet. Vorzeigen, scannen lassen, fertig.</p>
        </div>
        <div class="wp" data-ms-wp>
          <div class="wp__kopf"><span class="wp__logo"><Logo part="mark" /></span><span>{v.legalName}</span></div>
          <div class="wp__wer">
            <span class="wp__k">Mitgliedsausweis <span data-ms-jahr></span></span>
            <span class="wp__name" data-ms-name></span>
          </div>
          <div class="wp__daten">
            <div><span>Mitgliedsnummer</span><strong data-ms-nr-roh></strong></div>
            <div><span>Gültig bis</span><strong data-ms-gueltig-roh></strong></div>
          </div>
          <div class="wp__qr"><span data-ms-qr></span></div>
          <div class="wp__bild">
            <Image src={buehne} alt="" widths={[340, 680]} sizes="340px" />
            <span class="wp__keil"></span>
          </div>
        </div>
      </section>
    )}
  </div>

  <div class="ms-toast" role="status" data-ms-toast hidden><span class="ms-toast__sq" aria-hidden="true"></span><span data-ms-toast-text></span></div>
</Intern>

<script>
  import QRCode from 'qrcode';
  import { getSupabase } from '../../lib/supabase';
  import { initIntern, errorText, showMessage, internUrl, type InternContext } from '../../scripts/intern/session';
  import { freigabenHinweis } from '../../scripts/intern/freigaben';
  import { photoUrl } from '../../lib/supabase';
  import { status, gueltigBis, ausweisJahr, kurz, lang, monat, pruefUrl, BEITRAG_FAELLIG, type Mitgliedschaft, type Status } from '../../lib/mitgliedschaft';

  const ctx = await initIntern(false);
  const next = new URLSearchParams(location.search).get('weiter');
  if (ctx && next?.startsWith('/')) location.replace(next);
  if (ctx?.isRedaktion) void freigabenHinweis(ctx.sb, document.querySelector('[data-freigaben]'));
  if (ctx) void meinStatus(ctx);

  // ---------- Mein Status ----------
  async function meinStatus(ctx: InternContext) {
    const root = document.querySelector<HTMLElement>('[data-ms]')!;
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s);
    const alle = (s: string, f: (el: HTMLElement) => void) => root.querySelectorAll<HTMLElement>(s).forEach(f);
    const text = (s: string, t: string) => alle(s, (el) => (el.textContent = t));

    // fehlt die Tabelle (Migration nicht eingespielt) oder die Zeile, zeigt die Seite „In Vorbereitung“
    const { data } = await ctx.sb.from('mitgliedschaften').select('*').eq('person', ctx.user.id).maybeSingle<Mitgliedschaft>();
    const m = data ?? null;
    const st: Status | 'leer' = m ? status(m) : 'leer';
    const jahr = m ? ausweisJahr(m) : new Date().getFullYear();
    const bis = m ? gueltigBis(m) : null;
    const name = ctx.profile?.display_name || ctx.user.email || '';
    const [vorname, ...rest] = name.split(/\s+/);
    root.dataset.status = st;

    text('[data-ms-tag]', `Mitgliedschaft · ${jahr}`);
    text('[data-ms-jahr]', String(jahr));
    text('[data-ms-hallo]', `Hallo ${vorname}.`);
    const faellig = `${jahr}-${BEITRAG_FAELLIG}`;
    const heute = new Date().toISOString().slice(0, 10);
    text('[data-ms-lead]', {
      aktiv: `Deine Mitgliedschaft ist aktiv bis ${bis ? lang(bis) : `Ende ${jahr}`}.`,
      offen: `Dein Beitrag für ${jahr} ist noch offen. Sobald er da ist, schalten wir deinen Ausweis frei.`,
      abgelaufen: `Deine Mitgliedschaft ist am ${bis ? lang(bis) : '–'} ausgelaufen.`,
      leer: 'Deine Mitgliedsdaten trägt der Vorstand noch ein. Danach erscheint hier dein Ausweis.',
    }[st]);

    // Ausweis
    text('[data-ms-name]', name);
    text('[data-ms-vorname]', vorname ?? '');
    text('[data-ms-nachname]', rest.join(' '));
    text('[data-ms-art-seit]', [m?.art ?? 'Mitglied', m?.seit ? `seit ${m.seit.slice(0, 4)}` : ''].filter(Boolean).join(' · '));
    text('[data-ms-nr]', m?.nummer ? `Nr. ${m.nummer}` : 'Nr. folgt');
    text('[data-ms-nr-roh]', m?.nummer ?? '–');
    text('[data-ms-gueltig-kurz]', bis ? `Gültig bis ${kurz(bis)}` : '');
    text('[data-ms-gueltig-roh]', bis ? kurz(bis) : '–');
    const foto = q<HTMLImageElement>('[data-ms-foto]');
    const url = photoUrl(ctx.profile?.photo_path ?? null);
    if (foto && url) {
      foto.src = url;
      foto.alt = `Porträt ${name}`;
      foto.hidden = false;
    }
    text('[data-ms-initialen]', name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase()).join(''));
    const stempel = q('[data-ms-stempel]')!;
    stempel.textContent = { aktiv: '', offen: 'Beitrag offen', abgelaufen: 'Abgelaufen', leer: 'In Vorbereitung' }[st];
    stempel.hidden = st === 'aktiv';
    const erstellt = m?.bezahlt_am ?? m?.updated_at;
    text('[data-ms-erstellt]', erstellt ? `Erstellt am ${lang(erstellt)}` : '');

    if (m) {
      const lila = getComputedStyle(document.documentElement).getPropertyValue('--purple').trim() || '#2e1a4d';
      const svg = await QRCode.toString(pruefUrl(m.pruefcode), { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: lila, light: '#ffffff' } });
      alle('[data-ms-qr]', (el) => (el.innerHTML = svg));
    }

    // Angaben
    const badge = q('[data-ms-badge]')!;
    const [bText, bArt] = { aktiv: ['Aktiv', 'cyan'], offen: ['Beitrag offen', 'magenta'], abgelaufen: ['Abgelaufen', 'purple'], leer: ['In Vorbereitung', 'purple'] }[st];
    badge.textContent = bText;
    badge.className = `badge${bArt === 'magenta' ? '' : ` badge--${bArt}`}`;
    const beitrag =
      st === 'aktiv' ? (m?.bezahlt_am ? `Bezahlt am ${lang(m.bezahlt_am)}` : 'Bezahlt')
      : st === 'offen' ? (heute > faellig ? `Offen · fällig seit ${lang(faellig)}` : `Offen · fällig bis ${lang(faellig)}`)
      : st === 'abgelaufen' ? (m?.bezahlt_bis ? `Zuletzt bezahlt für ${m.bezahlt_bis}` : 'Nicht bezahlt')
      : '–';
    const zeilen: [string, string, boolean?][] = [
      ['Mitgliedsnummer', m?.nummer ?? 'wird vergeben'],
      ['Art', m?.art ?? '–'],
      ['Mitglied seit', m?.seit ? monat(m.seit) : '–'],
      [st === 'abgelaufen' ? 'Beitrag' : `Beitrag ${jahr}`, beitrag, st === 'offen' || st === 'abgelaufen'],
      ['Gültig bis', bis ? kurz(bis) : '–', st === 'offen' || st === 'abgelaufen'],
    ];
    q('[data-ms-daten]')!.replaceChildren(
      ...zeilen.map(([k, w, rot]) => {
        const div = document.createElement('div');
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = k;
        dd.textContent = w;
        if (rot) dd.className = 'is-offen';
        div.append(dt, dd);
        return div;
      }),
    );

    // Hinweis mit E-Mail (Betreff mit Mitgliedsnummer)
    const cta = q('[data-ms-cta]')!;
    if (st === 'offen' || st === 'abgelaufen') {
      text('[data-ms-cta-text]', st === 'offen' ? 'Der Ausweis gilt erst mit bezahltem Jahresbeitrag.' : 'Verlängere deine Mitgliedschaft und wir erstellen dir einen neuen Ausweis.');
      alle('[data-ms-cta-mail]', (el) => {
        el.hidden = el.dataset.msCtaMail !== st;
        const pe = el.querySelector<HTMLElement>('[data-protected-email]');
        if (pe && m?.nummer) pe.dataset.subject = `${pe.dataset.subject} ${m.nummer}`;
      });
      cta.hidden = false;
    }

    // Auf dem Handy
    const ok = st === 'aktiv';
    const wallet = q<HTMLButtonElement>('[data-ms-wallet]');
    text('[data-ms-handy-text]', {
      aktiv: wallet
        ? 'Speichere deinen Ausweis in Google Wallet. Dann hast du ihn beim Training oder an der Abendkasse immer dabei.'
        : 'Speichere deinen Ausweis als PDF oder druck ihn aus. Dann hast du ihn beim Training oder an der Abendkasse immer dabei.',
      offen: `Verfügbar, sobald dein Beitrag für ${jahr} eingegangen ist.`,
      abgelaufen: 'Verlängere deine Mitgliedschaft, um einen neuen Ausweis zu erhalten.',
      leer: 'Verfügbar, sobald der Vorstand deine Mitgliedsdaten eingetragen hat.',
    }[st]);
    alle('[data-ms-pdf]', (el) => ((el as HTMLButtonElement).disabled = !ok));
    if (wallet) wallet.disabled = !ok;
    const vorschau = q('[data-ms-vorschau]');
    if (vorschau) vorschau.hidden = !m;

    // Umdrehen
    const innen = q('[data-ausweis]')!;
    const seiten = [...root.querySelectorAll<HTMLButtonElement>('[data-seite]')];
    const drehen = (hinten: boolean) => {
      innen.toggleAttribute('data-hinten', hinten);
      seiten.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.seite === 'hinten') === hinten)));
    };
    q('[data-ausweis-dreh]')!.addEventListener('click', () => drehen(!innen.hasAttribute('data-hinten')));
    seiten.forEach((b) => b.addEventListener('click', () => drehen(b.dataset.seite === 'hinten')));

    // PDF: beide Seiten in Kartengröße drucken („Als PDF speichern“ im Druckdialog)
    const druck = document.createElement('div');
    druck.className = 'ms-druck';
    druck.dataset.druck = '';
    druck.setAttribute('aria-hidden', 'true');
    document.body.append(druck);
    const pdf = () => {
      druck.replaceChildren(
        ...['[data-ausweis-vorne]', '[data-ausweis-hinten]'].map((s) => {
          const karte = document.createElement('div');
          karte.className = 'ms-druck__karte';
          karte.append(q(s)!.cloneNode(true));
          return karte;
        }),
      );
      const titel = document.title;
      document.title = `Mitgliedsausweis-${m?.nummer ?? 'TNDD'}`;
      addEventListener('afterprint', () => (document.title = titel), { once: true });
      print();
    };
    alle('[data-ms-pdf]', (el) => el.addEventListener('click', pdf));

    // Google Wallet (supabase/functions/ausweis, nur wenn in settings/supabase.ts eingeschaltet)
    const merkKey = `tndd-wallet-${ctx.user.id}-${jahr}`;
    const start = q('[data-ms-handy-start]')!;
    const gespeichert = q('[data-ms-gespeichert]');
    const zeigeGespeichert = (wann: string | null) => {
      if (!gespeichert) return;
      gespeichert.hidden = !wann;
      start.hidden = !!wann;
      text('[data-ms-wallet-wann]', wann ? `Seit ${wann}` : '');
    };
    let gemerkt: string | null = null;
    try {
      gemerkt = localStorage.getItem(merkKey);
    } catch {}
    if (ok) zeigeGespeichert(gemerkt);
    wallet?.addEventListener('click', async () => {
      const label = q('[data-ms-wallet-label]')!;
      wallet.disabled = true;
      label.textContent = 'Wird vorbereitet …';
      const { data: antwort, error } = await ctx.sb.functions.invoke<{ url?: string }>('ausweis', { body: {} });
      if (error || !antwort?.url) {
        let meldung = 'Das hat nicht geklappt. Bitte versuch es später noch einmal.';
        try {
          const j = await (error as { context?: Response })?.context?.json();
          if (j?.fehler) meldung = j.fehler;
        } catch {}
        toast(meldung);
        wallet.disabled = false;
        label.textContent = 'Zu Google Wallet hinzufügen';
        return;
      }
      const wann = new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
      try {
        localStorage.setItem(merkKey, wann);
      } catch {}
      zeigeGespeichert(wann);
      location.assign(antwort.url);
    });
    q('[data-ms-wallet-zurueck]')?.addEventListener('click', () => {
      try {
        localStorage.removeItem(merkKey);
      } catch {}
      zeigeGespeichert(null);
      if (wallet) {
        wallet.disabled = false;
        q('[data-ms-wallet-label]')!.textContent = 'Zu Google Wallet hinzufügen';
      }
    });
  }

  let toastZeit = 0;
  function toast(t: string) {
    const el = document.querySelector<HTMLElement>('[data-ms-toast]');
    if (!el) return;
    el.querySelector('[data-ms-toast-text]')!.textContent = t;
    el.hidden = false;
    clearTimeout(toastZeit);
    toastZeit = window.setTimeout(() => (el.hidden = true), 4000);
  }

  // ---------- Anmelden ----------
  const sb = getSupabase();
  const form = document.querySelector<HTMLFormElement>('[data-login-form]');
  const msg = document.querySelector<HTMLElement>('[data-login-msg]');
  const pwField = document.querySelector<HTMLElement>('[data-password-field]');
  const pwInput = pwField?.querySelector('input');
  const submit = document.querySelector<HTMLButtonElement>('[data-login-submit]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');
  let magic = false;

  toggle?.addEventListener('click', () => {
    magic = !magic;
    if (pwField) pwField.hidden = magic;
    if (pwInput) pwInput.required = !magic;
    if (submit) submit.textContent = magic ? 'Login-Link senden' : 'Anmelden';
    toggle.textContent = magic ? 'Mit Passwort anmelden' : 'Stattdessen Login-Link per E-Mail';
    showMessage(msg, '');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!sb || !submit) return;
    const fd = new FormData(form);
    const email = String(fd.get('email') ?? '').trim();
    submit.disabled = true;
    try {
      if (magic) {
        const { error } = await sb.auth.signInWithOtp({ email, options: { shouldCreateUser: false, emailRedirectTo: location.origin + internUrl() } });
        if (error) throw error;
        showMessage(msg, 'Wir haben dir einen Login-Link geschickt. Schau in dein Postfach.', 'ok');
      } else {
        const { error } = await sb.auth.signInWithPassword({ email, password: String(fd.get('password') ?? '') });
        if (error) throw error;
        location.replace(next?.startsWith('/') ? next : internUrl());
      }
    } catch (err) {
      showMessage(msg, errorText(err));
    } finally {
      submit.disabled = false;
    }
  });

  document.querySelector('[data-reset]')?.addEventListener('click', async () => {
    const email = (form?.querySelector<HTMLInputElement>('#login-email')?.value ?? '').trim();
    if (!email) {
      showMessage(msg, 'Trag oben deine E-Mail-Adresse ein, dann schicken wir dir einen Link zum Zurücksetzen.');
      return;
    }
    const { error } = (await sb?.auth.resetPasswordForEmail(email, { redirectTo: location.origin + internUrl('passwort/') })) ?? {};
    // Aus Datenschutzgründen nicht verraten, ob die Adresse existiert
