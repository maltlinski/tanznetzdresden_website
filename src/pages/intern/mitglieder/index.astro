---
/**
 * Intern → Mitglieder: alle mit Zugang. Der Vorstand lädt hier neue Mitglieder ein (Supabase-Funktion „einladen“),
 * vergibt Rollen und pflegt die Mitgliedschaften (Nummer, Beitrag, Austritt).
 */
import Intern from '../../../layouts/Intern.astro';
---
<Intern title="Mitglieder" current="mitglieder">
  <div class="dir-head">
    <div>
      <h1 class="i-h1">Mitglieder</h1>
      <p class="i-lead">Alle mit Zugang zum internen Bereich. Bitte nutze die Kontaktdaten nur für die Arbeit im Netzwerk.</p>
    </div>
    <div class="i-field dir-search">
      <label for="dir-q">Suchen</label>
      <input id="dir-q" type="search" placeholder="Name oder AG" data-dir-search />
    </div>
  </div>
  <p class="i-msg" role="alert" data-dir-msg hidden></p>
  <p class="dir-pending" data-dir-pending hidden></p>

  <!-- Einladen (nur Vorstand) -->
  <section class="ei" aria-labelledby="ei-h" data-einladen hidden>
    <details class="ei__klapp" data-ei-klapp>
      <summary><span class="ei__h" id="ei-h">Neues Mitglied einladen</span><span class="ei__zahl" data-ei-zahl></span></summary>
      <div class="ei__innen">
        <p class="ei__hilfe">
          Die Person bekommt eine E-Mail mit einem Link. Darüber legt sie ihr Passwort fest und ist danach im internen Bereich.
          Rolle und Mitgliedschaft lassen sich später auf ihrer Karte ändern.
        </p>
        <p class="i-msg" data-ei-fehlt hidden>
          Die Funktion „einladen“ ist in Supabase noch nicht eingerichtet. Die Anleitung steht in <code>docs/intern.md</code>
          („Mitglieder einladen“). Bis dahin geht es über das Supabase-Dashboard.
        </p>
        <form class="ei__form" data-ei-form>
          <div class="i-field">
            <label for="ei-name">Name</label>
            <input id="ei-name" name="name" required maxlength="80" autocomplete="off" />
          </div>
          <div class="i-field">
            <label for="ei-email">E-Mail</label>
            <input id="ei-email" name="email" type="email" required maxlength="200" autocomplete="off" />
          </div>
          <div class="i-field">
            <label for="ei-rolle">Rolle</label>
            <select id="ei-rolle" name="rolle">
              <option value="mitglied">Mitglied</option>
              <option value="presse">Presse (darf News schreiben)</option>
              <option value="vorstand">Vorstand</option>
              <option value="admin" data-nur-admin>Admin</option>
            </select>
          </div>
          <div class="i-field">
            <label for="ei-sprache">Sprache der Einladung</label>
            <select id="ei-sprache" name="sprache">
              <option value="de">Deutsch</option>
              <option value="en">English</option>
            </select>
          </div>
          <div class="i-field" data-ei-ms>
            <label for="ei-art">Art der Mitgliedschaft</label>
            <input id="ei-art" name="art" list="ms-arten" value="Ordentliches Mitglied" maxlength="80" />
          </div>
          <div class="i-field" data-ei-ms>
            <label for="ei-seit">Mitglied seit</label>
            <input id="ei-seit" name="seit" type="date" />
          </div>
          <div class="ei__knoepfe">
            <button type="submit" class="btn btn--primary btn--marker" data-ei-senden>Einladung senden</button>
          </div>
        </form>
        <div class="ei-offen" data-ei-offen hidden>
          <h2 class="ei-offen__h">Noch nicht angenommen</h2>
          <ul class="ei-offen__liste" data-ei-liste></ul>
        </div>
      </div>
    </details>
  </section>

  <ul class="dir" data-dir aria-live="polite"></ul>
  <template data-dir-item>
    <li class="dir__card">
      <div class="dir__top"><strong class="dir__name"></strong><span class="dir__badge" hidden></span></div>
      <span class="dir__pronouns"></span>
      <p class="dir__bio"></p>
      <span class="dir__ags"></span>
      <div class="dir__links"></div>
      <details class="dir__ms" hidden>
        <summary><span>Mitgliedschaft</span><span class="dir__ms-status"></span></summary>
        <form class="dir__ms-form">
          <label>Nummer<input name="nummer" placeholder="wird vergeben" autocomplete="off" /></label>
          <label>Art<input name="art" list="ms-arten" required /></label>
          <label>Mitglied seit<input name="seit" type="date" /></label>
          <label>Beitrag bezahlt bis (Jahr)<input name="bezahlt_bis" type="number" min="2000" max="2100" step="1" /></label>
          <label>Bezahlt am<input name="bezahlt_am" type="date" /></label>
          <label>Mitglied bis (Austritt)<input name="ende" type="date" /></label>
          <div class="dir__ms-knoepfe">
            <button type="button" class="dir__ms-bezahlt" data-ms-bezahlt></button>
            <button type="submit" class="dir__ms-speichern">Speichern</button>
          </div>
        </form>
      </details>
      <div class="dir__role" hidden>
        <label>Rolle</label>
        <select>
          <option value="mitglied">Mitglied</option>
          <option value="presse">Presse (darf News schreiben)</option>
          <option value="vorstand">Vorstand</option>
          <option value="admin">Admin</option>
        </select>
      </div>
    </li>
  </template>
  <datalist id="ms-arten">
    <option value="Ordentliches Mitglied"></option>
    <option value="Ordentliches Mitglied · Tanzschaffende"></option>
    <option value="Fördermitglied"></option>
    <option value="Ehrenmitglied"></option>
  </datalist>
</Intern>

<script>
  import { initIntern, errorText, showMessage } from '../../../scripts/intern/session';
  import { freigabenHinweis } from '../../../scripts/intern/freigaben';
  import type { DirectoryEntry } from '../../../lib/supabase';
  import { status, type Mitgliedschaft } from '../../../lib/mitgliedschaft';

  const ctx = await initIntern(true);
  const list = document.querySelector<HTMLUListElement>('[data-dir]');
  const tpl = document.querySelector<HTMLTemplateElement>('[data-dir-item]');
  const msg = document.querySelector<HTMLElement>('[data-dir-msg]');
  const search = document.querySelector<HTMLInputElement>('[data-dir-search]');

  const link = (href: string, text: string) => {
    const a = document.createElement('a');
    a.href = href;
    a.textContent = text;
    if (href.startsWith('http')) { a.rel = 'noopener'; a.target = '_blank'; }
    return a;
  };
  const safeUrl = (u: string) => (/^https?:\/\//i.test(u) ? u : `https://${u}`);

  const ms = new Map<string, Mitgliedschaft>();
  let msFehlt = false;
  let cards: HTMLLIElement[] = [];
  const STATUS_TEXT = { aktiv: 'aktiv', offen: 'Beitrag offen', abgelaufen: 'abgelaufen' } as const;

  /** Bereich „Mitgliedschaft“ auf einer Karte (nur Vorstand) */
  function mitgliedschaft(li: HTMLElement, person: string, name: string) {
    if (!ctx) return;
    const box = li.querySelector<HTMLDetailsElement>('.dir__ms')!;
    const form = box.querySelector('form')!;
    const anzeige = box.querySelector<HTMLElement>('.dir__ms-status')!;
    const bezahlt = box.querySelector<HTMLButtonElement>('[data-ms-bezahlt]')!;
    const feld = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const jahr = new Date().getFullYear();
    bezahlt.textContent = `Beitrag ${jahr} bezahlt`;
    form.querySelectorAll('input').forEach((i) => (i.id = `ms-${person}-${i.name}`));

    const zeigen = () => {
      const z = ms.get(person);
      feld('nummer').value = z?.nummer ?? '';
      feld('art').value = z?.art ?? 'Ordentliches Mitglied';
      feld('seit').value = z?.seit ?? '';
      feld('bezahlt_bis').value = z?.bezahlt_bis != null ? String(z.bezahlt_bis) : '';
      feld('bezahlt_am').value = z?.bezahlt_am ?? '';
      feld('ende').value = z?.ende ?? '';
      anzeige.textContent = z ? `${z.nummer ?? ''} · ${STATUS_TEXT[status(z)]}` : 'noch nicht angelegt';
      anzeige.dataset.status = z ? status(z) : '';
      bezahlt.hidden = !!z && z.bezahlt_bis != null && z.bezahlt_bis >= jahr;
    };
    const speichern = async (extra: Partial<Mitgliedschaft> = {}) => {
      const leer = (v: string) => v.trim() || null;
      const zeile = {
        person,
        nummer: leer(feld('nummer').value)?.toUpperCase() ?? null,
        art: feld('art').value.trim() || 'Ordentliches Mitglied',
        seit: leer(feld('seit').value),
        bezahlt_bis: feld('bezahlt_bis').value ? Number(feld('bezahlt_bis').value) : null,
        bezahlt_am: leer(feld('bezahlt_am').value),
        ende: leer(feld('ende').value),
        ...extra,
      };
      const { data: neu, error: fehler } = await ctx.sb.from('mitgliedschaften').upsert(zeile).select().single<Mitgliedschaft>();
      if (fehler) return showMessage(msg, /duplicate|unique/i.test(fehler.message) ? 'Diese Mitgliedsnummer ist schon vergeben.' : errorText(fehler));
      ms.set(person, neu);
      zeigen();
      showMessage(msg, `${name || 'Mitgliedschaft'}: gespeichert (${neu.nummer}).`, 'ok');
    };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void speichern();
    });
    bezahlt.addEventListener('click', () => void speichern({ bezahlt_bis: jahr, bezahlt_am: new Date().toISOString().slice(0, 10) }));
    zeigen();
    box.hidden = false;
  }

  /** Mitgliederliste laden und zeigen (auch nach einer Einladung) */
  async function laden() {
    if (!ctx || !list || !tpl) return;
    const { data, error } = await ctx.sb.rpc('member_directory');
    if (error) showMessage(msg, errorText(error));
    const entries = (data ?? []) as DirectoryEntry[];
    // Vorstand: Mitgliedschaften aller (fehlt die Tabelle, ist die Migration 20261022 noch nicht eingespielt)
    if (ctx.isVorstand) {
      const r = await ctx.sb.from('mitgliedschaften').select('*');
      if (r.error) msFehlt = true;
      else (r.data as Mitgliedschaft[]).forEach((z) => ms.set(z.person, z));
      if (msFehlt) showMessage(msg, 'Mitgliedschaften lassen sich pflegen, sobald die Migration 20261022000000_mitgliedschaft.sql eingespielt ist (docs/intern.md).');
    }
    cards = entries.map((m) => {
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      li.querySelector('.dir__name')!.textContent = m.display_name || 'Ohne Namen';
      const badge = li.querySelector<HTMLElement>('.dir__badge')!;
      const roleName = { mitglied: '', presse: 'Presse', vorstand: 'Vorstand', admin: 'Admin' } as const;
      const roles = [roleName[m.role], m.is_trainer ? 'Training' : ''].filter(Boolean);
      badge.textContent = roles.join(' · ');
      badge.hidden = !roles.length;
      li.querySelector('.dir__pronouns')!.textContent = m.pronouns ?? '';
      li.querySelector('.dir__bio')!.textContent = m.bio ?? '';
      li.querySelector('.dir__ags')!.textContent = m.ags?.length ? `AG ${m.ags.join(' · ')}` : '';
      const links = li.querySelector('.dir__links')!;
      if (m.email) links.append(link(`mailto:${m.email}`, m.email));
      if (m.phone) links.append(link(`tel:${m.phone.replace(/\s/g, '')}`, m.phone));
      if (m.website) links.append(link(safeUrl(m.website), m.website.replace(/^https?:\/\//, '')));
      if (m.instagram) links.append(link(`https://www.instagram.com/${encodeURIComponent(m.instagram)}/`, `@${m.instagram}`));
      li.dataset.search = `${m.display_name} ${m.ags?.join(' ')}`.toLowerCase();

      // Vorstand: Rollen vergeben (z. B. Presse für die News-Redaktion)
      if (ctx.isVorstand) {
        const box = li.querySelector<HTMLElement>('.dir__role')!;
        const sel = box.querySelector('select')!;
        const lbl = box.querySelector('label')!;
        sel.id = `role-${m.id}`;
        lbl.htmlFor = sel.id;
        sel.value = m.role;
        // Admin vergeben nur Admins
        if (ctx.profile?.role !== 'admin') sel.querySelector<HTMLOptionElement>('option[value="admin"]')!.disabled = m.role !== 'admin';
        sel.disabled = m.id === ctx.user.id;
        if (sel.disabled) sel.title = 'Die eigene Rolle ändert jemand anderes aus dem Vorstand.';
        sel.addEventListener('change', async () => {
          const prev = m.role;
          const { error } = await ctx.sb.from('profiles').update({ role: sel.value }).eq('id', m.id);
          if (error) {
            sel.value = prev;
            return showMessage(msg, errorText(error));
          }
          m.role = sel.value as typeof m.role;
          const r = [roleName[m.role], m.is_trainer ? 'Training' : ''].filter(Boolean);
          badge.textContent = r.join(' · ');
          badge.hidden = !r.length;
          showMessage(msg, `${m.display_name || 'Rolle'}: jetzt ${sel.selectedOptions[0].text}.`, 'ok');
        });
        box.hidden = false;
      }

      if (ctx.isVorstand && !msFehlt) mitgliedschaft(li, m.id, m.display_name);

      // öffentliches Profil: Link auf die Website (freigegeben wird unter Redaktion → Freigaben)
      if (m.public_listing && m.slug && m.verified) {
        li.querySelector('.dir__links')!.append(link(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}netzwerk/${m.slug}/`, 'Profil auf der Website'));
      }
      return li;
    });
    list.replaceChildren(...cards);
    filtern();
  }
  function filtern() {
    const q = (search?.value ?? '').trim().toLowerCase();
    cards.forEach((c) => (c.hidden = !!q && !(c.dataset.search ?? '').includes(q)));
  }

  // ---------- Einladen (Vorstand, Funktion supabase/functions/einladen) ----------
  type Offen = { id: string; email: string; name: string; eingeladen_am: string };
  class Fehlt extends Error {}

  async function funktion<T>(body: Record<string, unknown>): Promise<T> {
    const { data, error } = await ctx!.sb.functions.invoke<T>('einladen', { body });
    if (!error) return data as T;
    const antwort = (error as { context?: Response }).context;
    let j: { fehler?: string } | null = null;
    try {
      j = await antwort?.json();
    } catch {}
    if (j?.fehler) throw new Error(j.fehler);
    // Funktion nicht angelegt (404) oder nicht erreichbar
    if (!antwort || antwort.status === 404) throw new Fehlt();
    throw new Error(errorText(error));
  }

  function einladen() {
    if (!ctx?.isVorstand) return;
    const box = document.querySelector<HTMLElement>('[data-einladen]')!;
    const form = box.querySelector<HTMLFormElement>('[data-ei-form]')!;
    const senden = box.querySelector<HTMLButtonElement>('[data-ei-senden]')!;
    const fehlt = box.querySelector<HTMLElement>('[data-ei-fehlt]')!;
    const offenBox = box.querySelector<HTMLElement>('[data-ei-offen]')!;
    const liste = box.querySelector<HTMLUListElement>('[data-ei-liste]')!;
    const zahl = box.querySelector<HTMLElement>('[data-ei-zahl]')!;
    const feld = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const datum = (iso: string) => (iso ? new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso)) : '');
    // Admin vergeben nur Admins; ohne Tabelle mitgliedschaften keine Angaben dazu
    if (ctx.profile?.role !== 'admin') form.querySelector('[data-nur-admin]')?.remove();
    if (msFehlt) form.querySelectorAll<HTMLElement>('[data-ei-ms]').forEach((el) => el.remove());
    else feld('seit').value = new Date().toISOString().slice(0, 10);
    box.hidden = false;

    const fehler = (e: unknown) => {
      if (e instanceof Fehlt) fehlt.hidden = false;
      else showMessage(msg, e instanceof Error ? e.message : errorText(e));
    };

    async function offeneLaden() {
      try {
        const { offen } = await funktion<{ offen: Offen[] }>({ aktion: 'offen' });
        fehlt.hidden = true;
        zahl.textContent = offen.length ? `${offen.length} offen` : '';
        offenBox.hidden = !offen.length;
        liste.replaceChildren(
          ...offen.map((o) => {
            const li = document.createElement('li');
            li.className = 'ei-offen__z';
            const wer = document.createElement('span');
            wer.className = 'ei-offen__wer';
            const name = document.createElement('strong');
            name.textContent = o.name || o.email;
            const mehr = document.createElement('span');
            mehr.textContent = [o.name ? o.email : '', o.eingeladen_am ? `eingeladen am ${datum(o.eingeladen_am)}` : ''].filter(Boolean).join(' · ');
            wer.append(name, mehr);
            const knopf = (text: string, label: string, fn: () => Promise<void>) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'ei-offen__knopf';
              b.textContent = text;
              b.setAttribute('aria-label', `${label}: ${o.name || o.email}`);
              b.addEventListener('click', async () => {
                b.disabled = true;
                try {
                  await fn();
                } catch (e) {
                  fehler(e);
                } finally {
                  b.disabled = false;
                }
              });
              return b;
            };
            li.append(
              wer,
              knopf('Erneut senden', 'Einladung erneut senden', async () => {
                await funktion({ aktion: 'erneut', id: o.id });
                showMessage(msg, `Einladung an ${o.email} noch einmal verschickt.`, 'ok');
              }),
              knopf('Zurücknehmen', 'Einladung zurücknehmen', async () => {
                if (!confirm(`Einladung an ${o.email} zurücknehmen? Der Link in der E-Mail funktioniert dann nicht mehr.`)) return;
                await funktion({ aktion: 'zuruecknehmen', id: o.id });
                showMessage(msg, `Einladung an ${o.email} zurückgenommen.`, 'ok');
                await Promise.all([offeneLaden(), laden()]);
              }),
            );
            return li;
          }),
        );
      } catch (e) {
        fehler(e);
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const name = feld('name').value.trim();
      const email = feld('email').value.trim();
      const rolle = (form.elements.namedItem('rolle') as HTMLSelectElement).value;
      senden.disabled = true;
      senden.textContent = 'Wird verschickt …';
      try {
        const { id } = await funktion<{ id: string }>({
          aktion: 'einladen',
          name,
          email,
          sprache: (form.elements.namedItem('sprache') as HTMLSelectElement).value,
        });
        // Rolle und Mitgliedschaft mit der eigenen Anmeldung (Row Level Security, Trigger der Rollen)
        const nachher: string[] = [];
        if (rolle !== 'mitglied') {
          const { error } = await ctx.sb.from('profiles').update({ role: rolle }).eq('id', id);
          if (error) nachher.push(`Rolle: ${errorText(error)}`);
        }
        if (!msFehlt) {
          const { error } = await ctx.sb
            .from('mitgliedschaften')
            .upsert({ person: id, art: feld('art').value.trim() || 'Ordentliches Mitglied', seit: feld('seit').value || null });
          if (error) nachher.push(`Mitgliedschaft: ${errorText(error)}`);
        }
        showMessage(
          msg,
          nachher.length
            ? `Einladung an ${email} verschickt. Bitte auf der Karte nachtragen – ${nachher.join(' ')}`
            : `Einladung an ${email} verschickt. ${name} steht jetzt in der Liste.`,
          nachher.length ? 'error' : 'ok',
        );
        form.reset();
        if (!msFehlt) feld('seit').value = new Date().toISOString().slice(0, 10);
        await Promise.all([offeneLaden(), laden()]);
      } catch (err) {
        fehler(err);
      } finally {
        senden.disabled = false;
        senden.textContent = 'Einladung senden';
      }
    });
    void offeneLaden();
  }

  if (ctx) {
    await laden();
    einladen();
    if (ctx.isRedaktion) void freigabenHinweis(ctx.sb, document.querySelector('[data-dir-pending]'));
    search?.addEventListener('input', filtern);
  }
</script>

<style>
  .dir-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px 40px; margin-bottom: 28px; }
  .dir-head .i-lead { margin-bottom: 0; }
  .dir-search { min-width: min(100%, 300px); }
  .dir { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  :global(.dir__card) { display: flex; flex-direction: column; gap: 8px; padding: 22px; background: var(--paper); border-top: 3px solid var(--magenta); }
  :global(.dir__top) { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  :global(.dir__name) { font-family: var(--font-display); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; color: var(--purple); }
  :global(.dir__badge) { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; background: var(--cyan); color: var(--purple); padding: 3px 7px; white-space: nowrap; }
  :global(.dir__pronouns), :global(.dir__ags) { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); }
  :global(.dir__bio) { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--ink-soft); }
  :global(.dir__bio:empty), :global(.dir__pronouns:empty), :global(.dir__ags:empty) { display: none; }
  :global(.dir__links) { display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
  :global(.dir__ms) { margin-top: 6px; padding-top: 10px; border-top: 1px solid var(--rule); font-size: 13px; }
  :global(.dir__ms[hidden]) { display: none; }
  :global(.dir__ms summary) { display: flex; justify-content: space-between; gap: 10px; cursor: pointer; font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); }
  :global(.dir__ms-status) { color: var(--purple); }
  :global(.dir__ms-status[data-status='offen']), :global(.dir__ms-status[data-status='abgelaufen']) { color: var(--magenta-2); }
  :global(.dir__ms-form) { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 10px; margin-top: 12px; }
  :global(.dir__ms-form label) { display: flex; flex-direction: column; gap: 4px; font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); }
  :global(.dir__ms-form input) { width: 100%; font: inherit; font-family: var(--font-body); font-size: 14px; font-weight: 400; letter-spacing: 0; text-transform: none; padding: 6px 8px; border: 1.5px solid var(--rule); border-radius: 0; background: var(--paper); color: var(--ink); min-width: 0; }
  :global(.dir__ms-form input:focus) { border-color: var(--magenta); outline: none; }
