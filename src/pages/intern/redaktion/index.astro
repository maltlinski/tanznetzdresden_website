---
/**
 * Website-Inhalte: Startseite der Redaktion (Presse, Vorstand, Admin) – „Was möchtest du ändern?“ mit großen Kacheln,
 * darunter die Seiten der Website zum direkten Hinspringen, der Zustand der Website und was zuletzt geändert wurde.
 * Aufbau des Bereichs: docs/redaktion.md. Gespeichert wird über die Supabase-Funktion „inhalte“.
 * Technisches (Rechtliches, Demo-Ansicht, Datenbank) steht unter Verwaltung (nur Vorstand/Admin).
 */
import Redaktion from '../../../layouts/Redaktion.astro';
import RedaktionStatus from '../../../components/intern/RedaktionStatus.astro';
import { href } from '../../../lib/url';
import texte from '../../../settings/texte.json';
import { seitenplan } from '../../../scripts/intern/redaktion/seitenplan';
import '../../../styles/redaktion.css';

const plan = seitenplan(texte);
const gruppen = [...new Set(plan.map((s) => s.gruppe))];
const kacheln = [
  { titel: 'Texte ändern', text: 'Überschriften, Einleitungen, Knöpfe und Hinweise. Seite für Seite, auf Deutsch und Englisch.', ziel: href('intern/redaktion/texte/'), id: 'texte' },
  { titel: 'Seite für Seite', text: 'Alles, was auf einer Seite steht: Texte, Fotos, Listen. So aufgebaut wie die Website.', ziel: href('intern/redaktion/seiten/'), id: 'seiten' },
  { titel: 'Beitrag schreiben', text: 'News mit Foto, Frist oder Zitat anlegen und veröffentlichen.', ziel: href('intern/news/'), id: 'beitraege' },
  { titel: 'Termin eintragen', text: 'Vorstellungen, Workshops und KEEP UP-Trainings für den Tanzkalender.', ziel: href('intern/kalender/'), id: 'termine' },
  { titel: 'Medien verwalten', text: 'Fotos hochladen, beschreiben und sehen, wo sie verwendet werden.', ziel: href('intern/news/medien/'), id: 'medien' },
  { titel: 'Freigaben', text: 'Profile und Fotos, die Mitglieder selbst pflegen, für die Website freigeben.', ziel: href('intern/redaktion/freigaben/'), id: 'freigaben' },
];
---
<Redaktion title="Website-Inhalte" current="inhalte">
  <div class="r-head">
    <div>
      <p class="r-kicker">Website-Inhalte</p>
      <h1 class="i-h1">Was möchtest du ändern?</h1>
      <p class="i-lead">
        Hier pflegst du alles, was auf der Website steht. Was du speicherst, ist nach 2–3 Minuten online. Jede Änderung
        wird mit deinem Namen festgehalten und lässt sich zurückholen.
      </p>
    </div>
    <RedaktionStatus />
  </div>

  <div class="i-card" data-no-access hidden>
    <p>Die Redaktion ist für Mitglieder mit der Rolle <strong>Presse</strong>, <strong>Vorstand</strong> oder <strong>Admin</strong>.
      Der Vorstand vergibt die Rolle unter <a href={href('intern/mitglieder/')}>Mitglieder</a>.</p>
  </div>
  <p class="i-msg" role="alert" data-msg hidden></p>
  <p class="i-hint" data-loading hidden>Inhalte werden geladen …</p>

  <div data-access hidden>
    <ul class="r-start" aria-label="Was möchtest du ändern?">
      {kacheln.map((k) => (
        <li>
          <a href={k.ziel} data-kachel={k.id}>
            <strong>{k.titel}{k.id === 'freigaben' && <span class="r-tiles__n" data-freigaben-n></span>}</strong>
            <span>{k.text}</span>
          </a>
        </li>
      ))}
      <li>
        <a href={href('intern/redaktion/vorschau/')} data-kachel="vorschau">
          <strong>Vorschau öffnen</strong>
          <span>Jede Seite auf Computer, Tablet und Handy ansehen, mit allem, was ausgeblendet ist.</span>
        </a>
      </li>
    </ul>

    <section class="r-gruppe" aria-labelledby="g-seiten">
      <h2 class="r-gruppe__h" id="g-seiten">Oder direkt zu einer Seite</h2>
      <div class="r-seitenwahl">
        {gruppen.map((g) => (
          <div>
            <p class="r-seitenwahl__g">{g}</p>
            <ul>
              {plan.filter((s) => s.gruppe === g).map((s) => (
                <li><a href={href(`intern/redaktion/seiten/?s=${s.id}`)}>{s.titel}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="r-gruppe" aria-labelledby="g-verlauf">
      <h2 class="r-gruppe__h" id="g-verlauf">Zuletzt geändert</h2>
      <ol class="rs-verlauf" data-verlauf></ol>
      <p class="i-hint r-hilfe">
        Etwas ist schiefgegangen? Jede Änderung lässt sich zurückholen. Gib dafür dem Vorstand oder Admin Bescheid.
      </p>
    </section>
  </div>
</Redaktion>

<script>
  import { $, starten, statusAnzeigen } from '../../../scripts/intern/redaktion/seite';
  import { offeneFreigaben } from '../../../scripts/intern/freigaben';

  const r = await starten();
  if (r) {
    void offeneFreigaben(r.ctx.sb).then((n) => {
      const el = $('[data-freigaben-n]');
      if (el) el.textContent = n ? String(n) : '';
    });
    statusAnzeigen(r, $('[data-website-status]'), $('[data-verlauf]'));
  }
</script>
