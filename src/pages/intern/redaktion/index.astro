---
/**
 * Redaktion: Übersicht über alles, was Presse, Vorstand und Admin an der Website bearbeiten können.
 * Gespeichert wird über die Supabase-Funktion „inhalte“ direkt im Repository (docs/redaktion.md).
 */
import Redaktion from '../../../layouts/Redaktion.astro';
import RedaktionStatus from '../../../components/intern/RedaktionStatus.astro';
import { href } from '../../../lib/url';
import { bereiche, gruppen } from '../../../scripts/intern/redaktion/bereiche';
import '../../../styles/redaktion.css';

const ziel = (b: (typeof bereiche)[number]) => href(b.art === 'einstellung' ? `intern/redaktion/eintrag/?b=${b.id}` : `intern/redaktion/liste/?b=${b.id}`);
---
<Redaktion title="Website-Inhalte" current="inhalte">
  <div class="r-head">
    <div>
      <h1 class="i-h1">Website-Inhalte</h1>
      <p class="i-lead">
        Hier pflegst du die Website: die Texte der Seiten, dazu Termine, Formate, Profitraining, Personen, Partner und
        Vereinsdaten, und du gibst Mitgliederprofile frei. Was du
        speicherst, ist nach 2–3 Minuten online. Jede Änderung wird mit deinem Namen festgehalten und lässt sich
        zurückholen.
      </p>
    </div>
    <RedaktionStatus />
  </div>

  <div class="i-card" data-no-access hidden>
    <p>Die Redaktion ist für Mitglieder mit der Rolle <strong>Presse</strong>, <strong>Vorstand</strong> oder <strong>Admin</strong>.
      Der Vorstand vergibt die Rolle unter <a href={href('intern/mitglieder/')}>Mitglieder</a>.</p>
  </div>
  <p class="i-msg" role="alert" data-msg hidden></p>
  <p class="i-hint" data-loading hidden>Inhalte werden geladen …</p>

  <div data-access hidden>
    <section class="r-gruppe" aria-labelledby="g-texte">
      <h2 class="r-gruppe__h" id="g-texte">Texte der Website</h2>
      <ul class="r-tiles">
        <li>
          <a href={href('intern/redaktion/texte/')}>
            <strong>Texte</strong>
            <span>Alle Überschriften, Knöpfe und Hinweise, Seite für Seite, Deutsch und Englisch.</span>
          </a>
        </li>
        <li>
          <a href={href('intern/redaktion/texte/textbuch/')}>
            <strong>Textbuch</strong>
            <span>Alle Texte am Stück zum Durchlesen, Abstimmen und Drucken.</span>
          </a>
        </li>
      </ul>
    </section>
    {gruppen.map((g, gi) => (
      <section class="r-gruppe" aria-labelledby={`g-${gi}`}>
        <h2 class="r-gruppe__h" id={`g-${gi}`}>{g}</h2>
        <ul class="r-tiles">
          {g === 'Netzwerk & Partner' && (
            <li>
              <a href={href('intern/redaktion/freigaben/')}>
                <strong>Freigaben<span class="r-tiles__n" data-freigaben-n></span></strong>
                <span>Profile und Fotos, die Mitglieder selbst pflegen, für die Website freigeben.</span>
              </a>
            </li>
          )}
          {g === 'Programm' && (
            <li>
              <a href={href('intern/news/')}>
                <strong>News schreiben</strong>
                <span>Beiträge für „Aus dem Netz“ mit Foto, Frist oder Zitat anlegen und veröffentlichen.</span>
              </a>
            </li>
          )}
          {bereiche.filter((b) => b.gruppe === g).map((b) => (
            <li>
              <a href={ziel(b)} data-bereich={b.id}>
                <strong>{b.label}<span class="r-tiles__n" data-anzahl={b.art === 'ordner' ? b.ordner : undefined}></span></strong>
                <span>{b.beschreibung}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="r-gruppe" aria-labelledby="g-verlauf">
      <h2 class="r-gruppe__h" id="g-verlauf">Zuletzt geändert</h2>
      <ol class="rs-verlauf" data-verlauf></ol>
      <p class="i-hint r-hilfe">
        Fragen zur Redaktion? Die Anleitung steht in <code>docs/redaktion.md</code>. Etwas ist schiefgegangen? Jede
        Änderung lässt sich auf GitHub rückgängig machen. Das macht der Admin.
      </p>
    </section>
  </div>

  <section class="r-gruppe demo" data-redaktion-only hidden aria-labelledby="g-demo">
    <h2 class="r-gruppe__h" id="g-demo">Ausprobieren</h2>
    <label class="i-check"><input type="checkbox" data-demo-schalter />Demo-Ansicht</label>
    <p class="i-hint">
      Füllt leere Profile auf der Website mit Beispielfoto, -text und Schwerpunkten, damit sich Gestaltung und
      Abläufe ausprobieren lassen. Gilt nur in diesem Browser, echte Angaben bleiben unverändert. Ein Band unten links
      zeigt, dass sie an ist. Ohne Anmeldung: Adresse mit <code>?demo=1</code> öffnen, <code>?demo=0</code> schaltet aus.
    </p>
  </section>
</Redaktion>

<script>
  import { $, starten, statusAnzeigen } from '../../../scripts/intern/redaktion/seite';
  import { offeneFreigaben } from '../../../scripts/intern/freigaben';
  import { DEMO_KEY } from '../../../lib/demo';

  // Demo-Ansicht an/aus (src/lib/demo.ts)
  const demo = document.querySelector<HTMLInputElement>('[data-demo-schalter]');
  if (demo) {
    demo.checked = document.documentElement.classList.contains('demo');
    demo.addEventListener('change', () => {
      try {
        if (demo.checked) localStorage.setItem(DEMO_KEY, '1');
        else localStorage.removeItem(DEMO_KEY);
      } catch {}
      document.documentElement.classList.toggle('demo', demo.checked);
    });
  }

  const r = await starten();
  if (r) {
    void offeneFreigaben(r.ctx.sb).then((n) => {
      const el = $('[data-freigaben-n]');
      if (el) el.textContent = n ? String(n) : '';
    });
    statusAnzeigen(r, $('[data-website-status]'), $('[data-verlauf]'));
    // Anzahl je Ordner (Dateien im Repository)
    document.querySelectorAll<HTMLElement>('[data-anzahl]').forEach((el) => {
      const prefix = `${el.dataset.anzahl}/`;
      const n = r.stand.dateien.filter((d) => d.pfad.startsWith(prefix) && d.pfad.endsWith('.md') && !d.pfad.slice(prefix.length).includes('/')).length;
      el.textContent = String(n);
    });
  }
</script>

<style>
  .demo { display: grid; gap: 6px; max-width: 70ch; }
  .demo[hidden] { display: none; }
  .demo .i-hint { margin: 0; }
</style>
