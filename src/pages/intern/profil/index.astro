---
import Intern from '../../../layouts/Intern.astro';
import { arbeitsgruppen } from '../../../settings/arbeitsgruppen';
import { href } from '../../../lib/url';
import { ANGABEN, GALERIE_LAYOUTS, OFFEN_FUER } from '../../../lib/profil-felder';
---
<Intern title="Mein Profil" current="profil">
  <h1 class="i-h1">Mein Profil</h1>
  <p class="i-lead">Was du hier einträgst, sehen alle angemeldeten Mitglieder:innen. E-Mail und Telefon nur, wenn du sie freigibst. Ein öffentliches Profil auf der Website ist freiwillig.</p>
  <div class="i-card">
    <form class="i-form profile" data-profile-form>
      <div class="i-field">
        <label for="p-name">Name</label>
        <input id="p-name" name="display_name" required maxlength="80" autocomplete="name" />
      </div>
      <div class="i-field">
        <label for="p-pronouns">Pronomen <span class="opt">optional</span></label>
        <input id="p-pronouns" name="pronouns" maxlength="40" placeholder="z. B. sie/ihr" />
      </div>
      <div class="i-field">
        <label for="p-bio">Kurzbio</label>
        <textarea id="p-bio" name="bio" maxlength="1200" aria-describedby="p-bio-hint"></textarea>
        <span class="i-hint" id="p-bio-hint">Höchstens 1.200 Zeichen. Woran arbeitest du, was bietest du an? Absätze mit einer Leerzeile trennen.</span>
      </div>
      <div class="i-field">
        <label for="p-website">Website</label>
        <input id="p-website" name="website" type="url" placeholder="https://" autocomplete="url" />
      </div>
      <div class="i-field">
        <label for="p-instagram">Instagram</label>
        <input id="p-instagram" name="instagram" placeholder="@name" />
      </div>
      <div class="i-field">
        <label for="p-phone">Telefon</label>
        <input id="p-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <fieldset class="i-fieldset">
        <legend class="i-legend">Arbeitsgruppen</legend>
        <div class="ags">
          {arbeitsgruppen.map((ag) => (
            <label class="i-check"><input type="checkbox" name="ags" value={ag.name} />{ag.name}</label>
          ))}
        </div>
      </fieldset>
      <fieldset class="i-fieldset">
        <legend class="i-legend">Für Mitglieder sichtbar</legend>
        <label class="i-check"><input type="checkbox" name="is_trainer" />Ich gebe Training (KEEP UP, Workshops)</label>
        <label class="i-check"><input type="checkbox" name="show_email" />Meine E-Mail-Adresse für Mitglieder:innen anzeigen</label>
        <label class="i-check"><input type="checkbox" name="show_phone" />Meine Telefonnummer für Mitglieder:innen anzeigen</label>
      </fieldset>

      <fieldset class="i-fieldset public">
        <legend class="i-legend">Öffentliches Profil auf der Website</legend>
        <label class="i-check"><input type="checkbox" name="public_listing" data-public-toggle />Ich möchte ein öffentliches Profil unter „Netzwerk“ (Name, Kurzbio, Fotos, Arbeiten, Kontakt)</label>
        <p class="status" data-public-status hidden></p>
        <div class="public__fields" data-public-fields>
          <div class="i-field">
            <label for="p-slug">Adresse</label>
            <div class="slug"><span>…/netzwerk/</span><input id="p-slug" name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" minlength="3" maxlength="60" aria-describedby="p-slug-hint" /><span>/</span></div>
            <span class="i-hint" id="p-slug-hint">Kleinbuchstaben, Ziffern, Bindestriche. Steht dein Name schon auf der Website, nimm dasselbe Kürzel – dann wird das bestehende Profil ergänzt.</span>
          </div>
          <div class="two">
            <div class="i-field">
              <label for="p-profession">Tätigkeit <span class="opt">optional</span></label>
              <input id="p-profession" name="profession" maxlength="80" placeholder="z. B. Tänzerin und Choreografin" data-neu />
            </div>
            <div class="i-field">
              <label for="p-base">Basis <span class="opt">optional</span></label>
              <input id="p-base" name="base" maxlength="60" placeholder="z. B. Dresden-Neustadt" data-neu />
            </div>
          </div>
          <div class="i-field">
            <label for="p-pitch">In einem Satz <span class="opt">optional</span></label>
            <textarea id="p-pitch" name="pitch" maxlength="200" rows="2" class="kurz" aria-describedby="p-pitch-hint" data-neu></textarea>
            <span class="i-hint" id="p-pitch-hint">Steht groß oben auf deinem Profil. Was nach einem Doppelpunkt kommt, wird pink hervorgehoben, z. B. „Ich bringe Tanz an Orte, an denen ihn niemand erwartet: Höfe, Haltestellen, leere Läden.“</span>
          </div>
          <div class="i-field">
            <label for="p-tags">Schwerpunkte</label>
            <input id="p-tags" name="tags" placeholder="z. B. Choreografie, Contemporary, Somatics" aria-describedby="p-tags-hint" />
            <span class="i-hint" id="p-tags-hint">Mit Komma trennen, höchstens 6.</span>
          </div>
          <div class="photo">
            <div class="photo__box">
              <div class="photo__preview" data-photo-preview><span>Kein Foto</span></div>
              <span class="photo__wait" data-photo-wait hidden>Wartet auf Freigabe</span>
            </div>
            <div class="photo__controls">
              <div class="i-field">
                <label for="p-photo">Porträt</label>
                <input id="p-photo" type="file" accept="image/jpeg,image/png,image/webp" data-photo-input aria-describedby="p-photo-hint" />
                <span class="i-hint" id="p-photo-hint">JPG, PNG oder WebP, höchstens 5 MB, am besten Hochformat. Nur Fotos, an denen du die Rechte hast. Neue Fotos erscheinen nach der Freigabe durch Presse oder Vorstand, bis dahin bleibt das bisherige.</span>
              </div>
              <div class="i-field">
                <label for="p-credit">Foto: Name der Fotograf:in</label>
                <input id="p-credit" name="photo_credit" maxlength="80" />
              </div>
              <button type="button" class="i-linkbtn" data-photo-remove hidden>Foto entfernen</button>
            </div>
          </div>

          <p class="i-msg" data-neu-fehlt hidden>Galerie, Arbeiten und weitere Angaben kommen bald dazu. Bis dahin bleibt dein Profil wie bisher.</p>
          <div class="mehr" data-neu-bereich>
            <details class="klapp" data-klapp="galerie">
              <summary>Galerie <span class="klapp__info" data-info-galerie></span></summary>
              <div class="klapp__in">
                <p class="i-hint">Bis zu 12 Fotos aus deiner Arbeit. Das Porträt steht groß oben, die Galerie darunter. Nur Fotos, an denen du die Rechte hast.</p>
                <div data-galerie></div>
                <fieldset class="i-fieldset">
                  <legend class="i-legend">Galerie zeigen als</legend>
                  <div class="wahl">
                    {Object.entries(GALERIE_LAYOUTS).map(([wert, l]) => (
                      <label class="i-check"><input type="radio" name="gallery_layout" value={wert} /><span><strong>{l.de}</strong> {l.hilfe}</span></label>
                    ))}
                  </div>
                </fieldset>
              </div>
            </details>
            <details class="klapp" data-klapp="arbeiten">
              <summary>Arbeiten <span class="klapp__info" data-info-arbeiten></span></summary>
              <div class="klapp__in">
                <p class="i-hint">Stücke und Projekte mit Jahr und Ort. Die neuesten stehen oben.</p>
                <div data-arbeiten></div>
              </div>
            </details>
            <details class="klapp" data-klapp="angaben">
              <summary>Ausbildung, Sprachen und mehr <span class="klapp__info" data-info-angaben></span></summary>
              <div class="klapp__in two">
                {ANGABEN.map((a) => (
                  <div class="i-field">
                    <label for={`p-${a.key}`}>{a.de} <span class="opt">optional</span></label>
                    <input id={`p-${a.key}`} name={a.key} maxlength={a.max} placeholder={a.platzhalter} data-neu />
                  </div>
                ))}
              </div>
            </details>
            <details class="klapp" data-klapp="kontakt">
              <summary>Kontakt und Video <span class="klapp__info" data-info-kontakt></span></summary>
              <div class="klapp__in">
                <div class="i-field">
                  <label for="p-public-email">Öffentliche E-Mail-Adresse <span class="opt">optional</span></label>
                  <input id="p-public-email" name="public_email" type="email" maxlength="120" autocomplete="email" aria-describedby="p-public-email-hint" data-neu />
                  <span class="i-hint" id="p-public-email-hint">Für Anfragen über dein Profil. Auf der Website gegen Spam geschützt. Kann eine andere sein als die für den Login.</span>
                </div>
                <fieldset class="i-fieldset">
                  <legend class="i-legend">Offen für</legend>
                  <div class="wahl wahl--zwei">
                    {Object.entries(OFFEN_FUER).map(([wert, l]) => (
                      <label class="i-check"><input type="checkbox" name="open_for" value={wert} />{l.de}</label>
                    ))}
                  </div>
                </fieldset>
                <div class="i-field">
                  <label for="p-vimeo">Video oder Showreel <span class="opt">optional</span></label>
                  <input id="p-vimeo" name="vimeo" type="url" placeholder="https://vimeo.com/…" />
                </div>
              </div>
            </details>
            <details class="klapp" data-klapp="englisch">
              <summary>Auf Englisch <span class="klapp__info" data-info-englisch></span></summary>
              <div class="klapp__in">
                <p class="i-hint">Erscheint auf der englischen Seite. Leer = deutscher Text.</p>
                <div class="i-field">
                  <label for="p-profession-en">Tätigkeit (Englisch)</label>
                  <input id="p-profession-en" name="profession_en" maxlength="80" lang="en" placeholder="e.g. Dancer and choreographer" data-neu />
                </div>
                <div class="i-field">
                  <label for="p-pitch-en">In einem Satz (Englisch)</label>
                  <textarea id="p-pitch-en" name="pitch_en" maxlength="200" rows="2" class="kurz" lang="en" data-neu></textarea>
                </div>
                <div class="i-field">
                  <label for="p-bio-en">Kurzbio (Englisch)</label>
                  <textarea id="p-bio-en" name="bio_en" maxlength="1200" lang="en"></textarea>
                </div>
              </div>
            </details>
          </div>
        </div>
      </fieldset>

      <p class="i-msg" role="status" data-profile-msg hidden></p>
      <div class="profile__actions">
        <button type="submit" class="btn btn--primary btn--marker">Speichern</button>
        <a class="i-linkbtn" href={href('intern/passwort/')}>Passwort ändern</a>
        <a class="i-linkbtn" data-public-link hidden target="_blank" rel="noopener">Öffentliches Profil ansehen</a>
      </div>
    </form>
  </div>
</Intern>

<script>
  import { initIntern, errorText, showMessage } from '../../../scripts/intern/session';
  import { photoUrl, slugify, type GalerieEintrag } from '../../../lib/supabase';
  import { arbeitenEditor, galerieEditor } from '../../../scripts/intern/profil-galerie';

  const BUCKET = 'profilbilder';
  const ctx = await initIntern(true);
  const form = document.querySelector<HTMLFormElement>('[data-profile-form]');
  const msg = document.querySelector<HTMLElement>('[data-profile-msg]');
  const textFields = ['display_name', 'pronouns', 'bio', 'bio_en', 'website', 'instagram', 'phone', 'slug', 'vimeo', 'photo_credit'] as const;
  const flags = ['is_trainer', 'show_email', 'show_phone', 'public_listing'] as const;
  // ab Migration 20261020000000_profil_seite.sql
  const neueTexte = ['profession', 'profession_en', 'base', 'pitch', 'pitch_en', 'education', 'techniques', 'languages', 'regions', 'height', 'available', 'public_email'] as const;
  const preview = document.querySelector<HTMLElement>('[data-photo-preview]');
  const photoInput = document.querySelector<HTMLInputElement>('[data-photo-input]');
  const removeBtn = document.querySelector<HTMLButtonElement>('[data-photo-remove]');
  const publicToggle = document.querySelector<HTMLInputElement>('[data-public-toggle]');
  const publicFields = document.querySelector<HTMLElement>('[data-public-fields]');
  const publicStatus = document.querySelector<HTMLElement>('[data-public-status]');
  const publicLink = document.querySelector<HTMLAnchorElement>('[data-public-link]');
  const waitTag = document.querySelector<HTMLElement>('[data-photo-wait]');
  /** freigegebenes Foto (auf der Website) und neues, das auf Freigabe wartet */
  let photoPath: string | null = null;
  let pendingPath: string | null = null;

  const showPhoto = (localUrl?: string) => {
    if (!preview) return;
    const src = localUrl ?? photoUrl(pendingPath ?? photoPath);
    preview.replaceChildren();
    if (src) {
      const img = document.createElement('img');
      img.src = src;
      img.alt = 'Dein Porträt (Vorschau)';
      preview.append(img);
    } else {
      preview.innerHTML = '<span>Kein Foto</span>';
    }
    if (waitTag) waitTag.hidden = !pendingPath;
    if (removeBtn) {
      removeBtn.hidden = !pendingPath && !photoPath;
      removeBtn.textContent = pendingPath ? (photoPath ? 'Neues Foto verwerfen' : 'Foto verwerfen') : 'Foto entfernen';
    }
  };
  const showPublic = () => {
    if (publicFields) publicFields.hidden = !publicToggle?.checked;
  };
  const showStatus = (verified: boolean, listed: boolean, slug: string | null) => {
    if (!publicStatus) return;
    publicStatus.hidden = !listed;
    publicStatus.dataset.kind = verified ? 'ok' : 'wait';
    publicStatus.textContent = verified
      ? 'Freigegeben: Dein Profil ist öffentlich. Textänderungen erscheinen spätestens am nächsten Morgen, neue Fotos nach der Freigabe.'
      : 'Wartet auf Freigabe durch Presse oder Vorstand. Danach erscheint dein Profil auf der Website.';
    if (publicLink) {
      publicLink.hidden = !(verified && listed && slug);
      publicLink.href = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}netzwerk/${slug}/`;
    }
  };

  if (ctx && form) {
    const p = ctx.profile;
    const hatNeu = !!p && 'gallery' in p;
    const feld = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | null;
    let galerie: ReturnType<typeof galerieEditor> | null = null;
    let arbeiten: ReturnType<typeof arbeitenEditor> | null = null;
    let verified = !!p?.verified;
    if (!hatNeu) {
      // Datenbank kennt die neuen Felder noch nicht: nur zeigen, was sich speichern lässt
      form.querySelectorAll<HTMLElement>('[data-neu]').forEach((el) => (el.closest<HTMLElement>('.i-field')!.hidden = true));
      form.querySelectorAll<HTMLElement>('[data-klapp="galerie"], [data-klapp="arbeiten"], [data-klapp="angaben"]').forEach((el) => (el.hidden = true));
      form.querySelector<HTMLElement>('input[name="open_for"]')!.closest<HTMLElement>('fieldset')!.hidden = true;
      document.querySelector<HTMLElement>('[data-neu-fehlt]')!.hidden = false;
    }
    if (p) {
      for (const f of textFields) {
        const el = form.elements.namedItem(f) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) el.value = (p[f] as string | null) ?? '';
      }
      for (const f of flags) {
        const el = form.elements.namedItem(f) as HTMLInputElement | null;
        if (el) el.checked = !!p[f];
      }
      form.querySelectorAll<HTMLInputElement>('input[name="ags"]').forEach((c) => (c.checked = p.ags?.includes(c.value) ?? false));
      if (hatNeu) {
        for (const f of neueTexte) {
          const el = feld(f);
          if (el) el.value = p[f] ?? '';
        }
        form.querySelectorAll<HTMLInputElement>('input[name="open_for"]').forEach((c) => (c.checked = p.open_for?.includes(c.value) ?? false));
        form.querySelectorAll<HTMLInputElement>('input[name="gallery_layout"]').forEach((r) => (r.checked = r.value === (p.gallery_layout ?? 'filmstreifen')));
        galerie = galerieEditor({
          sb: ctx.sb,
          userId: ctx.user.id,
          box: document.querySelector<HTMLElement>('[data-galerie]')!,
          start: p.gallery ?? [],
          verified: () => verified,
          melden: (text, art) => {
            showMessage(msg, text, art);
            zusammenfassen();
          },
        });
        arbeiten = arbeitenEditor(document.querySelector<HTMLElement>('[data-arbeiten]')!, p.works ?? []);
      }
      (form.elements.namedItem('tags') as HTMLInputElement).value = (p.tags ?? []).join(', ');
      if (!p.slug) (form.elements.namedItem('slug') as HTMLInputElement).value = slugify(p.display_name);
      photoPath = p.photo_path;
      pendingPath = p.photo_pending;
      showPhoto();
      showStatus(p.verified, p.public_listing, p.slug);
    }
    showPublic();
    publicToggle?.addEventListener('change', showPublic);

    /** Kurzinfo hinter den aufklappbaren Bereichen, z. B. „3 Fotos, 1 wartet“ */
    function zusammenfassen() {
      const info = (k: string, text: string) => {
        const el = document.querySelector(`[data-info-${k}]`);
        if (el) el.textContent = text ? `· ${text}` : '';
      };
      const g = galerie?.wert() ?? [];
      const warten = g.filter((x) => !x.frei).length;
      info('galerie', g.length ? `${g.length} ${g.length === 1 ? 'Foto' : 'Fotos'}${warten ? `, ${warten} ${warten === 1 ? 'wartet' : 'warten'} auf Freigabe` : ''}` : '');
      const a = arbeiten?.wert().length ?? 0;
      info('arbeiten', a ? `${a} ${a === 1 ? 'Eintrag' : 'Einträge'}` : '');
      const n = (namen: readonly string[]) => namen.filter((x) => feld(x)?.value.trim()).length;
      const angaben = n(['education', 'techniques', 'languages', 'regions', 'height', 'available']);
      info('angaben', angaben ? `${angaben} ausgefüllt` : '');
      const kontakt = n(['public_email', 'vimeo']) + form!.querySelectorAll('input[name="open_for"]:checked').length;
      info('kontakt', kontakt ? `${kontakt} ausgefüllt` : '');
      info('englisch', n(['profession_en', 'pitch_en', 'bio_en']) ? 'ausgefüllt' : '');
    }
    zusammenfassen();
    form.addEventListener('change', zusammenfassen);

    photoInput?.addEventListener('change', async () => {
      const file = photoInput.files?.[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) return showMessage(msg, 'Das Foto ist größer als 5 MB.');
      const ext = file.type === 'image/png' ? 'png' : file.type === 'image/webp' ? 'webp' : 'jpg';
      // neuer Dateiname bei jedem Upload, damit Browser- und Build-Caches das neue Bild holen
      const path = `${ctx.user.id}/portrait-${Date.now()}.${ext}`;
      showPhoto(URL.createObjectURL(file));
      const { error } = await ctx.sb.storage.from(BUCKET).upload(path, file, { contentType: file.type, upsert: false });
      if (error) return showMessage(msg, errorText(error));
      // ein älteres, noch nicht freigegebenes Foto wird ersetzt
      const { error: e2 } = await ctx.sb.from('profiles').update({ photo_pending: path }).eq('id', ctx.user.id);
      if (e2) return showMessage(msg, errorText(e2));
      if (pendingPath) await ctx.sb.storage.from(BUCKET).remove([pendingPath]);
      pendingPath = path;
      photoInput.value = '';
      showPhoto();
      showMessage(msg, 'Foto hochgeladen. Auf der Website erscheint es, sobald Presse oder Vorstand es freigegeben haben.', 'ok');
    });

    removeBtn?.addEventListener('click', async () => {
      const pending = !!pendingPath;
      const path = pendingPath ?? photoPath;
      if (!path || !confirm(pending ? 'Das neue Foto verwerfen?' : 'Foto wirklich entfernen? Es verschwindet auch von der Website.')) return;
      const { error } = await ctx.sb.from('profiles').update(pending ? { photo_pending: null } : { photo_path: null }).eq('id', ctx.user.id);
      if (error) return showMessage(msg, errorText(error));
      await ctx.sb.storage.from(BUCKET).remove([path]);
      if (pending) pendingPath = null;
      else photoPath = null;
      showPhoto();
      showMessage(msg, pending ? 'Neues Foto verworfen.' : 'Foto entfernt.', 'ok');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const fd = new FormData(form);
      const clean = (v: FormDataEntryValue | null) => String(v ?? '').trim() || null;
      const update = {
        display_name: String(fd.get('display_name') ?? '').trim(),
        pronouns: clean(fd.get('pronouns')),
        bio: clean(fd.get('bio')),
        bio_en: clean(fd.get('bio_en')),
        website: clean(fd.get('website')),
        instagram: clean(fd.get('instagram'))?.replace(/^@/, '') ?? null,
        vimeo: clean(fd.get('vimeo')),
        phone: clean(fd.get('phone')),
        slug: clean(fd.get('slug')),
        photo_credit: clean(fd.get('photo_credit')),
        tags: String(fd.get('tags') ?? '').split(',').map((t) => t.trim()).filter(Boolean).slice(0, 6),
        ags: fd.getAll('ags').map(String),
        ...Object.fromEntries(flags.map((f) => [f, fd.has(f)])),
        ...(hatNeu
          ? {
              ...Object.fromEntries(neueTexte.map((f) => [f, clean(fd.get(f))])),
              open_for: fd.getAll('open_for').map(String),
              gallery_layout: String(fd.get('gallery_layout') ?? 'filmstreifen'),
              works: arbeiten?.wert() ?? [],
              gallery: galerie?.wert() ?? [],
            }
          : {}),
      };
      const { data, error } = await ctx.sb
        .from('profiles')
        .update(update)
        .eq('id', ctx.user.id)
        .select(hatNeu ? 'verified, public_listing, slug, gallery' : 'verified, public_listing, slug')
        .single<{ verified: boolean; public_listing: boolean; slug: string | null; gallery?: GalerieEintrag[] }>();
      if (error) {
        return showMessage(msg, /duplicate|unique/i.test(error.message) ? 'Diese Adresse ist schon vergeben. Bitte wähle eine andere.' : errorText(error));
      }
      document.querySelectorAll<HTMLElement>('[data-intern-name]').forEach((el) => (el.textContent = update.display_name));
      verified = data.verified;
      if (data.gallery) galerie?.setzen(data.gallery);
      showStatus(data.verified, data.public_listing, data.slug);
      zusammenfassen();
      showMessage(msg, 'Gespeichert.', 'ok');
    });
  }
</script>

<style>
  .opt { color: var(--ink-muted); font-weight: 500; letter-spacing: 0.1em; margin-left: 6px; }
  :global(.i-fieldset) { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; }
  :global(.i-fieldset legend) { margin-bottom: 10px; }
  .ags { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px 20px; }
  .public { padding-top: 22px; border-top: 1px solid var(--rule); }
  .public__fields { display: grid; gap: 18px; margin-top: 8px; }
  .public__fields[hidden] { display: none; }
  .slug { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted); }
  .slug input { flex: 1; }
  .status { margin: 0; padding: 10px 14px; font-size: 14px; border-left: 4px solid var(--cyan-2); background: var(--cyan-tint); color: var(--purple); }
  .status[data-kind='wait'] { border-left-color: var(--magenta); background: var(--magenta-tint); }
  .photo { display: grid; grid-template-columns: 160px 1fr; gap: 20px; align-items: start; }
  .photo__box { display: grid; gap: 8px; align-content: start; }
