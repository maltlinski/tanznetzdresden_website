---
/**
 * News-Editor der Redaktion (Presse, Vorstand, Admin).
 * Kopfleiste (Status, Speicherstand, Vorschau, Veröffentlichen) · links Rubrik, Titel, Teaser, Titelbild und
 * Blöcke · rechts die Live-Vorschau. „Veröffentlichen“ öffnet ein Seitenpanel mit Checkliste, Zeitpunkt
 * (sofort oder geplant), Newsletter, Story-Bild und der Ansicht in der Chronik.
 *
 * Entwürfe speichert der Editor selbst (ab einem Titel); Änderungen an Beiträgen, die online sind, gehen erst
 * mit „Änderungen veröffentlichen“ raus. Ungespeichertes sichert der Browser zusätzlich auf dem Gerät.
 * Der Text besteht aus Blöcken (src/scripts/intern/news/abschnitte.ts), gespeichert wird Markdown
 * (src/lib/news-bloecke.ts). Fotos kommen aus der Mediathek (src/scripts/intern/news/medien.ts).
 */
import Redaktion from '../../../../layouts/Redaktion.astro';
import { href } from '../../../../lib/url';
import { newsCategories } from '../../../../content.config';
import { url, type RouteKey } from '../../../../lib/i18n';
import { getProfiles } from '../../../../lib/profiles';
import { getTermine } from '../../../../lib/content';
import { getNews } from '../../../../lib/news';
import { newsBausteine } from '../../../../settings/news-bausteine';
import '../../../../styles/news-editor.css';
import '../../../../styles/mediathek.css';

// Ziele für „Link einfügen“ (Adressen ohne Basis-Pfad, den ergänzt die Website selbst)
const basis = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ohneBasis = (u: string) => `/${u.slice(basis.length)}`;
const seiten: [RouteKey, string][] = [
  ['termine', 'Tanzkalender'], ['news', 'News'], ['profitraining', 'Profitraining KEEP UP'], ['netzwerk', 'Netzwerk'],
  ['kooperationen', 'Kooperationen'], ['verein', 'Über uns'], ['mitglied', 'Mitglied werden'], ['kontakt', 'Kontakt'],
  ['spenden', 'Spenden'], ['transparenz', 'Transparenz'],
];
const linkziele = [
  ...seiten.map(([k, titel]) => ({ art: 'Seite', titel, href: ohneBasis(url('de', k)) })),
  ...(await getProfiles()).map((p) => ({ art: 'Person', titel: p.name, href: ohneBasis(url('de', 'netzwerk', `${p.id}/`)) })),
  ...(await getTermine()).reverse().map((t) => ({ art: 'Termin', titel: `${t.data.title} · ${t.data.start.slice(0, 10).split('-').reverse().join('.')}`, href: ohneBasis(url('de', 'termine', `${t.id}/`)) })),
  ...(await getNews('de')).map((n) => ({ art: 'News', titel: n.title, href: ohneBasis(url('de', 'news', `${n.id}/`)) })),
];
const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');

// Kopfbereich: kleine Skizzen der Varianten (Entwurf Redaktion v2); „bild“ = dort steht das Titelbild
type Teil = { l: string; t: string; w: string; h: string; bg?: string; bild?: boolean };
const SKIZZEN: Record<'vollbild' | 'hochkant' | 'split' | 'typo', Teil[]> = {
  vollbild: [{ l: '0', t: '0', w: '100%', h: '100%', bild: true }, { l: '0', t: '64%', w: '100%', h: '36%', bg: 'color-mix(in srgb, var(--purple) 90%, transparent)' }, { l: '8%', t: '75%', w: '52%', h: '9%', bg: '#fff' }, { l: '0', t: '60%', w: '40%', h: '4%', bg: 'var(--cyan)' }],
  hochkant: [{ l: '0', t: '0', w: '100%', h: '100%', bg: 'var(--purple)' }, { l: '60%', t: '0', w: '30%', h: '100%', bild: true }, { l: '8%', t: '52%', w: '42%', h: '10%', bg: '#fff' }, { l: '8%', t: '68%', w: '30%', h: '6%', bg: 'rgba(255,255,255,0.6)' }],
  split: [{ l: '0', t: '0', w: '100%', h: '100%', bg: 'var(--purple)' }, { l: '46%', t: '0', w: '54%', h: '100%', bild: true }, { l: '8%', t: '52%', w: '32%', h: '10%', bg: '#fff' }, { l: '8%', t: '68%', w: '24%', h: '6%', bg: 'rgba(255,255,255,0.6)' }],
  typo: [{ l: '0', t: '0', w: '100%', h: '58%', bg: 'var(--purple)' }, { l: '8%', t: '16%', w: '50%', h: '10%', bg: '#fff' }, { l: '8%', t: '44%', w: '84%', h: '52%', bild: true }],
};
const KOEPFE = [['auto', 'Automatisch'], ['vollbild', 'Vollbild'], ['hochkant', 'Hochkant'], ['split', 'Split'], ['typo', 'Typo']] as const;
const FLAECHEN = [['purple', 'Lila', 'var(--purple)'], ['cyan', 'Cyan', 'var(--cyan)'], ['tint', 'Hell', 'var(--tint)']] as const;
---
<Redaktion title="Beitrag" current="beitraege" voll>
  <div class="ne-top">
    <a class="ne-top__zurueck" href={href('intern/news/')}>← Beiträge</a>
    <span class="ne-top__trenner" aria-hidden="true"></span>
    <span class="badge ne-st" data-status-badge data-status="entwurf">Entwurf</span>
    <span class="ne-top__stand" data-sicher aria-live="polite"></span>
    <div class="ne-top__rechts" data-editor-only hidden>
      <button type="button" class="ne-top__knopf" data-vp-schalter>Vorschau</button>
      <button type="button" class="btn btn--primary btn--marker btn--sm" data-pub-oeffnen>Veröffentlichen</button>
    </div>
  </div>

  <div class="i-card ne-kein" data-no-access hidden>
    <p>News schreiben dürfen Mitglieder mit der Rolle Presse, Vorstand oder Admin.</p>
  </div>

  <div class="ne-layout" data-layout>
    <div class="ne-haupt">
      <div class="ne-spalte">
        <div class="ne-wieder" role="alert" data-wieder hidden>
          <p data-wieder-text></p>
          <button type="button" class="btn btn--primary btn--sm" data-wieder-ja>Wiederherstellen</button>
          <button type="button" class="md-leise" data-wieder-nein>Verwerfen</button>
        </div>

        <div class="ne-vorlagen" data-vorlagen hidden>
          <span class="ne-label">Mit einer Vorlage starten</span>
          <div class="ne-vorlagen__liste" data-vorlagen-liste></div>
        </div>

        <form class="ne" data-form novalidate hidden>
          <fieldset class="ne-feld">
            <legend class="ne-label">Rubrik</legend>
            <div class="ne-chips">
              {newsCategories.map((c, i) => (
                <label class="ne-chip"><input type="radio" name="category" value={c} checked={i === 0} />{c}</label>
              ))}
            </div>
          </fieldset>

          <div class="i-field ne-kurz" data-nur="Ausschreibung">
            <label for="ne-deadline">Bewerbungsfrist</label>
            <input id="ne-deadline" name="deadline" type="date" />
            <span class="i-hint">Wird auf der Website als Countdown angezeigt.</span>
          </div>

          <fieldset class="ne-feld ne-zitat" data-nur="Stimme">
            <legend class="ne-label">Zitat für die Übersicht <span class="ne-opt">optional</span></legend>
            <div class="i-field">
              <label for="ne-qtext" class="visually-hidden">Zitat</label>
              <textarea id="ne-qtext" name="quote_text" rows="2" maxlength="400" placeholder="Ein Satz, der neugierig macht."></textarea>
            </div>
            <div class="ne-row">
              <div class="i-field"><label for="ne-qwho">Wer sagt das?</label><input id="ne-qwho" name="quote_who" maxlength="120" /></div>
              <div class="i-field"><label for="ne-qrole">Funktion</label><input id="ne-qrole" name="quote_role" maxlength="160" placeholder="z. B. Projektleitung KEEP UP" /></div>
            </div>
          </fieldset>

          <div class="ne-feld">
            <label class="ne-label" for="ne-title">Titel</label>
            <textarea id="ne-title" class="ne-titel" name="title" rows="1" maxlength="160" placeholder="Worum geht es?"></textarea>
          </div>

          <div class="ne-feld">
            <div class="ne-feld__kopf">
              <label class="ne-label" for="ne-teaser">Teaser</label>
              <span class="ne-zahl" data-count="teaser">0 / 220</span>
            </div>
            <textarea id="ne-teaser" class="ne-teaser" name="teaser" rows="2" maxlength="400" placeholder="Zwei, drei Sätze: Was, wann, wo, mit wem?"></textarea>
            <span class="i-hint">Erscheint in der Chronik, auf der Startseite und als Vorschau beim Teilen.</span>
          </div>

          <div class="ne-feld" data-schritt="titelfoto">
            <span class="ne-label" id="ne-cover-l">Titelbild</span>
            <div class="ne-drop" data-cover-leer>
              <span class="ne-drop__m" aria-hidden="true"></span>
              <strong>Bild hierher ziehen</strong>
              <span class="i-hint">JPG, PNG oder WebP. Große Fotos werden beim Hochladen verkleinert.</span>
              <div class="ne-drop__knoepfe">
                <button type="button" class="btn btn--primary btn--sm" data-cover-mediathek>Aus Mediathek</button>
                <label class="md-knopf">Vom Computer<input type="file" accept="image/jpeg,image/png,image/webp" data-photo-input aria-labelledby="ne-cover-l" /></label>
              </div>
            </div>
            <div class="ne-cover" data-cover-voll hidden>
              <div data-cover-fokus></div>
              <span class="i-hint">Ins Bild klicken setzt den Fokuspunkt. Alle Zuschnitte richten sich danach.</span>
              <div data-cover-crops></div>
              <div class="ne-row">
                <div class="i-field">
                  <label for="ne-alt">Bildbeschreibung (optional)</label>
                  <input id="ne-alt" name="image_alt" maxlength="300" placeholder="Was ist zu sehen?" />
                  <span class="i-hint">Hilft Menschen, die das Foto nicht sehen können.</span>
                </div>
                <div class="i-field">
                  <label for="ne-credit">Fotonachweis</label>
                  <input id="ne-credit" name="image_credit" maxlength="120" placeholder="Vorname Nachname" />
                  <span class="i-hint">Gilt überall, wo das Bild verwendet wird.</span>
                </div>
              </div>
              <div class="fb-knoepfe">
                <button type="button" class="md-knopf" data-cover-mediathek>Anderes Bild</button>
                <label class="md-knopf">Hochladen<input type="file" accept="image/jpeg,image/png,image/webp" data-photo-input aria-label="Anderes Titelbild hochladen" /></label>
                <button type="button" class="md-leise" data-photo-remove>Entfernen</button>
              </div>
            </div>
            <p class="i-msg" data-photo-msg hidden></p>
          </div>

          <div class="ne-feld" data-kopf-feld>
            <div class="ne-feld__kopf">
              <span class="ne-label" id="ne-kopf-l">Kopfbereich</span>
              <span class="ne-feld__tipp" data-kopf-info>Ohne Titelbild · Netz</span>
            </div>
            <div class="ne-kopf" data-kopf-mit-bild hidden>
              <div class="ne-koepfe" role="radiogroup" aria-labelledby="ne-kopf-l">
                {KOEPFE.map(([wert, name], i) => (
                  <label class="ne-kopf-opt">
                    <input type="radio" name="hero" value={wert} checked={i === 0} />
                    <span class="ne-skizze" aria-hidden="true">
                      {(wert === 'auto' ? (['vollbild', 'hochkant'] as const) : [wert]).map((m) => (
                        <span class="ne-skizze__satz" data-skizze={m}>
                          {SKIZZEN[m].map((t) => (
                            <span class="ne-skizze__teil" style={`left:${t.l};top:${t.t};width:${t.w};height:${t.h}${t.bg ? `;background:${t.bg}` : ''}`}>
                              {t.bild && <img alt="" data-kopf-bild />}
                            </span>
                          ))}
                        </span>
                      ))}
                    </span>
                    <span class="ne-kopf-opt__name" data-kopf-name={wert}>{name}</span>
                  </label>
                ))}
              </div>
              <span class="i-hint">Automatisch: Querformat wird Vollbild, Hochkant-Fotos bekommen den Hochkant-Kopf.</span>
            </div>
            <div class="ne-kopf ne-kopf--netz" data-kopf-ohne-bild>
              <span class="i-hint">Ohne Titelbild zeigt der Beitrag das Netz auf einer Farbfläche. Ein Magenta-Knoten trägt die wichtigste Angabe.</span>
              <div class="ne-flaechen" role="radiogroup" aria-label="Farbfläche">
                {FLAECHEN.map(([wert, name, farbe], i) => (
                  <label class="ne-kopf-opt ne-flaeche">
                    <input type="radio" name="hero_theme" value={wert} checked={i === 0} />
                    <span class="ne-flaeche__farbe" style={`background:${farbe}`} aria-hidden="true"></span>
                    <span class="ne-kopf-opt__name">{name}</span>
                  </label>
                ))}
              </div>
              <p class="i-hint ne-kopf__frist" data-nur="Ausschreibung">Bei Ausschreibungen zeigt der Knoten automatisch den Countdown bis zur Frist.</p>
              <div class="ne-row" data-kein="Ausschreibung">
                <div class="i-field"><label for="ne-node-k">Knoten · kleine Zeile</label><input id="ne-node-k" name="node_kicker" maxlength="60" placeholder="z. B. Ausgabe" /></div>
                <div class="i-field"><label for="ne-node-v">Knoten · Angabe</label><input id="ne-node-v" name="node_value" maxlength="80" placeholder="z. B. #6 · 26. November" /></div>
              </div>
            </div>
          </div>

          <div class="ne-feld" data-fakten>
            <div class="ne-feld__kopf">
              <span class="ne-label" id="ne-facts-l">Eckdaten</span>
              <span class="ne-feld__tipp">Infokasten oben im Beitrag</span>
            </div>
            <div class="ne-facts ne-facts--haupt" data-facts="facts" role="group" aria-labelledby="ne-facts-l"></div>
            <button type="button" class="ne-plus" data-add-fact="facts">+ Eckdatum</button>
          </div>

          <div class="ne-feld">
            <div class="ne-feld__kopf">
              <span class="ne-label" id="ne-body-l">Inhalt</span>
              <span class="ne-feld__tipp">Klick in der Vorschau springt zum Block</span>
            </div>
            <p class="i-msg" data-abschnitt-hinweis hidden></p>
            <div class="ne-abschnitte" data-abschnitte aria-labelledby="ne-body-l"></div>
          </div>

          <details class="ne-mehr ne-en" data-en>
            <summary>Englische Fassung <span class="ne-opt" data-en-state></span></summary>
            <p class="i-hint">Fehlt ein Feld, zeigt die englische Seite den deutschen Text. Die Blöcke übersetzt du direkt dort („Englisch“ aufklappen).</p>
            <div class="i-field"><label for="ne-title-en">Title</label><input id="ne-title-en" name="title_en" maxlength="160" lang="en" /></div>
            <div class="i-field"><label for="ne-teaser-en">Teaser (English)</label><textarea id="ne-teaser-en" name="teaser_en" maxlength="400" rows="2" lang="en"></textarea></div>
            <div class="i-field" data-nur-bild><label for="ne-alt-en">Image description</label><input id="ne-alt-en" name="image_alt_en" maxlength="300" lang="en" /></div>
            <div class="ne-row" data-kein="Ausschreibung" data-nur-netz>
              <div class="i-field"><label for="ne-node-k-en">Node · small line</label><input id="ne-node-k-en" name="node_kicker_en" maxlength="60" lang="en" /></div>
              <div class="i-field"><label for="ne-node-v-en">Node · value</label><input id="ne-node-v-en" name="node_value_en" maxlength="80" lang="en" /></div>
            </div>
            <div data-nur="Stimme">
              <div class="i-field"><label for="ne-qtext-en">Quote</label><textarea id="ne-qtext-en" name="quote_text_en" rows="2" maxlength="400" lang="en"></textarea></div>
              <div class="i-field"><label for="ne-qrole-en">Role</label><input id="ne-qrole-en" name="quote_role_en" maxlength="160" lang="en" /></div>
            </div>
            <div class="ne-facts-en">
              <span class="ne-label">Key facts</span>
              <div class="ne-facts" data-facts="facts_en" data-mirror></div>
            </div>
          </details>

          <details class="ne-mehr" data-weitere>
            <summary>Weitere Angaben</summary>
            <div class="ne-row">
              <div class="i-field">
                <label for="ne-author">Text von</label>
                <input id="ne-author" name="author" maxlength="120" placeholder="Name oder AG" />
              </div>
              <div class="i-field">
                <label for="ne-date">Datum</label>
                <input id="ne-date" name="date" type="date" required />
                <span class="i-hint">Planen geht beim Veröffentlichen.</span>
              </div>
            </div>
            <label class="i-check">
              <input type="checkbox" name="featured" />
              <span><strong>Titelthema:</strong> groß oben auf der News-Seite und auf der Startseite.</span>
            </label>
            <div class="i-field">
              <label for="ne-slug">Adresse</label>
              <input id="ne-slug" name="slug" maxlength="80" pattern="[a-z0-9]+(-[a-z0-9]+)*" />
              <span class="i-hint">Wird aus dem Titel gebildet. Nach dem Veröffentlichen besser nicht mehr ändern.</span>
            </div>
            <div class="ne-weitere__knoepfe">
              <a class="md-leise" data-view-live hidden target="_blank" rel="noopener">Auf der Website ansehen ↗</a>
              <button type="button" class="md-leise" data-vorschau-link hidden>Vorschau-Link kopieren</button>
              <button type="button" class="md-leise ne-danger" data-delete hidden>Beitrag löschen</button>
            </div>
          </details>
        </form>
      </div>
    </div>

    <!-- Live-Vorschau neben dem Editor (große Bildschirme) -->
    <aside class="ne-vp" data-vp data-geraet="computer" aria-label="Live-Vorschau" hidden>
      <div class="ne-vp__bar">
        <span class="tag">Live-Vorschau</span>
        <div class="ne-vp__gruppen">
          <div class="ne-vp__gruppe" role="group" aria-label="Bildschirm">
            <button type="button" data-geraet="computer" aria-pressed="true">Desktop</button>
            <button type="button" data-geraet="handy" aria-pressed="false">Mobil</button>
          </div>
          <div class="ne-vp__gruppe" role="group" aria-label="Sprache">
            <button type="button" data-sprache="de" aria-pressed="true">DE</button>
            <button type="button" data-sprache="en" aria-pressed="false">EN</button>
          </div>
          <button type="button" class="ne-vp__gross" data-preview-open title="Vorschau groß zeigen">Groß</button>
        </div>
      </div>
      <div class="ne-vp__buehne" data-geraet="computer">
        <iframe title="Vorschau des Beitrags (daneben)"></iframe>
      </div>
      <p class="ne-vp__fuss" data-vp-adresse></p>
    </aside>
  </div>

  <!-- Vorschau groß -->
  <dialog class="nv" data-vorschau data-geraet="computer" aria-labelledby="nv-h">
    <div class="nv__bar">
      <strong id="nv-h" class="nv__h">Vorschau</strong>
      <div class="nv__gruppe" role="group" aria-label="Bildschirm">
        <button type="button" data-geraet="computer" aria-pressed="true">Desktop</button>
        <button type="button" data-geraet="handy" aria-pressed="false">Mobil</button>
      </div>
      <div class="nv__gruppe" role="group" aria-label="Sprache">
        <button type="button" data-sprache="de" aria-pressed="true">Deutsch</button>
        <button type="button" data-sprache="en" aria-pressed="false">Englisch</button>
      </div>
      <button type="button" class="nv__zu" data-vorschau-zu>Schließen</button>
    </div>
    <div class="nv__buehne" data-geraet="computer">
      <iframe title="Vorschau des Beitrags" data-vorschau-frame></iframe>
    </div>
  </dialog>

  <!-- Veröffentlichen: Seitenpanel -->
  <dialog class="ne-pub" data-pub aria-labelledby="ne-pub-h">
    <div class="ne-pub__kopf">
      <div class="ne-pub__titel">
        <span class="tag">Veröffentlichen</span>
        <h2 id="ne-pub-h" data-pub-titel></h2>
      </div>
      <button type="button" class="md-leise" data-pub-zu>Schließen</button>
    </div>

    <section class="ne-pub__teil" aria-labelledby="ne-check-h">
      <div class="ne-pub__zeile">
        <h3 class="ne-pub__h" id="ne-check-h">Checkliste</h3>
        <span class="ne-pub__summe" data-check-summe></span>
      </div>
      <ul class="ne-check" data-check-liste></ul>
    </section>

    <section class="ne-pub__teil" aria-labelledby="ne-zeit-h">
      <h3 class="ne-pub__h" id="ne-zeit-h">Zeitpunkt</h3>
      <div class="ne-modus" role="group" aria-labelledby="ne-zeit-h">
        <button type="button" data-modus="sofort" aria-pressed="true">Sofort</button>
        <button type="button" data-modus="planen" aria-pressed="false">Planen</button>
      </div>
      <div class="i-field" data-plan hidden>
        <label for="ne-plan">Erscheint am</label>
        <input id="ne-plan" type="date" data-plan-datum />
        <span class="i-hint">Der Beitrag erscheint an diesem Tag morgens mit dem automatischen Update der Website.</span>
      </div>
    </section>

    <section class="ne-pub__teil" aria-labelledby="ne-aus-h">
      <h3 class="ne-pub__h" id="ne-aus-h">Ausspielen</h3>
      <label class="ne-switch"><input type="checkbox" role="switch" checked disabled /><span class="ne-switch__bahn" aria-hidden="true"></span>Website · News und Chronik</label>
      <label class="ne-switch"><input type="checkbox" role="switch" data-newsletter /><span class="ne-switch__bahn" aria-hidden="true"></span>Für den nächsten Newsletter vormerken</label>
      <label class="ne-switch"><input type="checkbox" role="switch" data-story /><span class="ne-switch__bahn" aria-hidden="true"></span>Instagram-Story als Bild herunterladen</label>
      <p class="i-hint ne-pub__hinweis" data-newsletter-hinweis hidden>Vormerken geht, sobald die Migration 20261016000000_mediathek.sql ausgeführt ist.</p>
    </section>

    <section class="ne-pub__teil" aria-labelledby="ne-chronik-h">
      <h3 class="ne-pub__h" id="ne-chronik-h">So erscheint er in der Chronik</h3>
      <div class="ne-chronik" data-chronik></div>
    </section>

    <div class="ne-pub__fuss">
      <p class="ne-pub__block" data-pub-block hidden>Erst die Pflichtpunkte erledigen, dann geht der Beitrag online.</p>
      <div class="ne-pub__knoepfe">
        <button type="button" class="btn btn--primary btn--marker" data-publish>Jetzt veröffentlichen</button>
        <button type="button" class="md-knopf" data-pub-zu>Weiter bearbeiten</button>
      </div>
      <button type="button" class="md-leise ne-danger" data-offline hidden>Offline nehmen</button>
    </div>
  </dialog>

  <div class="ne-toast" role="status" aria-live="polite" data-msg hidden></div>

  <script type="application/json" data-bausteine set:html={json(newsBausteine)} />
  <script type="application/json" data-linkziele set:html={json(linkziele)} />
</Redaktion>

<script>
  import { initIntern, errorText, internUrl } from '../../../../scripts/intern/session';
  import { slugify, newsPhotoUrl, type MedienRow, type NewsRow } from '../../../../lib/supabase';
  import { neuBauenLassen } from '../../../../scripts/intern/redaktion/api';
  import { abschnittEditor, type Baustein, type EBlock, type Gewaehlt } from '../../../../scripts/intern/news/abschnitte';
  import { drehen } from '../../../../scripts/intern/news/fotos';
  import { fokusFlaeche, medienHochladen, medienWaehlen, zuschnitte } from '../../../../scripts/intern/news/medien';
  import { vorschau, type Sprache, type Sprungziel } from '../../../../scripts/intern/news/vorschau';
  import { linkAuswahl, type Linkziel } from '../../../../scripts/intern/news/links';
  import { vorlagen } from '../../../../scripts/intern/news/vorlagen';
  import { storyBild } from '../../../../scripts/intern/news/story';
  import { h } from '../../../../scripts/intern/news/dom';
  import { abschnitte, hatEnglisch, zuMarkdown, type Block } from '../../../../lib/news-bloecke';
  import { newsBadge } from '../../../../lib/news-format';

  type Fact = { label: string; value: string };
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel);
  const $$ = <T extends Element = HTMLElement>(sel: string) => [...document.querySelectorAll<T>(sel)];
  const lesenJson = <T,>(sel: string, leer: T): T => {
    try {
      return JSON.parse($(sel)?.textContent ?? '') as T;
    } catch {
      return leer;
    }
  };
  const heute = () => new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin' }).format(new Date());
  const morgen = () => {
    const d = new Date(`${heute()}T12:00:00`);
    d.setDate(d.getDate() + 1);
    return d.toISOString().slice(0, 10);
  };
  const datumLang = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
  const datumKurz = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString('de-DE', { day: '2-digit', month: 'short', year: 'numeric' });
  const uhrzeit = () => new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
  const EMOJI = /\p{Extended_Pictographic}/u;

  // Meldungen unten rechts
  const toastEl = $('[data-msg]')!;
  let toastTimer = 0;
  const melden = (text: string, art: 'error' | 'ok' = 'error') => {
    window.clearTimeout(toastTimer);
    toastEl.textContent = text;
    toastEl.dataset.kind = art;
    toastEl.hidden = !text;
    if (text && art === 'ok') toastTimer = window.setTimeout(() => (toastEl.hidden = true), 6000);
  };

  const ctx = await initIntern(true);
  const form = $<HTMLFormElement>('[data-form]');
  const id0 = new URLSearchParams(location.search).get('id');

  if (ctx && form) {
    if (!ctx.isRedaktion) {
      $('[data-no-access]')!.hidden = false;
      $('[data-layout]')!.hidden = true;
    } else {
      form.hidden = false;
      $('[data-editor-only]')!.hidden = false;
      let row: Partial<NewsRow> = {};
      let imagePath: string | null = null;
      let imageFocus: string | null = null;
      let newsletter = false;
      let dirty = false;
      let slugTouched = false;
      const field = <T extends HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(name: string) =>
        form.elements.namedItem(name) as T | null;
      const val = (n: string) => {
        const el = form.elements.namedItem(n);
        if (el instanceof RadioNodeList) return el.value;
        return (el as HTMLInputElement | null)?.value.trim() ?? '';
      };
      const orNull = (v: string) => v || null;

      // ---------- Laden ----------
      if (id0) {
        const { data, error } = await ctx.sb.from('news_posts').select('*').eq('id', id0).maybeSingle<NewsRow>();
        if (error || !data) melden(error ? errorText(error) : 'Diesen Beitrag gibt es nicht (mehr).');
        if (data) row = data;
      }
      const set = (name: string, v: unknown) => {
        const el = form.elements.namedItem(name);
        if (!el) return;
        if (el instanceof RadioNodeList) el.value = v == null ? '' : String(v);
        else if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = !!v;
        else (el as HTMLInputElement).value = v == null ? '' : String(v);
      };

      // ---------- Mediathek-Angaben der Fotos dieses Beitrags ----------
      const medien = new Map<string, Gewaehlt>();
      let medienOk = true;
      {
        const dateien = [...new Set([row.image_path, ...abschnitte(row.body ?? '').bloecke.flatMap((b) => (b.typ === 'bilder' ? b.bilder.map((x) => x.datei) : []))].filter((d): d is string => !!d))];
        const { data, error } = await ctx.sb.from('news_medien').select('*').in('datei', dateien.length ? dateien : ['-']);
        medienOk = !error;
        for (const m of (data ?? []) as MedienRow[]) medien.set(m.datei, { datei: m.datei, alt: m.alt ?? '', alt_en: m.alt_en ?? '', credit: m.credit ?? '', focus: m.focus });
      }
      const newsletterOk = !!row.id ? 'newsletter' in row : medienOk;
      if (!newsletterOk) {
        $<HTMLInputElement>('[data-newsletter]')!.disabled = true;
        $('[data-newsletter-hinweis]')!.hidden = false;
      }

      // ---------- Auf einen Blick ----------
      const factBoxes = { facts: $('[data-facts="facts"]')!, facts_en: $('[data-facts="facts_en"]')! };
      const factRow = (box: HTMLElement, f: Fact, mirror?: Fact) => {
        const div = h('div', { class: 'ne-fact' },
          h('input', { class: 'ne-fact__k', value: f.label, placeholder: mirror?.label || 'Wann', maxLength: 60, 'aria-label': 'Bezeichnung' }),
          h('input', { class: 'ne-fact__v', value: f.value, placeholder: mirror?.value || 'Do · 26. November 2026 · 20:00 Uhr', maxLength: 200, 'aria-label': 'Angabe' }));
        if (!box.hasAttribute('data-mirror')) {
          div.append(h('button', { type: 'button', class: 'ne-fact__weg', text: 'Löschen', onclick: () => { div.remove(); syncMirror(); geaendert(); } }));
        }
        box.append(div);
      };
      const readFacts = (box: HTMLElement): Fact[] =>
        [...box.querySelectorAll('.ne-fact')].map((d) => {
          const [l, v] = d.querySelectorAll('input');
          return { label: l.value.trim(), value: v.value.trim() };
        });
      const syncMirror = () => {
        const de = readFacts(factBoxes.facts);
        const en = readFacts(factBoxes.facts_en);
        factBoxes.facts_en.replaceChildren();
        de.forEach((f, i) => factRow(factBoxes.facts_en, en[i] ?? { label: '', value: '' }, f));
        $('.ne-facts-en')!.hidden = de.length === 0;
      };
      const faktenSetzen = (de: Fact[], en: Fact[] = []) => {
        factBoxes.facts.replaceChildren();
        factBoxes.facts_en.replaceChildren();
        de.forEach((f) => factRow(factBoxes.facts, f));
        de.forEach((f, i) => factRow(factBoxes.facts_en, en[i] ?? { label: '', value: '' }, f));
        $('.ne-facts-en')!.hidden = !de.length;
      };
      $('[data-add-fact="facts"]')!.addEventListener('click', () => {
        factRow(factBoxes.facts, { label: '', value: '' });
        syncMirror();
        factBoxes.facts.querySelector<HTMLInputElement>('.ne-fact:last-child input')?.focus();
      });
      factBoxes.facts.addEventListener('change', syncMirror);

      // ---------- Rubrik: Frist bei Ausschreibung, Zitat bei Stimme ----------
      // sichtbar = Rubrik passt oder es steht schon etwas darin (dann lässt es sich auch leeren)
      const sichtbar = (nur: string) => val('category') === nur || (nur === 'Ausschreibung' ? !!val('deadline') : !!val('quote_text'));
      const rubrik = () => {
        $$('[data-nur]').forEach((el) => (el.hidden = !sichtbar(el.dataset.nur!)));
        $$('[data-kein]').forEach((el) => (el.hidden = val('category') === el.dataset.kein || (el.hasAttribute('data-nur-netz') && !!imagePath)));
        $('[data-nur-bild]')!.hidden = !imagePath;
      };

      /** Formular aus einem gespeicherten Stand füllen (ohne Blöcke) */
      const fuellen = (r: Partial<NewsRow>) => {
        for (const k of ['title', 'teaser', 'image_alt', 'image_credit', 'deadline', 'quote_text', 'quote_who', 'quote_role',
          'date', 'author', 'featured', 'title_en', 'teaser_en', 'image_alt_en', 'quote_text_en', 'quote_role_en', 'slug',
          'node_kicker', 'node_value', 'node_kicker_en', 'node_value_en']) {
          set(k, (r as Record<string, unknown>)[k]);
        }
        set('category', r.category ?? 'Netzwerk');
        set('hero', r.hero ?? 'auto');
        set('hero_theme', r.hero_theme ?? 'purple');
        if (!r.date) set('date', heute());
        if (!r.author) set('author', ctx.profile?.display_name ?? '');
        slugTouched = !!r.slug;
        imagePath = r.image_path ?? null;
        imageFocus = r.image_focus ?? null;
        newsletter = !!r.newsletter;
        // Angaben der Mediathek gelten überall
        const m = imagePath ? medien.get(imagePath) : undefined;
        if (m?.alt) set('image_alt', m.alt);
        if (m?.alt_en) set('image_alt_en', m.alt_en);
        if (m?.credit) set('image_credit', m.credit);
        if (m?.focus) imageFocus = m.focus;
        faktenSetzen(r.facts ?? [], r.facts_en ?? []);
        if (r.title_en || r.body_en) $<HTMLDetailsElement>('[data-en]')!.open = true;
        rubrik();
      };
      fuellen(row);

      // ---------- Titel, Teaser, Adresse ----------
      const titel = field<HTMLTextAreaElement>('title')!;
      const teaser = field<HTMLTextAreaElement>('teaser')!;
      const wachsen = (ta: HTMLTextAreaElement) => {
        ta.style.height = 'auto';
        ta.style.height = `${ta.scrollHeight + 2}px`;
      };
      titel.addEventListener('keydown', (e) => e.key === 'Enter' && e.preventDefault());
      titel.addEventListener('input', () => {
        if (titel.value.includes('\n')) titel.value = titel.value.replace(/\s*\n\s*/g, ' ');
        wachsen(titel);
      });
      teaser.addEventListener('input', () => wachsen(teaser));
      requestAnimationFrame(() => [titel, teaser].forEach(wachsen));
      const zaehler = $('[data-count="teaser"]')!;
      const count = () => {
        zaehler.textContent = `${teaser.value.length} / 220`;
        zaehler.classList.toggle('is-zu-lang', teaser.value.length > 220);
      };
      teaser.addEventListener('input', count);
      count();
      const slug = field<HTMLInputElement>('slug')!;
      const adresse = () => `${location.host}${base}news/${slug.value || '…'}/`;
      const showSlug = () => ($('[data-vp-adresse]')!.textContent = adresse());
      titel.addEventListener('input', () => {
        if (!slugTouched) slug.value = slugify(titel.value).slice(0, 80).replace(/-+$/, '');
        showSlug();
      });
      slug.addEventListener('input', () => {
        slugTouched = true;
        slug.value = slugify(slug.value);
        showSlug();
      });
      showSlug();

      // ---------- Mediathek ----------
      const mediathek = async (mehrere: boolean): Promise<Gewaehlt[]> => {
        const l = await medienWaehlen(ctx.sb, { mehrere, slug: () => slug.value });
        return l.map((m) => {
          const g = { datei: m.datei, alt: m.alt, alt_en: m.alt_en, credit: m.credit, focus: m.focus };
          medien.set(m.datei, g);
          return g;
        });
      };
      const hochladen = (f: File) => medienHochladen(ctx.sb, f, slug.value);

      // ---------- Text in Blöcken ----------
      const start = abschnitte(row.body ?? '', row.body_en);
      if (!start.passend) {
        const hinweis = $('[data-abschnitt-hinweis]')!;
        hinweis.textContent = 'Der englische Text dieses Beitrags passt nicht zu den Blöcken. Er steht jetzt komplett beim ersten Absatz unter „Englisch“. Bitte dort aufteilen.';
        hinweis.hidden = false;
      }
      const editor = abschnittEditor($('[data-abschnitte]')!, {
        start: start.bloecke,
        hochladen,
        drehen: (d) => drehen(ctx.sb, d, slug.value),
        linkWaehlen: linkAuswahl(lesenJson<Linkziel[]>('[data-linkziele]', [])),
        mediathek,
        bausteine: lesenJson<Baustein[]>('[data-bausteine]', []),
        geaendert: () => geaendert(),
        aktiv: (i) => vp.zeigen(i),
        fehler: (t) => melden(t),
      });
      if (medien.size) editor.angabenSetzen(medien);

      // ---------- Titelbild ----------
      const leerEl = $('[data-cover-leer]')!;
      const vollEl = $('[data-cover-voll]')!;
      const photoMsg = $('[data-photo-msg]')!;
      const zeigeFotoMeldung = (t: string) => {
        photoMsg.textContent = t;
        photoMsg.hidden = !t;
      };
      // Kopfbereich: Varianten mit Titelbild oder Farbfläche und Knoten ohne
      const kopfInfo = $('[data-kopf-info]')!;
      const KOPF_NAME: Record<string, string> = { vollbild: 'Vollbild', hochkant: 'Hochkant', split: 'Split', typo: 'Typo' };
      let hochformat = false;
      const kopfZeigen = () => {
        const src = newsPhotoUrl(imagePath);
        $('[data-kopf-mit-bild]')!.hidden = !src;
        $('[data-kopf-ohne-bild]')!.hidden = !!src;
        const auto = hochformat ? 'hochkant' : 'vollbild';
        $$('[data-skizze]').forEach((el) => (el.hidden = !!el.closest('.ne-kopf-opt')?.querySelector('input[value="auto"]') && el.dataset.skizze !== auto));
        $('[data-kopf-name="auto"]')!.textContent = `Auto · ${KOPF_NAME[auto]}`;
        const gewaehlt = val('hero') || 'auto';
        const zeigt = gewaehlt === 'auto' || (gewaehlt === 'vollbild' && hochformat) ? auto : gewaehlt;
        kopfInfo.textContent = src ? `${hochformat ? 'Hochkant-Foto' : 'Querformat'} · zeigt ${KOPF_NAME[zeigt]}` : 'Ohne Titelbild · Netz';
      };
      const kopfBild = (src: string | null) => {
        $$<HTMLImageElement>('[data-kopf-bild]').forEach((img) => {
          if (src) img.src = src;
          img.style.objectPosition = imageFocus ?? '';
        });
        if (!src) return kopfZeigen();
        const probe = new Image();
        probe.onload = () => {
          hochformat = probe.naturalHeight > probe.naturalWidth;
          kopfZeigen();
        };
        probe.src = src;
        kopfZeigen();
      };
      const showPhoto = () => {
        const src = newsPhotoUrl(imagePath);
        leerEl.hidden = !!src;
        vollEl.hidden = !src;
        rubrik();
        kopfBild(src);
        if (!src) return;
        let crops = zuschnitte(src, imageFocus);
        $('[data-cover-crops]')!.replaceChildren(crops);
        $('[data-cover-fokus]')!.replaceChildren(fokusFlaeche(src, imageFocus, (f) => {
          imageFocus = f;
          const neu = zuschnitte(src, f);
          crops.replaceWith(neu);
          crops = neu;
          $$<HTMLImageElement>('[data-kopf-bild]').forEach((img) => (img.style.objectPosition = f));
          geaendert();
        }));
      };
      const titelbildSetzen = (datei: string, m?: Gewaehlt) => {
        imagePath = datei;
        imageFocus = m?.focus ?? null;
        if (m?.alt) set('image_alt', m.alt);
        if (m?.alt_en) set('image_alt_en', m.alt_en);
        if (m?.credit) set('image_credit', m.credit);
        showPhoto();
        geaendert();
      };
      showPhoto();
      const coverHoch = async (file: File) => {
        zeigeFotoMeldung('');
        leerEl.classList.add('is-laedt');
        try {
          titelbildSetzen(await hochladen(file));
          set('image_alt', '');
        } catch (err) {
          zeigeFotoMeldung((err as Error).message?.startsWith('Bitte') ? (err as Error).message : errorText(err));
        } finally {
          leerEl.classList.remove('is-laedt');
        }
      };
      $$<HTMLInputElement>('[data-photo-input]').forEach((input) =>
        input.addEventListener('change', () => {
          const file = input.files?.[0];
          input.value = '';
          if (file) void coverHoch(file);
        }),
      );
      $$('[data-cover-mediathek]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [m] = await mediathek(false);
          if (m) titelbildSetzen(m.datei, m);
        }),
      );
      const coverFeld = $('[data-schritt="titelfoto"]')!;
      coverFeld.addEventListener('dragover', (e) => {
        if (!e.dataTransfer?.types.includes('Files')) return;
        e.preventDefault();
        coverFeld.classList.add('is-drop');
      });
      coverFeld.addEventListener('dragleave', (e) => !coverFeld.contains(e.relatedTarget as Node) && coverFeld.classList.remove('is-drop'));
      coverFeld.addEventListener('drop', (e) => {
        e.preventDefault();
        coverFeld.classList.remove('is-drop');
        const f = [...(e.dataTransfer?.files ?? [])].find((x) => x.type.startsWith('image/'));
        if (f) void coverHoch(f);
      });
      $('[data-photo-remove]')!.addEventListener('click', () => {
        imagePath = null;
        imageFocus = null;
        showPhoto();
        geaendert();
      });

      // ---------- Daten zum Speichern ----------
      /** Kopfbereich und Knoten (Migration 20261029000000) */
      const kopf = () => ({
        hero: (val('hero') || 'auto') as NonNullable<NewsRow['hero']>,
        hero_theme: (val('hero_theme') || 'purple') as NonNullable<NewsRow['hero_theme']>,
        node_kicker: orNull(val('node_kicker')),
        node_value: orNull(val('node_value')),
        node_kicker_en: orNull(val('node_kicker_en')),
        node_value_en: orNull(val('node_value_en')),
      });
      const kopfOk = () => {
        const k = kopf();
        return 'hero' in row || k.hero !== 'auto' || k.hero_theme !== 'purple' || !!(k.node_kicker || k.node_value || k.node_kicker_en || k.node_value_en);
      };
      const datumBeimVeroeffentlichen = { wert: '' };
      const daten = (status: 'entwurf' | 'veroeffentlicht') => {
        const bloecke = editor.bloecke();
        const de = readFacts(factBoxes.facts).filter((f) => f.label || f.value);
        const en = readFacts(factBoxes.facts_en);
        const frist = sichtbar('Ausschreibung');
        const zitat = sichtbar('Stimme');
        return {
          slug: slug.value,
          status,
          category: val('category'),
          date: datumBeimVeroeffentlichen.wert || val('date') || heute(),
          author: val('author'),
          featured: field<HTMLInputElement>('featured')!.checked,
          title: val('title'),
          teaser: val('teaser'),
          body: zuMarkdown(bloecke, 'de'),
          facts: de,
          facts_en: en.some((f) => f.label || f.value) ? en.slice(0, de.length) : [],
          // Frist nur bei Ausschreibungen, Zitat nur bei Stimmen (oder wenn schon etwas darin steht)
          deadline: frist ? orNull(val('deadline')) : null,
          image_path: imagePath,
          image_alt: imagePath ? orNull(val('image_alt')) : null,
          image_credit: imagePath ? orNull(val('image_credit')) : null,
          // erst ab Migration 20261015000000 vorhanden: ohne sie nur mitschicken, wenn ein Ausschnitt gewählt ist
          ...(imageFocus || 'image_focus' in row ? { image_focus: imagePath ? imageFocus : null } : {}),
          // erst ab Migration 20261016000000
          ...(newsletterOk ? { newsletter } : {}),
          // erst ab Migration 20261029000000: ohne sie nur mitschicken, wenn etwas gewählt ist
          ...(kopfOk() ? kopf() : {}),
          image_alt_en: imagePath ? orNull(val('image_alt_en')) : null,
          quote_text: zitat ? orNull(val('quote_text')) : null,
          quote_who: zitat ? orNull(val('quote_who')) : null,
          quote_role: zitat ? orNull(val('quote_role')) : null,
          quote_text_en: zitat ? orNull(val('quote_text_en')) : null,
          quote_role_en: zitat ? orNull(val('quote_role_en')) : null,
          title_en: orNull(val('title_en')),
          teaser_en: orNull(val('teaser_en')),
          body_en: hatEnglisch(bloecke) ? zuMarkdown(bloecke, 'en') : null,
        };
      };
      /** für die Vorschau: dazu jeder Block einzeln (Klick springt dorthin) */
      const vorschauDaten = (lang: Sprache) => {
        const bloecke = editor.bloecke();
        return { ...daten(row.status ?? 'entwurf'), ...kopf(), image_focus: imageFocus, abschnitte: bloecke.map((b) => zuMarkdown([b], lang)) };
      };

      // ---------- Springen (aus der Vorschau oder der Checkliste) ----------
      const pub = $<HTMLDialogElement>('[data-pub]')!;
      const hin = (el: HTMLElement | null, fokus?: HTMLElement | null) => {
        if (pub.open) pub.close();
        el?.closest('details')?.setAttribute('open', '');
        el?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        (fokus ?? el)?.focus({ preventScroll: true });
      };
      const springen = (z: Sprungziel) => {
        if (pub.open) pub.close();
        if (z.ziel === 'abschnitt') return editor.springen(z.i);
        if (z.ziel === 'titel') return hin(titel);
        if (z.ziel === 'kurztext') return hin(teaser);
        if (z.ziel === 'frist') return hin(field('deadline') as HTMLElement);
        if (z.ziel === 'titelfoto') return hin(coverFeld, imagePath ? field('image_alt') as HTMLElement : $('[data-cover-mediathek]'));
        if (z.ziel === 'fakten') return hin($('[data-fakten]'), factBoxes.facts.querySelector('input') ?? $('[data-add-fact="facts"]'));
        if (z.ziel === 'kopf') return hin(kopfFeld, kopfFeld.querySelector<HTMLInputElement>(`${imagePath ? '[data-kopf-mit-bild]' : '[data-kopf-ohne-bild]'} input:checked`));
      };
      const kopfFeld = $('[data-kopf-feld]')!;
      const vp = vorschau({ url: `${internUrl('news/vorschau/')}?eingebettet=1`, daten: vorschauDaten, springen });
      titel.addEventListener('focus', () => vp.zeigen('titel'));
      teaser.addEventListener('focus', () => vp.zeigen('kurztext'));
      coverFeld.addEventListener('focusin', () => vp.zeigen('titelfoto'));
      kopfFeld.addEventListener('focusin', () => vp.zeigen('kopf'));
      $('[data-fakten]')!.addEventListener('focusin', () => vp.zeigen('fakten'));

      // ---------- Checkliste ----------
      type Punkt = { text: string; ok: boolean; pflicht: boolean; ziel: () => void };
      const punkte = (): Punkt[] => {
        const kat = val('category');
        const p: Punkt[] = [];
        const tz = val('teaser');
        if (editor.laedt()) p.push({ text: 'Fotos sind hochgeladen', ok: false, pflicht: true, ziel: () => {} });
        p.push({ text: 'Titel gesetzt', ok: val('title').length >= 3, pflicht: true, ziel: () => springen({ ziel: 'titel' }) });
        p.push({ text: 'Teaser geschrieben, höchstens 220 Zeichen', ok: !!tz && tz.length <= 220, pflicht: !tz, ziel: () => springen({ ziel: 'kurztext' }) });
        if (kat === 'Ausschreibung') p.push({ text: 'Bewerbungsfrist eingetragen', ok: !!val('deadline'), pflicht: true, ziel: () => springen({ ziel: 'frist' }) });
        if (kat === 'Stimme') p.push({ text: 'Zitat für die Übersicht', ok: !!val('quote_text') && !!val('quote_who'), pflicht: false, ziel: () => hin(field('quote_text') as HTMLElement) });
        p.push({ text: 'Titelbild gewählt', ok: !!imagePath, pflicht: false, ziel: () => springen({ ziel: 'titelfoto' }) });
        const ohne = editor.ohneBeschreibung() + (imagePath && !val('image_alt') ? 1 : 0);
        p.push({ text: ohne ? `Bildbeschreibung fehlt bei ${ohne} ${ohne === 1 ? 'Foto' : 'Fotos'}` : 'Bildbeschreibung für alle Bilder', ok: !ohne, pflicht: false, ziel: () => {
          if (imagePath && !val('image_alt')) return hin(field('image_alt') as HTMLElement);
          const i = $$('.ab-block').findIndex((b) => b.classList.contains('ab-block--bilder') || b.classList.contains('ab-block--schritte'));
          if (i >= 0) springen({ ziel: 'abschnitt', i });
        } });
        const ohneNachweis = editor.ohneNachweis() + (imagePath && !val('image_credit') ? 1 : 0);
        p.push({ text: 'Fotonachweis für alle Bilder', ok: !ohneNachweis, pflicht: false, ziel: () => {
          if (imagePath && !val('image_credit')) return hin(field('image_credit') as HTMLElement);
          const i = $$('.ab-block').findIndex((b) => b.classList.contains('ab-block--bilder') || b.classList.contains('ab-block--schritte'));
          if (i >= 0) springen({ ziel: 'abschnitt', i });
        } });
        const leer = editor.leer();
        p.push({ text: 'Keine leeren oder unvollständigen Blöcke', ok: leer < 0, pflicht: false, ziel: () => leer >= 0 && springen({ ziel: 'abschnitt', i: leer }) });
        const alles = JSON.stringify(daten('entwurf'));
        p.push({ text: 'Keine Emoji (Gestaltungsregel)', ok: !EMOJI.test(alles), pflicht: true, ziel: () => springen({ ziel: 'titel' }) });
        p.push({ text: 'Englische Fassung', ok: !!val('title_en') || hatEnglisch(editor.bloecke()), pflicht: false, ziel: () => {
          $<HTMLDetailsElement>('[data-en]')!.open = true;
          hin(field('title_en') as HTMLElement);
        } });
        return p;
      };
      const fehlend = () => punkte().filter((p) => p.pflicht && !p.ok);

      // ---------- Englisch-Status ----------
      const enState = $('[data-en-state]')!;
      const updateEn = () => {
        const has = ['title_en', 'teaser_en'].filter((n) => val(n)).length + (hatEnglisch(editor.bloecke()) ? 1 : 0);
        enState.textContent = has === 3 ? 'übersetzt' : has ? 'teilweise' : 'optional';
      };

      // ---------- Status, Kopfleiste ----------
      const online = () => row.status === 'veroeffentlicht';
      const geplant = () => online() && (row.date ?? '') > heute();
      const statusBadge = $('[data-status-badge]')!;
      const sicherEl = $('[data-sicher]')!;
      const oeffnen = $<HTMLButtonElement>('[data-pub-oeffnen]')!;
      const delBtn = $<HTMLButtonElement>('[data-delete]')!;
      const live = $<HTMLAnchorElement>('[data-view-live]')!;
      const linkBtn = $<HTMLButtonElement>('[data-vorschau-link]')!;
      const renderStatus = () => {
        const z = geplant() ? 'geplant' : online() ? 'online' : 'entwurf';
        statusBadge.textContent = z === 'geplant' ? `Geplant · ${datumKurz(row.date!)}` : z === 'online' ? 'Online' : 'Entwurf';
        statusBadge.dataset.status = z;
        oeffnen.textContent = online() ? 'Aktualisieren' : 'Veröffentlichen';
        delBtn.hidden = !row.id;
        linkBtn.hidden = !row.id;
        live.hidden = !online() || geplant();
        live.href = `${base}news/${row.slug}/`;
        document.title = `${row.title || 'Neuer Beitrag'} · Redaktion`;
      };
      const stand = (text: string) => (sicherEl.textContent = text);
      renderStatus();
      stand(row.updated_at ? `Gespeichert · ${new Date(row.updated_at).toLocaleString('de-DE', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })}` : 'Noch nicht gespeichert');

      // ---------- Sicherung auf diesem Gerät ----------
      interface Sicherung { zeit: number; basis: string | null; stand: string; imagePath: string | null; imageFocus: string | null; daten: ReturnType<typeof daten>; bloecke: Block[] }
      const schluessel = (id?: string | null) => `tndd-news-sicherung:${id ?? 'neu'}`;
      const standJson = () => JSON.stringify([daten('entwurf'), imagePath, imageFocus, newsletter]);
      let gespeicherterStand = '';
      const sichern = () => {
        if (!dirty) return;
        try {
          const s: Sicherung = { zeit: Date.now(), basis: row.updated_at ?? null, stand: standJson(), imagePath, imageFocus, daten: daten('entwurf'), bloecke: editor.bloecke() };
          localStorage.setItem(schluessel(row.id), JSON.stringify(s));
          if (online()) stand(`Änderungen noch nicht online · auf diesem Gerät gesichert ${uhrzeit()}`);
        } catch {
          /* kein Speicher (privates Fenster): dann nur die Warnung beim Verlassen */
        }
      };
      const sicherungLoeschen = () => {
        try {
          localStorage.removeItem(schluessel(row.id));
          localStorage.removeItem(schluessel(null));
        } catch {
          /* egal */
        }
      };

      // ---------- Speichern ----------
      /** Angaben der Fotos in die Mediathek übernehmen (gelten dann überall) */
      const medienUebernehmen = async () => {
        if (!medienOk) return;
        const mitNachweis: Omit<MedienRow, 'created_at' | 'updated_at'>[] = [];
        const ohneNachweis: Omit<MedienRow, 'created_at' | 'updated_at' | 'credit'>[] = [];
        const dazu = (x: { datei: string; alt: string; alt_en: string; focus: string | null; credit: string }) => {
          const alt = { datei: x.datei, alt: x.alt.trim(), alt_en: x.alt_en.trim(), focus: x.focus };
          if (x.credit.trim()) mitNachweis.push({ ...alt, credit: x.credit.trim() });
          else ohneNachweis.push(alt);
          medien.set(x.datei, { ...alt, credit: x.credit.trim() || medien.get(x.datei)?.credit || '' });
        };
        if (imagePath) dazu({ datei: imagePath, alt: val('image_alt'), alt_en: val('image_alt_en'), focus: imageFocus, credit: val('image_credit') });
        editor.fotos().forEach(dazu);
        if (mitNachweis.length) await ctx.sb.from('news_medien').upsert(mitNachweis);
        if (ohneNachweis.length) await ctx.sb.from('news_medien').upsert(ohneNachweis);
      };

      let speichertGerade: Promise<boolean> | null = null;
      const save = async (status: 'entwurf' | 'veroeffentlicht', auto = false): Promise<boolean> => {
        if (speichertGerade) await speichertGerade;
        const lauf = (async () => {
          const payload = daten(status);
          const vorher = standJson();
          if (!auto) stand('Speichert …');
          const q = row.id
            ? ctx.sb.from('news_posts').update(payload).eq('id', row.id).select().single<NewsRow>()
            : ctx.sb.from('news_posts').insert(payload).select().single<NewsRow>();
          const { data, error } = await q;
          if (error) {
            stand('Nicht gespeichert');
            const dup = /duplicate|unique/i.test(error.message);
            if (/image_focus|news_image_alt/.test(error.message)) melden('Die Datenbank ist noch nicht auf dem neuen Stand: Bitte die Migration 20261015000000_news_bilder.sql im SQL-Editor ausführen.');
            else if (/newsletter/.test(error.message)) melden('Bitte die Migration 20261016000000_mediathek.sql im SQL-Editor ausführen.');
            else if (/hero|node_kicker|node_value/.test(error.message)) melden('Für den Kopfbereich bitte die Migration 20261029000000_news_kopf.sql im SQL-Editor ausführen.');
            else if (/body_check|body_en_check/.test(error.message)) melden('Der Text ist zu lang. Bitte die Migration 20261015000000_news_bilder.sql ausführen (erlaubt längere Texte) oder kürzen.');
            else melden(dup ? 'Diese Adresse ist schon vergeben. Bitte unter „Weitere Angaben → Adresse“ eine andere wählen.' : errorText(error));
            return false;
          }
          await medienUebernehmen();
          const warOnline = online();
          row = data;
          // während des Speicherns weitergetippt? Dann bleibt es „ungespeichert“
          if (standJson() === vorher) {
            dirty = false;
            sicherungLoeschen();
          }
          gespeicherterStand = standJson();
          if (!id0 || id0 !== row.id) history.replaceState(null, '', `${internUrl('news/bearbeiten/')}?id=${row.id}`);
          renderStatus();
          stand(`Gespeichert · ${uhrzeit()}`);
          if (auto) return true;
          // Online-Stand geändert: Website neu bauen lassen (holt die News beim Build aus Supabase)
          const baut = status === 'veroeffentlicht' || warOnline ? await neuBauenLassen(ctx.sb) : false;
          const wann = baut ? 'in 2–3 Minuten' : 'mit dem nächsten Update, spätestens morgen früh';
          melden(
            status === 'veroeffentlicht'
              ? geplant()
                ? `Eingeplant. Der Beitrag erscheint am ${datumLang(row.date!)} morgens automatisch auf der Website.`
                : `Veröffentlicht. Der Beitrag ist ${wann} online.`
              : warOnline
                ? `Offline genommen. Der Beitrag verschwindet ${wann} von der Website und ist wieder Entwurf.`
                : 'Entwurf gespeichert. Nur die Redaktion sieht ihn.',
            'ok',
          );
          return true;
        })();
        speichertGerade = lauf;
        try {
          return await lauf;
        } finally {
          if (speichertGerade === lauf) speichertGerade = null;
        }
      };

      // Entwürfe speichert der Editor selbst (ab einem Titel); online bleibt alles bis „Aktualisieren“
      let autoTimer = 0;
      const autoSpeichern = () => {
        window.clearTimeout(autoTimer);
        if (online()) return;
        autoTimer = window.setTimeout(() => {
          if (!dirty || online() || val('title').length < 3 || editor.laedt()) {
            if (dirty && val('title').length < 3) stand('Ab einem Titel speichert der Editor selbst');
            return;
          }
          void save('entwurf', true);
        }, 2500);
      };

      // ---------- Änderungen ----------
      let sicherTimer = 0;
      function geaendert() {
        dirty = true;
        updateEn();
        vp.neu();
        if (pub.open) pubZeichnen();
        window.clearTimeout(sicherTimer);
        sicherTimer = window.setTimeout(sichern, 1200);
        autoSpeichern();
        if (!online()) stand('Ungespeicherte Änderungen');
        $('[data-vorlagen]')!.hidden = !!id0 || !!row.id || vorlageGewaehlt || editor.hatText();
      }
      form.addEventListener('input', geaendert);
      form.addEventListener('change', (e) => {
        const name = (e.target as HTMLInputElement).name;
        if (name === 'category') rubrik();
        if (name === 'hero') kopfZeigen();
        geaendert();
      });

      // ---------- Veröffentlichen-Panel ----------
      let modus: 'sofort' | 'planen' = 'sofort';
      const planDatum = $<HTMLInputElement>('[data-plan-datum]')!;
      const publishBtn = $<HTMLButtonElement>('[data-publish]')!;
      const newsletterEl = $<HTMLInputElement>('[data-newsletter]')!;
      const storyEl = $<HTMLInputElement>('[data-story]')!;
      const modusSetzen = (m: typeof modus) => {
        modus = m;
        $$('[data-modus]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modus === m)));
        $('[data-plan]')!.hidden = m !== 'planen';
        pubZeichnen();
      };
      function pubZeichnen() {
        $('[data-pub-titel]')!.textContent = val('title') || 'Ohne Titel';
        const p = punkte();
        const ok = p.filter((x) => x.ok).length;
        $('[data-check-summe]')!.textContent = `${ok} von ${p.length} erfüllt`;
        $('[data-check-liste]')!.replaceChildren(...p.map((x) =>
          h('li', { 'data-zustand': x.ok ? 'ok' : x.pflicht ? 'fehlt' : 'tipp' },
            h('span', { class: 'ne-check__box', 'aria-hidden': 'true' }),
            h('span', { class: 'ne-check__text', text: x.text }),
            h('span', { class: 'visually-hidden', text: x.ok ? ': erledigt' : x.pflicht ? ': Pflicht, fehlt' : ': empfohlen' }),
            x.ok ? null : h('span', { class: 'ne-check__art', 'aria-hidden': 'true', text: x.pflicht ? 'Pflicht' : 'Empfohlen' }),
            x.ok ? null : h('button', { type: 'button', class: 'ne-check__fix', text: 'Beheben', 'aria-label': `${x.text}: beheben`, onclick: x.ziel }))));
        const gesperrt = p.some((x) => x.pflicht && !x.ok) || (modus === 'planen' && !(planDatum.value > heute()));
        $('[data-pub-block]')!.hidden = !p.some((x) => x.pflicht && !x.ok);
        publishBtn.disabled = gesperrt;
        publishBtn.textContent = modus === 'planen' ? 'Einplanen' : online() && !geplant() ? 'Änderungen veröffentlichen' : 'Jetzt veröffentlichen';
        $('[data-offline]')!.hidden = !online();
        // So erscheint er in der Chronik
        const kat = val('category') as NewsRow['category'];
        const datum = modus === 'planen' && planDatum.value ? planDatum.value : online() ? val('date') : heute();
        const src = newsPhotoUrl(imagePath);
        $('[data-chronik]')!.replaceChildren(
          src ? h('div', { class: 'ne-chronik__bild' }, h('img', { src, alt: '', style: imageFocus ? `object-position:${imageFocus}` : undefined })) : '',
          h('div', { class: 'ne-chronik__text' },
            h('span', { class: 'ne-chronik__meta' }, h('span', { class: `badge${newsBadge[kat] === 'magenta' ? '' : ` badge--${newsBadge[kat]}`}`, text: kat }), ` ${datumKurz(datum)}`),
            h('span', { class: 'ne-chronik__titel', text: val('title') || 'Titel des Beitrags' }),
            h('span', { class: 'ne-chronik__teaser', text: val('teaser') })));
      }
      oeffnen.addEventListener('click', () => {
        newsletterEl.checked = newsletter;
        planDatum.min = morgen();
        planDatum.value = geplant() ? row.date! : planDatum.value || morgen();
        modusSetzen(geplant() ? 'planen' : 'sofort');
        pub.showModal();
      });
      $$('[data-pub-zu]').forEach((b) => b.addEventListener('click', () => pub.close()));
      pub.addEventListener('click', (e) => e.target === pub && pub.close());
      $$('[data-modus]').forEach((b) => b.addEventListener('click', () => modusSetzen(b.dataset.modus as typeof modus)));
      planDatum.addEventListener('input', pubZeichnen);
      newsletterEl.addEventListener('change', () => {
        newsletter = newsletterEl.checked;
        geaendert();
      });
      publishBtn.addEventListener('click', async () => {
        if (fehlend().length) return pubZeichnen();
        // Sofort: erstes Veröffentlichen mit heutigem Datum, danach bleibt es; Planen: gewählter Tag
        const d = val('date') || heute();
        datumBeimVeroeffentlichen.wert = modus === 'planen' ? planDatum.value : !online() || d > heute() ? heute() : d;
        publishBtn.disabled = true;
        const ok = await save('veroeffentlicht');
        datumBeimVeroeffentlichen.wert = '';
        publishBtn.disabled = false;
        if (!ok) return;
        set('date', row.date);
        pub.close();
        if (storyEl.checked) {
          try {
            await storyBild({ titel: row.title ?? '', kategorie: row.category ?? 'Netzwerk', datum: row.date ?? heute(), bild: newsPhotoUrl(imagePath), fokus: imageFocus, datei: `story-${row.slug}.png` });
          } catch {
            melden('Das Story-Bild ließ sich nicht erstellen. Bitte erneut versuchen.');
          }
        }
      });
      $('[data-offline]')!.addEventListener('click', async () => {
        if (!confirm('Beitrag offline nehmen? Er verschwindet von der Website und wird wieder Entwurf.')) return;
        if (await save('entwurf')) pub.close();
      });

      // ---------- Weitere Angaben: Löschen, Vorschau-Link ----------
      delBtn.addEventListener('click', async () => {
        if (!row.id || !confirm(`„${row.title}“ wirklich löschen? Das lässt sich nicht rückgängig machen. Die Fotos bleiben in der Mediathek.`)) return;
        const { error } = await ctx.sb.from('news_posts').delete().eq('id', row.id);
        if (error) return melden(errorText(error));
        if (online()) await neuBauenLassen(ctx.sb);
        sicherungLoeschen();
        dirty = false;
        location.href = internUrl('news/');
      });
      linkBtn.addEventListener('click', async () => {
        const link = `${location.origin}${internUrl('news/vorschau/')}?id=${row.id}`;
        try {
          await navigator.clipboard.writeText(link);
          linkBtn.textContent = 'Link kopiert';
          setTimeout(() => (linkBtn.textContent = 'Vorschau-Link kopieren'), 2000);
        } catch {
          prompt('Link zur Vorschau (zeigt den zuletzt gespeicherten Stand, nur für Presse, Vorstand und Admin):', link);
        }
      });
      addEventListener('beforeunload', (e) => {
        if (dirty) {
          sichern();
          e.preventDefault();
        }
      });

      // ---------- Vorlagen (nur neue Beiträge) ----------
      let vorlageGewaehlt = false;
      const vorlagenBox = $('[data-vorlagen]')!;
      vorlagenBox.hidden = !!id0 || editor.hatText();
      $('[data-vorlagen-liste]')!.replaceChildren(...vorlagen.map((v) =>
        h('button', {
          type: 'button', class: 'ne-vorlage',
          onclick: () => {
            set('category', v.kategorie);
            if (v.fakten.length) faktenSetzen(v.fakten.map((label) => ({ label, value: '' })));
            editor.setzen(v.bloecke() as EBlock[]);
            vorlageGewaehlt = true;
            vorlagenBox.hidden = true;
            rubrik();
            geaendert();
            titel.focus();
          },
        }, h('strong', { text: v.name }), h('span', { text: v.text }))));

      // ---------- Wiederherstellen ----------
      gespeicherterStand = standJson();
      let sicherung: Sicherung | null = null;
      try {
        sicherung = JSON.parse(localStorage.getItem(schluessel(id0)) ?? 'null') as Sicherung | null;
      } catch {
        sicherung = null;
      }
      if (sicherung && sicherung.stand !== gespeicherterStand) {
        const box = $('[data-wieder]')!;
        const wann = new Date(sicherung.zeit).toLocaleString('de-DE', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
        const anders = (sicherung.basis ?? null) !== (row.updated_at ?? null);
        $('[data-wieder-text]')!.textContent = `Auf diesem Gerät gibt es ungespeicherte Änderungen vom ${wann}.${anders ? ' Achtung: Inzwischen wurde der Beitrag gespeichert, vielleicht von jemand anderem.' : ''}`;
        box.hidden = false;
        $('[data-wieder-ja]')!.addEventListener('click', () => {
          const s = sicherung!;
          fuellen({ ...row, ...s.daten, image_path: s.imagePath, image_focus: s.imageFocus } as Partial<NewsRow>);
          imagePath = s.imagePath;
          imageFocus = s.imageFocus;
          showPhoto();
          editor.setzen(s.bloecke as EBlock[]);
          count();
          showSlug();
          [titel, teaser].forEach(wachsen);
          box.hidden = true;
          geaendert();
          melden(online() ? 'Wiederhergestellt. Zum Übernehmen „Aktualisieren“ wählen.' : 'Wiederhergestellt.', 'ok');
        });
        $('[data-wieder-nein]')!.addEventListener('click', () => {
          sicherungLoeschen();
          box.hidden = true;
        });
      }

      updateEn();
      if (!id0) titel.focus();
    }
  }
</script>
