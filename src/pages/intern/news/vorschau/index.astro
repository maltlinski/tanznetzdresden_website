---
/**
 * Vorschau eines News-Beitrags, so wie er auf der Website erscheint (gleiches Gerüst: src/lib/news-artikel.ts,
 * gleiche Stile: src/styles/artikel.css, gleiche Skripte: src/scripts/news-artikel.ts).
 *  - im Editor (Rahmen, ?eingebettet=1): bekommt den aktuellen Stand per postMessage, auch ungespeichert
 *  - als Link (?id=…): zeigt den zuletzt gespeicherten Stand, nur für Presse, Vorstand und Admin
 */
import Page from '../../../../layouts/Page.astro';
import '../../../../styles/artikel.css';
---
<Page title="Vorschau · News" noindex>
  <p class="vb" data-vorschau-band>Vorschau · so erscheint der Beitrag auf der Website <span data-vorschau-stand></span></p>
  <p class="vb vb--fehler" data-vorschau-fehler hidden></p>

  <article data-article hidden>
    <div data-v="kopf"></div>
    <div class="ab">
      <div class="ab__spalte">
        <p class="ab__stand" data-v="stand" hidden></p>
        <p class="ab__note" lang="en" data-v="only-de" hidden>This post is only available in German so far.</p>
        <div data-v="zeile"></div>
        <div data-v="fakten"></div>
        <div class="ab__text" data-v="html"></div>
        <div data-v="fuss"></div>
      </div>
    </div>
  </article>
</Page>

<script>
  import { renderMarkdown } from '../../../../lib/markdown';
  import { newsPhotoUrl, getSupabase, type NewsRow } from '../../../../lib/supabase';
  import { faktenHtml, fussHtml, kopfHtml, kopfModus, nachweise, zeileHtml, type Flaeche } from '../../../../lib/news-artikel';
  import { texte } from '../../../../lib/texte';
  import { initLightbox } from '../../../../scripts/lightbox';
  import { initArtikel, verhaeltnisse } from '../../../../scripts/news-artikel';

  type Beitrag = Partial<NewsRow>;
  const base = import.meta.env.BASE_URL;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const v = (k: string) => $(`[data-v="${k}"]`);
  const article = $('[data-article]');
  initLightbox(article);

  type MitAbschnitten = Beitrag & { abschnitte?: string[] };
  const eingebettet = window.parent !== window;

  // Seitenverhältnis des Titelbilds (entscheidet zwischen Vollbild und Hochkant)
  const masse = new Map<string, Promise<number>>();
  const verhaeltnis = (src: string) => {
    if (!masse.has(src)) {
      masse.set(src, new Promise((fertig) => {
        const im = new Image();
        im.onload = () => fertig(im.naturalWidth / im.naturalHeight || 1.5);
        im.onerror = () => fertig(1.5);
        im.src = src;
      }));
    }
    return masse.get(src)!;
  };
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  let erstesMal = true;
  let zuletzt: { b: MitAbschnitten; lang: 'de' | 'en' } | null = null;

  async function zeigen(b: MitAbschnitten, lang: 'de' | 'en') {
    zuletzt = { b, lang };
    const t = texte(lang, 'news', 'beitrag');
    const en = lang === 'en';
    const pick = <X,>(de: X, e: X | null | undefined) => (en && e != null && e !== '' && !(Array.isArray(e) && !e.length) ? e : de);
    const body = pick(b.body ?? '', b.body_en);
    const cat = b.category ?? 'Netzwerk';
    const date = b.date || new Date().toISOString().slice(0, 10);
    const words = `${b.teaser ?? ''} ${body}`.replace(/::: (bilder|schritte)[\s\S]*?:::/g, '').split(/\s+/).filter(Boolean).length;
    const titel = pick(b.title ?? '', b.title_en) || (en ? 'Title' : 'Titel des Beitrags');
    const teaser = pick(b.teaser ?? '', b.teaser_en);
    const cover = newsPhotoUrl(b.image_path ?? null);
    const r = cover ? await verhaeltnis(cover) : undefined;
    if (zuletzt?.b !== b) return; // inzwischen neuer Stand
    const modus = kopfModus(b.hero, !!cover, r);
    const credit = b.image_credit ?? '';
    const kicker = pick(b.node_kicker ?? '', b.node_kicker_en);
    const value = pick(b.node_value ?? '', b.node_value_en);

    document.documentElement.lang = lang;
    v('kopf').innerHTML = kopfHtml({
      lang, modus, flaeche: (b.hero_theme ?? 'purple') as Flaeche, kategorie: cat, titel, teaser, autor: b.author ?? '',
      datum: date, minuten: Math.max(2, Math.ceil(words / 180)), zurueck: '',
      bild: cover
        ? {
            img: `<img class="ak__img" src="${esc(cover)}" alt="${esc(pick(b.image_alt ?? '', b.image_alt_en))}"${b.image_focus ? ` style="object-position:${b.image_focus}"` : ''}>`,
            gross: cover, verhaeltnis: r ?? 1.5, credit,
          }
        : undefined,
      knoten: kicker || value ? { kicker, value } : undefined,
      frist: b.deadline ?? undefined,
    });
    const stand = v('stand');
    stand.hidden = modus !== 'vollbild' || !teaser;
    stand.textContent = teaser;
    v('only-de').hidden = !(en && !b.body_en && (b.body ?? '').trim());
    v('zeile').innerHTML = zeileHtml(lang, b.author ?? '', date, '#');
    v('fakten').innerHTML = faktenHtml(lang, pick(b.facts ?? [], b.facts_en), b.deadline ?? undefined);

    // Aus dem Editor: jeder Abschnitt einzeln, damit ein Klick zur Stelle im Editor springt
    const abb = { n: 0 };
    const html = v('html');
    if (b.abschnitte) {
      html.replaceChildren(...b.abschnitte.map((md, i) => {
        const teil = document.createElement('div');
        teil.className = 'vs-teil';
        teil.dataset.abschnitt = String(i);
        teil.innerHTML = renderMarkdown(md, base, { lang, abb }) || `<p class="vs-leer">${en ? 'Empty section' : 'Leerer Abschnitt'}</p>`;
        return teil;
      }));
      if (!b.abschnitte.length) html.innerHTML = `<p class="vs-leer">${en ? 'No text yet.' : 'Noch kein Text.'}</p>`;
    } else {
      html.innerHTML = renderMarkdown(body, base, { lang, abb }) || `<p class="vs-leer">${en ? 'No text yet.' : 'Noch kein Text.'}</p>`;
    }
    v('fuss').innerHTML = fussHtml(lang, b.author ?? '', date, nachweise(html.innerHTML, credit ? { k: t.cover, credit } : undefined));
    article.hidden = false;
    initArtikel(article, { seed: b.slug || titel, neu: !erstesMal });
    if (erstesMal) erstesMal = false;
    verhaeltnisse(article);
  }

  const fehler = (text: string) => {
    const el = $('[data-vorschau-fehler]');
    el.textContent = text;
    el.hidden = false;
  };

  const params = new URLSearchParams(location.search);
  const id = params.get('id');
  if (id) {
    // Gespeicherter Stand: nur für die Redaktion (Row Level Security auf news_posts)
    const sb = getSupabase();
    const { data: s } = (await sb?.auth.getSession()) ?? { data: null };
    if (!sb || !s?.session) {
      location.replace(`${base.replace(/\/?$/, '/')}intern/?weiter=${encodeURIComponent(location.pathname + location.search)}`);
    } else {
      const { data, error } = await sb.from('news_posts').select('*').eq('id', id).maybeSingle<NewsRow>();
      if (error || !data) fehler('Diesen Beitrag gibt es nicht, oder die Vorschau ist nur für Presse, Vorstand und Admin.');
      else {
        $('[data-vorschau-stand]').textContent = `· gespeichert am ${new Date(data.updated_at).toLocaleString('de-DE')}${data.status === 'veroeffentlicht' ? ' · online' : ' · Entwurf'}`;
        await zeigen(data, params.get('lang') === 'en' ? 'en' : 'de');
      }
    }
  }

  // Stellen im Beitrag, die zu einem Feld im Editor gehören
  const STELLEN: [string, string][] = [
    ['.ak__titel', 'titel'], ['.ak__teaser', 'kurztext'], ['.ab__stand', 'kurztext'], ['.ak__zoom', 'titelfoto'], ['.ak__figur', 'titelfoto'],
    ['.ab__call', 'frist'], ['.ab__fakten', 'fakten'], ['.ak__knoten', 'kopf'], ['.ak--netz', 'kopf'], ['.ak', 'kopf'],
  ];
  const ZIEL: Record<string, string> = { titel: '.ak__titel', kurztext: '.ak__teaser, .ab__stand', titelfoto: '.ak__zoom', fakten: '.ab__fakten', kopf: '.ak' };

  // Aus dem Editor (gleiche Adresse): aktueller, auch ungespeicherter Stand
  addEventListener('message', (e) => {
    if (e.origin !== location.origin) return;
    if (e.data?.typ === 'news-vorschau') void zeigen(e.data.beitrag as MitAbschnitten, e.data.lang === 'en' ? 'en' : 'de');
    if (e.data?.typ === 'news-zeigen') {
      // Block i oder Titel, Teaser, Titelbild, Kopf, Eckdaten: hinscrollen und markieren
      const teil = e.data.ziel ? document.querySelector<HTMLElement>(ZIEL[e.data.ziel] ?? '-') : document.querySelector<HTMLElement>(`[data-abschnitt="${Number(e.data.i)}"]`);
      const ziel = (e.data.ziel ? teil : teil?.firstElementChild) as HTMLElement | null;
      if (!teil || !ziel) return;
      ziel.scrollIntoView({ block: 'center', behavior: 'smooth' });
      document.querySelectorAll('.vs-aktiv, .vs-aktiv-el').forEach((x) => x.classList.remove('vs-aktiv', 'vs-aktiv-el'));
      teil.classList.add(e.data.ziel ? 'vs-aktiv-el' : 'vs-aktiv');
    }
  });

  // Klick in der Vorschau → zur Stelle im Editor
  if (eingebettet) {
    document.documentElement.classList.add('vorschau-eingebettet');
    article.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest('.nb__steuer, [data-copy]')) return;
      const teil = t.closest<HTMLElement>('[data-abschnitt]');
      const ziel = teil ? null : STELLEN.find(([sel]) => t.closest(sel))?.[1];
      if (!teil && !ziel) return;
      e.preventDefault();
      e.stopPropagation();
      parent.postMessage(teil ? { typ: 'news-springen', ziel: 'abschnitt', i: Number(teil.dataset.abschnitt) } : { typ: 'news-springen', ziel }, location.origin);
    }, true);
  }
</script>

<style>
  .vb {
    margin: 0; padding: 10px clamp(16px, 3vw, 28px); background: var(--magenta); color: #fff; font-family: var(--font-mono);
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .vb--fehler { background: var(--purple); }
  :global(.ak__back) { cursor: default; }
  /* Abschnitte liegen als display: contents im Text, damit die Abstände wie auf der Website bleiben */
  :global(.vs-teil) { display: contents; }
  :global(.vs-leer) { color: var(--ink-muted); font-style: italic; }
  :global(.vorschau-eingebettet .vs-teil > *),
  :global(.vorschau-eingebettet .ak__titel), :global(.vorschau-eingebettet .ak__teaser), :global(.vorschau-eingebettet .ak__zoom),
  :global(.vorschau-eingebettet .ab__stand), :global(.vorschau-eingebettet .ab__fakten), :global(.vorschau-eingebettet .ak) { cursor: pointer; }
  :global(.vorschau-eingebettet .vs-teil:hover > *), :global(.vorschau-eingebettet .vs-aktiv > *),
  :global(.vorschau-eingebettet .vs-aktiv-el) { outline: 2px dashed var(--magenta); outline-offset: 6px; }
  :global(.vorschau-eingebettet .ak__titel:hover), :global(.vorschau-eingebettet .ak__teaser:hover), :global(.vorschau-eingebettet .ab__stand:hover),
  :global(.vorschau-eingebettet .ab__fakten:hover) { outline: 1.5px solid var(--cyan); outline-offset: 6px; }
  :global(.vorschau-eingebettet .ak.vs-aktiv-el), :global(.vorschau-eingebettet .ak__zoom.vs-aktiv-el) { outline-offset: -3px; }
  /* im Editor ohne Band: dort steht „Live-Vorschau“ schon darüber */
  :global(.vorschau-eingebettet .vb:not(.vb--fehler)) { display: none; }
</style>
