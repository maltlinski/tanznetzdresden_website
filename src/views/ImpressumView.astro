---
import TextPageView from './TextPageView.astro';
import ProtectedEmail from '../components/ProtectedEmail.astro';
import { getVerein } from '../lib/settings';
import { getLang } from '../lib/i18n';
import { fuellen, texte } from '../lib/texte';
import { gestaltung } from '../settings/gestaltung';

const lang = getLang(Astro);
const v = getVerein(lang);
const a = v.address;
const r = v.register;
const t = texte(lang, 'rechtliches', 'impressum');
---
<TextPageView id="impressum" route="impressum" kicker={t.kicker}>
  <Fragment slot="before">
    <h2>{t.h}</h2>
    <p><strong>{v.legalName}</strong><br />{a.street}<br />{a.zip} {a.city}</p>
    <p>{t.rep} {r.representatives}<br />{r.representationNote}</p>
    <p>{t.reg}<br />{t.court}: {r.court}<br />{t.no}: {r.number}</p>
    <p>{r.taxNote}</p>
    <h2>{t.contact}</h2>
    <p>
      {t.phone}: <a href={`tel:${v.phone.replace(/\s/g, '')}`}>{v.phone}</a><br />
      {t.mail}: <ProtectedEmail email={v.emails.kontakt} label={t.show} />
    </p>
    <h2>{t.resp}</h2>
    <p>{r.contentResponsible}</p>
    <h2 id="gestaltung">{t.designH}</h2>
    <p>{t.designBy} {gestaltung.name}<br />© {gestaltung.seit} {gestaltung.name}</p>
    <p>{fuellen(t.designRights, { name: gestaltung.name })}</p>
  </Fragment>
</TextPageView>
