---
/** News-Übersicht („Aus dem Netz.“): Titelthema, offene Fristen, Chronik nach Monaten mit Filter. */
import Page from '../layouts/Page.astro';
import Tag from '../components/ui/Tag.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import KeilBar from '../components/ui/KeilBar.astro';
import NewsImage from '../components/NewsImage.astro';
import ProtectedEmail from '../components/ProtectedEmail.astro';
import {
  getNews, leadPost, daysLeft, deadlineText, dateLong, dateShort, monthLong, monthShort, nrLabel,
  newsBadge, newsCategoryLabel, type NewsCategory, type NewsPost,
} from '../lib/news';
import { newsCategories } from '../content.config';
import { getVerein } from '../lib/settings';
import { href } from '../lib/url';
import { getLang, tr, url } from '../lib/i18n';

const lang = getLang(Astro);
const verein = getVerein(lang);
const posts = await getNews(lang);
const lead = leadPost(posts);
const open = posts.filter((p) => p.deadline && daysLeft(p.deadline) >= 0);
const year = new Date().getFullYear();
const t = tr(lang, {
  de: {
    title: 'News', description: 'Neues aus der freien Tanzszene in Dresden: Ausschreibungen, Formate, Stimmen und Neuigkeiten aus dem Verein.',
    kicker: 'Journal · Neues aus der freien Szene', l1: 'Aus dem', l2: 'Netz.', featured: 'Titelthema', read: 'Beitrag lesen',
    openCall: 'Offene Frist', all: 'Alle Beiträge', chronicle: 'Chronik', filter: 'Nach Kategorie filtern',
    post: 'Beitrag', posts: 'Beiträge', readShort: 'Lesen', min: 'Min', deadline: 'Frist', until: 'bis', toTalk: 'Zum Gespräch',
    empty: 'In dieser Kategorie gibt es noch keine Beiträge.', none: 'Noch keine Beiträge.',
    stayH: 'Nichts verpassen', stayP: 'Einmal im Monat im Postfach: Termine, Ausschreibungen und Neuigkeiten aus der freien Szene.',
    newsletter: 'Newsletter abonnieren', submit: 'Meldung einreichen', rss: 'RSS-Feed',
  },
  en: {
    title: 'News', description: "News from Dresden's independent dance scene: open calls, formats, voices and updates from the association.",
    kicker: 'Journal · News from the independent scene', l1: 'From the', l2: 'network.', featured: 'Featured', read: 'Read the post',
    openCall: 'Open call', all: 'All posts', chronicle: 'Chronicle', filter: 'Filter by category',
    post: 'post', posts: 'posts', readShort: 'Read', min: 'min', deadline: 'Deadline', until: 'until', toTalk: 'Read the conversation',
    empty: 'No posts in this category yet.', none: 'No posts yet.',
    stayH: 'Stay in the loop', stayP: 'Once a month in your inbox: events, open calls and news from the independent scene.',
    newsletter: 'Subscribe to the newsletter', submit: 'Send us news', rss: 'RSS feed',
  },
});
const link = (p: NewsPost) => url(lang, 'news', `${p.id}/`);
const count = (n: number) => `${n} ${n === 1 ? t.post : t.posts}`;

// Chronik: Monatsgruppen (das Titelthema steht oben und erscheint nur beim Filtern in der Liste)
const months: { key: string; date: string; posts: NewsPost[] }[] = [];
for (const p of posts) {
  const key = p.date.slice(0, 7);
  const g = months.at(-1);
  if (g?.key === key) g.posts.push(p);
  else months.push({ key, date: p.date, posts: [p] });
}
const cats = (['Alle', ...newsCategories] as const).map((c) => ({
  id: c,
  label: newsCategoryLabel[lang][c],
  n: c === 'Alle' ? posts.length : posts.filter((p) => p.category === c).length,
}));
const feed = href(lang === 'de' ? 'news.xml' : 'en/news.xml');
---
<Page route="news" title={t.title} description={t.description}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`${verein.name} – News`} href={feed} />

  <section class="ni" aria-labelledby="news-title" data-news-intro>
    <div class="wrap ni__inner">
      <div class="ni__top">
        <div data-rise="0.05"><Tag color="cyan">{t.kicker}</Tag></div>
        <span class="ni__place" data-rise="0.15">Dresden · {year}</span>
      </div>
      <h1 id="news-title" class="ni__title">
        <span data-sweep="0.25" data-bar="var(--cyan)">{t.l1}</span><br /><em data-sweep="0.5" data-bar="var(--magenta)">{t.l2}</em>
      </h1>
      {lead ? (
        <a href={link(lead)} class="ni__lead" data-rise="0.95">
          <div class="ni__lead-img">
            {lead.image && <NewsImage src={lead.image} alt={lead.alt ?? ''} sizes="(min-width: 900px) 620px, 100vw" loading="eager" />}
            <span class="ni__corner" aria-hidden="true"></span>
          </div>
          <div class="ni__lead-text">
            <span class="ni__lead-meta">{t.featured} · {dateLong(lead.date, lang)}</span>
            <h2 class="ni__lead-title">{lead.title}</h2>
            <p class="ni__lead-teaser">{lead.teaser}</p>
            <span class="ni__lead-more">{t.read} · {lead.minutes} {t.min} →</span>
          </div>
        </a>
      ) : <p class="ni__none">{t.none}</p>}
    </div>
    {open.length > 0 && (
      <div class="ni__calls">
        <div class="wrap ni__calls-inner">
          {open.map((p) => (
            <a href={link(p)} class="ni__call" data-rise="1.25" data-deadline={p.deadline} data-deadline-open>
              <span class="ni__call-k"><span class="ni__dot" aria-hidden="true"></span>{t.openCall}</span>
              <span class="ni__call-title">{p.title}</span>
              <span class="ni__call-d">
                {dateShort(p.deadline!, lang)} · <span data-deadline={p.deadline} data-deadline-part="label">{deadlineText(daysLeft(p.deadline!), 'label', lang)}</span> →
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
    <KeilBar class="ni__keil" />
  </section>

  <section id="journal" class="section journal" aria-labelledby="journal-h">
    <div class="wrap">
      <div class="journal__head">
        <div>
          <Tag>{t.all}</Tag>
          <h2 id="journal-h" class="h2">{t.chronicle}</h2>
        </div>
        <div class="chips" role="group" aria-label={t.filter} data-news-filter hidden>
          {cats.filter((c) => c.n > 0).map((c) => (
            <button type="button" class="chip" data-cat={c.id} aria-pressed={c.id === 'Alle' ? 'true' : 'false'}>
              {c.label}<span class="chip__count">{c.n}</span>
            </button>
          ))}
        </div>
      </div>

      <p class="journal__empty" data-news-empty hidden>{t.empty}</p>

      {months.map((g) => {
        const visible = g.posts.filter((p) => p !== lead).length;
        return (
          <div class="month" data-month hidden={visible === 0}>
            <div class="month__label">
              <span class="month__dot" aria-hidden="true"></span>
              <span class="month__mo" aria-hidden="true">{monthShort(g.date, lang)}</span>
              <h3 class="month__name">{monthLong(g.date, lang)}</h3>
              <span class="month__count" data-month-count>{count(visible)}</span>
            </div>
            <div class="month__posts">
              {g.posts.map((p) => {
                const isLead = p === lead;
                const cat = newsCategoryLabel[lang][p.category as NewsCategory];
                const meta = (
                  <div class="post__meta">
                    <span class="post__nr">{nrLabel(p.nr)} · {dateShort(p.date, lang)}</span>
                    <Badge variant={newsBadge[p.category]}>{cat}</Badge>
                  </div>
                );
                return (
                  <a href={link(p)} class:list={['post', `post--${p.kind}`]} data-post data-cat={p.category} data-lead={isLead ? '' : undefined} hidden={isLead}>
                    {p.kind === 'photo' && (
                      <>
                        <div class="post__img">{p.image && <NewsImage src={p.image} alt={p.alt ?? ''} sizes="(min-width: 900px) 420px, 100vw" />}</div>
                        <div class="post__body">
                          {meta}
                          <h4 class="post__title">{p.title}</h4>
                          <p class="post__teaser">{p.teaser}</p>
                          <span class="post__more">{t.readShort} · {p.minutes} {t.min} →</span>
                        </div>
                      </>
                    )}
                    {p.kind === 'text' && (
                      <>
                        <div class="post__body">
                          {meta}
                          <h4 class="post__title">{p.title}</h4>
                          <p class="post__teaser">{p.teaser}</p>
                        </div>
                        <span class="post__arrow" aria-hidden="true">→</span>
                      </>
                    )}
                    {p.kind === 'call' && (
                      <>
                        <div class="post__body">
                          {meta}
                          <h4 class="post__title">{p.title}</h4>
                          <p class="post__teaser">{p.teaser}</p>
                        </div>
                        <div class="post__deadline">
                          <span class="post__dl-k">{t.deadline}</span>
                          <span class="post__dl-n" data-deadline={p.deadline} data-deadline-part="n">{deadlineText(daysLeft(p.deadline!), 'n', lang)}</span>
                          <span class="post__dl-u" data-deadline={p.deadline} data-deadline-part="unit">{deadlineText(daysLeft(p.deadline!), 'unit', lang)}</span>
                          <span class="post__dl-d">{t.until} {dateShort(p.deadline!, lang)}</span>
                        </div>
                      </>
                    )}
                    {p.kind === 'quote' && p.quote && (
                      <>
                        {meta}
                        <span class="post__q-mark" aria-hidden="true"><span>„</span></span>
                        <blockquote class="post__quote">{p.quote.text}</blockquote>
                        <span class="visually-hidden">{p.title}</span>
                        <div class="post__q-foot">
                          <span>{p.quote.who}{p.quote.role && ` · ${p.quote.role}`}</span>
                          <span class="post__q-more">{t.toTalk} →</span>
                        </div>
                      </>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}

      <div class="stay">
        <div class="stay__text">
          <p class="stay__h">{t.stayH}</p>
          <p class="stay__p">{t.stayP}</p>
        </div>
        <div class="stay__actions">
          <Button href={url(lang, 'home', '#newsletter')} variant="primary" marker>{t.newsletter}</Button>
          <ProtectedEmail email={verein.emails.kontakt} label={`${t.submit} →`} subject="Meldung für die News" class="stay__mail" />
          <a class="mono-link stay__rss" href={feed}>{t.rss}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<script>
  import { introText } from '../scripts/intro-text';
  import '../scripts/deadline';

  introText(document.querySelector('[data-news-intro]'));

  // Filter: ohne JavaScript ist einfach alles sichtbar.
  const bar = document.querySelector<HTMLElement>('[data-news-filter]');
  const posts = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const months = [...document.querySelectorAll<HTMLElement>('[data-month]')];
  const empty = document.querySelector<HTMLElement>('[data-news-empty]');
  const lang = document.documentElement.lang.startsWith('en') ? 'en' : 'de';
  const count = (n: number) => (lang === 'en' ? `${n} ${n === 1 ? 'post' : 'posts'}` : `${n} ${n === 1 ? 'Beitrag' : 'Beiträge'}`);
  if (bar) {
    bar.hidden = false;
    const apply = (cat: string) => {
      bar.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      // „Alle“: Titelthema steht oben, nicht noch einmal in der Liste
      posts.forEach((p) => (p.hidden = cat === 'Alle' ? p.hasAttribute('data-lead') : p.dataset.cat !== cat));
      let total = 0;
      months.forEach((m) => {
        const n = m.querySelectorAll('[data-post]:not([hidden])').length;
        total += n;
        m.hidden = n === 0;
        const c = m.querySelector('[data-month-count]');
        if (c) c.textContent = count(n);
      });
      if (empty) empty.hidden = total > 0;
    };
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cat]');
      if (btn?.dataset.cat) apply(btn.dataset.cat);
    });
  }
</script>

<style>
  /* ---------- Intro ---------- */
  .ni { position: relative; background: var(--purple); color: #fff; overflow: hidden; }
  .ni__inner { padding-top: clamp(56px, 8vw, 104px); }
  .ni__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 32px; margin-bottom: 28px; }
  .ni__place, .ni__lead-meta, .ni__call-d {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--on-dark-soft);
  }
  .ni__title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(64px, 11vw, 176px); line-height: 0.86;
    letter-spacing: -0.045em; margin: 0 0 clamp(44px, 6vw, 80px); color: #fff;
  }
  .ni__title em { font-style: normal; color: var(--magenta); }
  .ni__lead {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 28px clamp(28px, 4vw, 64px);
    align-items: end; color: #fff; padding-bottom: clamp(40px, 5vw, 64px);
  }
  .ni__lead:hover { color: var(--cyan); }
  .ni__lead-img {
    position: relative; aspect-ratio: 16 / 10; background: #000; overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 86%, 92% 100%, 0 100%);
  }
  .ni__lead-img :global(img), .post__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ni__corner { position: absolute; top: 0; left: 0; width: 36px; height: 36px; background: var(--magenta); }
  .ni__lead-text { display: flex; flex-direction: column; gap: 16px; padding-bottom: 6px; }
  .ni__lead-meta { color: var(--cyan); }
  .ni__lead-title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(32px, 3.8vw, 56px); line-height: 0.98;
    letter-spacing: -0.03em; margin: 0; color: inherit; transition: color var(--dur-base); text-wrap: balance;
  }
  .ni__lead-teaser { margin: 0; max-width: 520px; font-size: 16.5px; line-height: 1.6; color: rgba(255, 255, 255, 0.88); text-wrap: pretty; }
  .ni__lead-more {
    align-self: flex-start; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: #fff; border-bottom: 1.5px solid var(--magenta); padding-bottom: 4px;
  }
  .ni__none { margin: 0; padding-bottom: 64px; color: var(--on-dark-soft); }
  .ni__calls { border-top: 1px solid var(--on-dark-rule); }
  .ni__calls-inner { padding-block: 18px 30px; display: flex; flex-direction: column; gap: 12px; }
  .ni__call { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 20px; color: #fff; }
  .ni__call:hover { color: var(--cyan); }
  .ni__call[hidden] { display: none; }
  .ni__call-k {
    display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan);
  }
  .ni__dot { width: 8px; height: 8px; background: var(--magenta); }
  .ni__call-title { font-family: var(--font-display); font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
  .ni :global(.ni__keil) { position: absolute; left: 0; bottom: 0; width: 34%; z-index: 2; }

  /* ---------- Chronik ---------- */
  .journal { scroll-margin-top: var(--header-h); }
  .journal__head {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 40px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .journal__head :global(.tag) { margin-bottom: 16px; }
  .journal__empty { margin: 0 0 40px; color: var(--ink-soft); }
  .month {
    display: grid; grid-template-columns: clamp(80px, 16vw, 220px) minmax(0, 1fr); gap: 0 clamp(16px, 3vw, 40px);
    border-top: 2px solid var(--purple); margin-bottom: clamp(40px, 5vw, 64px);
  }
  .month[hidden] { display: none; }
  .month__label {
    position: sticky; top: calc(var(--header-h) + 26px); align-self: start; padding: 22px 0 24px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .month__dot { width: 10px; height: 10px; background: var(--magenta); margin-bottom: 6px; }
  .month__mo {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(34px, 5.2vw, 76px); line-height: 0.88;
    letter-spacing: -0.045em; color: var(--purple);
  }
  .month__name, .month__count {
    margin: 0; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .month__name { color: var(--ink-muted); }
  .month__count { color: var(--magenta-2); }
  .month__posts { min-width: 0; display: flex; flex-direction: column; padding-top: 8px; }

  .post { color: var(--purple); transition: background var(--dur-base), border-color var(--dur-base); }
  .post[hidden] { display: none; }
  .post__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .post__nr {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted);
  }
  .post__body { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .post__title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(26px, 2.8vw, 38px); line-height: 1.02;
    letter-spacing: -0.03em; margin: 0; color: var(--purple); text-wrap: balance;
  }
  .post__teaser { margin: 0; max-width: 640px; font-size: 15px; line-height: 1.6; color: var(--ink-soft); text-wrap: pretty; }
  .post__more, .post__q-more {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--magenta-2);
  }

  .post--photo, .post--text { padding: 24px 16px; border-bottom: 1px solid var(--rule); }
  .post--photo:hover, .post--text:hover, .post--call:hover { background: var(--tint); }
  .post--photo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 20px clamp(20px, 3vw, 36px); align-items: center; }
  .post__img {
    position: relative; aspect-ratio: 4 / 3; background: var(--purple); overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 84%, 88% 100%, 0 100%);
  }
  .post--text { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: end; padding-block: 28px; }
  .post--text .post__title { font-size: clamp(28px, 3.4vw, 46px); line-height: 1; }
  .post__arrow { font-family: var(--font-display); font-size: 26px; color: var(--purple); }

  .post--call {
    display: flex; flex-wrap: wrap; align-items: stretch; gap: 20px 28px; padding: 26px clamp(18px, 2.4vw, 28px);
    margin: 16px 0; border: 1.5px solid var(--purple);
  }
  .post--call:hover { border-color: var(--magenta); }
  .post--call .post__body { flex: 1 1 280px; }
  .post--call .post__title { font-size: clamp(26px, 3vw, 40px); }
  .post__deadline {
    flex: 0 0 auto; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px;
    border-left: 1px solid var(--rule); padding-left: clamp(18px, 2.4vw, 28px);
  }
  .post__dl-k, .post__dl-u, .post__dl-d {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted);
  }
  .post__dl-u { color: var(--purple); }
  .post__dl-d { letter-spacing: 0.14em; margin-top: 6px; }
  .post__dl-n {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(52px, 6vw, 84px); line-height: 0.88;
    letter-spacing: -0.04em; color: var(--magenta);
  }

  .post--quote {
    display: flex; flex-direction: column; gap: 18px; background: var(--cyan); color: var(--purple); margin: 16px 0;
    padding: clamp(26px, 4vw, 48px) clamp(22px, 4vw, 48px) clamp(36px, 5vw, 60px);
    clip-path: polygon(0 0, 100% 0, 100% 80%, 94% 100%, 0 100%);
  }
  .post--quote:hover { box-shadow: inset 0 0 0 2px var(--purple); }
  .post--quote .post__nr { color: var(--purple); }
  .post__q-mark { display: block; position: relative; height: 44px; }
  .post__q-mark span {
    position: absolute; left: -4px; bottom: -14px; font-family: var(--font-display); font-weight: 800;
    font-size: 120px; line-height: 1; color: var(--magenta);
  }
  .post__quote {
    margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(24px, 2.9vw, 38px); line-height: 1.14;
    letter-spacing: -0.02em; max-width: 820px; text-wrap: balance;
  }
  .post__q-foot {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px 24px;
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .post__q-more { color: var(--purple); border-bottom: 1.5px solid var(--purple); padding-bottom: 3px; }

  /* ---------- Newsletter ---------- */
  .stay {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px;
    border-top: 2px solid var(--purple); padding-top: 32px;
  }
  .stay__text { max-width: 560px; }
  .stay__h { margin: 0 0 8px; font-family: var(--font-display); font-weight: 800; font-size: 28px; letter-spacing: -0.02em; color: var(--purple); }
  .stay__p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  .stay__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; }
  .stay__rss { color: var(--ink-soft); letter-spacing: 0.14em; }
  .stay__rss:hover { color: var(--magenta); }

  @media (max-width: 640px) {
    .month { grid-template-columns: minmax(0, 1fr); }
    .month__label { position: static; flex-direction: row; align-items: baseline; flex-wrap: wrap; gap: 6px 14px; padding-bottom: 8px; }
    .month__dot { align-self: center; margin: 0; }
    .month__mo { font-size: 34px; }
  }
</style>
