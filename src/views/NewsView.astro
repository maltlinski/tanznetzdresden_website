---
/**
 * News-Übersicht („Aus dem Netz.“, Entwurf News v4): Titelthema, offene Fristen und die Chronik als Archiv
 * mit Suche, Rubriken, Jahren, Sortierung, Ansicht (Liste/Kompakt) und „Weitere laden“ (src/scripts/news-chronik.ts).
 */
import Page from '../layouts/Page.astro';
import Tag from '../components/ui/Tag.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import KeilBar from '../components/ui/KeilBar.astro';
import NewsImage from '../components/NewsImage.astro';
import ProtectedEmail from '../components/ProtectedEmail.astro';
import {
  getNews, leadPost, daysLeft, deadlineText, dateLong, dateShort, monthLong, monthShort,
  newsBadge, newsCategoryLabel, type NewsCategory, type NewsPost,
} from '../lib/news';
import { newsCategories } from '../content.config';
import { getVerein } from '../lib/settings';
import { href } from '../lib/url';
import { getLang, tr, url } from '../lib/i18n';
import { fuellen, texte, zeilen } from '../lib/texte';

const lang = getLang(Astro);
const verein = getVerein(lang);
const posts = await getNews(lang);
const lead = leadPost(posts);
const open = posts.filter((p) => p.deadline && daysLeft(p.deadline) >= 0);
const year = new Date().getFullYear();
const u = texte(lang, 'news', 'uebersicht');
const [l1, l2] = zeilen(u.titel);
const t = { ...u, l1, l2 };
const link = (p: NewsPost) => url(lang, 'news', `${p.id}/`);
const count = (n: number) => `${n} ${n === 1 ? t.post : t.posts}`;
const a = tr(lang, {
  de: { filter: 'Nach Kategorie filtern', suche: 'Beiträge durchsuchen', leeren: 'Suche leeren', sortierung: 'Sortierung', ansicht: 'Ansicht', jahr: 'Jahr' },
  en: { filter: 'Filter by category', suche: 'Search posts', leeren: 'Clear search', sortierung: 'Sort order', ansicht: 'View', jahr: 'Year' },
});
/** 12. Okt / 12 Oct (kompakte Zeile) */
const datumKurz = (iso: string) => (lang === 'de' ? `${iso.slice(8, 10)}. ${monthShort(iso, lang)}` : `${Number(iso.slice(8, 10))} ${monthShort(iso, lang)}`);

// Chronik: Jahre → Monate (ohne JavaScript; src/scripts/news-chronik.ts gruppiert beim Filtern neu).
// Das Titelthema steht oben und ist erst beim Filtern in der Liste.
const jahresGruppen: { jahr: number; n: number; monate: { key: string; date: string; posts: NewsPost[] }[] }[] = [];
for (const p of posts) {
  if (p === lead) continue;
  const jahr = Number(p.date.slice(0, 4));
  let j = jahresGruppen.at(-1);
  if (j?.jahr !== jahr) jahresGruppen.push((j = { jahr, n: 0, monate: [] }));
  j.n++;
  const key = p.date.slice(0, 7);
  const g = j.monate.at(-1);
  if (g?.key === key) g.posts.push(p);
  else j.monate.push({ key, date: p.date, posts: [p] });
}
// der Titelbeitrag steht trotzdem im HTML (versteckt), damit Filter und Suche ihn finden
if (lead) {
  const jahr = Number(lead.date.slice(0, 4));
  const j = jahresGruppen.find((g) => g.jahr === jahr) ?? jahresGruppen[0];
  if (j) (j.monate.find((g) => g.key === lead.date.slice(0, 7)) ?? j.monate[0]).posts.unshift(lead);
}
const cats = (['Alle', ...newsCategories] as const).map((c) => ({
  id: c,
  label: newsCategoryLabel[lang][c],
  n: c === 'Alle' ? posts.length - (lead ? 1 : 0) : posts.filter((p) => p.category === c).length,
}));
const jahreAlle = [...new Set(posts.map((p) => Number(p.date.slice(0, 4))))].sort((x, y) => y - x);
const von = jahreAlle.at(-1) ?? year;
const bis = jahreAlle[0] ?? year;
const jahre = [
  { id: 'alle', label: newsCategoryLabel[lang].Alle, n: posts.length - (lead ? 1 : 0) },
  ...jahreAlle.map((y) => ({ id: String(y), label: String(y), n: posts.filter((p) => p.date.startsWith(String(y))).length })),
];
const jsTexte = {
  post: t.post, posts: t.posts, deadline: t.deadline, mehr: t.mehr, gezeigt: t.gezeigt,
  kategorien: Object.fromEntries(newsCategories.map((c) => [c, newsCategoryLabel[lang][c]])),
};
const feed = href(lang === 'de' ? 'news.xml' : 'en/news.xml');
---
<Page route="news" title={t.title} description={t.description}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`${verein.name} – News`} href={feed} />

  <section class="ni" aria-labelledby="news-title" data-news-intro>
    <div class="wrap ni__inner">
      <div class="ni__top">
        <div data-rise="0.05"><Tag color="cyan">{t.kicker}</Tag></div>
        <span class="ni__place" data-rise="0.15">Dresden · {year}</span>
      </div>
      <h1 id="news-title" class="ni__title">
        <span data-sweep="0.25" data-bar="var(--cyan)">{t.l1}</span><br /><em data-sweep="0.5" data-bar="var(--magenta)">{t.l2}</em>
      </h1>
      {lead ? (
        <a href={link(lead)} class="ni__lead" data-rise="0.95">
          <div class="ni__lead-img">
            {lead.image && <NewsImage src={lead.image} alt={lead.alt ?? ''} focus={lead.imageFocus} sizes="(min-width: 900px) 620px, 100vw" loading="eager" />}
            <span class="ni__corner" aria-hidden="true"></span>
          </div>
          <div class="ni__lead-text">
            <span class="ni__lead-meta">{t.featured} · {dateLong(lead.date, lang)}</span>
            <h2 class="ni__lead-title">{lead.title}</h2>
            <p class="ni__lead-teaser">{lead.teaser}</p>
            <span class="ni__lead-more">{t.read} · {lead.minutes} {t.min} →</span>
          </div>
        </a>
      ) : <p class="ni__none">{t.none}</p>}
    </div>
    {open.length > 0 && (
      <div class="ni__calls">
        <div class="wrap ni__calls-inner">
          {open.map((p) => (
            <a href={link(p)} class="ni__call" data-rise="1.25" data-deadline={p.deadline} data-deadline-open>
              <span class="ni__call-k"><span class="ni__dot" aria-hidden="true"></span>{t.openCall}</span>
              <span class="ni__call-title">{p.title}</span>
              <span class="ni__call-d">
                {dateShort(p.deadline!, lang)} · <span data-deadline={p.deadline} data-deadline-part="label">{deadlineText(daysLeft(p.deadline!), 'label', lang)}</span> →
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
    <KeilBar class="ni__keil" />
  </section>

  <section id="journal" class="section journal" aria-labelledby="journal-h" data-chronik data-ansicht="liste" data-texte={JSON.stringify(jsTexte)}>
    <div class="wrap">
      <div class="journal__head">
        <div>
          <Tag>{fuellen(t.archiv, { jahr: von })}</Tag>
          <h2 id="journal-h" class="h2">{t.chronicle}</h2>
        </div>
        <span class="journal__summe">{fuellen(t.summe, { zahl: posts.length, von, bis })}</span>
      </div>

      <!-- Werkzeugleiste: ohne JavaScript ausgeblendet, dann ist einfach alles sichtbar -->
      <div class="jt" data-leiste hidden>
        <div class="jt__reihe">
          <label class="jt__suche">
            <span class="jt__punkt" aria-hidden="true"></span>
            <input type="search" data-suche placeholder={t.suche} aria-label={a.suche} autocomplete="off" />
            <button type="button" class="jt__leeren" data-suche-leeren aria-label={a.leeren} hidden>×</button>
          </label>
          <div class="jt__gruppe" role="group" aria-label={a.sortierung}>
            {(['neu', 'alt', 'az'] as const).map((k) => (
              <button type="button" data-sort={k} aria-pressed={k === 'neu' ? 'true' : 'false'}>{{ neu: t.neueste, alt: t.aelteste, az: t.az }[k]}</button>
            ))}
          </div>
          <div class="jt__gruppe" role="group" aria-label={a.ansicht}>
            {(['liste', 'kompakt'] as const).map((k) => (
              <button type="button" data-ansicht={k} aria-pressed={k === 'liste' ? 'true' : 'false'}>{t[k]}</button>
            ))}
          </div>
        </div>
        <div class="jt__chips" role="group" aria-label={a.filter}>
          {cats.filter((c) => c.n > 0).map((c) => (
            <button type="button" class="chip" data-kat={c.id} aria-pressed={c.id === 'Alle' ? 'true' : 'false'}>
              {c.label}<span class="chip__count">{c.n}</span>
            </button>
          ))}
        </div>
        <div class="jt__jahre" role="group" aria-label={a.jahr}>
          {jahre.map((j) => (
            <button type="button" class="jt__jahr" data-jahr={j.id} aria-pressed={j.id === 'alle' ? 'true' : 'false'}>
              <span class="jt__jahr-l">{j.label}</span><span class="jt__jahr-n">{j.n}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="jr" data-ergebnis-zeile hidden>
        <span class="jr__text" data-ergebnis aria-live="polite"></span>
        <button type="button" class="jr__zurueck" data-zuruecksetzen hidden>{t.zuruecksetzen}</button>
      </div>
      <div class="jleer" data-leer hidden>
        <p class="jleer__h">{t.leer}</p>
        <p class="jleer__p">{t.empty}</p>
      </div>

      <div class="jliste" data-liste>
        {jahresGruppen.map((j) => (
          <div class="jjahr">
            <div class="jjahr__kopf"><h3 class="jjahr__zahl">{j.jahr}</h3><span class="jjahr__n">{count(j.n)}</span></div>
            {j.monate.map((g) => (
              <div class="jmonat">
                <div class="jmonat__label">
                  <span class="jmonat__punkt"></span>
                  <span class="jmonat__mo" aria-hidden="true">{monthShort(g.date, lang)}</span>
                  <span class="jmonat__name">{monthLong(g.date, lang)}</span>
                  <span class="jmonat__n">{count(g.posts.filter((p) => p !== lead).length)}</span>
                </div>
                <div class="jmonat__posts">
                  {g.posts.map((p) => {
                    const cat = newsCategoryLabel[lang][p.category as NewsCategory];
                    const meta = (
                      <div class="post__meta">
                        <span class="post__datum">{dateShort(p.date, lang)}</span>
                        <Badge variant={newsBadge[p.category]}>{cat}</Badge>
                      </div>
                    );
                    return (
                      <div
                        class="eintrag" data-post data-cat={p.category} data-date={p.date} data-titel={p.title}
                        data-suchtext={[p.title, p.teaser, p.author, cat, p.quote?.who].filter(Boolean).join(' ').toLowerCase()}
                        data-lead={p === lead ? '' : undefined} hidden={p === lead} data-frist={p.deadline ?? undefined}
                        data-minuten={`${p.minutes} ${t.min}`} data-mo={monthShort(p.date, lang)} data-monat={monthLong(p.date, lang)}
                      >
                        <a href={link(p)} class:list={['post', `post--${p.kind}`]}>
                          {p.kind === 'photo' && (
                            <>
                              <div class="post__img">{p.image && <NewsImage src={p.image} alt={p.alt ?? ''} focus={p.imageFocus} sizes="(min-width: 1000px) 560px, 100vw" />}</div>
                              <div class="post__body">
                                {meta}
                                <h4 class="post__title">{p.title}</h4>
                                <p class="post__teaser">{p.teaser}</p>
                                <span class="post__more">{t.readShort} · {p.minutes} {t.min} →</span>
                              </div>
                            </>
                          )}
                          {p.kind === 'text' && (
                            <>
                              <div class="post__body">
                                {meta}
                                <h4 class="post__title">{p.title}</h4>
                                <p class="post__teaser">{p.teaser}</p>
                              </div>
                              <span class="post__arrow" aria-hidden="true">→</span>
                            </>
                          )}
                          {p.kind === 'call' && (
                            <>
                              <div class="post__body">
                                {meta}
                                <h4 class="post__title">{p.title}</h4>
                                <p class="post__teaser">{p.teaser}</p>
                              </div>
                              <div class="post__deadline">
                                <span class="post__dl-k">{t.deadline}</span>
                                <span class="post__dl-n" data-deadline={p.deadline} data-deadline-part="n">{deadlineText(daysLeft(p.deadline!), 'n', lang)}</span>
                                <span class="post__dl-u">
                                  <span data-deadline={p.deadline} data-deadline-part="unit">{deadlineText(daysLeft(p.deadline!), 'unit', lang)}</span> · {t.until} {dateShort(p.deadline!, lang)}
                                </span>
                              </div>
                            </>
                          )}
                          {p.kind === 'quote' && p.quote && (
                            <>
                              {meta}
                              <blockquote class="post__quote"><span class="post__q-mark" aria-hidden="true">„</span>{p.quote.text}<span aria-hidden="true">“</span></blockquote>
                              <span class="visually-hidden">{p.title}</span>
                              <span class="post__q-foot">{p.quote.who}{p.quote.role && ` · ${p.quote.role}`} →</span>
                            </>
                          )}
                        </a>
                        <a href={link(p)} class="zeile">
                          <span class="zeile__datum">{datumKurz(p.date)}</span>
                          <span class="zeile__mitte"><span class="zeile__titel">{p.title}</span><Badge variant={newsBadge[p.category]}>{cat}</Badge></span>
                          <span class="zeile__rechts" data-rechts>{p.minutes} {t.min}</span>
                        </a>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>

      <div class="jmehr" data-mehr hidden>
        <span class="jmehr__text" data-mehr-text></span>
        <div class="jmehr__balken"><span data-mehr-balken></span></div>
        <button type="button" class="jmehr__knopf" data-mehr-knopf></button>
      </div>

      <div class="stay">
        <div class="stay__text">
          <p class="stay__h">{t.stayH}</p>
          <p class="stay__p">{t.stayP}</p>
        </div>
        <div class="stay__actions">
          <Button href={url(lang, 'home', '#newsletter')} variant="primary" marker>{t.newsletter}</Button>
          <ProtectedEmail email={verein.emails.kontakt} label={`${t.submit} →`} subject="Meldung für die News" class="stay__mail" />
          <a class="mono-link stay__rss" href={feed}>{t.rss}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<script>
  import { introText } from '../scripts/intro-text';
  import { initChronik } from '../scripts/news-chronik';
  import '../scripts/deadline';

  introText(document.querySelector('[data-news-intro]'));
  const chronik = document.querySelector<HTMLElement>('[data-chronik]');
  if (chronik) initChronik(chronik);
</script>

<style>
  /* ---------- Intro ---------- */
  /* so hoch wie der Kopf der Startseite (--buehne-h) */
  .ni { position: relative; display: flex; flex-direction: column; min-height: var(--buehne-h); background: var(--purple); color: #fff; overflow: hidden; }
  .ni__inner { flex: 1; width: 100%; display: flex; flex-direction: column; justify-content: center; padding-top: var(--buehne-oben); }
  .ni__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 32px; margin-bottom: 20px; }
  .ni__place, .ni__lead-meta, .ni__call-d {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--on-dark-soft);
  }
  .ni__title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(64px, min(11vw, 15vh), 176px); line-height: 0.86;
    letter-spacing: -0.045em; margin: 0 0 clamp(32px, 5vh, 64px); color: #fff;
  }
  .ni__title em { font-style: normal; color: var(--magenta); }
  .ni__lead {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 28px clamp(28px, 4vw, 64px);
    align-items: end; color: #fff; padding-bottom: clamp(28px, 4vh, 48px);
  }
  .ni__lead:hover { color: var(--cyan); }
  .ni__lead-img {
    position: relative; width: 100%; aspect-ratio: 16 / 10; max-height: 30vh; min-height: 180px; background: #000; overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 86%, 92% 100%, 0 100%);
  }
  .ni__lead-img :global(img), .post__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ni__corner { position: absolute; top: 0; left: 0; width: 36px; height: 36px; background: var(--magenta); }
  .ni__lead-text { display: flex; flex-direction: column; gap: 16px; padding-bottom: 6px; }
  .ni__lead-meta { color: var(--cyan); }
  .ni__lead-title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(32px, 3.8vw, 56px); line-height: 0.98;
    letter-spacing: -0.03em; margin: 0; color: inherit; transition: color var(--dur-base); text-wrap: balance;
  }
  /* lange Titel und Teaser (Beiträge der alten Website) kürzen, damit die Bühne so hoch bleibt wie überall */
  .ni__lead-title, .ni__lead-teaser { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }
  .ni__lead-teaser { margin: 0; max-width: 520px; font-size: 16.5px; line-height: 1.6; color: rgba(255, 255, 255, 0.88); text-wrap: pretty; }
  .ni__lead-more {
    align-self: flex-start; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: #fff; border-bottom: 1.5px solid var(--magenta); padding-bottom: 4px;
  }
  .ni__none { margin: 0; padding-bottom: 64px; color: var(--on-dark-soft); }
  .ni__calls { border-top: 1px solid var(--on-dark-rule); }
  .ni__calls-inner { padding-block: 16px 26px; display: flex; flex-direction: column; gap: 12px; }
  .ni__call { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 20px; color: #fff; }
  .ni__call:hover { color: var(--cyan); }
  .ni__call[hidden] { display: none; }
  .ni__call-k {
    display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan);
  }
  .ni__dot { width: 8px; height: 8px; background: var(--magenta); }
  .ni__call-title { font-family: var(--font-display); font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
  .ni :global(.ni__keil) { position: absolute; left: 0; bottom: 0; width: 34%; z-index: 2; }

  /* ---------- Newsletter ---------- */
  .stay {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px;
    border-top: 2px solid var(--purple); padding-top: 32px;
  }
  .stay__text { max-width: 560px; }
  .stay__h { margin: 0 0 8px; font-family: var(--font-display); font-weight: 800; font-size: 28px; letter-spacing: -0.02em; color: var(--purple); }
  .stay__p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  .stay__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; }
  .stay__rss { color: var(--ink-soft); letter-spacing: 0.14em; }
  .stay__rss:hover { color: var(--magenta); }

</style>

<style is:global>
  /* Chronik: Jahres- und Monatsköpfe baut src/scripts/news-chronik.ts, deshalb global (alles unter .journal) */
  /* ---------- Chronik (Archiv) ---------- */
  /* --jt-h: Höhe der Werkzeugleiste, misst src/scripts/news-chronik.ts */
  .journal { --jt-h: 210px; scroll-margin-top: var(--header-h); padding-block: clamp(48px, 6vw, 80px) clamp(56px, 8vw, 104px); }
  .journal__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px; margin-bottom: 24px; }
  .journal__head .tag { margin-bottom: 16px; }
  .journal__summe, .journal .jr__text, .journal .jmehr__text {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted);
  }

  /* Werkzeugleiste: klebt unter dem Kopf der Seite */
  .journal .jt {
    position: sticky; top: var(--header-h); z-index: 20; background: var(--paper);
    margin-inline: calc(-1 * var(--gutter)); padding: 14px var(--gutter) 0; border-bottom: 2px solid var(--purple);
  }
  .journal .jt[hidden] { display: none; }
  .journal .jt__reihe { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .journal .jt__suche {
    flex: 1 1 260px; min-width: 0; display: flex; align-items: center; gap: 10px; height: 44px; padding: 0 14px;
    border: 1.5px solid var(--purple); background: var(--paper);
  }
  .journal .jt__suche:focus-within { border-color: var(--magenta); }
  .journal .jt__punkt { flex: none; width: 8px; height: 8px; background: var(--magenta); }
  .journal .jt__suche input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; font: inherit; font-size: 15px; color: var(--purple); }
  .journal .jt__suche input::placeholder { color: var(--ink-muted); }
  .journal .jt__suche input::-webkit-search-cancel-button { display: none; }
  .journal .jt__leeren { border: 0; background: transparent; color: var(--ink-muted); font-size: 18px; cursor: pointer; padding: 0 2px; }
  .journal .jt__leeren:hover { color: var(--magenta-2); }
  .journal .jt__gruppe { display: flex; border: 1.5px solid var(--purple); }
  .journal .jt__gruppe button {
    height: 41px; padding: 0 14px; border: 0; border-radius: 0; background: var(--paper); color: var(--purple); cursor: pointer;
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .journal .jt__gruppe button:hover { color: var(--magenta-2); }
  .journal .jt__gruppe button[aria-pressed='true'] { background: var(--purple); color: #fff; }
  .journal .jt__chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .journal .jt__chips .chip { padding: 7px 11px; font-size: 10.5px; gap: 7px; border-color: var(--rule); }
  .journal .jt__chips .chip[aria-pressed='true'] { border-color: var(--purple); }
  .journal .jt__chips .chip:hover { border-color: var(--magenta); }
  .journal .jt__chips .chip.is-leer { opacity: 0.4; }
