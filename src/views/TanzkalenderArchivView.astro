---
/**
 * Tanzkalender-Archiv (Entwurf Tanzkalender Archiv, November 2026): alle Ausgaben des Monatsplakats
 * 2024–2026 nach Jahrgang, mit Großansicht zum Blättern und PDF. Gehört zum Archiv der Formate-Seite.
 * Ausgaben: src/content/formate-archiv/tanzkalender.yaml; Plakate und PDFs übernimmt `npm run archiv:laden`
 * (bis dahin die Dateien der alten Website). Großansicht: src/scripts/tanzkalender-archiv.ts.
 */
import { Image, getImage } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Button from '../components/ui/Button.astro';
import KeilBar from '../components/ui/KeilBar.astro';
import { getTanzkalenderAusgaben, type Ausgabe } from '../lib/formate';
import { getLang, tr, url } from '../lib/i18n';
import { fuellen, texte, zeilen } from '../lib/texte';

const lang = getLang(Astro);
const k = texte(lang, 'tanzkalenderArchiv', 'kopf');
const l = texte(lang, 'tanzkalenderArchiv', 'liste');
const v = texte(lang, 'tanzkalenderArchiv', 'ansicht');
// nur für Screenreader
const sr = tr(lang, {
  de: { pfad: 'Brotkrumen', jahre: 'Nach Jahrgang filtern', ansehen: '{label} ansehen', pdf: '{label} als PDF (öffnet in neuem Tab)', zu: 'Schließen', vor: 'Vorherige Ausgabe', nach: 'Nächste Ausgabe', plakat: 'Plakat Tanzkalender Dresden, {label}' },
  en: { pfad: 'Breadcrumb', jahre: 'Filter by year', ansehen: 'View {label}', pdf: '{label} as PDF (opens in a new tab)', zu: 'Close', vor: 'Previous issue', nach: 'Next issue', plakat: 'Tanzkalender Dresden poster, {label}' },
});

const ausgaben = await getTanzkalenderAusgaben(lang);
const gesamt = String(ausgaben.length);
const jahre = [...new Set(ausgaben.map((a) => a.jahr))];
const [t1, t2] = zeilen(k.titel);

/** Vorschau und große Fassung: eigene Datei (nach archiv:laden), sonst die Größen der alten Website */
const vorschauAlt = (a: Ausgabe) => a.plakatAlt.replace(/\.jpg$/, a.breit ? '-734x1024.jpg' : '-367x1024.jpg');
const gross = await Promise.all(
  ausgaben.map(async (a) => (a.plakat ? (await getImage({ src: a.plakat, width: Math.min(a.plakat.width, 1100), format: 'webp', quality: 82 })).src : a.plakatAlt)),
);
const kopfAusgaben = ausgaben.filter((a) => a.kopf).slice(0, 3);
const versatz = ['0px', '48px', '16px'];
const daten = JSON.stringify(
  ausgaben.map((a, i) => ({ nr: a.nr, label: a.label, gross: gross[i], pdf: a.pdf, alt: fuellen(sr.plakat, { label: a.label }), jahr: a.jahr })),
).replace(/</g, '\\u003c');
---
<Page title={k.title} description={k.desc} route="tanzkalenderArchiv">
  <section class="tka-kopf kopf" data-kopf-auftritt>
    <div class="wrap tka-kopf__grid">
      <div class="tka-kopf__text">
        <nav class="tka-pfad kopf__kicker" aria-label={sr.pfad}>
          <a href={url(lang, 'formate')}>{k.formate}</a>
          <span aria-hidden="true">·</span>
          <a href={url(lang, 'formate', '#archiv')}>{k.archiv}</a>
          <span aria-hidden="true">·</span>
          <span aria-current="page">{k.hier}</span>
        </nav>
        <h1 class="tka-h1">{t1}<br />{t2}<br /><span>{fuellen(k.anzahl, { zahl: gesamt })}</span></h1>
        <p class="tka-lead" data-kopf-folgt>{k.lead}</p>
        <p class="tka-lead tka-lead--zwei" data-kopf-folgt>{k.lead2}</p>
        <div class="tka-kopf__links" data-kopf-folgt>
          <Button href="#ausgaben" variant="secondary" size="lg" marker>{k.alle}</Button>
          <a class="tka-kalender" href={url(lang, 'termine')}>{k.kalender}</a>
        </div>
      </div>
      <div class="tka-kopf__plakate" aria-hidden="true">
        {kopfAusgaben.map((a, i) => (
          <button type="button" class="tka-kopf__plakat" tabindex="-1" style={`margin-top:${versatz[i]}`} data-oeffnen={ausgaben.indexOf(a)}>
            {a.plakat
              ? <Image src={a.plakat} alt="" widths={[240, 480]} sizes="(min-width: 900px) 14vw, 30vw" loading="eager" data-wipe />
              : <img src={vorschauAlt(a)} alt="" data-wipe />}
          </button>
        ))}
      </div>
    </div>
    <KeilBar color="var(--magenta)" height={10} class="tka-kopf__keil" />
  </section>

  <section class="tka-liste" id="ausgaben" aria-label={k.alle}>
    <div class="wrap">
      <div class="tka-filter" role="group" aria-label={sr.jahre} hidden data-tka-filter>
        <span class="tka-filter__k" aria-hidden="true">{l.jahrgang}</span>
        <div class="tka-chips">
          <button type="button" class="tka-chip" aria-pressed="true" data-jahr="">{l.alle} <span>{ausgaben.length}</span></button>
          {jahre.map((j) => (
            <button type="button" class="tka-chip" aria-pressed="false" data-jahr={j}>{j} <span>{ausgaben.filter((a) => a.jahr === j).length}</span></button>
          ))}
        </div>
      </div>

      {jahre.map((j) => {
        const liste = ausgaben.filter((a) => a.jahr === j);
        return (
          <div class="tka-jahr" data-tka-jahr={j}>
            <div class="tka-jahr__kopf">
              <div class="tka-jahr__sticky">
                <h2 class="tka-jahr__zahl" data-reveal>{j}</h2>
                <p class="tka-jahr__n"><span aria-hidden="true"></span>{liste.length} {liste.length === 1 ? l.ausgabe : l.ausgaben}</p>
              </div>
            </div>
            <ul class="tka-grid">
              {liste.map((a) => {
                const i = ausgaben.indexOf(a);
                return (
                  <li class:list={['tka-ausgabe', a.breit && 'tka-ausgabe--breit']}>
                    <button type="button" class="tka-plakat" tabindex="-1" aria-hidden="true" data-oeffnen={i}>
                      {a.plakat
                        ? <Image src={a.plakat} alt="" widths={a.breit ? [400, 800] : [200, 400]} sizes={a.breit ? '(min-width: 760px) 360px, 90vw' : '(min-width: 760px) 180px, 45vw'} />
                        : <img src={vorschauAlt(a)} alt="" loading="lazy" />}
                    </button>
                    <div class="tka-ausgabe__text">
                      <span class="tka-ausgabe__nr">{fuellen(l.nr, { nr: a.nr })} · {a.code}</span>
                      <span class="tka-ausgabe__label">{a.label}</span>
                      <div class="tka-ausgabe__links">
                        <button type="button" class="tka-ansehen" aria-label={fuellen(sr.ansehen, { label: a.label })} data-oeffnen={i}>{l.ansehen}</button>
                        <a class="tka-pdf" href={a.pdf} target="_blank" rel="noopener" aria-label={fuellen(sr.pdf, { label: a.label })}>{l.pdf}</a>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}

      <div class="tka-fuss">
        <p>{l.dank}</p>
        <a class="tka-zurueck" href={url(lang, 'formate', '#archiv')}>{l.zurueck}</a>
      </div>
    </div>
  </section>

  <dialog class="tka-lb" aria-label={k.hier} data-tka-lb>
    <div class="tka-lb__bar">
      <span class="tka-lb__k"><span aria-hidden="true"></span><span data-lb-kopf>{fuellen(v.kopf, { nr: ausgaben[0]?.nr ?? '', gesamt })}</span></span>
      <span class="tka-lb__label" data-lb-label></span>
      <div class="tka-lb__aktionen">
        <Button href="#" variant="secondary" size="sm" marker target="_blank" rel="noopener" data-lb-pdf>{v.pdf}</Button>
        <button type="button" class="tka-lb__zu" aria-label={sr.zu} data-lb-zu>×</button>
      </div>
    </div>
    <div class="tka-lb__buehne">
      <button type="button" class="tka-lb__pfeil" aria-label={sr.vor} data-lb-vor>←</button>
      <div class="tka-lb__flaeche"><img class="tka-lb__img" alt="" data-lb-img /></div>
      <button type="button" class="tka-lb__pfeil" aria-label={sr.nach} data-lb-nach>→</button>
    </div>
    <p class="tka-lb__hinweis" aria-hidden="true">{v.hinweis}</p>
  </dialog>
  <script type="application/json" id="tka-daten" set:html={daten} />
  <script type="application/json" id="tka-texte" set:html={JSON.stringify({ kopf: v.kopf, gesamt })} />
</Page>

<script>
  import { initKopfAuftritt } from '../scripts/kopf-auftritt';
  import { initTanzkalenderArchiv } from '../scripts/tanzkalender-archiv';
  initKopfAuftritt();
  initTanzkalenderArchiv();
</script>

<style>
  /* ---------- Kopf ---------- */
  .tka-kopf { position: relative; background: var(--purple); color: #fff; overflow: hidden; }
  .tka-kopf__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px clamp(32px, 6vw, 96px); align-items: start;
    padding-top: var(--buehne-oben); padding-bottom: clamp(56px, 7vw, 96px);
  }
  .tka-kopf__text { min-width: 0; }
  /* Regel „Köpfe“: der Pfad steht als erste Zeile, die Headline --kopf-kicker darunter */
  .tka-pfad { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-bottom: var(--kopf-kicker); font-family: var(--font-mono); font-size: var(--t-tag); line-height: 1; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  @media (max-width: 520px) { .tka-pfad { line-height: 1.5; } }
  .tka-pfad a { color: rgba(255, 255, 255, 0.72); }
  .tka-pfad a:hover { color: var(--cyan); }
  .tka-pfad span[aria-hidden] { color: rgba(255, 255, 255, 0.5); }
  .tka-pfad [aria-current] { color: var(--cyan); }
  .tka-h1 { margin: 0 0 28px; font-family: var(--font-display); font-weight: 800; font-size: clamp(44px, 6vw, 88px); line-height: 0.92; letter-spacing: -0.035em; color: #fff; }
  .tka-h1 span { color: var(--cyan); }
  .tka-lead { max-width: 500px; margin: 0 0 18px; font-size: clamp(16px, 1.3vw, 18px); line-height: 1.6; color: rgba(255, 255, 255, 0.9); text-wrap: pretty; }
  .tka-lead--zwei { margin-bottom: 32px; }
  .tka-kopf__links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; }
  .tka-kalender { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; border-bottom: 1.5px solid var(--magenta); padding-bottom: 4px; }
  .tka-kalender:hover { color: var(--cyan); }
  .tka-kopf__plakate { position: relative; min-width: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.4vw, 18px); align-items: start; }
  .tka-kopf__plakat { display: block; padding: 0; border: 0; border-radius: 0; background: rgba(255, 255, 255, 0.06); cursor: zoom-in; aspect-ratio: 367 / 1024; overflow: hidden; }
  .tka-kopf__plakat:hover { outline: 3px solid var(--magenta); outline-offset: 0; }
  .tka-kopf__plakat img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tka-kopf :global(.tka-kopf__keil) { position: absolute; left: 0; bottom: 0; width: 34%; }

  /* ---------- Ausgaben ---------- */
  .tka-liste { background: #fff; padding: clamp(48px, 6vw, 88px) 0 clamp(64px, 8vw, 112px); }
  .tka-filter { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-bottom: clamp(32px, 4vw, 56px); }
  .tka-filter[hidden] { display: none; }
  .tka-filter__k { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); }
  .tka-chips { flex: 1 1 auto; min-width: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tka-chip {
    display: flex; align-items: center; gap: 8px; padding: 9px 14px; border: 1.5px solid var(--purple); border-radius: 0; background: transparent; color: var(--purple); cursor: pointer;
    font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; transition: background var(--dur-base), color var(--dur-base);
  }
  .tka-chip:hover { border-color: var(--magenta); }
  .tka-chip span { color: var(--ink-muted); }
  .tka-chip[aria-pressed='true'] { background: var(--purple); color: #fff; }
  .tka-chip[aria-pressed='true'] span { color: var(--cyan); }

  .tka-jahr { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 24px clamp(24px, 4vw, 56px); padding: clamp(28px, 3vw, 40px) 0 clamp(40px, 5vw, 64px); border-top: 2px solid var(--purple); }
  .tka-jahr[hidden] { display: none; }
  .tka-jahr__kopf { min-width: 0; }
  .tka-jahr__sticky { position: sticky; top: calc(var(--header-h) + 40px); }
  .tka-jahr__zahl { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(48px, 5.4vw, 80px); line-height: 0.85; letter-spacing: -0.045em; color: var(--purple); }
  .tka-jahr__n { display: flex; align-items: center; gap: 10px; margin: 14px 0 0; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); }
  .tka-jahr__n span { width: 8px; height: 8px; background: var(--magenta); flex: none; }
  .tka-grid { min-width: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 36px clamp(16px, 2vw, 28px); align-items: start; margin: 0; padding: 0; list-style: none; }
  .tka-ausgabe { min-width: 0; display: flex; flex-direction: column; }
  .tka-ausgabe--breit { grid-column: span 2; }
  .tka-plakat { position: relative; display: block; width: 100%; padding: 0; border: 0; border-radius: 0; background: var(--tint); cursor: zoom-in; aspect-ratio: 367 / 1024; overflow: hidden; }
  .tka-ausgabe--breit .tka-plakat { aspect-ratio: 734 / 1024; }
  .tka-plakat:hover { outline: 3px solid var(--magenta); outline-offset: 0; }
  .tka-plakat img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; display: block; }
  .tka-ausgabe__text { display: flex; flex-direction: column; gap: 6px; padding-top: 14px; }
  .tka-ausgabe__nr { font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--magenta-2); }
  .tka-ausgabe__label { font-family: var(--font-display); font-weight: 800; font-size: 19px; line-height: 1.1; letter-spacing: -0.015em; color: var(--purple); }
  .tka-ausgabe__links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 4px; }
  .tka-ansehen { padding: 0; border: 0; background: transparent; cursor: pointer; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--purple); }
  .tka-ansehen:hover { color: var(--magenta-2); }
  .tka-pdf { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--magenta-2); border-bottom: 1.5px solid var(--magenta); padding-bottom: 2px; }
  .tka-pdf:hover { color: var(--purple); border-color: var(--purple); }
  .tka-fuss { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; padding-top: 28px; border-top: 1px solid var(--rule); }
  .tka-fuss p { max-width: 620px; margin: 0; font-size: 14px; line-height: var(--lh-text); color: var(--ink-soft); }
  .tka-zurueck { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--magenta-2); border-bottom: 1.5px solid var(--magenta); padding-bottom: 3px; }
  .tka-zurueck:hover { color: var(--purple); border-color: var(--purple); }
  @media (max-width: 759px) {
    .tka-jahr { grid-template-columns: minmax(0, 1fr); }
    .tka-jahr__sticky { position: static; }
  }
  @media (max-width: 559px) {
    .tka-ausgabe--breit { grid-column: auto; }
  }

  /* ---------- Großansicht ---------- */
  .tka-lb { position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: var(--purple); color: #fff; }
  .tka-lb[open] { display: flex; flex-direction: column; }
  .tka-lb::backdrop { background: var(--purple); }
  .tka-lb__bar { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 24px; padding: 16px clamp(16px, 3vw, 32px); border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .tka-lb__k { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); }
  .tka-lb__k > span:first-child { width: 8px; height: 8px; background: var(--magenta); }
  .tka-lb__label { font-family: var(--font-display); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; }
  .tka-lb__aktionen { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .tka-lb__zu, .tka-lb__pfeil {
    display: flex; align-items: center; justify-content: center; border: 1.5px solid rgba(255, 255, 255, 0.5); border-radius: 0; background: transparent; color: #fff;
    font-family: var(--font-display); line-height: 1; cursor: pointer;
  }
  .tka-lb__zu { width: 40px; height: 40px; font-size: 22px; }
  .tka-lb__pfeil { width: 48px; height: 48px; font-size: 24px; }
  .tka-lb__zu:hover, .tka-lb__pfeil:hover:not(:disabled) { border-color: var(--cyan); color: var(--cyan); }
  .tka-lb__pfeil:disabled { opacity: 0.3; cursor: default; }
  .tka-lb__buehne { flex: 1; min-height: 0; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: clamp(8px, 2vw, 24px); padding: clamp(12px, 2vw, 24px) clamp(8px, 2vw, 24px); }
  .tka-lb__flaeche { height: 100%; min-height: 0; display: flex; align-items: center; justify-content: center; }
  .tka-lb__img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; outline: 1px solid rgba(255, 255, 255, 0.12); }
  .tka-lb__hinweis { margin: 0; padding: 0 0 14px; text-align: center; font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); }
</style>
