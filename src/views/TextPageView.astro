---
/**
 * Textseite aus src/content/seiten/<id>.md (englisch: seiten/en/<id>.md).
 * Fehlt die englische Datei, erscheint die deutsche mit Hinweis.
 * Slots „before“/„after“ stehen vor/nach dem Markdown-Text (z. B. Pflichtangaben aus den Einstellungen).
 */
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import PageIntro from '../components/PageIntro.astro';
import Prose from '../components/Prose.astro';
import { getLang, tr, type RouteKey } from '../lib/i18n';

interface Props {
  id: string;
  route: RouteKey;
  kicker: string;
  /** Inhaltsverzeichnis anzeigen */
  toc?: boolean;
  /** Zusätzliche Einträge oben im Inhaltsverzeichnis (für Inhalte im Slot) */
  tocExtra?: { slug: string; text: string }[];
}
const { id, route, kicker, toc = false, tocExtra = [] } = Astro.props;
const lang = getLang(Astro);
const translated = lang === 'en' ? await getEntry('seiten', `en/${id}`) : undefined;
const entry = translated ?? (await getEntry('seiten', id));
if (!entry) throw new Error(`src/content/seiten/${id}.md fehlt`);
const { Content, headings } = await render(entry);
const t = tr(lang, {
  de: { contents: 'Inhalt', updated: 'Stand', fallback: '' },
  en: { contents: 'Contents', updated: 'Last updated', fallback: 'This page is only available in German.' },
});
const dateFmt = lang === 'en' ? 'en-GB' : 'de-DE';
const tocItems = [...tocExtra, ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }))];
---
<Page title={entry.data.title} description={entry.data.description} route={route}>
  <PageIntro kicker={kicker} title={entry.data.title} />
  <section class="section">
    <div class:list={['wrap', toc && 'tp-grid']}>
      {toc && (
        <nav class="toc" aria-label={t.contents}>
          <span class="toc__h">{t.contents}</span>
          <ol>{tocItems.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          <slot name="toc-after" />
        </nav>
      )}
      <Prose>
        {lang === 'en' && !translated && <p class="fallback" lang="en">{t.fallback}</p>}
        <slot name="before" />
        <div lang={translated || lang === 'de' ? undefined : 'de'}><Content /></div>
        <slot name="after" />
        {entry.data.updated && (
          <p class="updated">{t.updated}: {new Date(entry.data.updated).toLocaleDateString(dateFmt, { day: 'numeric', month: 'long', year: 'numeric' })}</p>
        )}
      </Prose>
    </div>
  </section>
</Page>

<style>
  .tp-grid { display: grid; grid-template-columns: minmax(200px, 280px) minmax(0, 1fr); gap: 40px clamp(32px, 6vw, 96px); align-items: start; }
  .toc { position: sticky; top: 100px; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .toc__h { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--magenta-2); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14px; }
  .toc a { color: var(--ink-soft); }
  .toc a:hover { color: var(--magenta); }
  .fallback { padding: 12px 16px; background: var(--tint); border-left: 4px solid var(--magenta); }
  .updated { margin-top: 3em; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted); }
  @media (max-width: 860px) { .tp-grid { grid-template-columns: 1fr; } .toc { position: static; } }
</style>
