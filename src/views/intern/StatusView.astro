---
/**
 * Interner Bereich: Anmelden und danach „Mein Status“ (Entwurf Mitgliedsstatus, design/entwuerfe/2026-10-intern):
 * Mitgliedsausweis zum Umdrehen (Rückseite mit QR-Code zur Prüfseite), Angaben zur Mitgliedschaft,
 * Hinweis bei offenem Beitrag, Ausweis als PDF und – wenn eingerichtet – in Google Wallet.
 * Daten: Tabelle mitgliedschaften (supabase/migrations/20261022000000_mitgliedschaft.sql), gepflegt vom Vorstand.
 * Deutsch (/intern/) und Englisch (/en/intern/); Texte im Skript mit t() aus scripts/intern/sprache.ts.
 */
import { Image } from 'astro:assets';
import Intern from '../../layouts/Intern.astro';
import Logo from '../../components/ui/Logo.astro';
import ProtectedEmail from '../../components/ProtectedEmail.astro';
import { href } from '../../lib/url';
import { getLang, tr, url } from '../../lib/i18n';
import { internPfad } from '../../lib/intern-sprache';
import { getVerein } from '../../lib/settings';
import { supabase } from '../../settings/supabase';
import buehne from '../../assets/photos/duo-silhouette-stage.jpg';

const lang = getLang(Astro);
const v = getVerein(lang);
const wallet = supabase.wallet;
const domain = new URL(Astro.site ?? 'https://tanznetzdresden.de').hostname.replace(/^www\./, '');
const t = tr(lang, {
  de: {
    titel: 'Mein Status', anmelden: 'Anmelden', loginLead: 'Für Mitglieder:innen von TanzNetzDresden. Zugänge vergibt der Vorstand per Einladung.',
    email: 'E-Mail', passwort: 'Passwort', linkStatt: 'Stattdessen Login-Link per E-Mail', vergessen: 'Passwort vergessen?',
    keinZugang: 'Noch kein Zugang?', keinZugangText: 'Mitglieder:innen bekommen eine Einladung per E-Mail. Du bist Mitglied, hast aber keine bekommen? Melde dich beim Vorstand.',
    vorstand: 'Vorstand kontaktieren →', mitgliedschaft: 'Mitgliedschaft', ausweis: 'Mitgliedsausweis', umdrehen: 'Ausweis umdrehen',
    istMitglied: 'ist Mitglied im', pruefen: 'Zum Prüfen den Code scannen. Er zeigt den aktuellen Status der Mitgliedschaft.',
    seite: 'Seite des Ausweises', vorne: 'Vorderseite', hinten: 'Rückseite', zahlung: 'Zahlungsinfos anfragen', zahlungBetreff: 'Mitgliedsbeitrag',
    verlaengern: 'Mitgliedschaft verlängern', handy: 'Auf dem Handy', walletAdd: 'Zu Google Wallet hinzufügen', pdf: 'Als PDF speichern',
    walletDrin: 'In Google Wallet hinzugefügt', walletText: 'Nach deiner nächsten Beitragszahlung holst du dir hier den Ausweis für das neue Jahr.',
    walletOeffnen: 'In Google Wallet öffnen →', zuruecksetzen: 'Zurücksetzen', falsch: 'Name oder Foto falsch?', profil: 'Profil bearbeiten',
    oder: 'oder', schreiben: 'Mitgliederverwaltung schreiben', ausweisBetreff: 'Mitgliedsausweis', vorschau: 'Vorschau · Google Wallet',
    vorschauH1: 'So erscheint dein Ausweis', vorschauH2: 'auf dem Handy.', vorschauText: 'Der Ausweis liegt offline in deiner Wallet. Vorzeigen, scannen lassen, fertig.',
    nummer: 'Mitgliedsnummer', gueltig: 'Gültig bis',
  },
  en: {
    titel: 'My status', anmelden: 'Log in', loginLead: 'For members of TanzNetzDresden. Access is granted by the board by invitation.',
    email: 'Email', passwort: 'Password', linkStatt: 'Get a login link by email instead', vergessen: 'Forgot your password?',
    keinZugang: 'No access yet?', keinZugangText: 'Members receive an invitation by email. You are a member but did not get one? Contact the board.',
    vorstand: 'Contact the board →', mitgliedschaft: 'Membership', ausweis: 'Membership card', umdrehen: 'Flip the card',
    istMitglied: 'is a member of', pruefen: 'Scan the code to check. It shows the current status of the membership.',
    seite: 'Side of the card', vorne: 'Front', hinten: 'Back', zahlung: 'Ask for payment details', zahlungBetreff: 'Membership fee',
    verlaengern: 'Renew membership', handy: 'On your phone', walletAdd: 'Add to Google Wallet', pdf: 'Save as PDF',
    walletDrin: 'Added to Google Wallet', walletText: 'After your next fee payment, get the card for the new year here.',
    walletOeffnen: 'Open Google Wallet →', zuruecksetzen: 'Reset', falsch: 'Wrong name or photo?', profil: 'Edit your profile',
    oder: 'or', schreiben: 'write to the membership team', ausweisBetreff: 'Membership card', vorschau: 'Preview · Google Wallet',
    vorschauH1: 'This is how your card', vorschauH2: 'looks on your phone.', vorschauText: 'The card is stored offline in your wallet. Show it, have it scanned, done.',
    nummer: 'Membership number', gueltig: 'Valid until',
  },
});
---
<Intern title={t.titel} current="status" loginPage>
  <!-- Anmelden -->
  <div class="login" data-when="login">
    <div class="i-card">
      <h1 class="i-h1">{t.anmelden}</h1>
      <p class="i-lead">{t.loginLead}</p>

      <form class="i-form" data-login-form>
        <div class="i-field">
          <label for="login-email">{t.email}</label>
          <input id="login-email" name="email" type="email" autocomplete="username" required />
        </div>
        <div class="i-field" data-password-field>
          <label for="login-password">{t.passwort}</label>
          <input id="login-password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <p class="i-msg" role="alert" data-login-msg hidden></p>
        <div class="login__actions">
          <button type="submit" class="btn btn--primary btn--marker" data-login-submit>{t.anmelden}</button>
          <button type="button" class="i-linkbtn" data-mode-toggle>{t.linkStatt}</button>
          <button type="button" class="i-linkbtn" data-reset>{t.vergessen}</button>
        </div>
      </form>
    </div>
    <aside class="login__aside">
      <h2>{t.keinZugang}</h2>
      <p>{t.keinZugangText}</p>
      <a class="mono-link" href={url(lang, 'kontakt', '#vorstand')}>{t.vorstand}</a>
    </aside>
  </div>

  <!-- Mein Status -->
  <div class="ms" data-when="ready" data-ms data-status="leer">
    <p class="hinweis" data-freigaben hidden></p>

    <header class="ms-kopf">
      <span class="tag" data-ms-tag>{t.mitgliedschaft}</span>
      <h1 class="i-h1">{t.titel}</h1>
      <p class="ms-lead"><span data-ms-hallo></span> <span data-ms-lead></span></p>
    </header>

    <div class="ms-grid">
      <section class="ms-links" aria-label={t.ausweis}>
        <div class="ausweis" data-blende-karte>
          <button type="button" class="ausweis__knopf" aria-label={t.umdrehen} data-ausweis-dreh>
            <span class="ausweis__innen" data-ausweis>
              <span class="ausweis__seite ausweis__vorne" data-ausweis-vorne>
                <span class="av__logo"><Logo part="mark" /></span>
                <span class="av__titel"><span class="av__sq"></span>{t.ausweis} <span data-ms-jahr></span></span>
                <span class="av__foto"><img alt="" hidden data-ms-foto /><span class="av__ini" data-ms-initialen></span></span>
                <span class="av__wer">
                  <span class="av__name"><span data-ms-vorname></span><br /><span class="av__nach" data-ms-nachname></span></span>
                  <span class="av__art" data-ms-art-seit></span>
                </span>
                <span class="av__leiste"><span data-ms-nr></span><span data-ms-gueltig-kurz></span></span>
              </span>
              <span class="ausweis__seite ausweis__hinten" data-ausweis-hinten>
                <span class="ah__kopf"><span class="av__sq"></span>{v.legalName} · {t.ausweis}</span>
                <span class="ah__qr" data-ms-qr></span>
                <span class="ah__text">
                  <span class="ah__satz"><span data-ms-name></span> {t.istMitglied} {v.legalName}</span>
                  <span class="ah__hilfe">{t.pruefen}</span>
                  <span class="ah__adresse">{v.address.street} · {v.address.zip} {v.address.city}<br />{domain}</span>
                </span>
                <span class="ah__linie"></span>
              </span>
              <span class="ausweis__stempel" data-ms-stempel hidden></span>
            </span>
          </button>
        </div>
        <div class="ms-seiten">
          <div class="ms-seg" role="group" aria-label={t.seite}>
            <button type="button" aria-pressed="true" data-seite="vorne">{t.vorne}</button>
            <button type="button" aria-pressed="false" data-seite="hinten">{t.hinten}</button>
          </div>
          <span class="ms-klein" data-ms-erstellt></span>
        </div>
      </section>

      <section class="ms-rechts">
        <div class="ms-karte">
          <div class="ms-karte__kopf">
            <h2 class="ms-h2">{t.mitgliedschaft}</h2>
            <span class="badge" data-ms-badge></span>
          </div>
          <dl class="ms-daten" data-ms-daten></dl>
        </div>

        <div class="ms-cta" data-ms-cta hidden>
          <p data-ms-cta-text></p>
          <span data-ms-cta-mail="offen" hidden><ProtectedEmail email={v.emails.kontakt} label={t.zahlung} subject={t.zahlungBetreff} button class="ms-cta__mail" /></span>
          <span data-ms-cta-mail="abgelaufen" hidden><ProtectedEmail email={v.emails.vorstand} label={t.verlaengern} subject={t.verlaengern} button class="ms-cta__mail" /></span>
        </div>

        <div class="ms-handy">
          <span class="tag">{t.handy}</span>
          <p class="ms-text" data-ms-handy-text></p>
          <div class="ms-knoepfe" data-ms-handy-start>
            {wallet && (
              <button type="button" class="ms-wallet" data-ms-wallet>
                <span class="ms-wallet__icon" aria-hidden="true"></span><span data-ms-wallet-label>{t.walletAdd}</span>
              </button>
            )}
            <button type="button" class="ms-pdf" data-ms-pdf>{t.pdf}</button>
          </div>
          {wallet && (
            <div class="ms-gespeichert" data-ms-gespeichert hidden>
              <div class="ms-gespeichert__kopf">
                <span class="badge badge--cyan">{t.walletDrin}</span>
                <span class="ms-klein" data-ms-wallet-wann></span>
              </div>
              <p class="ms-text">{t.walletText}</p>
              <div class="ms-links-zeile">
                <a class="mono-link" href="https://wallet.google.com" target="_blank" rel="noopener">{t.walletOeffnen}</a>
                <button type="button" class="ms-textknopf" data-ms-pdf>{t.pdf}</button>
                <button type="button" class="ms-textknopf ms-textknopf--leise" data-ms-wallet-zurueck>{t.zuruecksetzen}</button>
              </div>
            </div>
          )}
          <p class="ms-fuss">
            {t.falsch} <a href={href(internPfad(lang, 'profil/'))}>{t.profil}</a> {t.oder}
            <ProtectedEmail email={v.emails.vorstand} label={t.schreiben} subject={t.ausweisBetreff} />.
          </p>
        </div>
      </section>
    </div>

    {wallet && (
      <section class="ms-vorschau" data-ms-vorschau hidden>
        <div class="ms-vorschau__text">
          <span class="tag">{t.vorschau}</span>
          <h2 class="ms-vorschau__h">{t.vorschauH1}<br /><span>{t.vorschauH2}</span></h2>
          <p class="ms-text">{t.vorschauText}</p>
        </div>
        <div class="wp" data-ms-wp>
          <div class="wp__kopf"><span class="wp__logo"><Logo part="mark" /></span><span>{v.legalName}</span></div>
          <div class="wp__wer">
            <span class="wp__k">{t.ausweis} <span data-ms-jahr></span></span>
            <span class="wp__name" data-ms-name></span>
          </div>
          <div class="wp__daten">
            <div><span>{t.nummer}</span><strong data-ms-nr-roh></strong></div>
            <div><span>{t.gueltig}</span><strong data-ms-gueltig-roh></strong></div>
          </div>
          <div class="wp__qr"><span data-ms-qr></span></div>
          <div class="wp__bild">
            <Image src={buehne} alt="" widths={[340, 680]} sizes="340px" />
            <span class="wp__keil"></span>
          </div>
        </div>
      </section>
    )}
  </div>

  <div class="ms-toast" role="status" data-ms-toast hidden><span class="ms-toast__sq" aria-hidden="true"></span><span data-ms-toast-text></span></div>
</Intern>

<script>
  import QRCode from 'qrcode';
  import { getSupabase } from '../../lib/supabase';
  import { initIntern, errorText, showMessage, internUrl, type InternContext } from '../../scripts/intern/session';
  import { freigabenHinweis } from '../../scripts/intern/freigaben';
  import { photoUrl } from '../../lib/supabase';
  import { status, gueltigBis, ausweisJahr, kurz as kurzDe, lang as langDe, monat as monatDe, pruefUrl, artName, BEITRAG_FAELLIG, type Mitgliedschaft, type Status } from '../../lib/mitgliedschaft';
  import { sprache, t, locale } from '../../scripts/intern/sprache';

  const kurz = (s: string) => kurzDe(s, locale);
  const lang = (s: string) => langDe(s, locale);
  const monat = (s: string) => monatDe(s, locale);

  const ctx = await initIntern(false);
  const next = new URLSearchParams(location.search).get('weiter');
  if (ctx && next?.startsWith('/')) location.replace(next);
  if (ctx?.isRedaktion) void freigabenHinweis(ctx.sb, document.querySelector('[data-freigaben]'));
  if (ctx) void meinStatus(ctx);

  // ---------- Mein Status ----------
  async function meinStatus(ctx: InternContext) {
    const root = document.querySelector<HTMLElement>('[data-ms]')!;
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s);
    const alle = (s: string, f: (el: HTMLElement) => void) => root.querySelectorAll<HTMLElement>(s).forEach(f);
    const text = (s: string, wert: string) => alle(s, (el) => (el.textContent = wert));

    // fehlt die Tabelle (Migration nicht eingespielt) oder die Zeile, zeigt die Seite „In Vorbereitung“
    const { data } = await ctx.sb.from('mitgliedschaften').select('*').eq('person', ctx.user.id).maybeSingle<Mitgliedschaft>();
    const m = data ?? null;
    const st: Status | 'leer' = m ? status(m) : 'leer';
    const jahr = m ? ausweisJahr(m) : new Date().getFullYear();
    const bis = m ? gueltigBis(m) : null;
    const name = ctx.profile?.display_name || ctx.user.email || '';
    const [vorname, ...rest] = name.split(/\s+/);
    root.dataset.status = st;

    text('[data-ms-tag]', `${t('Mitgliedschaft', 'Membership')} · ${jahr}`);
    text('[data-ms-jahr]', String(jahr));
    text('[data-ms-hallo]', t(`Hallo ${vorname}.`, `Hello ${vorname}.`));
    const faellig = `${jahr}-${BEITRAG_FAELLIG}`;
    const heute = new Date().toISOString().slice(0, 10);
    text('[data-ms-lead]', t({
      aktiv: `Deine Mitgliedschaft ist aktiv bis ${bis ? lang(bis) : `Ende ${jahr}`}.`,
      offen: `Dein Beitrag für ${jahr} ist noch offen. Sobald er da ist, schalten wir deinen Ausweis frei.`,
      abgelaufen: `Deine Mitgliedschaft ist am ${bis ? lang(bis) : '–'} ausgelaufen.`,
      leer: 'Deine Mitgliedsdaten trägt der Vorstand noch ein. Danach erscheint hier dein Ausweis.',
    }, {
      aktiv: `Your membership is active until ${bis ? lang(bis) : `the end of ${jahr}`}.`,
      offen: `Your fee for ${jahr} is still open. As soon as it arrives, we will activate your card.`,
      abgelaufen: `Your membership ended on ${bis ? lang(bis) : '–'}.`,
      leer: 'The board is still entering your membership details. Your card will appear here afterwards.',
    })[st]);

    // Ausweis
    text('[data-ms-name]', name);
    text('[data-ms-vorname]', vorname ?? '');
    text('[data-ms-nachname]', rest.join(' '));
    text('[data-ms-art-seit]', [m ? artName(m.art, sprache) : t('Mitglied', 'Member'), m?.seit ? t(`seit ${m.seit.slice(0, 4)}`, `since ${m.seit.slice(0, 4)}`) : ''].filter(Boolean).join(' · '));
    text('[data-ms-nr]', m?.nummer ? `${t('Nr.', 'No.')} ${m.nummer}` : t('Nr. folgt', 'No. to follow'));
    text('[data-ms-nr-roh]', m?.nummer ?? '–');
    text('[data-ms-gueltig-kurz]', bis ? `${t('Gültig bis', 'Valid until')} ${kurz(bis)}` : '');
    text('[data-ms-gueltig-roh]', bis ? kurz(bis) : '–');
    const foto = q<HTMLImageElement>('[data-ms-foto]');
    const url = photoUrl(ctx.profile?.photo_path ?? null);
    if (foto && url) {
      foto.src = url;
      foto.alt = t(`Porträt ${name}`, `Portrait of ${name}`);
      foto.hidden = false;
    }
    text('[data-ms-initialen]', name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase()).join(''));
    const stempel = q('[data-ms-stempel]')!;
    stempel.textContent = t(
      { aktiv: '', offen: 'Beitrag offen', abgelaufen: 'Abgelaufen', leer: 'In Vorbereitung' },
      { aktiv: '', offen: 'Fee open', abgelaufen: 'Expired', leer: 'In preparation' },
    )[st];
    stempel.hidden = st === 'aktiv';
    const erstellt = m?.bezahlt_am ?? m?.updated_at;
    text('[data-ms-erstellt]', erstellt ? t(`Erstellt am ${lang(erstellt)}`, `Issued ${lang(erstellt)}`) : '');

    if (m) {
      const lila = getComputedStyle(document.documentElement).getPropertyValue('--purple').trim() || '#2e1a4d';
      const svg = await QRCode.toString(pruefUrl(m.pruefcode), { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: lila, light: '#ffffff' } });
      alle('[data-ms-qr]', (el) => (el.innerHTML = svg));
    }

    // Angaben
    const badge = q('[data-ms-badge]')!;
    const [bText, bArt] = t(
      { aktiv: ['Aktiv', 'cyan'], offen: ['Beitrag offen', 'magenta'], abgelaufen: ['Abgelaufen', 'purple'], leer: ['In Vorbereitung', 'purple'] },
      { aktiv: ['Active', 'cyan'], offen: ['Fee open', 'magenta'], abgelaufen: ['Expired', 'purple'], leer: ['In preparation', 'purple'] },
    )[st];
    badge.textContent = bText;
    badge.className = `badge${bArt === 'magenta' ? '' : ` badge--${bArt}`}`;
    const beitrag =
      st === 'aktiv' ? (m?.bezahlt_am ? t(`Bezahlt am ${lang(m.bezahlt_am)}`, `Paid on ${lang(m.bezahlt_am)}`) : t('Bezahlt', 'Paid'))
      : st === 'offen' ? (heute > faellig ? t(`Offen · fällig seit ${lang(faellig)}`, `Open · due since ${lang(faellig)}`) : t(`Offen · fällig bis ${lang(faellig)}`, `Open · due by ${lang(faellig)}`))
      : st === 'abgelaufen' ? (m?.bezahlt_bis ? t(`Zuletzt bezahlt für ${m.bezahlt_bis}`, `Last paid for ${m.bezahlt_bis}`) : t('Nicht bezahlt', 'Not paid'))
      : '–';
    const beitragK = t('Beitrag', 'Fee');
    const zeilen: [string, string, boolean?][] = [
      [t('Mitgliedsnummer', 'Membership number'), m?.nummer ?? t('wird vergeben', 'being assigned')],
      [t('Art', 'Type'), m ? artName(m.art, sprache) : '–'],
      [t('Mitglied seit', 'Member since'), m?.seit ? monat(m.seit) : '–'],
      [st === 'abgelaufen' ? beitragK : `${beitragK} ${jahr}`, beitrag, st === 'offen' || st === 'abgelaufen'],
      [t('Gültig bis', 'Valid until'), bis ? kurz(bis) : '–', st === 'offen' || st === 'abgelaufen'],
    ];
    q('[data-ms-daten]')!.replaceChildren(
      ...zeilen.map(([k, w, rot]) => {
        const div = document.createElement('div');
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = k;
        dd.textContent = w;
        if (rot) dd.className = 'is-offen';
        div.append(dt, dd);
        return div;
      }),
    );

    // Hinweis mit E-Mail (Betreff mit Mitgliedsnummer)
    const cta = q('[data-ms-cta]')!;
    if (st === 'offen' || st === 'abgelaufen') {
      text('[data-ms-cta-text]', st === 'offen'
        ? t('Der Ausweis gilt erst mit bezahltem Jahresbeitrag.', 'The card is only valid once the annual fee is paid.')
        : t('Verlängere deine Mitgliedschaft und wir erstellen dir einen neuen Ausweis.', 'Renew your membership and we will issue you a new card.'));
      alle('[data-ms-cta-mail]', (el) => {
        el.hidden = el.dataset.msCtaMail !== st;
        const pe = el.querySelector<HTMLElement>('[data-protected-email]');
        if (pe && m?.nummer) pe.dataset.subject = `${pe.dataset.subject} ${m.nummer}`;
      });
      cta.hidden = false;
    }

    // Auf dem Handy
    const ok = st === 'aktiv';
    const wallet = q<HTMLButtonElement>('[data-ms-wallet]');
    text('[data-ms-handy-text]', t({
      aktiv: wallet
        ? 'Speichere deinen Ausweis in Google Wallet. Dann hast du ihn beim Training oder an der Abendkasse immer dabei.'
        : 'Speichere deinen Ausweis als PDF oder druck ihn aus. Dann hast du ihn beim Training oder an der Abendkasse immer dabei.',
      offen: `Verfügbar, sobald dein Beitrag für ${jahr} eingegangen ist.`,
      abgelaufen: 'Verlängere deine Mitgliedschaft, um einen neuen Ausweis zu erhalten.',
      leer: 'Verfügbar, sobald der Vorstand deine Mitgliedsdaten eingetragen hat.',
    }, {
      aktiv: wallet
        ? 'Save your card in Google Wallet. Then you always have it with you at training or at the box office.'
        : 'Save your card as a PDF or print it. Then you always have it with you at training or at the box office.',
      offen: `Available as soon as your fee for ${jahr} has arrived.`,
      abgelaufen: 'Renew your membership to get a new card.',
      leer: 'Available as soon as the board has entered your membership details.',
    })[st]);
    alle('[data-ms-pdf]', (el) => ((el as HTMLButtonElement).disabled = !ok));
    if (wallet) wallet.disabled = !ok;
    const vorschau = q('[data-ms-vorschau]');
    if (vorschau) vorschau.hidden = !m;

    // Umdrehen
    const innen = q('[data-ausweis]')!;
    const seiten = [...root.querySelectorAll<HTMLButtonElement>('[data-seite]')];
    const drehen = (hinten: boolean) => {
      innen.toggleAttribute('data-hinten', hinten);
      seiten.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.seite === 'hinten') === hinten)));
    };
    q('[data-ausweis-dreh]')!.addEventListener('click', () => drehen(!innen.hasAttribute('data-hinten')));
    seiten.forEach((b) => b.addEventListener('click', () => drehen(b.dataset.seite === 'hinten')));

    // PDF: beide Seiten in Kartengröße drucken („Als PDF speichern“ im Druckdialog)
    const druck = document.createElement('div');
    druck.className = 'ms-druck';
    druck.dataset.druck = '';
    druck.setAttribute('aria-hidden', 'true');
    document.body.append(druck);
    const pdf = () => {
      druck.replaceChildren(
        ...['[data-ausweis-vorne]', '[data-ausweis-hinten]'].map((s) => {
          const karte = document.createElement('div');
          karte.className = 'ms-druck__karte';
          karte.append(q(s)!.cloneNode(true));
          return karte;
        }),
      );
      const titel = document.title;
      document.title = `${t('Mitgliedsausweis', 'Membership-card')}-${m?.nummer ?? 'TNDD'}`;
      addEventListener('afterprint', () => (document.title = titel), { once: true });
      print();
    };
    alle('[data-ms-pdf]', (el) => el.addEventListener('click', pdf));

    // Google Wallet (supabase/functions/ausweis, nur wenn in settings/supabase.ts eingeschaltet)
    const merkKey = `tndd-wallet-${ctx.user.id}-${jahr}`;
    const start = q('[data-ms-handy-start]')!;
    const gespeichert = q('[data-ms-gespeichert]');
    const zeigeGespeichert = (wann: string | null) => {
      if (!gespeichert) return;
      gespeichert.hidden = !wann;
      start.hidden = !!wann;
      text('[data-ms-wallet-wann]', wann ? `${t('Seit', 'Since')} ${wann}` : '');
    };
    let gemerkt: string | null = null;
    try {
      gemerkt = localStorage.getItem(merkKey);
    } catch {}
    if (ok) zeigeGespeichert(gemerkt);
    wallet?.addEventListener('click', async () => {
      const label = q('[data-ms-wallet-label]')!;
      wallet.disabled = true;
      label.textContent = t('Wird vorbereitet …', 'Preparing …');
      const { data: antwort, error } = await ctx.sb.functions.invoke<{ url?: string }>('ausweis', { body: {} });
      if (error || !antwort?.url) {
        let meldung = t('Das hat nicht geklappt. Bitte versuch es später noch einmal.', 'That did not work. Please try again later.');
        try {
          const j = await (error as { context?: Response })?.context?.json();
          if (j?.fehler) meldung = j.fehler;
        } catch {}
        toast(meldung);
        wallet.disabled = false;
        label.textContent = t('Zu Google Wallet hinzufügen', 'Add to Google Wallet');
        return;
      }
      const wann = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
      try {
        localStorage.setItem(merkKey, wann);
      } catch {}
      zeigeGespeichert(wann);
      location.assign(antwort.url);
    });
    q('[data-ms-wallet-zurueck]')?.addEventListener('click', () => {
      try {
        localStorage.removeItem(merkKey);
      } catch {}
      zeigeGespeichert(null);
      if (wallet) {
        wallet.disabled = false;
        q('[data-ms-wallet-label]')!.textContent = t('Zu Google Wallet hinzufügen', 'Add to Google Wallet');
      }
    });
  }

  let toastZeit = 0;
  function toast(meldung: string) {
    const el = document.querySelector<HTMLElement>('[data-ms-toast]');
    if (!el) return;
    el.querySelector('[data-ms-toast-text]')!.textContent = meldung;
    el.hidden = false;
    clearTimeout(toastZeit);
    toastZeit = window.setTimeout(() => (el.hidden = true), 4000);
  }

  // ---------- Anmelden ----------
  const sb = getSupabase();
  const form = document.querySelector<HTMLFormElement>('[data-login-form]');
  const msg = document.querySelector<HTMLElement>('[data-login-msg]');
  const pwField = document.querySelector<HTMLElement>('[data-password-field]');
  const pwInput = pwField?.querySelector('input');
  const submit = document.querySelector<HTMLButtonElement>('[data-login-submit]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');
  let magic = false;

  toggle?.addEventListener('click', () => {
    magic = !magic;
    if (pwField) pwField.hidden = magic;
    if (pwInput) pwInput.required = !magic;
    if (submit) submit.textContent = magic ? t('Login-Link senden', 'Send login link') : t('Anmelden', 'Log in');
    toggle.textContent = magic ? t('Mit Passwort anmelden', 'Log in with password') : t('Stattdessen Login-Link per E-Mail', 'Get a login link by email instead');
    showMessage(msg, '');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!sb || !submit) return;
    const fd = new FormData(form);
    const email = String(fd.get('email') ?? '').trim();
    submit.disabled = true;
    try {
      if (magic) {
        const { error } = await sb.auth.signInWithOtp({ email, options: { shouldCreateUser: false, emailRedirectTo: location.origin + internUrl() } });
        if (error) throw error;
        showMessage(msg, t('Wir haben dir einen Login-Link geschickt. Schau in dein Postfach.', 'We have sent you a login link. Check your inbox.'), 'ok');
      } else {
        const { error } = await sb.auth.signInWithPassword({ email, password: String(fd.get('password') ?? '') });
        if (error) throw error;
        location.replace(next?.startsWith('/') ? next : internUrl());
      }
    } catch (err) {
      showMessage(msg, errorText(err));
    } finally {
      submit.disabled = false;
    }
  });

  document.querySelector('[data-reset]')?.addEventListener('click', async () => {
    const email = (form?.querySelector<HTMLInputElement>('#login-email')?.value ?? '').trim();
    if (!email) {
      showMessage(msg, t('Trag oben deine E-Mail-Adresse ein, dann schicken wir dir einen Link zum Zurücksetzen.', 'Enter your email address above and we will send you a reset link.'));
      return;
    }
    const { error } = (await sb?.auth.resetPasswordForEmail(email, { redirectTo: location.origin + internUrl('passwort/') })) ?? {};
    // Aus Datenschutzgründen nicht verraten, ob die Adresse existiert
    showMessage(msg, error && /rate/i.test(error.message) ? errorText(error) : t('Falls es ein Konto gibt, ist ein Link zum Zurücksetzen unterwegs.', 'If there is an account, a reset link is on its way.'), 'ok');
  });
</script>

