---
/**
 * Intern → Open Calls (Entwurf design/entwuerfe/2026-10-open-calls/): Förderungen, Residenzen, Auditions und Jobs.
 * Alle Mitglieder sehen die freigegebenen Calls, merken sie sich, verfolgen ihre Bewerbungen und melden neue Calls;
 * die Redaktion prüft Meldungen und trägt selbst ein. Nach der Frist steht ein Call im Archiv.
 * Daten: Tabellen open_calls, open_call_stand, open_call_netz (docs/open-calls.md), Logik in src/lib/open-calls.ts,
 * Seite im Browser: src/scripts/intern/open-calls.ts. Deutsch und Englisch.
 */
import Intern from '../../layouts/Intern.astro';
import { getLang, tr, url } from '../../lib/i18n';
import { supabase } from '../../settings/supabase';
import '../../styles/intern-bausteine.css';

const lang = getLang(Astro);
const t = tr(lang, {
  de: {
    tag: 'Netzwerk · Ausschreibungen',
    lead: 'Förderungen, Residenzen, Auditions und Jobs für die Dresdner Tanzszene. Die Redaktion prüft jeden Eintrag. Nach Ablauf der Frist wandert ein Call automatisch ins Archiv.',
    export: 'Gemerkte Fristen in Kalender ↓', melden: 'Call melden', zeit: 'Fristen · nächste 12 Wochen', ansicht: 'Ansicht',
    suche: 'Suchen: Titel, Anbieter, Ort', sucheLabel: 'Open Calls durchsuchen', sortLabel: 'Sortierung', nachFrist: 'Nach Frist', neu: 'Neueste zuerst',
    art: 'Art', reichweite: 'Reichweite', eigenschaften: 'Eigenschaften', laden: 'Open Calls werden geladen …', schliessen: 'Schließen',
    titel: 'Titel', anbieter: 'Anbieter', frist: 'Frist · Ablaufdatum', uhrzeit: 'Uhrzeit', link: 'Link zur Ausschreibung',
    leistung: 'Leistung / Honorar', beschreibung: 'Kurzbeschreibung', nurMitglieder: 'Nur für Mitglieder sichtbar, nicht auf der öffentlichen Website',
    titelPh: 'z. B. Residenz Herbst 2027', anbieterPh: 'Institution, Festival oder Kollektiv', leistungPh: 'z. B. 1.500 € pro Person, Unterkunft',
    beschreibungPh: 'Worum geht es, wer kann sich bewerben?', pflicht: 'Pflichtfeld',
    mehr: 'Mehr Angaben', nurRedaktion: 'Redaktion', ort: 'Ort', zeitraum: 'Zeitraum', zielgruppe: 'Für wen', sprache: 'Sprache',
    start: 'Antragstellung ab', wiederkehrend: 'Wiederkehrend', unterlagen: 'Unterlagen', unterlagenHint: 'Eine pro Zeile. Mitglieder haken sie ab.',
    quelle: 'Quelle', honoriert: 'Honoriert', englisch: 'Auch auf Englisch', vomNetzwerk: 'Ausschreibung des Vereins (Vom Netzwerk)',
    gemeinsam: 'Gemeinsamer Antrag des Netzwerks: Mitglieder können „Ich mache mit“ setzen', hinweis: 'Hinweis aus dem Netzwerk',
    hinweisPh: 'z. B. Der Vorstand prüft einen gemeinsamen Antrag. Wer mitmachen will, setzt bis 30. November den Haken.',
    loeschen: 'Löschen',
  },
  en: {
    tag: 'Network · Open calls',
    lead: 'Funding, residencies, auditions and jobs for the Dresden dance scene. The editorial team checks every entry. Once the deadline has passed, a call moves to the archive automatically.',
    export: 'Saved deadlines to calendar ↓', melden: 'Report a call', zeit: 'Deadlines · next 12 weeks', ansicht: 'View',
    suche: 'Search: title, organiser, place', sucheLabel: 'Search open calls', sortLabel: 'Sort', nachFrist: 'By deadline', neu: 'Newest first',
    art: 'Type', reichweite: 'Reach', eigenschaften: 'Properties', laden: 'Loading open calls …', schliessen: 'Close',
    titel: 'Title', anbieter: 'Organiser', frist: 'Deadline', uhrzeit: 'Time', link: 'Link to the call',
    leistung: 'Funding / fee', beschreibung: 'Short description', nurMitglieder: 'Members only, not on the public website',
    titelPh: 'e.g. Autumn residency 2027', anbieterPh: 'Institution, festival or collective', leistungPh: 'e.g. €1,500 per person, accommodation',
    beschreibungPh: 'What is it about, who can apply?', pflicht: 'Required',
    mehr: 'More details', nurRedaktion: 'Editorial', ort: 'Place', zeitraum: 'Period', zielgruppe: 'Who for', sprache: 'Language',
    start: 'Applications from', wiederkehrend: 'Recurring', unterlagen: 'Documents', unterlagenHint: 'One per line. Members tick them off.',
    quelle: 'Source', honoriert: 'Paid', englisch: 'Also in English', vomNetzwerk: 'Call by the association (From the network)',
    gemeinsam: 'Joint application of the network: members can tick “I am in”', hinweis: 'Note from the network',
    hinweisPh: 'e.g. The board is preparing a joint application. Tick the box by 30 November if you want to take part.',
    loeschen: 'Delete',
  },
});
const netzwerk = url(lang, 'netzwerk');
---
<Intern title="Open Calls" current="opencalls">
  <div class="oc" data-oc data-erinnerungen={supabase.erinnerungen ? 'an' : undefined} data-netzwerk={netzwerk}>
    <header class="ku-kopf oc-kopf">
      <div class="ku-kopf__titel oc-kopf__titel">
        <span class="tag">{t.tag}</span>
        <h1 class="i-h1">Open Calls</h1>
        <p class="oc-lead">{t.lead}</p>
      </div>
      <div class="oc-kopf__aktionen">
        <button type="button" class="ku-linie" data-oc-export>{t.export}</button>
        <button type="button" class="btn btn--primary btn--marker" data-oc-melden>{t.melden}</button>
      </div>
    </header>

    <p class="i-msg" role="alert" data-msg hidden></p>
    <p class="oc-laden" role="status" data-oc-laden>{t.laden}</p>

    <div class="ku-hinweis oc-band" data-oc-pruefen hidden>
      <div class="ku-hinweis__text">
        <span class="ku-hinweis__sq" aria-hidden="true"></span>
        <span><span class="ku-hinweis__titel" data-oc-pruefen-titel></span><span class="ku-hinweis__namen" data-oc-pruefen-namen></span></span>
      </div>
      <button type="button" class="btn btn--secondary btn--sm" data-oc-pruefen-knopf></button>
    </div>
    <div class="ku-hinweis oc-band" data-oc-dringend hidden>
      <div class="ku-hinweis__text">
        <span class="ku-hinweis__sq" aria-hidden="true"></span>
        <span><span class="ku-hinweis__titel" data-oc-dringend-titel></span><span class="ku-hinweis__namen" data-oc-dringend-namen></span></span>
      </div>
      <button type="button" class="btn btn--secondary btn--sm" data-oc-dringend-knopf></button>
    </div>

    <section class="oc-zeit" aria-labelledby="oc-zeit-h" data-oc-zeit hidden>
      <div class="oc-zeit__kopf">
        <h2 class="oc-zeit__h" id="oc-zeit-h">{t.zeit}</h2>
        <span class="oc-zeit__spaeter" data-oc-spaeter></span>
      </div>
      <div class="oc-zeit__bahn" data-oc-bahn></div>
    </section>

    <div class="oc-bereich" data-oc-bereich hidden>
      <div class="oc-leiste">
        <div class="oc-tabs" role="group" aria-label={t.ansicht} data-oc-tabs></div>
        <div class="oc-suche" data-oc-suche>
          <label class="visually-hidden" for="oc-q">{t.sucheLabel}</label>
          <input id="oc-q" type="search" placeholder={t.suche} data-oc-q />
          <label class="visually-hidden" for="oc-sort">{t.sortLabel}</label>
          <select id="oc-sort" data-oc-sort>
            <option value="frist">{t.nachFrist}</option>
            <option value="neu">{t.neu}</option>
          </select>
        </div>
      </div>
      <div class="oc-filter" data-oc-filter>
        <div class="oc-chips" role="group" aria-label={t.art} data-oc-arten></div>
        <div class="oc-filter__zeile">
          <div class="oc-seg" role="group" aria-label={t.reichweite} data-oc-reichweiten></div>
          <div class="oc-flags" role="group" aria-label={t.eigenschaften} data-oc-flags></div>
        </div>
      </div>
      <div class="oc-liste" data-oc-liste></div>
      <div class="oc-board" data-oc-board hidden></div>
    </div>

    <!-- Detail -->
    <dialog class="oc-schublade" aria-labelledby="oc-d-titel" data-oc-detail>
      <div class="oc-schublade__panel" data-oc-panel></div>
    </dialog>

    <!-- Call melden (Mitglieder) oder eintragen und bearbeiten (Redaktion) -->
    <dialog class="oc-schublade" aria-labelledby="oc-f-titel" data-oc-form-dlg>
      <form class="oc-schublade__panel" data-oc-form novalidate>
        <div class="oc-schublade__kopf">
          <div>
            <span class="tag" data-f-tag></span>
            <h2 id="oc-f-titel" class="oc-schublade__h" data-f-titel></h2>
            <p class="oc-schublade__lead" data-f-lead></p>
          </div>
          <button type="button" class="oc-zu" aria-label={t.schliessen} data-zu>×</button>
        </div>
        <div class="oc-schublade__inhalt">
          <div class="i-field">
            <label for="f-titel">{t.titel} <span aria-hidden="true">*</span></label>
            <input id="f-titel" maxlength="160" required placeholder={t.titelPh} data-f="titel" />
          </div>
          <div class="i-field">
            <label for="f-anbieter">{t.anbieter} <span aria-hidden="true">*</span></label>
            <input id="f-anbieter" maxlength="160" required placeholder={t.anbieterPh} data-f="anbieter" />
          </div>
          <fieldset class="oc-feld">
            <legend class="oc-feld__l">{t.art}</legend>
            <div class="oc-chips oc-chips--form" data-f-arten></div>
          </fieldset>
          <fieldset class="oc-feld">
            <legend class="oc-feld__l">{t.reichweite}</legend>
            <div class="oc-seg oc-seg--voll" data-f-reichweiten></div>
          </fieldset>
          <div class="oc-zwei">
            <div class="i-field">
              <label for="f-frist">{t.frist} <span aria-hidden="true">*</span></label>
              <input id="f-frist" type="date" required data-f="frist" />
            </div>
            <div class="i-field">
              <label for="f-uhrzeit">{t.uhrzeit}</label>
              <input id="f-uhrzeit" type="time" data-f="uhrzeit" />
            </div>
          </div>
          <div class="i-field">
            <label for="f-link">{t.link} <span aria-hidden="true">*</span></label>
            <input id="f-link" type="url" required placeholder="https://" data-f="link" />
          </div>
          <div class="i-field">
            <label for="f-leistung">{t.leistung}</label>
            <input id="f-leistung" maxlength="200" placeholder={t.leistungPh} data-f="leistung" />
          </div>
          <div class="i-field">
            <label for="f-beschreibung">{t.beschreibung}</label>
            <textarea id="f-beschreibung" rows="4" maxlength="2000" placeholder={t.beschreibungPh} data-f="beschreibung"></textarea>
          </div>
          <label class="oc-check"><input type="checkbox" data-f-check="nur_mitglieder" /><span>{t.nurMitglieder}</span></label>

          <details class="oc-mehr" data-f-mehr hidden>
            <summary>{t.mehr} <span class="oc-opt">{t.nurRedaktion}</span></summary>
            <div class="oc-mehr__inhalt">
              <div class="oc-zwei">
                <div class="i-field"><label for="f-ort">{t.ort}</label><input id="f-ort" maxlength="160" data-f="ort" /></div>
                <div class="i-field"><label for="f-start">{t.start}</label><input id="f-start" type="date" data-f="start" /></div>
              </div>
              <div class="i-field"><label for="f-zeitraum">{t.zeitraum}</label><input id="f-zeitraum" maxlength="200" data-f="zeitraum" /></div>
              <div class="i-field"><label for="f-zielgruppe">{t.zielgruppe}</label><input id="f-zielgruppe" maxlength="300" data-f="zielgruppe" /></div>
              <div class="oc-zwei">
                <div class="i-field"><label for="f-sprache">{t.sprache}</label><input id="f-sprache" maxlength="100" data-f="sprache" /></div>
                <div class="i-field"><label for="f-quelle">{t.quelle}</label><input id="f-quelle" maxlength="160" data-f="quelle" /></div>
              </div>
              <div class="i-field"><label for="f-wiederkehrend">{t.wiederkehrend}</label><input id="f-wiederkehrend" maxlength="200" data-f="wiederkehrend" /></div>
              <div class="i-field">
                <label for="f-unterlagen">{t.unterlagen}</label>
                <textarea id="f-unterlagen" rows="4" data-f="unterlagen" aria-describedby="f-unterlagen-hint"></textarea>
                <span class="i-hint" id="f-unterlagen-hint">{t.unterlagenHint}</span>
              </div>
              <label class="oc-check"><input type="checkbox" data-f-check="honoriert" /><span>{t.honoriert}</span></label>
              <label class="oc-check"><input type="checkbox" data-f-check="englisch" /><span>{t.englisch}</span></label>
              <label class="oc-check"><input type="checkbox" data-f-check="vom_netzwerk" /><span>{t.vomNetzwerk}</span></label>
              <label class="oc-check"><input type="checkbox" data-f-check="gemeinsam" /><span>{t.gemeinsam}</span></label>
              <div class="i-field">
                <label for="f-hinweis">{t.hinweis}</label>
                <textarea id="f-hinweis" rows="3" maxlength="600" placeholder={t.hinweisPh} data-f="hinweis"></textarea>
              </div>
            </div>
          </details>
        </div>
        <div class="oc-schublade__fuss">
          <button type="submit" class="btn btn--primary btn--marker" data-f-senden></button>
          <span class="oc-fuss__hint" aria-live="polite" data-f-hint></span>
          <button type="button" class="oc-loeschen" data-f-loeschen hidden>{t.loeschen}</button>
        </div>
      </form>
    </dialog>
  </div>

  <div class="ku-toast" role="status" data-ku-toast hidden>
    <span class="ku-toast__sq" aria-hidden="true"></span>
    <span data-ku-toast-text></span>
    <button type="button" class="ku-toast__knopf" data-ku-toast-knopf hidden></button>
  </div>
</Intern>

<script>
  import '../../scripts/intern/open-calls';
</script>

<style>
  .oc-kopf { align-items: flex-end; }
  .oc-kopf__titel { flex: 1 1 380px; max-width: 640px; }
  .oc-lead { margin: 0; font-size: 17px; line-height: 1.6; text-wrap: pretty; }
  .oc-kopf__aktionen { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .oc-laden { color: var(--ink-soft); }
  .oc-laden[hidden], .oc-band[hidden], .oc-zeit[hidden], .oc-bereich[hidden], .oc-board[hidden] { display: none; }
  .oc > .i-msg { margin-bottom: 24px; }
  .oc-band { margin-bottom: 32px; }

  /* Zeitleiste */
  .oc-zeit { margin-bottom: 32px; padding: 18px 20px 16px; background: var(--paper); border-top: 2px solid var(--purple); }
  .oc-zeit__kopf { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; margin-bottom: 14px; }
  .oc-zeit__h { margin: 0; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--purple); }
  .oc-zeit__spaeter { font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); }
  .oc-zeit__bahn { position: relative; height: 96px; }
  .oc-zeit__bahn :global(.oc-zeit__linie) { position: absolute; left: 0; right: 0; top: 72px; height: 2px; background: var(--rule); }
  .oc-zeit__bahn :global(.oc-zeit__monat) {
    position: absolute; top: 64px; bottom: 0; padding: 12px 0 0 6px; border-left: 1px solid var(--rule); white-space: nowrap;
    font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted);
  }
  .oc-zeit__bahn :global(.oc-zeit__heute) { position: absolute; left: 0; top: 52px; bottom: 12px; width: 2px; background: var(--purple); }
  .oc-zeit__bahn :global(.oc-zeit__heute-t) {
    position: absolute; left: 6px; top: 50px; font-family: var(--font-mono); font-size: 9.5px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--purple);
  }
  .oc-zeit__bahn :global(.oc-marke) {
    position: absolute; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; padding: 0; border: 0;
    background: none; cursor: pointer;
  }
  .oc-zeit__bahn :global(.oc-marke:hover), .oc-zeit__bahn :global(.oc-marke:focus-visible) { z-index: 2; }
  .oc-zeit__bahn :global(.oc-marke__tag) {
    padding: 3px 6px; font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.06em; white-space: nowrap;
    background: var(--oc-ton); color: var(--oc-ton-text);
  }
  .oc-zeit__bahn :global(.oc-marke__stiel) { width: 2px; background: var(--oc-ton); }
  .oc-zeit__bahn :global(.oc-marke:hover .oc-marke__tag) { outline: 2px solid var(--purple); outline-offset: 1px; }
  :global(.oc-ton--dringend) { --oc-ton: var(--magenta); --oc-ton-text: #fff; }
  :global(.oc-ton--bald) { --oc-ton: var(--purple); --oc-ton-text: #fff; }
  :global(.oc-ton--spaeter) { --oc-ton: var(--cyan-tint); --oc-ton-text: var(--purple); }
  :global(.oc-ton--grau) { --oc-ton: var(--tint); --oc-ton-text: var(--ink-muted); }
  /* in der Zeitleiste kräftiger als in der Liste (Cyan mit Lila, lesbar) */
  .oc-zeit__bahn :global(.oc-ton--spaeter) { --oc-ton: var(--cyan); --oc-ton-text: var(--purple); }

  /* Leiste mit Ansichten, Suche, Filter */
  .oc-bereich { display: flex; flex-direction: column; gap: 16px; }
  .oc-leiste { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .oc-tabs { display: flex; flex-wrap: wrap; }
  .oc-tabs :global(button), .oc-seg :global(button) {
    display: flex; align-items: center; gap: 8px; margin-right: -1.5px; border: 1.5px solid var(--purple); background: var(--paper); color: var(--purple);
    font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; cursor: pointer;
  }
  .oc-tabs :global(button) { padding: 11px 15px; font-size: 11px; letter-spacing: 0.16em; }
  .oc-tabs :global(button[aria-pressed='true']), .oc-seg :global(button[aria-pressed='true']) { background: var(--purple); color: #fff; }
  .oc-tabs :global(.oc-zahl) { opacity: 0.65; }
  .oc-suche { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .oc-suche[hidden], .oc-filter[hidden] { display: none; }
  .oc-suche input, .oc-suche select { padding: 11px 14px; border: 1.5px solid var(--rule); border-radius: 0; background: var(--paper); outline: none; }
  .oc-suche input { flex: 1 1 auto; width: 240px; min-width: 0; font-size: 15px; }
  .oc-suche input:focus, .oc-suche select:focus { border-color: var(--magenta); }
  .oc-suche select { padding: 11px 12px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--purple); cursor: pointer; }
  .oc-filter { display: flex; flex-direction: column; gap: 10px; padding: 16px 0 4px; border-top: 1px solid var(--rule); }
  .oc-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .oc-chips :global(button) {
    display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1.5px solid var(--rule); background: var(--paper); color: var(--purple);
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer;
  }
  .oc-chips :global(button:hover) { border-color: var(--magenta); }
  .oc-chips :global(button[aria-pressed='true']) { border-color: var(--purple); background: var(--purple); color: #fff; }
  .oc-chips :global(button.is-leer:not([aria-pressed='true'])) { border-style: dashed; color: var(--ink-soft); }
  .oc-chips--form { gap: 6px; }
  .oc-chips--form :global(button) { padding: 8px 11px; border-color: var(--purple); letter-spacing: 0.12em; }
  .oc-filter__zeile { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .oc-seg { display: flex; flex-wrap: wrap; }
  .oc-seg :global(button) { padding: 8px 12px; font-size: 10.5px; letter-spacing: 0.14em; }
  .oc-seg--voll { display: grid; grid-template-columns: repeat(4, 1fr); border: 1.5px solid var(--purple); }
  .oc-seg--voll :global(button) { justify-content: center; margin: 0; border: 0; padding: 10px 4px; letter-spacing: 0.1em; }
  .oc-flags { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  :global(.oc-mk) { width: 8px; height: 8px; flex: none; background: var(--rule); }
  :global(.oc-mk[data-art='foerderung']) { background: var(--purple); }
  :global(.oc-mk[data-art='residenz']) { background: var(--cyan); }
  :global(.oc-mk[data-art='audition']) { background: var(--magenta); }
  :global(.oc-mk[data-art='festival']) { background: var(--cyan-2); }
  :global(.oc-mk[data-art='job']) { background: var(--purple-2); }
  :global(.oc-mk[data-art='stipendium']) { background: var(--magenta-2); }
  :global(.oc-mk[data-art='weiterbildung']) { background: var(--ink-muted); }
  :global(.oc-mk[data-art='alle']) { background: var(--purple); }
  :global([aria-pressed='true'] > .oc-mk[data-art='alle']) { background: var(--magenta); }
  :global([aria-pressed='true'] > .oc-mk) { outline: 1px solid #fff; }

  /* Kästchen (Filter, Erinnerung, Unterlagen, Netzwerk) */
  :global(.oc-check) { display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; line-height: 1.45; color: var(--ink); cursor: pointer; }
  :global(.oc-check input) {
    appearance: none; flex: none; width: 18px; height: 18px; margin: 1px 0 0; border: 1.5px solid var(--purple); border-radius: 0; background: var(--paper);
    display: grid; place-content: center; cursor: pointer;
  }
  :global(.oc-check input::before) { content: ''; width: 10px; height: 6px; border: solid #fff; border-width: 0 0 2px 2px; transform: translateY(-1px) rotate(-45deg); opacity: 0; }
  :global(.oc-check input:checked) { background: var(--magenta); border-color: var(--magenta); }
  :global(.oc-check input:checked::before) { opacity: 1; }
  :global(.oc-check input:focus-visible) { outline: 2px solid var(--magenta); outline-offset: 2px; }
  :global(.oc-check--klein) { align-items: center; padding: 6px 0; font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--purple); }
  :global(.oc-check--klein input) { width: 16px; height: 16px; margin: 0; }
