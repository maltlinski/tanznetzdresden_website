---
/**
 * Tanzkalender (/termine/, /en/events/) nach dem Entwurf design/entwuerfe/2026-10-kalender/:
 * Kopf mit Netz und den nächsten drei Terminen, Leiste (Liste/Monat, Filter, Suche, Heute), Liste mit
 * Mini-Monat oder Monatsraster mit Tagesansicht. Daten: src/lib/tanzkalender.ts, Darstellung im Browser:
 * src/scripts/tanzkalender.ts. Ohne JavaScript erscheint die einfache Liste aller kommenden Termine.
 */
import Page from '../layouts/Page.astro';
import Tag from '../components/ui/Tag.astro';
import KeilBar from '../components/ui/KeilBar.astro';
import EventList from '../components/EventList.astro';
import { categoryLabel, getUpcoming } from '../lib/content';
import { getTanzkalenderDaten, netz, uhrzeit } from '../lib/tanzkalender';
import { FILTER } from '../lib/tanzkalender-modell';
import { todayKey } from '../lib/keep-up';
import { href } from '../lib/url';
import { dateLocale, getLang, tr, url } from '../lib/i18n';
import { texte, zeilen } from '../lib/texte';

const lang = getLang(Astro);
const termine = await getTanzkalenderDaten(lang);
const k = texte(lang, 'termine', 'kopf');
const a = texte(lang, 'termine', 'ansicht');
const e = texte(lang, 'termine', 'eintrag');
const [h1, accent] = zeilen(k.titel);
// nur für Screenreader
const sr = tr(lang, {
  de: { ansicht: 'Ansicht', filter: 'Nach Kategorie filtern', suche: 'Termine durchsuchen', vor: 'Vorheriger Monat', nach: 'Nächster Monat', keine: 'keine Termine' },
  en: { ansicht: 'View', filter: 'Filter by category', suche: 'Search events', vor: 'Previous month', nach: 'Next month', keine: 'no events' },
});
const kat = { ...categoryLabel[lang], Frist: a.frist };
const legende = [
  { kat: 'Bühne', text: a.buehneText },
  { kat: 'Training', text: a.trainingText },
  { kat: 'Diskurs', text: a.diskursText },
  { kat: 'Frist', text: a.fristText },
] as const;

const locale = dateLocale[lang];
const utc = (d: string) => new Date(`${d}T00:00:00Z`);
const fmt = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(locale, { ...o, timeZone: 'UTC' });
const ohnePunkt = (s: string) => s.replace(/\.$/, '');
const wochentage = Array.from({ length: 7 }, (_, i) => ohnePunkt(fmt({ weekday: 'short' }).format(utc(`2026-01-${String(5 + i).padStart(2, '0')}`))));

// Beim Build: die nächsten drei Termine ohne Training (der Browser rechnet beim Öffnen neu)
const heute = todayKey();
const naechste = termine.filter((t) => t.datum >= heute && t.kat !== 'Training').slice(0, 3);
const n = netz(0.7);
const chipKats: ('' | (typeof FILTER)[number])[] = ['', ...FILTER];

const json = JSON.stringify({
  termine,
  locale,
  texte: { ...a, ...e, kat, keine: sr.keine },
}).replace(/</g, '\\u003c');
---
<Page title={k.title} description={k.desc} route="termine" fortschritt>
  <section class="tk-kopf" data-hero data-tk-kopf>
    <svg class="tk-netz" viewBox={`0 0 ${n.breite} ${n.hoehe}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-tk-netz>
      {n.linien.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} pathLength="1" class:list={[l.dick && 'dick']} />)}
      {n.punkte.map((p) => <rect x={p.x} y={p.y} width={p.s} height={p.s} class:list={[p.magenta && 'mg']} />)}
    </svg>
    <div class="wrap tk-kopf__inner">
      <div>
        <Tag color="cyan">{k.kicker}</Tag>
        <h1 class="tk-kopf__h1" data-split>{h1}{accent && <><br /><span>{accent}</span></>}</h1>
        <p class="tk-kopf__lead" data-tk-rise>{k.lead}</p>
      </div>
      <div class="tk-next" data-tk-rise hidden={!naechste.length} data-tk-next-box>
        <p class="tk-next__k"><span aria-hidden="true"></span>{k.next}</p>
        <ul data-tk-next>
          {naechste.map((t) => {
            const d = utc(t.datum);
            return (
              <li>
                <a href={t.link} data-id={t.id}>
                  <span class="tk-next__d">
                    <span>{ohnePunkt(fmt({ weekday: 'short' }).format(d))}</span>
                    <strong>{d.getUTCDate()}</strong>
                    <span>{ohnePunkt(fmt({ month: 'short' }).format(d))}</span>
                  </span>
                  <span class="tk-next__t">
                    <strong>{t.titel}</strong>
                    <span>{[t.kat === 'Frist' ? a.frist : uhrzeit(lang, t.von), t.ort].filter(Boolean).join(' · ')}</span>
                  </span>
                  <span class="tk-next__pfeil" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
    <KeilBar class="tk-kopf__keil" />
  </section>

  <div class="tk-leiste" data-tk-leiste>
    <div class="wrap tk-leiste__inner">
      <div class="tk-tabs" role="tablist" aria-label={sr.ansicht}>
        <button type="button" role="tab" id="tk-tab-liste" aria-controls="tk-liste" aria-selected="true" data-tk-ansicht="liste">{a.liste}</button>
        <button type="button" role="tab" id="tk-tab-monat" aria-controls="tk-monat" aria-selected="false" tabindex="-1" data-tk-ansicht="monat">{a.monat}</button>
      </div>
      <div class="tk-chips" role="group" aria-label={sr.filter} data-tk-chips>
        {chipKats.map((c) => (
          <button type="button" class="tk-chip" data-kat={c} aria-pressed={c === '' ? 'true' : 'false'}>
            <span class="tk-sq" data-kat={c || undefined} aria-hidden="true"></span>{c ? kat[c] : kat.Alle}<span class="tk-chip__n" data-n></span>
          </button>
        ))}
      </div>
      <div class="tk-suche">
        <input type="search" placeholder={a.suche} aria-label={sr.suche} data-tk-q />
        <button type="button" class="tk-heute" data-tk-heute>{a.heute}</button>
      </div>
    </div>
  </div>

  <div class="wrap tk-main" data-tk-main>
    <div id="tk-liste" class="tk-liste" role="tabpanel" aria-labelledby="tk-tab-liste" data-tk-panel="liste">
      <aside class="tk-aside">
        <div class="tk-mini">
          <div class="tk-mini__kopf">
            <span class="tk-mini__label" data-tk-mini-label></span>
            <div class="tk-pfeile">
              <button type="button" class="tk-pfeil" aria-label={sr.vor} data-tk-mini-vor>←</button>
              <button type="button" class="tk-pfeil" aria-label={sr.nach} data-tk-mini-nach>→</button>
            </div>
          </div>
          <div class="tk-wt" aria-hidden="true">{wochentage.map((w) => <span>{w}</span>)}</div>
          <div class="tk-mini__tage" data-tk-mini></div>
        </div>
        <ul class="tk-legende">
          {legende.map((l) => <li><span class="tk-sq" data-kat={l.kat} aria-hidden="true"></span><strong>{kat[l.kat]}</strong> · {l.text}</li>)}
        </ul>
        <div class="tk-aktionen">
          <button type="button" class="tk-mono tk-mono--magenta" data-tk-ics-alle>{a.auswahl}</button>
          <a class="tk-mono tk-mono--magenta" href={href('termine.ics')}>{k.ics}</a>
          <a class="tk-mono" href={url(lang, 'kontakt', '#termin-einreichen')}>{k.submit}</a>
        </div>
      </aside>
      <div class="tk-spalte">
        <div class="tk-spalte__kopf">
          <span class="tk-treffer" aria-live="polite" data-tk-treffer></span>
          <button type="button" class="tk-mono tk-mono--magenta" data-tk-past></button>
        </div>
        <div data-tk-monate></div>
        <div class="tk-leer" data-tk-leer hidden>
          <p>{a.leer}</p>
          <button type="button" class="tk-mono tk-mono--magenta" data-tk-reset>{a.reset}</button>
        </div>
      </div>
    </div>

    <div id="tk-monat" class="tk-monat" role="tabpanel" aria-labelledby="tk-tab-monat" data-tk-panel="monat" hidden>
      <div class="tk-monat__haupt">
        <div class="tk-monat__kopf">
          <h2 class="tk-monat__label" aria-live="polite" data-tk-vm-label></h2>
          <div class="tk-pfeile">
            <button type="button" class="tk-pfeil tk-pfeil--gross" aria-label={sr.vor} data-tk-vm-vor>←</button>
            <button type="button" class="tk-pfeil tk-pfeil--gross tk-pfeil--voll" aria-label={sr.nach} data-tk-vm-nach>→</button>
          </div>
        </div>
        <div class="tk-wt tk-wt--gross" aria-hidden="true">{wochentage.map((w) => <span>{w}</span>)}</div>
        <div class="tk-raster" data-tk-raster></div>
        <ul class="tk-legende tk-legende--zeile" aria-hidden="true">
          {legende.map((l) => <li><span class="tk-sq" data-kat={l.kat}></span>{kat[l.kat]}</li>)}
        </ul>
      </div>
      <aside class="tk-tag" data-tk-tag></aside>
    </div>
  </div>

  <div class="wrap tk-ohnejs">
    <EventList events={await getUpcoming()} id="all-events" groupByMonth />
  </div>
  <script type="application/json" data-tk-daten set:html={json} />
</Page>

<script>
  import { initTanzkalender } from '../scripts/tanzkalender';
  initTanzkalender();
</script>

<style>
  /* Höhe von Kopfzeile und Leiste (das Skript misst nach) für die klebenden Überschriften */
  :global(:root) { --tk-kopf-h: var(--header-h); --tk-oben: calc(var(--header-h) + 66px); }

  /* ---------- Kopf ---------- */
  .tk-kopf { position: relative; display: flex; flex-direction: column; min-height: var(--buehne-h); background: var(--purple); color: #fff; overflow: hidden; }
  .tk-netz { position: absolute; inset: -4% 0; width: 100%; height: 108%; display: block; pointer-events: none; }
  .tk-netz line { stroke: var(--cyan); stroke-opacity: 0.15; stroke-width: 1; stroke-dasharray: 1; }
  .tk-netz line.dick { stroke-opacity: 0.28; stroke-width: 2; }
  .tk-netz rect { fill: var(--cyan); fill-opacity: 0.4; }
  .tk-netz rect.mg { fill: var(--magenta); fill-opacity: 0.7; }
  /* bis das Skript das Netz einzeichnet */
  @media (prefers-reduced-motion: no-preference) { :global(.js) .tk-netz:not(.is-da) { opacity: 0; } }
  .tk-kopf__inner {
    position: relative; width: 100%; margin-block: auto; padding-block: var(--buehne-oben) clamp(64px, 8vw, 104px);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 48px clamp(32px, 6vw, 96px); align-items: end;
  }
  .tk-kopf :global(.tag) { margin-bottom: 24px; }
  .tk-kopf__h1 {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(52px, 7vw, 104px); line-height: 0.92;
    letter-spacing: -0.035em; margin: 0 0 28px; color: #fff;
  }
  .tk-kopf__h1 span { color: var(--cyan); }
  .tk-kopf__lead { max-width: 480px; margin: 0; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.6; color: rgba(255, 255, 255, 0.88); text-wrap: pretty; }
  .tk-kopf :global(.tk-kopf__keil) { position: absolute; left: 0; bottom: 0; width: 34%; }

  .tk-next { background: color-mix(in srgb, var(--purple) 90%, transparent); border-top: 3px solid var(--magenta); }
  .tk-next__k {
    margin: 0; padding: 16px 20px 12px; display: flex; align-items: center; gap: 12px; font-family: var(--font-mono);
    font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #fff;
  }
  .tk-next__k span { width: 10px; height: 10px; background: var(--magenta); }
  .tk-next :global(ul) { list-style: none; margin: 0; padding: 0; }
  .tk-next :global(a) {
    display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 18px; align-items: center; padding: 16px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.14); color: #fff; transition: color var(--dur-base);
  }
  .tk-next :global(a:hover) { color: var(--cyan); }
  :global(.tk-next__d) { display: flex; flex-direction: column; gap: 4px; }
  :global(.tk-next__d span) { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #fff; }
  :global(.tk-next__d span:first-child) { color: var(--cyan); letter-spacing: 0.18em; }
  :global(.tk-next__d strong) { font-family: var(--font-display); font-weight: 800; font-size: 40px; line-height: 0.88; letter-spacing: -0.04em; color: #fff; }
  :global(.tk-next__t) { min-width: 0; display: flex; flex-direction: column; gap: 5px; }
  :global(.tk-next__t strong) { font-family: var(--font-display); font-weight: 700; font-size: clamp(18px, 1.7vw, 22px); line-height: 1.12; letter-spacing: -0.015em; }
  :global(.tk-next__t span) { font-size: 14px; line-height: 1.45; color: rgba(255, 255, 255, 0.8); }
  :global(.tk-next__pfeil) { font-family: var(--font-display); font-size: 24px; color: var(--magenta); }

  /* ---------- Leiste ---------- */
  .tk-leiste { position: sticky; top: var(--tk-kopf-h); z-index: 20; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .tk-leiste__inner { padding-block: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .tk-tabs { display: flex; border: 1.5px solid var(--purple); }
  .tk-tabs button {
    padding: 9px 16px; border: 0; background: var(--paper); color: var(--purple); font-family: var(--font-mono); font-size: 11px;
    font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; border-radius: 0;
  }
  .tk-tabs button[aria-selected='true'] { background: var(--purple); color: #fff; }
  .tk-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .tk-chip {
    display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1.5px solid var(--purple); background: transparent;
    color: var(--purple); font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; cursor: pointer; border-radius: 0; transition: border-color var(--dur-base);
  }
  .tk-chip:hover { border-color: var(--magenta); }
  .tk-chip[aria-pressed='true'] { background: var(--purple); color: #fff; }
  .tk-chip__n { color: var(--ink-soft); }
  .tk-chip[aria-pressed='true'] .tk-chip__n { color: var(--cyan); }
  .tk-chip .tk-sq:not([data-kat]) { background: var(--purple); }
  .tk-chip[aria-pressed='true'] .tk-sq:not([data-kat]) { background: #fff; }
  .tk-chip[aria-pressed='true'] .tk-sq[data-kat='Diskurs'] { outline: 1.5px solid #fff; outline-offset: -1.5px; }
  .tk-suche { margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .tk-suche input {
    width: clamp(200px, 22vw, 280px); padding: 10px 12px; border: 1.5px solid var(--rule); background: var(--paper); color: var(--purple);
    font-family: var(--font-body); font-size: 14px; border-radius: 0; outline: none;
  }
  .tk-suche input:focus { border-color: var(--magenta); }
  .tk-suche input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .tk-heute {
    padding: 10px 14px; border: 1.5px solid var(--purple); background: var(--purple); color: #fff; font-family: var(--font-mono);
    font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; border-radius: 0;
  }
  .tk-heute:hover { background: var(--magenta); border-color: var(--magenta); }

  /* ---------- gemeinsam ---------- */
  .tk-sq { flex: none; display: inline-block; width: 8px; height: 8px; background: var(--cyan); }
  :global(.tk-sq[data-kat='Bühne']) { background: var(--magenta); }
  :global(.tk-sq[data-kat='Training']) { background: var(--cyan); }
  :global(.tk-sq[data-kat='Diskurs']) { background: var(--purple); }
  :global(.tk-sq[data-kat='Frist']) { background: #fff; outline: 1.5px solid var(--magenta); outline-offset: -1.5px; }
  .tk-mono, :global(.tk-mono) {
    padding: 0; border: 0; background: transparent; font-family: var(--font-mono); font-size: 12px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); cursor: pointer; text-align: left;
  }
  :global(.tk-mono--magenta) { color: var(--magenta-2); }
  .tk-mono:hover, :global(.tk-mono:hover) { color: var(--purple); }
  .tk-pfeile { display: flex; gap: 6px; }
  .tk-pfeil {
    width: 34px; height: 34px; border: 1.5px solid var(--purple); background: transparent; color: var(--purple);
    font-family: var(--font-display); font-size: 16px; cursor: pointer; border-radius: 0;
  }
  .tk-pfeil:hover:not(:disabled) { border-color: var(--magenta); color: var(--magenta); }
  .tk-pfeil:disabled { border-color: var(--rule); color: var(--ink-muted); cursor: default; }
  .tk-pfeil--gross { width: 48px; height: 48px; font-size: 22px; }
  .tk-pfeil--voll:not(:disabled) { background: var(--purple); color: #fff; }
  .tk-pfeil--voll:hover:not(:disabled) { background: var(--magenta); border-color: var(--magenta); color: #fff; }
  .tk-wt { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px; margin-bottom: 4px; }
  .tk-wt span {
    text-align: center; padding: 4px 0; font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-soft);
  }
  .tk-wt--gross { gap: 0; margin: 0; }
  .tk-wt--gross span { text-align: left; padding: 0 8px 8px; font-size: 11px; letter-spacing: 0.16em; }
  .tk-legende { list-style: none; margin: 0; padding: 18px 0 0; border-top: 1px solid var(--rule); display: flex; flex-direction: column; gap: 10px; }
  .tk-legende li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--ink-soft); }
  .tk-legende .tk-sq { width: 10px; height: 10px; }
  .tk-legende strong { font-weight: 600; color: var(--purple); margin-right: -4px; }
  .tk-legende--zeile { flex-direction: row; flex-wrap: wrap; gap: 10px 24px; margin-top: 16px; padding: 0; border: 0; }
  .tk-legende--zeile li { gap: 8px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  .tk-legende--zeile .tk-sq { width: 9px; height: 9px; }

  /* ---------- Liste ---------- */
  .tk-main { padding-block: clamp(32px, 4vw, 56px) clamp(72px, 9vw, 120px); }
  .tk-liste { display: flex; flex-wrap: wrap; gap: 40px clamp(32px, 4vw, 64px); align-items: flex-start; }
  .tk-liste[hidden], .tk-monat[hidden] { display: none; }
  .tk-aside {
    flex: 0 1 300px; min-width: 260px; position: sticky; top: calc(var(--tk-oben) + 24px);
    display: flex; flex-direction: column; gap: 28px;
  }
  .tk-mini { border-top: 3px solid var(--magenta); padding-top: 16px; }
  .tk-mini__kopf { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .tk-mini__label { font-family: var(--font-display); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; color: var(--purple); }
  .tk-mini__tage { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px; }
  .tk-mini__tage :global(button), .tk-mini__tage :global(span.leer) {
    aspect-ratio: 1 / 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
    border: 0; background: transparent; color: var(--purple); font-family: var(--font-display); font-weight: 700; font-size: 14px;
    border-radius: 0; padding: 0; transition: background var(--dur-base), color var(--dur-base);
  }
  .tk-mini__tage :global(button) { cursor: pointer; }
  .tk-mini__tage :global(button:hover:not(:disabled)) { outline: 1.5px solid var(--purple); outline-offset: -1.5px; }
  .tk-mini__tage :global(button:disabled) { cursor: default; color: var(--ink-soft); }
  .tk-mini__tage :global(.is-vergangen) { color: var(--ink-soft); }
  .tk-mini__tage :global(.is-heute) { outline: 1.5px solid var(--magenta); outline-offset: -1.5px; }
  .tk-mini__tage :global(.is-an) { background: var(--purple); color: #fff; outline: 0; }
  .tk-mini__tage :global(.is-an .tk-sq[data-kat='Diskurs']) { background: #fff; }
  .tk-mini__tage :global(.punkte) { display: flex; gap: 2px; height: 5px; }
  .tk-mini__tage :global(.punkte .tk-sq) { width: 5px; height: 5px; }

  .tk-spalte { flex: 1 1 560px; min-width: 0; }
  .tk-spalte__kopf { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; margin-bottom: 8px; }
  .tk-treffer { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
  .tk-spalte :global(.tk-mo) { margin-bottom: 24px; }
  .tk-spalte :global(.tk-mo__kopf) {
    position: sticky; top: var(--tk-oben); z-index: 2; background: var(--paper); padding: 18px 0 12px;
    border-bottom: 2px solid var(--purple); display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
  }
  .tk-spalte :global(.tk-mo__kopf h2) { font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 3vw, 40px); line-height: 1; letter-spacing: -0.03em; color: var(--purple); margin: 0; }
  .tk-spalte :global(.tk-mo__kopf span) { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); }
  .tk-spalte :global(.tk-tagzeile) { border-bottom: 1px solid var(--rule); scroll-margin-top: calc(var(--tk-oben) + 70px); }
