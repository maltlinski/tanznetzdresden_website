---
import Page from '../layouts/Page.astro';
import PageIntro from '../components/PageIntro.astro';
import Kalender from '../components/Kalender.astro';
import EventList from '../components/EventList.astro';
import { badgeVariant, categoryLabel, eventCategories, getUpcoming } from '../lib/content';
import { getTanzkalender } from '../lib/kalender';
import { href } from '../lib/url';
import { getLang, tr, url } from '../lib/i18n';

const lang = getLang(Astro);
const { days, months } = await getTanzkalender(lang);
const t = tr(lang, {
  de: {
    title: 'Tanzkalender', desc: 'Alle Termine der freien Tanzszene Dresden: Bühne, Training und Diskurs, dazu das Profitraining KEEP UP.',
    kicker: 'Tanzkalender', h1: 'Was läuft', accent: 'im Netz.',
    lead: 'Aufführungen, Training und Gespräche aus dem Netzwerk, dazu jeder Tag Profitraining. Abonniere den Kalender, dann landen neue Termine automatisch in deiner Kalender-App.',
    ics: 'Kalender abonnieren (.ics)', submit: 'Termin einreichen →', calKicker: 'Monat für Monat', h2: 'Kalender', filter: 'Nach Kategorie filtern',
  },
  en: {
    title: 'Dance calendar', desc: "All events of Dresden's independent dance scene: stage, training and discourse, plus the KEEP UP professional training.",
    kicker: 'Dance calendar', h1: "What's on", accent: 'in the network.',
    lead: 'Performances, training and talks from the network, plus every day of professional training. Subscribe to the calendar and new events appear in your calendar app automatically.',
    ics: 'Subscribe to calendar (.ics)', submit: 'Submit an event →', calKicker: 'Month by month', h2: 'Calendar', filter: 'Filter by category',
  },
});
---
<Page title={t.title} description={t.desc} route="termine">
  <PageIntro kicker={t.kicker} title={t.h1} accent={t.accent} lead={t.lead}>
    <div class="cal-actions">
      <a class="btn btn--secondary btn--marker" href={href('termine.ics')}>{t.ics}</a>
      <a class="mono-link underline-link" href={url(lang, 'kontakt', '#termin-einreichen')}>{t.submit}</a>
    </div>
  </PageIntro>
  <Kalender
    days={days}
    months={months}
    kicker={t.calKicker}
    title={t.h2}
    filter={{ label: t.filter, chips: eventCategories.map((c) => ({ key: c, label: categoryLabel[lang][c] })) }}
    legende={eventCategories.map((c) => ({ color: badgeVariant[c], label: categoryLabel[lang][c] }))}
  >
    <EventList slot="liste" events={await getUpcoming()} id="all-events" groupByMonth />
  </Kalender>
</Page>

<style>
  .cal-actions { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; margin-top: 32px; }
</style>
