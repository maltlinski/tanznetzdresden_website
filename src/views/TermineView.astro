---
import Page from '../layouts/Page.astro';
import PageIntro from '../components/PageIntro.astro';
import Kalender from '../components/Kalender.astro';
import EventList from '../components/EventList.astro';
import { badgeVariant, categoryLabel, eventCategories, getUpcoming } from '../lib/content';
import { getTanzkalender } from '../lib/kalender';
import { href } from '../lib/url';
import { getLang, tr, url } from '../lib/i18n';
import { texte, zeilen } from '../lib/texte';

const lang = getLang(Astro);
const { days, months } = await getTanzkalender(lang);
const k = texte(lang, 'termine', 'kopf');
const [h1, accent] = zeilen(k.titel);
const t = { ...k, h1, accent, ...tr(lang, { de: { filter: 'Nach Kategorie filtern' }, en: { filter: 'Filter by category' } }) };
---
<Page title={t.title} description={t.desc} route="termine">
  <PageIntro kicker={t.kicker} title={t.h1} accent={t.accent} lead={t.lead}>
    <div class="cal-actions">
      <a class="btn btn--secondary btn--marker" href={href('termine.ics')}>{t.ics}</a>
      <a class="mono-link underline-link" href={url(lang, 'kontakt', '#termin-einreichen')}>{t.submit}</a>
    </div>
  </PageIntro>
  <Kalender
    days={days}
    months={months}
    kicker={t.calKicker}
    title={t.h2}
    filter={{ label: t.filter, chips: eventCategories.map((c) => ({ key: c, label: categoryLabel[lang][c] })) }}
    legende={eventCategories.map((c) => ({ color: badgeVariant[c], label: categoryLabel[lang][c] }))}
  >
    <EventList slot="liste" events={await getUpcoming()} id="all-events" groupByMonth />
  </Kalender>
</Page>

<style>
  .cal-actions { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; margin-top: 32px; }
</style>
