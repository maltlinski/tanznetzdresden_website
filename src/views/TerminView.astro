---
/** Einzelner Termin: Kopf auf Lila mit Datum, Ort, Kategorie; Beschreibung, Mitwirkende, passender Beitrag. */
import Page from '../layouts/Page.astro';
import Tag from '../components/ui/Tag.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import KeilBar from '../components/ui/KeilBar.astro';
import EventList from '../components/EventList.astro';
import { badgeVariant, categoryLabel, getUpcoming, type Termin } from '../lib/content';
import { dateParts } from '../lib/dates';
import { getNews } from '../lib/news';
import { getProfile } from '../lib/profiles';
import { renderMarkdown } from '../lib/markdown';
import { getVerein } from '../lib/settings';
import { href } from '../lib/url';
import { getLang, loc, tr, url } from '../lib/i18n';

interface Props {
  termin: Termin;
}
const { termin } = Astro.props;
const d = termin.data;
const lang = getLang(Astro);
const verein = getVerein(lang);
const date = dateParts(d.start, lang);
const title = loc(d, 'title', lang);
const teaser = loc(d, 'teaser', lang);
const time = loc(d, 'timeLabel', lang) ?? (d.end ? `${date.time.replace(' Uhr', '')}–${dateParts(d.end, lang).time}` : date.time);
const body = termin.body?.trim() ? renderMarkdown(termin.body, import.meta.env.BASE_URL) : '';
const people = (await Promise.all(d.people.map(async (id) => ({ id, profile: await getProfile(id) }))))
  .filter((p) => p.profile)
  .map((p) => ({ id: p.id, name: p.profile!.name }));
const post = d.news ? (await getNews(lang)).find((p) => p.id === d.news) : undefined;
const more = (await getUpcoming()).filter((t) => t.id !== termin.id).slice(0, 3);
const end = (d.end ?? d.start).replace(' ', 'T');

const t = tr(lang, {
  de: {
    back: '← Ganzer Kalender', when: 'Wann', where: 'Wo', what: 'Was', people: 'Mit', ics: 'In meinen Kalender (.ics)',
    link: 'Tickets & Anmeldung', post: 'Mehr dazu im Journal', read: 'Beitrag lesen →', past: 'Dieser Termin ist vorbei.',
    more: 'Tanzkalender', moreH: 'Weitere Termine', all: 'Ganzer Kalender →',
  },
  en: {
    back: '← Full calendar', when: 'When', where: 'Where', what: 'What', people: 'With', ics: 'Add to my calendar (.ics)',
    link: 'Tickets & registration', post: 'More in the journal', read: 'Read the post →', past: 'This event has already taken place.',
    more: 'Dance calendar', moreH: 'More events', all: 'Full calendar →',
  },
});
const pageUrl = new URL(url(lang, 'termine', `${termin.id}/`), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description: teaser,
  startDate: date.iso,
  ...(d.end ? { endDate: dateParts(d.end, lang).iso } : {}),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: d.venue, address: 'Dresden' },
  organizer: { '@type': 'Organization', name: verein.legalName },
  url: pageUrl,
};
---
<Page route="termine" rest={`${termin.id}/`} title={`${title} · ${date.day}. ${date.month}`} description={teaser}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article data-termin data-end={end}>
    <header class="th">
      <div class="wrap th__inner">
        <a href={url(lang, 'termine')} class="th__back" data-rise="0">{t.back}</a>
        <div class="th__row">
          <time class="th__date" datetime={date.iso} data-rise="0.08">
            <span class="th__day" aria-hidden="true">{date.day}</span>
            <span class="th__dm" aria-hidden="true">{date.dow} · {date.month}</span>
            <span class="visually-hidden">{date.long}</span>
          </time>
          <div class="th__text">
            <div class="th__meta" data-rise="0.12">
              <Badge variant={badgeVariant[d.category] === 'purple' ? 'cyan' : badgeVariant[d.category]}>{categoryLabel[lang][d.category]}</Badge>
            </div>
            <h1 class="th__title" data-rise="0.16">{title}</h1>
            <p class="th__where" data-rise="0.24">{d.venue} · {time}</p>
          </div>
        </div>
        <p class="th__past" data-past hidden>{t.past}</p>
      </div>
      <KeilBar class="th__keil" />
    </header>

    <section class="tb">
      <div class="wrap tb__inner">
        <div class="tb__main">
          <p class="tb__teaser">{teaser}</p>
          {body && <div class="tb__text" set:html={body} />}
          <div class="tb__actions">
            {d.link && <Button href={d.link} variant="secondary" marker rel="noopener" target="_blank">{t.link}</Button>}
            <a class="mono-link tb__ics" href={href(`termine/${termin.id}.ics`)} download>{t.ics}</a>
          </div>
        </div>
        <aside class="tb__aside">
          <dl class="tb__facts">
            <div><dt>{t.when}</dt><dd>{date.long}<br />{time}</dd></div>
            <div><dt>{t.where}</dt><dd>{d.venue}</dd></div>
            <div><dt>{t.what}</dt><dd>{categoryLabel[lang][d.category]}</dd></div>
            {people.length > 0 && (
              <div>
                <dt>{t.people}</dt>
                <dd>{people.map((p, i) => <>{i > 0 && ', '}<a href={url(lang, 'netzwerk', `${p.id}/`)}>{p.name}</a></>)}</dd>
              </div>
            )}
          </dl>
          {post && (
            <a class="tb__post" href={url(lang, 'news', `${post.id}/`)}>
              <span class="tb__post-k">{t.post}</span>
              <span class="tb__post-t">{post.title}</span>
              <span class="tb__post-r">{t.read}</span>
            </a>
          )}
        </aside>
      </div>
    </section>

    {more.length > 0 && (
      <section class="tm surface-tint" aria-labelledby="tm-h">
        <div class="wrap">
          <div class="tm__head">
            <div>
              <Tag>{t.more}</Tag>
              <h2 id="tm-h" class="tm__h">{t.moreH}</h2>
            </div>
            <a class="mono-link tm__all" href={url(lang, 'termine')}>{t.all}</a>
          </div>
          <EventList events={more} id="more-events" />
        </div>
      </section>
    )}
  </article>
</Page>

<script>
  import { introText } from '../scripts/intro-text';

  const article = document.querySelector<HTMLElement>('[data-termin]');
  introText(article?.querySelector('.th') ?? null);
  // Die Seite wird einmal am Tag gebaut: vorbei ist, was der Browser für vorbei hält.
  if (article && new Date(article.dataset.end ?? '').getTime() < Date.now()) {
    article.querySelector<HTMLElement>('[data-past]')?.removeAttribute('hidden');
  }
</script>

<style>
  /* ---------- Kopf ---------- */
  .th { position: relative; background: var(--purple); color: #fff; overflow: hidden; }
  .th__inner { padding-block: clamp(36px, 5vw, 64px) clamp(64px, 9vw, 120px); }
  .th__back {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: clamp(36px, 5vw, 64px); color: #fff;
    font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .th__back:hover { color: var(--cyan); }
  .th__row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 20px clamp(24px, 4vw, 48px); }
  .th__date { display: flex; flex-direction: column; gap: 10px; flex: none; }
  .th__day {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(96px, 14vw, 200px); line-height: 0.78;
    letter-spacing: -0.05em; color: #fff;
  }
  .th__dm {
    font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; font-size: 15px;
    letter-spacing: 0.2em; color: var(--cyan);
  }
  .th__text { flex: 1 1 320px; min-width: 0; padding-bottom: 4px; }
  .th__meta { margin-bottom: 18px; }
  .th__title {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(40px, 5.6vw, 88px); line-height: 0.95;
    letter-spacing: -0.04em; margin: 0 0 20px; color: #fff; text-wrap: balance; hyphens: auto;
  }
  .th__where {
    margin: 0; font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; font-size: 14px;
    letter-spacing: 0.16em; color: rgba(255, 255, 255, 0.9);
  }
  .th__past {
    margin: 32px 0 0; display: inline-block; padding: 10px 14px; background: #fff; color: var(--purple);
    font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .th :global(.th__keil) { position: absolute; left: 0; bottom: 0; width: 34%; z-index: 2; }

  /* ---------- Inhalt ---------- */
  .tb { padding: clamp(48px, 7vw, 96px) 0; }
  .tb__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 48px clamp(40px, 6vw, 96px); }
  .tb__main { flex: 1 1 520px; max-width: 720px; min-width: 0; }
  .tb__teaser {
    margin: 0 0 28px; font-family: var(--font-display); font-weight: 700; font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.3; letter-spacing: -0.015em; color: var(--purple); text-wrap: pretty;
  }
  .tb__text { font-size: 18px; line-height: 1.75; color: var(--ink); }
  .tb__text :global(p) { margin: 0 0 1.3em; text-wrap: pretty; }
  .tb__text :global(a) { color: var(--purple); text-decoration: underline; text-decoration-color: var(--magenta); text-underline-offset: 3px; }
  .tb__text :global(a:hover) { color: var(--magenta); }
  .tb__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: 32px; }
  .tb__ics { color: var(--purple); border-bottom: 1.5px solid var(--magenta); padding-bottom: 4px; }
  .tb__ics:hover { color: var(--magenta); }

  .tb__aside { flex: 0 1 320px; min-width: 240px; display: flex; flex-direction: column; gap: 32px; }
  .tb__facts { margin: 0; border-top: 3px solid var(--magenta); }
  .tb__facts > div { padding: 14px 0; border-bottom: 1px solid var(--rule); display: flex; flex-direction: column; gap: 4px; }
  .tb__facts dt { font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); }
  .tb__facts dd { margin: 0; font-size: 15px; line-height: 1.5; font-weight: 600; color: var(--purple); }
  .tb__facts a { color: var(--purple); text-decoration: underline; text-decoration-color: var(--magenta); text-underline-offset: 3px; }
  .tb__facts a:hover { color: var(--magenta); }
  .tb__post {
    display: flex; flex-direction: column; gap: 10px; background: var(--purple); color: #fff; padding: 22px 24px 26px;
    clip-path: polygon(0 0, 100% 0, 100% 84%, 88% 100%, 0 100%);
  }
  .tb__post:hover { color: #fff; }
  .tb__post-k, .tb__post-r { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .tb__post-k { color: var(--cyan); }
  .tb__post-t { font-family: var(--font-display); font-weight: 800; font-size: 24px; line-height: 1.08; letter-spacing: -0.02em; }
  .tb__post:hover .tb__post-t { color: var(--cyan); }

  /* ---------- Weitere Termine ---------- */
  .tm { background: var(--tint); padding: clamp(56px, 7vw, 96px) 0; }
  .tm__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px; margin-bottom: 24px; }
  .tm__head :global(.tag) { margin-bottom: 16px; }
  .tm__h { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(34px, 4.4vw, 56px); line-height: 0.98; letter-spacing: -0.03em; color: var(--purple); }
  .tm__all { color: var(--magenta-2); letter-spacing: 0.14em; }
  .tm__all:hover { color: var(--purple); }
</style>
