---
/**
 * Spendenseite. Alle Angaben (Bankverbindung, Beträge, Wirkung, Online-Spende)
 * stehen in src/settings/verein.json → donation, der Steuerbescheid unter taxExemption.
 */
import Page from '../layouts/Page.astro';
import PageIntro from '../components/PageIntro.astro';
import Tag from '../components/ui/Tag.astro';
import ProtectedEmail from '../components/ProtectedEmail.astro';
import { getVerein } from '../lib/settings';
import { formatIban, giroCodeSvg, isValidIban } from '../lib/girocode';
import { getLang, tr, url } from '../lib/i18n';

const lang = getLang(Astro);
const v = getVerein(lang);
const d = v.donation;
const ibanOk = isValidIban(d.iban);
if (d.iban && !ibanOk) console.warn(`[spenden] Die IBAN in verein.json ist ungültig – Bankverbindung wird nicht angezeigt.`);

// Ein GiroCode je Betrag + einer ohne Betrag
const codes = ibanOk
  ? await Promise.all(
      [...d.amounts, 0].map(async (amount) => ({
        amount,
        svg: await giroCodeSvg({ name: d.accountHolder, iban: d.iban, bic: d.bic, amount: amount || undefined, text: d.reference }),
      })),
    )
  : [];
const euro = (n: number) => new Intl.NumberFormat(lang === 'en' ? 'en-GB' : 'de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);

const t = tr(lang, {
  de: {
    title: 'Spenden', desc: 'Unterstütze die freie Tanzszene in Dresden: mit einer Spende an TanzNetzDresden e.V. – steuerlich absetzbar.',
    kicker: 'Spenden · gemeinnützig', h1: 'Halte das Netz', accent: 'in Bewegung.',
    lead: 'Jede Spende fließt direkt in die freie Tanzszene: in faire Honorare, Probenräume, Training und Formate, die offen für alle sind. Deine Spende ist steuerlich absetzbar.',
    cta: 'Jetzt spenden', impactKicker: 'Was deine Spende bewirkt', impactH: 'Zum Beispiel', impactNote: 'Beispiele. Wir setzen Spenden dort ein, wo sie gerade am meisten fehlen.',
    howKicker: 'So spendest du', transferH: 'Per Überweisung', holder: 'Empfänger', bank: 'Bank', ref: 'Verwendungszweck', copy: 'Kopieren', copied: 'Kopiert',
    amount: 'Betrag für den GiroCode', free: 'Frei', qrHint: 'Mit der Banking-App scannen: Empfänger, IBAN, Betrag und Verwendungszweck sind dann schon ausgefüllt.',
    qrAlt: 'GiroCode für eine Überweisung', refHint: 'Für eine Zuwendungsbestätigung bitte Name und Anschrift im Verwendungszweck angeben.',
    noBank: 'Die Bankverbindung für Spenden ergänzen wir in Kürze. Bis dahin schick uns gern eine Nachricht – wir melden uns mit den Daten.',
    noBankMail: 'Bankverbindung anfragen', noBankSubject: 'Spende',
    onlineH: 'Online spenden', onlineP: (p: string) => `Mit Lastschrift, Karte oder PayPal über ${p}. Du wirst dafür zu ${p} weitergeleitet.`, onlineCta: (p: string) => `Zu ${p} →`,
    memberH: 'Regelmäßig unterstützen', memberP: 'Als Fördermitglied unterstützt du uns mit einem festen Jahresbeitrag – ohne dass du selbst tanzen musst.', memberCta: 'Fördermitgliedschaft anfragen', memberSubject: 'Fördermitgliedschaft',
    receiptKicker: 'Steuer', receiptH: 'Spendenbescheinigung',
    upTo: 'Bis 300 €', upToP: 'Für das Finanzamt reicht dein Kontoauszug zusammen mit unserem vereinfachten Spendennachweis. Einfach ausdrucken.', upToCta: 'Spendennachweis öffnen →',
    above: 'Über 300 €', aboveP: 'Du bekommst von uns eine Zuwendungsbestätigung. Bitte gib dafür Name und Anschrift im Verwendungszweck an oder schreib uns kurz.', aboveMail: 'Bestätigung anfordern', aboveSubject: 'Zuwendungsbestätigung',
    status: (office: string, date: string) => `Wir sind als gemeinnützig anerkannt (${office}, Bescheid vom ${date}).`,
    moreKicker: 'Weitere Wege', moreH: 'Anders helfen',
    more: [
      ['Sachspenden', 'Tanzboden, Licht, Technik, Kostüme: Sprich uns an, bevor du etwas vorbeibringst.'],
      ['Mitmachen', 'Die Arbeitsgruppen freuen sich über Hilfe bei Aufbau, Einlass und Öffentlichkeitsarbeit.'],
      ['Weitersagen', 'Erzähl von uns, teile unsere Termine und bring Freund:innen mit zur nächsten Vorstellung.'],
    ],
    transparency: 'Wofür wir unser Geld ausgeben, steht auf unserer Transparenz-Seite.', transparencyCta: 'Transparenz →',
  },
  en: {
    title: 'Donate', desc: "Support Dresden's independent dance scene with a donation to TanzNetzDresden e.V. – tax-deductible in Germany.",
    kicker: 'Donate · non-profit', h1: 'Keep the network', accent: 'moving.',
    lead: 'Every donation goes straight into the independent dance scene: fair fees, rehearsal spaces, training and formats that are open to everyone. Donations are tax-deductible in Germany.',
    cta: 'Donate now', impactKicker: 'What your donation does', impactH: 'For example', impactNote: 'Examples. We use donations where they are needed most at the time.',
    howKicker: 'How to donate', transferH: 'By bank transfer', holder: 'Recipient', bank: 'Bank', ref: 'Reference', copy: 'Copy', copied: 'Copied',
    amount: 'Amount for the QR code', free: 'Any', qrHint: 'Scan with your banking app: recipient, IBAN, amount and reference are filled in for you (SEPA/EPC QR code).',
    qrAlt: 'EPC QR code for a bank transfer', refHint: 'If you need a donation receipt, please include your name and address in the reference.',
    noBank: 'We will add the bank details for donations shortly. Until then, send us a message and we will get back to you.',
    noBankMail: 'Ask for bank details', noBankSubject: 'Donation',
    onlineH: 'Donate online', onlineP: (p: string) => `By direct debit, card or PayPal via ${p}. You will be redirected to ${p}.`, onlineCta: (p: string) => `Go to ${p} →`,
    memberH: 'Support us regularly', memberP: 'As a supporting member you back us with a fixed annual fee – you do not have to dance yourself.', memberCta: 'Ask about supporting membership', memberSubject: 'Supporting membership',
    receiptKicker: 'Tax', receiptH: 'Donation receipt',
    upTo: 'Up to €300', upToP: 'For the German tax office, your bank statement plus our simplified donation receipt is sufficient. Just print it (in German).', upToCta: 'Open simplified receipt →',
    above: 'Above €300', aboveP: 'We will send you an official donation receipt. Please include your name and address in the reference or drop us a line.', aboveMail: 'Request a receipt', aboveSubject: 'Donation receipt',
    status: (office: string, date: string) => `We are recognised as a non-profit organisation (${office}, notice dated ${date}).`,
    moreKicker: 'Other ways', moreH: 'Help differently',
    more: [
      ['Donations in kind', 'Dance floor, lights, technology, costumes: please talk to us before bringing anything.'],
      ['Get involved', 'Our working groups welcome help with set-up, front of house and public relations.'],
      ['Spread the word', 'Tell people about us, share our events and bring friends to the next performance.'],
    ],
    transparency: 'What we spend our money on is on our transparency page.', transparencyCta: 'Transparency →',
  },
});
const provider = d.onlineProvider || 'betterplace';
---
<Page title={t.title} description={t.desc} route="spenden">
  <PageIntro kicker={t.kicker} title={t.h1} accent={t.accent} lead={t.lead}>
    <div class="intro-actions">
      <a class="btn btn--secondary btn--lg btn--marker" href="#spenden-wie">{t.cta}</a>
    </div>
  </PageIntro>

  <section class="section" aria-labelledby="wirkung-h">
    <div class="wrap">
      <div class="section-head">
        <div data-reveal><Tag>{t.impactKicker}</Tag><h2 id="wirkung-h" class="h2">{t.impactH}</h2></div>
        <p class="note">{t.impactNote}</p>
      </div>
      <ul class="impact">
        {d.impact.map((i) => (
          <li><span class="impact__amount">{euro(i.amount)}</span><span class="impact__text">{i.text}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section how" id="spenden-wie" aria-labelledby="wie-h">
    <div class="wrap">
      <div class="section-head"><div data-reveal><Tag color="cyan">{t.howKicker}</Tag><h2 id="wie-h" class="h2 how__h">{t.transferH}</h2></div></div>
      <div class="how__grid">
        <div class="transfer">
          {ibanOk ? (
            <>
              <dl class="bank" data-copy-scope data-copied={t.copied}>
                <div><dt>{t.holder}</dt><dd><span>{d.accountHolder}</span><button type="button" class="copy" data-copy={d.accountHolder}>{t.copy}</button></dd></div>
                <div><dt>IBAN</dt><dd><span class="mono">{formatIban(d.iban)}</span><button type="button" class="copy" data-copy={d.iban.replace(/\s+/g, '')}>{t.copy}</button></dd></div>
                {d.bic && <div><dt>BIC</dt><dd><span class="mono">{d.bic}</span><button type="button" class="copy" data-copy={d.bic}>{t.copy}</button></dd></div>}
                {d.bank && <div><dt>{t.bank}</dt><dd><span>{d.bank}</span></dd></div>}
                <div><dt>{t.ref}</dt><dd><span>{d.reference}</span><button type="button" class="copy" data-copy={d.reference}>{t.copy}</button></dd></div>
              </dl>
              <p class="transfer__hint">{t.refHint}</p>
            </>
          ) : (
            <div class="nobank">
              <p>{t.noBank}</p>
              <ProtectedEmail email={v.emails.vorstand} label={t.noBankMail} subject={t.noBankSubject} />
            </div>
          )}
        </div>

        {ibanOk && (
          <div class="qr" data-qr>
            <div class="qr__chips chips" role="group" aria-label={t.amount}>
              {codes.map((c, i) => (
                <button type="button" class="chip" data-amount={c.amount} aria-pressed={i === 0 ? 'true' : 'false'}>{c.amount ? euro(c.amount) : t.free}</button>
              ))}
            </div>
            <div class="qr__codes">
              {codes.map((c, i) => (
                <figure class="qr__code" data-amount={c.amount} hidden={i !== 0} role="img" aria-label={`${t.qrAlt}${c.amount ? `: ${euro(c.amount)}` : ''}`}>
                  <Fragment set:html={c.svg} />
                </figure>
              ))}
            </div>
            <p class="qr__hint">{t.qrHint}</p>
          </div>
        )}
      </div>

      <div class="ways">
        {d.onlineUrl && (
          <div class="way">
            <h3>{t.onlineH}</h3>
            <p>{t.onlineP(provider)}</p>
            <a class="btn btn--secondary btn--marker" href={d.onlineUrl} rel="noopener" target="_blank">{t.onlineCta(provider)}</a>
          </div>
        )}
        <div class="way">
          <h3>{t.memberH}</h3>
          <p>{t.memberP}</p>
          <ProtectedEmail email={v.emails.vorstand} label={t.memberCta} subject={t.memberSubject} />
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-tint receipt" aria-labelledby="beleg-h">
    <div class="wrap">
      <div class="section-head"><div data-reveal><Tag>{t.receiptKicker}</Tag><h2 id="beleg-h" class="h2">{t.receiptH}</h2></div></div>
      <div class="receipt__grid">
        <div class="receipt__card">
          <span class="receipt__amount">{t.upTo}</span>
          <p>{t.upToP}</p>
          <a class="mono-link" href={url('de', 'spendenNachweis')} lang={lang === 'en' ? 'de' : undefined}>{t.upToCta}</a>
        </div>
        <div class="receipt__card">
          <span class="receipt__amount">{t.above}</span>
          <p>{t.aboveP}</p>
          <ProtectedEmail email={v.emails.vorstand} label={t.aboveMail} subject={t.aboveSubject} />
        </div>
      </div>
      <p class="receipt__status">{t.status(v.taxExemption.office, v.taxExemption.noticeDate)}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="anders-h">
    <div class="wrap">
      <div class="section-head"><div data-reveal><Tag>{t.moreKicker}</Tag><h2 id="anders-h" class="h2">{t.moreH}</h2></div></div>
      <ul class="more">
        {t.more.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
      </ul>
      <p class="transparency">{t.transparency} <a href={url(lang, 'transparenz')}>{t.transparencyCta}</a></p>
    </div>
  </section>
</Page>

<script>
  // Betrag wählen → passender GiroCode
  document.querySelectorAll<HTMLElement>('[data-qr]').forEach((qr) => {
    qr.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-amount]');
      if (!btn) return;
      qr.querySelectorAll('button[data-amount]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      qr.querySelectorAll<HTMLElement>('.qr__code').forEach((c) => (c.hidden = c.dataset.amount !== btn.dataset.amount));
    });
  });
  // Kopieren
  document.querySelectorAll<HTMLElement>('[data-copy-scope]').forEach((scope) => {
    scope.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-copy]');
      if (!btn) return;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        const label = btn.textContent;
        btn.textContent = scope.dataset.copied ?? '✓';
        btn.classList.add('is-done');
        setTimeout(() => { btn.textContent = label; btn.classList.remove('is-done'); }, 1600);
      } catch {
        /* Zwischenablage nicht erlaubt – Text bleibt markierbar */
      }
    });
  });
</script>

<style>
  .intro-actions { margin-top: 32px; }
  .note { max-width: 380px; margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-soft); }
  .impact { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); border-top: 1px solid var(--rule); }
  .impact li { display: flex; flex-direction: column; gap: 12px; padding: 28px 28px 32px 0; border-bottom: 1px solid var(--rule); }
  .impact__amount { font-family: var(--font-display); font-weight: 800; font-size: clamp(48px, 5.4vw, 76px); line-height: 0.9; letter-spacing: -0.035em; color: var(--magenta); }
  .impact__text { font-size: 17px; line-height: 1.55; color: var(--purple); max-width: 30ch; }

  .how { background: var(--purple); color: #fff; scroll-margin-top: var(--header-h); position: relative; }
  .how__h { color: #fff; }
  .how__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px clamp(32px, 6vw, 96px); align-items: start; }
  .bank { margin: 0; border-top: 1px solid var(--on-dark-rule); }
  .bank > div { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 8px 20px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--on-dark-rule); }
  .bank dt { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); }
  .bank dd { margin: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; font-size: 17px; }
  .bank .mono { font-family: var(--font-mono); font-size: 17px; letter-spacing: 0.06em; }
  .copy {
    background: none; border: 1.5px solid rgba(255, 255, 255, 0.4); color: #fff; padding: 5px 10px; cursor: pointer;
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    transition: border-color var(--dur-base), color var(--dur-base), background var(--dur-base);
  }
  .copy:hover { border-color: var(--magenta); color: var(--cyan); }
  .copy.is-done { background: var(--cyan); border-color: var(--cyan); color: var(--purple); }
  .transfer__hint { margin: 18px 0 0; font-size: 14px; line-height: 1.6; color: var(--on-dark-soft); max-width: 56ch; }
  .nobank { padding: 24px 26px; border: 1.5px dashed rgba(255, 255, 255, 0.35); }
  .nobank p { margin: 0 0 16px; color: rgba(255, 255, 255, 0.86); line-height: 1.6; }
  .nobank :global(.protected-email) { color: #fff; }

  .qr { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .qr .chip { border-color: rgba(255, 255, 255, 0.6); color: #fff; }
  .qr .chip:hover { border-color: var(--magenta); }
  .qr .chip[aria-pressed='true'] { background: var(--cyan); border-color: var(--cyan); color: var(--purple); }
  /* Der Code bleibt schwarz auf weiß – sonst lesen ihn manche Banking-Apps nicht */
  .qr__code { margin: 0; width: min(100%, 240px); padding: 16px; background: #fff; }
  .qr__code :global(svg) { display: block; width: 100%; height: auto; }
  .qr__hint { margin: 0; max-width: 34ch; font-size: 13.5px; line-height: 1.55; color: var(--on-dark-soft); }

  .ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 20px; margin-top: 48px; }
  .way { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 26px 26px 30px; background: var(--purple-2); }
  .way h3 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 24px; letter-spacing: -0.02em; }
  .way p { margin: 0 0 8px; font-size: 15px; line-height: 1.6; color: rgba(255, 255, 255, 0.86); }
  .way :global(.protected-email) { color: #fff; }

  .receipt { background: var(--tint); }
  .receipt__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px; }
  .receipt__card { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 26px 26px 30px; background: var(--paper); border-top: 3px solid var(--magenta); }
  .receipt__amount { font-family: var(--font-display); font-weight: 800; font-size: 30px; letter-spacing: -0.025em; color: var(--purple); }
  .receipt__card p { margin: 0 0 8px; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  .receipt__card :global(.protected-email) { color: var(--purple); }
  .receipt__status { margin: 24px 0 0; font-size: 13.5px; color: var(--ink-soft); }

  .more { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 0 32px; border-top: 1px solid var(--rule); }
  .more li { padding: 24px 0 28px; border-bottom: 1px solid var(--rule); }
  .more h3 { margin: 0 0 6px; font-family: var(--font-display); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; color: var(--purple); }
  .more p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); max-width: 40ch; }
  .transparency { margin: 32px 0 0; font-size: 15px; color: var(--ink-soft); }
  .transparency a { color: var(--purple); text-decoration: underline; text-decoration-color: var(--magenta); text-underline-offset: 3px; }

  @media (max-width: 860px) {
    .how__grid { grid-template-columns: 1fr; }
    .bank > div { grid-template-columns: 1fr; }
  }
</style>
