---
/**
 * Spendenseite (Entwurf Oktober 2026). Alle Angaben (Bankverbindung, Formate, Online-Spende)
 * stehen in src/settings/verein.json → donation, der Steuerbescheid unter taxExemption.
 */
import Page from '../layouts/Page.astro';
import Tag from '../components/ui/Tag.astro';
import KeilBar from '../components/ui/KeilBar.astro';
import ProtectedEmail from '../components/ProtectedEmail.astro';
import { Image } from 'astro:assets';
import { getVerein } from '../lib/settings';
import { getFormate } from '../lib/content';
import { formatIban, giroCodeSvg, isValidIban } from '../lib/girocode';
import { getLang, loc, tr, url } from '../lib/i18n';
import { fuellen, texte, zeilen } from '../lib/texte';
import sprung from '../assets/photos/sprung.jpg';

const lang = getLang(Astro);
const v = getVerein(lang);
const d = v.donation;
const ibanOk = isValidIban(d.iban);
if (d.iban && !ibanOk) console.warn(`[spenden] Die IBAN in verein.json ist ungültig – Bankverbindung wird nicht angezeigt.`);
// GiroCode ohne Betrag: den wählt die Person in der Banking-App
const qr = ibanOk ? await giroCodeSvg({ name: d.accountHolder, iban: d.iban, bic: d.bic, text: d.reference }) : '';

const alleFormate = await getFormate();
const formate = d.formate.map((f) => {
  const fm = alleFormate.find((x) => x.id === f.format);
  if (!fm) throw new Error(`src/settings/verein.json: Format „${f.format}“ gibt es nicht in src/content/formate/`);
  return { ...f, title: loc(fm.data, 'title', lang), image: fm.data.image, alt: loc(fm.data, 'alt', lang), page: fm.data.seite ? url(lang, fm.data.seite) : undefined };
});
// Platzhalter wie „[BITTE ERGÄNZEN]“ nicht öffentlich zeigen
const bescheid = !/\[/.test(`${v.taxExemption.office}${v.taxExemption.noticeDate}`);

const kopf = texte(lang, 'spenden', 'kopf');
const bew = texte(lang, 'spenden', 'bewegung');
const wege = texte(lang, 'spenden', 'wege');
const fr = texte(lang, 'spenden', 'fragen');
const [h1, accent] = zeilen(kopf.titel);
const frage = (text: string, link?: string) => {
  const [q, a] = zeilen(text);
  return { q, a, link };
};
const t = {
  ...kopf, h1, accent, ...texte(lang, 'spenden', 'konto'),
  ...bew, useH: zeilen(bew.useH),
  ...wege, onlineP: (p: string) => fuellen(wege.onlineP, { anbieter: p }), onlineCta: (p: string) => fuellen(wege.onlineCta, { anbieter: p }),
  ...fr, status: (amt: string, datum: string) => fuellen(fr.status, { amt, datum }),
  faqs: [frage(fr.frage1, fr.frage1Link), frage(fr.frage2), frage(fr.frage3)],
  // nur für Screenreader
  ...tr(lang, { de: { photoAlt: 'Sprung auf der Bühne', qrAlt: 'GiroCode für eine Überweisung' }, en: { photoAlt: 'A leap on stage', qrAlt: 'EPC QR code for a bank transfer' } }),
};
const provider = d.onlineProvider || 'betterplace';
const kopieren = [
  { k: t.holder, v: d.accountHolder, roh: d.accountHolder, mono: false },
  { k: 'IBAN', v: formatIban(d.iban), roh: d.iban.replace(/\s+/g, ''), mono: true },
  ...(d.bic ? [{ k: 'BIC', v: d.bic, roh: d.bic, mono: true }] : []),
  { k: t.ref, v: d.reference, roh: d.reference, mono: false },
];
---
<Page title={t.title} description={t.desc} route="spenden">
  <section class="sk" aria-labelledby="spenden-h">
    <div class="wrap sk__grid">
      <div class="sk__links">
        <div class="sk__tag"><Tag color="cyan">{t.kicker}</Tag></div>
        <h1 id="spenden-h" class="sk__h">{t.h1}{' '}<br /><span>{t.accent}</span></h1>
        <p class="sk__lead">{t.lead}</p>
        <div class="sk__foto">
          <Image src={sprung} alt={t.photoAlt} widths={[480, 760, 1120]} sizes="(min-width: 1000px) 560px, 100vw" loading="eager" />
        </div>
      </div>

      <div id="spende" class="konto">
        <div class="konto__kopf">
          <span class="konto__k">{t.account}</span>
          <h2 class="konto__h">{t.accountH}</h2>
        </div>
        {ibanOk ? (
          <>
            <dl class="konto__liste" data-copy-scope data-copied={t.copied}>
              {kopieren.map((r) => (
                <div class="konto__z">
                  <dt>{r.k}</dt>
                  <dd class:list={[r.mono && 'is-mono']}>{r.v}</dd>
                  <button type="button" class="konto__copy" data-copy={r.roh} aria-label={`${r.k} ${t.copy.toLowerCase()}`}>{t.copy}</button>
                </div>
              ))}
              {d.bank && <div class="konto__z"><dt>{t.bank}</dt><dd>{d.bank}</dd></div>}
            </dl>
            <div class="konto__qr">
              <figure class="konto__code" role="img" aria-label={t.qrAlt}><Fragment set:html={qr} /></figure>
              <div>
                <p class="konto__qr-h">{t.qrH}</p>
                <p class="konto__qr-p">{t.qrP}</p>
              </div>
            </div>
          </>
        ) : (
          <div class="konto__ohne">
            <p>{t.noBank}</p>
            <ProtectedEmail email={v.emails.vorstand} label={t.noBankMail} subject={t.noBankSubject} />
          </div>
        )}
        <p class="konto__beleg">
          <span class="konto__sq" aria-hidden="true"></span>
          <span>{t.receiptQ} <ProtectedEmail email={v.emails.kontakt} label={t.receiptMail} subject={t.receiptSubject} body={t.receiptBody} /> {t.receiptRest}</span>
        </p>
      </div>
    </div>
    <KeilBar class="sk__keil" />
  </section>

  <section class="section" aria-labelledby="bewegung-h">
    <div class="wrap">
      <div class="section-head">
        <div data-reveal><Tag>{t.useKicker}</Tag><h2 id="bewegung-h" class="h2">{t.useH[0]}{' '}<br />{t.useH[1]}</h2></div>
        <p class="note">{t.useP}</p>
      </div>
      <ul class="bewegung">
        {formate.map((f) => (
          <li class="bw">
            <div class="bw__bild"><Image src={f.image} alt={f.alt} widths={[400, 640, 900]} sizes="(min-width: 1000px) 400px, 100vw" /></div>
            <span class="bw__meta">{f.meta}</span>
            <h3 class="bw__t">{f.title}</h3>
            <p class="bw__p">{f.text}</p>
            {f.page && <a class="mono-link bw__link" href={f.page}>{t.more} {f.title} →</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="anders" aria-labelledby="anders-h">
    <KeilBar color="var(--purple)" height={14} flip class="anders__keil" />
    <div class="wrap anders__grid">
      <div>
        <Tag color="purple">{t.otherKicker}</Tag>
        <h2 id="anders-h" class="anders__h">{t.otherH}</h2>
      </div>
      <div class="weg">
        <h3>{t.memberH}</h3>
        <p>{t.memberP}</p>
        <a class="weg__link" href={url(lang, 'mitglied')}>{t.memberCta}</a>
      </div>
      <div class="weg">
        <h3>{t.orgH}</h3>
        <p>{t.orgP}</p>
        <ProtectedEmail email={v.emails.kontakt} label={t.orgMail} subject={t.orgSubject} />
      </div>
      {d.onlineUrl && (
        <div class="weg">
          <h3>{t.onlineH}</h3>
          <p>{t.onlineP(provider)}</p>
          <a class="weg__link" href={d.onlineUrl} rel="noopener" target="_blank">{t.onlineCta(provider)}</a>
        </div>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="fragen-h">
    <div class="wrap fragen">
      <div>
        <Tag>{t.faqKicker}</Tag>
        <h2 id="fragen-h" class="h2 fragen__h">{t.faqH}</h2>
        <p class="fragen__p">{t.faqP} <ProtectedEmail email={v.emails.kontakt} label={t.faqMail} subject={t.faqSubject} /></p>
        {bescheid && <p class="fragen__klein">{t.status(v.taxExemption.office, v.taxExemption.noticeDate)}</p>}
        <p class="fragen__klein">{t.transparency} <a href={url(lang, 'transparenz')}>{t.transparencyCta}</a></p>
      </div>
      <div class="faq">
        {t.faqs.map((f, i) => (
          <details class="faq__el" open={i === 0}>
            <summary><span>{f.q}</span><span class="faq__zeichen" aria-hidden="true"></span></summary>
            <p>
              {f.a}
              {f.link && <> <a href={url('de', 'spendenNachweis')} lang={lang === 'en' ? 'de' : undefined}>{f.link}</a></>}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Page>

<script>
  // Kopieren
  document.querySelectorAll<HTMLElement>('[data-copy-scope]').forEach((scope) => {
    scope.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-copy]');
      if (!btn) return;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        const label = btn.textContent;
        btn.textContent = scope.dataset.copied ?? '✓';
        btn.classList.add('is-done');
        setTimeout(() => { btn.textContent = label; btn.classList.remove('is-done'); }, 1600);
      } catch {
        /* Zwischenablage nicht erlaubt – Text bleibt markierbar */
      }
    });
  });
</script>

<style>
  /* Kopf mit Spendenkonto */
  /* so hoch wie der Kopf der Startseite (--buehne-h) */
  .sk { position: relative; display: flex; flex-direction: column; min-height: var(--buehne-h); background: var(--purple); color: #fff; overflow: hidden; }
  .sk__grid {
    flex: 1; width: 100%; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 48px clamp(32px, 5vw, 80px);
    align-items: center; align-content: center; padding-block: var(--buehne-oben) clamp(48px, 7vh, 72px);
  }
  .sk__links { display: flex; flex-direction: column; }
  .sk__tag { margin-bottom: 24px; display: flex; }
  .sk__h { margin: 0 0 26px; font-family: var(--font-display); font-weight: 800; font-size: clamp(48px, 6.4vw, 96px); line-height: 0.92; letter-spacing: -0.035em; text-wrap: balance; }
  .sk__h span { color: var(--magenta); }
  .sk__lead { margin: 0 0 32px; max-width: 460px; font-size: 17px; line-height: 1.6; color: rgba(255, 255, 255, 0.88); text-wrap: pretty; }
  .sk__foto { position: relative; width: 100%; aspect-ratio: 16 / 10; max-width: 560px; max-height: 26vh; min-height: 180px; background: #000; overflow: hidden; clip-path: polygon(0 0, 100% 0, 100% 86%, 90% 100%, 0 100%); }
  .sk__foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; display: block; }
  .sk :global(.sk__keil) { position: absolute; left: 0; bottom: 0; width: 34%; }

  .konto {
    justify-self: end; width: 100%; max-width: 560px; display: flex; flex-direction: column; gap: 24px;
    padding: clamp(24px, 3vw, 40px); background: #fff; color: var(--ink); border-top: 4px solid var(--magenta); scroll-margin-top: 24px;
  }
  .konto__kopf { display: flex; flex-direction: column; gap: 10px; }
  .konto__k { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--magenta-2); }
  .konto__h { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 2.8vw, 36px); line-height: 1; letter-spacing: -0.025em; color: var(--purple); }
  .konto__liste { margin: 0; border-top: 1px solid var(--rule); }
  .konto__z { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .konto__z dt { grid-column: 1; font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted); }
  .konto__z dd { grid-column: 1; margin: 0; font-family: var(--font-display); font-size: 18px; font-weight: 600; letter-spacing: -0.01em; color: var(--purple); overflow-wrap: anywhere; }
  .konto__z dd.is-mono { font-family: var(--font-mono); font-size: 16px; letter-spacing: 0.04em; }
  .konto__copy {
    grid-column: 2; grid-row: 1 / 3; min-width: 92px; padding: 8px 12px; border: 1px solid var(--rule); border-radius: 0; background: #fff; color: var(--purple); cursor: pointer;
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    transition: background var(--dur-base), color var(--dur-base), border-color var(--dur-base);
  }
  .konto__copy:hover { border-color: var(--magenta); }
  .konto__copy.is-done { background: var(--purple); border-color: var(--purple); color: #fff; }
  .konto__qr { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 20px; align-items: center; }
  /* Lila auf Weiß mit Rand: so lesen ihn die Banking-Apps sicher */
  .konto__code { margin: 0; width: 112px; height: 112px; padding: 6px; background: #fff; outline: 6px solid var(--tint); outline-offset: -6px; }
  .konto__code :global(svg) { display: block; width: 100%; height: 100%; }
  .konto__code :global(svg path:last-child) { stroke: var(--purple); }
  .konto__qr-h { margin: 0 0 6px; font-family: var(--font-display); font-weight: 700; font-size: 17px; letter-spacing: -0.01em; color: var(--purple); }
  .konto__qr-p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--ink-soft); text-wrap: pretty; }
  .konto__ohne { padding: 20px 22px; border: 1.5px dashed var(--rule); }
  .konto__ohne p { margin: 0 0 14px; line-height: 1.6; color: var(--ink-soft); }
  .konto__ohne :global(.protected-email) { color: var(--purple); }
  .konto__beleg {
    display: grid; grid-template-columns: 10px minmax(0, 1fr); gap: 14px; align-items: baseline; margin: 0; padding-top: 20px;
    border-top: 1px solid var(--rule); font-size: 14px; line-height: 1.55; color: var(--ink-soft); text-wrap: pretty;
  }
  .konto__sq { width: 10px; height: 10px; background: var(--magenta); }
  .konto__beleg :global(.protected-email) { display: inline; color: var(--purple); font-weight: 600; }
  .konto__beleg :global(.protected-email__icon) { display: none; }

  /* Deine Spende wird Bewegung */
  .note { max-width: 420px; margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  .bewegung { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 48px clamp(28px, 4vw, 56px); }
  .bw { display: flex; flex-direction: column; gap: 14px; }
  .bw__bild { position: relative; aspect-ratio: 4 / 3; background: var(--purple); overflow: hidden; clip-path: polygon(0 0, 100% 0, 100% 86%, 88% 100%, 0 100%); }
  .bw__bild :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .bw__meta { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--magenta-2); }
  .bw__t { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 26px; line-height: 1.05; letter-spacing: -0.02em; color: var(--purple); }
  .bw__p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); text-wrap: pretty; }
  .bw__link { align-self: flex-start; color: var(--magenta-2); }
  .bw__link:hover { color: var(--purple); }

  /* Andere Wege */
  .anders { position: relative; background: var(--cyan); color: var(--purple); }
  .anders :global(.anders__keil) { position: absolute; right: 0; top: 0; width: 42%; }
  .anders__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 36px clamp(28px, 4vw, 56px); align-items: start; padding-block: clamp(56px, 7vw, 96px); }
  .anders :global(.tag) { margin-bottom: 18px; }
  .anders__h { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(36px, 4.4vw, 56px); line-height: 0.98; letter-spacing: -0.03em; }
  .weg { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding-top: 20px; border-top: 2px solid var(--purple); }
  .weg h3 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; }
  .weg p { margin: 0; font-size: 15px; line-height: 1.6; }
  .weg__link, .weg :global(.protected-email__btn), .weg :global(.protected-email__link) {
    margin-top: 4px; padding: 6px 0; border-bottom: 1.5px solid var(--magenta); color: var(--purple);
    font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .weg__link:hover, .weg :global(.protected-email__btn:hover) { color: var(--magenta-2); }
  .weg :global(.protected-email__icon) { display: none; }

  /* Fragen */
  .fragen { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 32px clamp(32px, 5vw, 80px); align-items: start; }
  .fragen :global(.tag) { margin-bottom: 16px; }
  .fragen__h { margin-bottom: 18px; }
  .fragen__p { margin: 0 0 16px; max-width: 380px; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  .fragen__p :global(.protected-email) { color: var(--purple); }
  .fragen__klein { margin: 0 0 8px; max-width: 380px; font-size: 13.5px; line-height: 1.6; color: var(--ink-soft); }
  .fragen__klein a, .faq__el a { color: var(--purple); text-decoration: underline; text-decoration-color: var(--magenta); text-underline-offset: 3px; }
  .fragen__klein a:hover, .faq__el a:hover { color: var(--magenta-2); }
  .faq { border-top: 1px solid var(--rule); }
  .faq__el { border-bottom: 1px solid var(--rule); }
  .faq__el summary {
    display: grid; grid-template-columns: minmax(0, 1fr) 20px; gap: 20px; align-items: center; padding: 20px 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 700; font-size: 19px; line-height: 1.25; letter-spacing: -0.01em; color: var(--purple);
  }
  .faq__el summary::-webkit-details-marker { display: none; }
  .faq__el summary:hover { color: var(--magenta-2); }
  .faq__zeichen::before { content: '+'; display: block; text-align: right; font-family: var(--font-mono); font-size: 20px; font-weight: 600; color: var(--magenta-2); }
  .faq__el[open] .faq__zeichen::before { content: '–'; }
  .faq__el p { margin: 0; padding: 0 40px 22px 0; font-size: 15px; line-height: 1.6; color: var(--ink-soft); text-wrap: pretty; }

  @media (max-width: 560px) {
    .konto__qr { grid-template-columns: 1fr; }
  }
</style>
