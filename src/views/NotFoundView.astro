---
/** Eine 404-Seite für beide Sprachen (GitHub Pages kennt nur eine 404.html). */
import Page from '../layouts/Page.astro';
import { url } from '../lib/i18n';
import { texte, zeilen } from '../lib/texte';
import Tag from '../components/ui/Tag.astro';
import KeilBar from '../components/ui/KeilBar.astro';

// beide Sprachen auf einer Seite (Texte: Redaktion → Texte)
const de = texte('de', 'fehler', 'seite');
const en = texte('en', 'fehler', 'seite');
const [deL1, deL2] = zeilen(de.titel);
const [enL1, enL2] = zeilen(en.titel);
---
<Page title="404" noindex>
  <section class="nf">
    <div class="wrap nf__grid">
      <div>
        <Tag color="cyan">{de.kicker}</Tag>
        <h1 class="nf__title">{deL1}<br /><em>{deL2}</em></h1>
        <p>{de.text}</p>
        <div class="nf__actions">
          <a class="btn btn--secondary btn--marker" href={url('de', 'home')}>{de.home}</a>
          <a class="mono-link underline-link" href={url('de', 'termine')}>{de.kalender}</a>
        </div>
      </div>
      <div lang="en">
        <Tag color="cyan">{en.kicker}</Tag>
        <p class="nf__title nf__title--en" role="presentation">{enL1}<br /><em>{enL2}</em></p>
        <p>{en.text}</p>
        <div class="nf__actions">
          <a class="btn btn--secondary btn--marker" href={url('en', 'home')}>{en.home}</a>
          <a class="mono-link underline-link" href={url('en', 'termine')}>{en.kalender}</a>
        </div>
      </div>
    </div>
    <KeilBar class="nf__keil" />
  </section>
</Page>

<style>
  /* so hoch wie der Kopf der Startseite (--buehne-h) */
  .nf { position: relative; display: flex; flex-direction: column; min-height: var(--buehne-h); background: var(--purple); color: #fff; overflow: hidden; }
  .nf__grid { flex: 1; width: 100%; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); align-content: center; gap: 56px clamp(32px, 6vw, 96px); padding-block: var(--buehne-oben) clamp(56px, 8vw, 112px); }
  .nf :global(.tag) { margin-bottom: 24px; }
  .nf__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(44px, 6vw, 88px); line-height: 0.92; letter-spacing: -0.035em; margin: 0 0 20px; }
  .nf__title em { font-style: normal; color: var(--magenta); }
  .nf p { color: rgba(255, 255, 255, 0.86); font-size: 17px; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; margin-top: 28px; }
  .nf :global(.nf__keil) { position: absolute; left: 0; bottom: 0; width: 34%; }
</style>
