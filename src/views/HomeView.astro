---
/** Startseite (Entwurf v5): Hero, Demnächst (Termine + News), Formate, Netz, Mitglied werden. */
import Page from '../layouts/Page.astro';
import Hero from '../components/sections/Hero.astro';
import Demnaechst from '../components/sections/Demnaechst.astro';
import Formats from '../components/sections/Formats.astro';
import Netz from '../components/sections/Netz.astro';
import Join from '../components/sections/Join.astro';
import { abschnittZeigen } from '../lib/texte';
---
<Page route="home" fortschritt>
  <Hero />
  <Demnaechst />
  <Formats />
  {/* Abschnitte, die die Redaktion ausgeblendet hat, fehlen ganz (src/lib/texte.ts) */}
  {abschnittZeigen('startseite', 'netz') && <Netz />}
  {abschnittZeigen('startseite', 'mitglied') && <Join />}
</Page>

<script>
  import { ueberschriften } from '../scripts/split-text';
  ueberschriften();
</script>
