---
/**
 * Öffentliche Profilseite einer Person aus dem Netzwerk.
 * Abschnitte (nur wenn gefüllt): Pitch, Galerie, Über, Arbeiten, Termine, Kontakt.
 * Nummern der Abschnitte zählt CSS (counter), damit sie auch mit der Demo-Ansicht stimmen.
 * Bewegung (Intro, Wörter, Filmstreifen) nur ohne „Bewegung reduzieren“, Skript: scripts/profil.ts.
 */
import { getImage } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Tag from '../components/ui/Tag.astro';
import KeilBar from '../components/ui/KeilBar.astro';
import Bild from '../components/profil/Bild.astro';
import ProtectedEmail from '../components/ProtectedEmail.astro';
import EventList from '../components/EventList.astro';
import { bioParagraphs, initials, instagramUrl, profilText, type PublicProfile } from '../lib/profiles';
import { ANGABEN, OFFEN_FUER, type GalerieLayout } from '../lib/profil-felder';
import { demoFuer } from '../lib/demo';
import { getTermineFor } from '../lib/content';
import { getLang, tr, url } from '../lib/i18n';

interface Props {
  profile: PublicProfile;
}
const { profile: p } = Astro.props;
const lang = getLang(Astro);
const t = tr(lang, {
  de: {
    kicker: 'Tanzschaffende · Dresden', member: 'Mitglied', trainer: 'Training', board: 'Vorstand', back: '← Alle Tanzschaffenden',
    request: 'Anfrage senden', requestShort: 'Anfrage', showreel: 'Showreel', scroll: 'Scrollen ↓', sections: 'Abschnitte',
    pitch: 'In einem Satz', pitchNav: 'Pitch', gallery: 'Galerie', galleryH: ['Bilder aus', 'der Arbeit.'], photos: 'Bilder',
    full: 'Vollbild', allFull: 'Alle Bilder im Vollbild →', about: 'Über', aboutNav: 'Über', focus: 'Schwerpunkte', base: 'Basis',
    works: 'Arbeiten', worksH: ['Stücke und', 'Projekte.'], entries: 'Einträge', events: 'Termine', eventsH: 'Nächste Termine',
    contact: 'Kontakt', contactH: (n: string) => ['Mit ' + n, 'arbeiten.'], email: 'E-Mail', showEmail: 'Adresse anzeigen',
    subject: 'Anfrage über TanzNetzDresden', body: (n: string) => `Hallo ${n},\n\nProjekt:\nZeitraum:\nOrt:\n\nViele Grüße\n`,
    website: 'Website', video: 'Video', soon: 'Dieses Profil wird gerade aufgebaut.', photo: 'Foto',
    edit: 'Ist das dein Profil?', editCta: 'Im internen Bereich ergänzen →', open: 'Offen für',
    zoom: (nr: string) => `Foto ${nr} vergrößern`, close: 'Schließen', prev: 'Vorheriges Foto', next: 'Nächstes Foto', lightbox: 'Fotos',
    portrait: (n: string) => `Porträt von ${n}`, ofN: 'von',
  },
  en: {
    kicker: 'Dance artists · Dresden', member: 'Member', trainer: 'Training', board: 'Board', back: '← All dance artists',
    request: 'Send a request', requestShort: 'Request', showreel: 'Showreel', scroll: 'Scroll ↓', sections: 'Sections',
    pitch: 'In one sentence', pitchNav: 'Pitch', gallery: 'Gallery', galleryH: ['Pictures from', 'the work.'], photos: 'pictures',
    full: 'Full screen', allFull: 'All pictures full screen →', about: 'About', aboutNav: 'About', focus: 'Focus', base: 'Based in',
    works: 'Work', worksH: ['Pieces and', 'projects.'], entries: 'entries', events: 'Dates', eventsH: 'Upcoming events',
    contact: 'Contact', contactH: (n: string) => ['Work with', n + '.'], email: 'Email', showEmail: 'Show address',
    subject: 'Request via TanzNetzDresden', body: (n: string) => `Hello ${n},\n\nProject:\nDates:\nPlace:\n\nBest wishes\n`,
    website: 'Website', video: 'Video', soon: 'This profile is being set up.', photo: 'Photo',
    edit: 'Is this your profile?', editCta: 'Complete it in the members area →', open: 'Open to',
    zoom: (nr: string) => `Enlarge photo ${nr}`, close: 'Close', prev: 'Previous photo', next: 'Next photo', lightbox: 'Photos',
    portrait: (n: string) => `Portrait of ${n}`, ofN: 'of',
  },
});

const demo = demoFuer(p, lang);
const pad = (n: number) => String(n).padStart(2, '0');
const woerter = p.name.trim().split(/\s+/).filter(Boolean);
const vorname = woerter[0] ?? p.name;
const nachname = woerter.slice(1).join(' ');
// Schriftgröße passt sich dem längsten Wort an (lange Namen sprengen sonst die Zeile)
const laengstes = Math.max(...woerter.map((w) => w.length), 4);
const nameFit = `--fit: ${(150 / laengstes).toFixed(2)}vw`;

const rollen = [p.roles.includes('mitglied') ? t.member : null, p.roles.includes('trainer') ? t.trainer : null].filter(Boolean).join(' · ');
const vorstand = lang === 'en' ? p.vorstand_en ?? p.vorstand : p.vorstand;
const beruf = profilText(p, 'profession', lang);
const meta = (b?: string) => [p.pronouns, b, p.base].filter(Boolean).join(' · ');
const pitch = profilText(p, 'pitch', lang);
const bio = bioParagraphs(p, lang);
const events = await getTermineFor(p.id);

/** Pitch in Wörter: was nach dem ersten Doppelpunkt/Gedankenstrich steht, wird hervorgehoben (sonst die letzten drei Wörter) */
function pitchWoerter(satz: string) {
  const w = satz.split(/\s+/).filter(Boolean);
  const bis = satz.search(/[:–—]/);
  const ab = bis >= 0 ? satz.slice(0, bis + 1).split(/\s+/).filter(Boolean).length : Math.max(0, w.length - 3);
  return w.map((text, i) => ({ text, hi: i >= ab }));
}

// Fotos: Porträt groß oben, Galerie darunter. Ohne Porträt rückt das erste Galeriefoto nach oben.
interface Foto { src: ImageMetadata | string; alt: string; cap?: string; credit?: string; pos?: string }
const capOf = (g: PublicProfile['gallery'][number]) => (lang === 'en' && g.caption_en) || g.caption;
const galerieEcht: Foto[] = p.gallery.map((g) => ({ src: g.photo, alt: capOf(g) ?? '', cap: capOf(g), credit: g.credit }));
const portrait: Foto | undefined = p.photo ? { src: p.photo, alt: t.portrait(p.name), credit: p.photoCredit, pos: '50% 30%' } : undefined;
const heroEcht = portrait ?? galerieEcht[0];
const galerieRest = portrait ? galerieEcht : galerieEcht.slice(1);
const demoFotos: Foto[] | undefined = demo.gallery?.map((src) => ({ src, alt: '', cap: lang === 'en' ? 'Example photo' : 'Beispielfoto' }));
const heroDemo: Foto | undefined = !heroEcht && demo.photo ? { src: demo.photo, alt: '', pos: '50% 30%' } : undefined;

const groesse = async (src: ImageMetadata | string, width: number) =>
  (await getImage(typeof src === 'string' ? { src, inferSize: true, width } : { src, width })).src;

/** Galerie mit Daten fürs Vollbild; Nummern zählen das Foto oben mit */
async function galerie(fotos: Foto[], oben?: Foto) {
  const alle = oben ? [oben, ...fotos] : fotos;
  const vollbild = await Promise.all(
    alle.map(async (f, i) => ({ nr: pad(i + 1), gross: await groesse(f.src, 1800), klein: await groesse(f.src, 160), alt: f.alt, cap: f.cap ?? '', credit: f.credit ?? '' })),
  );
  return { fotos: fotos.map((f, k) => ({ ...f, nr: pad(k + (oben ? 2 : 1)), i: k + (oben ? 1 : 0) })), vollbild, anzahl: alle.length };
}
const gEcht = galerieRest.length ? await galerie(galerieRest, heroEcht) : null;
const gDemo = !p.gallery.length && demoFotos ? await galerie(demoFotos, heroEcht ?? heroDemo) : null;

// Filmstreifen: wechselnde Höhen und Formate wie im Entwurf (h in vh, r = Breite/Höhe)
const STREIFEN = [
  { h: 64, r: 4 / 5, align: 'start', keil: 'a' },
  { h: 48, r: 3 / 2, align: 'end', keil: '' },
  { h: 58, r: 3 / 4, align: 'center', keil: '' },
  { h: 44, r: 1, align: 'start', keil: 'b' },
  { h: 60, r: 16 / 10, align: 'end', keil: '' },
];
/** Mosaik: Gruppen aus einem großen und zwei kleinen Fotos, Rest halb oder ganz breit */
function mosaik(n: number, layout: GalerieLayout) {
  if (layout === 'raster') return Array.from({ length: n }, () => 'raster');
  const out: string[] = [];
  let i = 0;
  let gruppe = 0;
  while (i < n) {
    const rest = n - i;
    if (rest >= 3) { out.push(...(gruppe % 2 === 0 ? ['gross', 'klein', 'klein'] : ['klein', 'gross', 'klein'])); i += 3; gruppe++; }
    else if (rest === 2) { out.push('halb', 'halb'); i += 2; }
    else { out.push('ganz'); i += 1; }
  }
  return out;
}
const layout = p.galleryLayout;

const angaben = [
  ...ANGABEN.slice(0, 4).map((a) => ({ k: a[lang], v: p[a.key] })),
  { k: t.base, v: p.base },
  ...ANGABEN.slice(4).map((a) => ({ k: a[lang], v: p[a.key] })),
].filter((a): a is { k: string; v: string } => !!a.v);
const linkText = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const links = [
  p.website && { k: t.website, v: linkText(p.website), href: p.website },
  p.instagram && { k: 'Instagram', v: `@${p.instagram.replace(/^@/, '')}`, href: instagramUrl(p.instagram)! },
  p.vimeo && { k: t.video, v: linkText(p.vimeo), href: p.vimeo },
].filter(Boolean) as { k: string; v: string; href: string }[];

const arbeiten = [...p.works].filter((w) => w.title).sort((a, b) => String(b.year).localeCompare(String(a.year)));
const offen = p.openFor.map((o) => OFFEN_FUER[o][lang]);
const insta = p.instagram?.replace(/^@/, '');
const hatKontakt = !!(p.email || insta || p.website);
// Seite der Website (Fallback) im Kontaktbereich, wenn es weder E-Mail noch Instagram gibt
const kontaktWebsite = !p.email && !insta ? p.website : undefined;

// Abschnitte für die Leiste: echt, nur in der Demo-Ansicht oder gar nicht
type Art = 'echt' | 'demo' | null;
const abschnitte: { id: string; label: string; art: Art }[] = [
  { id: 'pitch', label: t.pitchNav, art: pitch ? 'echt' : demo.pitch ? 'demo' : null },
  { id: 'galerie', label: t.gallery, art: gEcht ? 'echt' : gDemo ? 'demo' : null },
  { id: 'ueber', label: t.aboutNav, art: 'echt' },
  { id: 'arbeiten', label: t.works, art: arbeiten.length ? 'echt' : demo.works ? 'demo' : null },
  { id: 'termine', label: t.events, art: events.length ? 'echt' : null },
  { id: 'kontakt', label: t.contact, art: hatKontakt ? 'echt' : null },
];
const demoKlasse = (a: Art) => (a === 'demo' ? 'demo-an' : undefined);
const description = (pitch ?? bio[0])?.slice(0, 160) ?? `${p.name} · TanzNetzDresden`;
---
<Page title={p.name} description={description} route="netzwerk" rest={`${p.id}/`} ogImage={typeof p.photo === 'object' ? p.photo : undefined}>
  <div class="profil" data-profil>
    <section class="ph" data-ph>
      {(heroEcht || heroDemo) && (
        <div class:list={['ph__bild', !heroEcht && 'demo-an']} data-wipe>
          <div class="ph__bild-in" data-parallax>
            <Bild src={(heroEcht ?? heroDemo)!.src} alt={(heroEcht ?? heroDemo)!.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 860px) 54vw, 100vw" eager pos={(heroEcht ?? heroDemo)!.pos} />
          </div>
          <span class="ph__sq" aria-hidden="true"></span>
          {heroEcht?.credit && <span class="ph__credit">{t.photo}: {heroEcht.credit}</span>}
        </div>
      )}
      {!heroEcht && <span class:list={['ph__initialen', heroDemo && 'demo-aus']} aria-hidden="true">{initials(p.name)}</span>}
      <div class="wrap ph__inhalt">
        <div class="ph__top" data-rise="0">
          <a class="ph__zurueck" href={url(lang, 'netzwerk')}>{t.back}</a>
          <Tag color="cyan">{t.kicker}{rollen && ` · ${rollen}`}</Tag>
        </div>
        <div class="ph__unten">
          <h1 class="ph__name" style={nameFit}>
            <span class="ph__vor" data-sweep="0.3" data-bar="var(--cyan)">{vorname}</span>
            {nachname && <>{' '}<br /><span class="ph__nach" data-sweep="0.55" data-bar="var(--magenta)">{nachname}</span></>}
          </h1>
          {meta(beruf) && <p class="ph__meta" data-rise="0.9">{meta(beruf)}</p>}
          {!beruf && demo.profession && <p class="ph__meta demo-an">{meta(demo.profession)}</p>}
          {vorstand && <p class="ph__vorstand" data-rise="0.9"><span>{t.board}</span> {vorstand}</p>}
          <div class="ph__aktionen" data-rise="1">
            {hatKontakt && <a class="btn btn--secondary btn--marker" href="#kontakt">{t.request}</a>}
            {p.vimeo && (
              <a class="ph__reel" href={p.vimeo} target="_blank" rel="noopener"><span class="ph__play" aria-hidden="true"></span>{t.showreel}</a>
            )}
            <a class="ph__scroll" href={`#${abschnitte.find((a) => a.art === 'echt')!.id}`}>{t.scroll}</a>
          </div>
        </div>
      </div>
      <KeilBar class="ph__keil" />
    </section>

    <nav class="pbar" aria-label={t.sections} data-pbar>
      <div class="wrap pbar__in">
        <span class="pbar__name" aria-hidden="true">{p.name}</span>
        <span class="pbar__sq" aria-hidden="true"></span>
        <ul class="pbar__liste">
          {abschnitte.filter((a) => a.art).map((a) => (
            <li class={demoKlasse(a.art)}><a href={`#${a.id}`} data-pbar-link={a.id}>{a.label}</a></li>
          ))}
        </ul>
        {hatKontakt && <a class="pbar__anfrage" href="#kontakt"><span aria-hidden="true"></span>{t.requestShort}</a>}
      </div>
      <span class="pbar__fortschritt" aria-hidden="true" data-fortschritt></span>
    </nav>

    {abschnitte[0].art && (
      <section id="pitch" class:list={['psec', 'ppitch', demoKlasse(abschnitte[0].art)]} aria-labelledby="pitch-h" data-pitch>
        <div class="wrap ppitch__grid">
          <div class="ppitch__kopf">
            <h2 class="pk" id="pitch-h"><span class="pk__nr" aria-hidden="true"></span><span class="pk__strich" aria-hidden="true"></span>{t.pitch}</h2>
            <span class="ppitch__quote" aria-hidden="true">„</span>
          </div>
          <div class="ppitch__body">
            <p class="ppitch__satz">
              {pitchWoerter((pitch ?? demo.pitch)!).map((w) => <span class:list={['ppitch__w', w.hi && 'ppitch__w--hi']} data-w>{w.text} </span>)}
            </p>
            {(p.tags.length > 0 || demo.tags) && (
              <ul class="ppitch__disc">
                {(p.tags.length ? p.tags : demo.tags!).map((tag, i) => <li class={i === 0 ? 'is-erst' : undefined}>{tag}</li>)}
              </ul>
            )}
          </div>
        </div>
      </section>
    )}

    {[gEcht && { g: gEcht, art: 'echt' as const }, gDemo && { g: gDemo, art: 'demo' as const }].filter(Boolean).map((x) => {
      const { g, art } = x as { g: NonNullable<typeof gEcht>; art: 'echt' | 'demo' };
      const streifen = layout === 'filmstreifen';
      const spans = mosaik(g.fotos.length, layout);
      return (
        <section id="galerie" class:list={['psec', 'pgal', demoKlasse(art)]} aria-labelledby={`galerie-h-${art}`} data-galerie>
          <div class="wrap pgal__kopf">
            <div class="pgal__titel">
              <div class="pk"><span class="pk__nr" aria-hidden="true"></span><span class="pk__strich" aria-hidden="true"></span>{t.gallery}</div>
              <h2 class="pgross" id={`galerie-h-${art}`}>{t.galleryH[0]}{' '}<br /><span>{t.galleryH[1]}</span></h2>
            </div>
            <div class="pgal__info">
              <span class="pgal__n">{pad(g.anzahl)} {t.photos}</span>
              <button type="button" class="pgal__voll" data-lb-oeffnen="0">{t.full}</button>
            </div>
          </div>
          {streifen ? (
            <div class="pstrip" data-strip>
              <div class="pstrip__sticky">
                <div class="pstrip__track" data-track>
                  {g.fotos.map((f, k) => {
                    const s = STREIFEN[k % STREIFEN.length];
                    return (
                      <button type="button" class:list={['pstrip__el', `pstrip__el--${s.align}`]} style={`--h: ${s.h}; --r: ${s.r}`} data-lb-oeffnen={f.i} aria-label={`${t.zoom(f.nr)}${f.cap ? `: ${f.cap}` : ''}`}>
                        <span class:list={['pstrip__bild', s.keil && `pstrip__bild--keil-${s.keil}`]}>
                          <Bild src={f.src} alt="" widths={[480, 800, 1200]} sizes="(min-width: 860px) 50vw, 85vw" pos={f.pos} />
                        </span>
                        <span class="pstrip__cap"><span class="pstrip__nr">{f.nr}</span>{f.cap && <span>{f.cap}</span>}</span>
                      </button>
                    );
                  })}
                  <button type="button" class="pstrip__ende" data-lb-oeffnen="0">
                    <span class="pstrip__ende-sq" aria-hidden="true"></span>
                    <span>{t.allFull}</span>
                  </button>
                </div>
                <div class="wrap pstrip__leiste" aria-hidden="true"><div class="pstrip__bar"><span data-strip-bar></span></div></div>
              </div>
            </div>
          ) : (
            <div class="wrap pgrid__wrap">
              <div class:list={['pgrid', `pgrid--${layout}`]}>
                {g.fotos.map((f, k) => (
                  <button type="button" class:list={['pgrid__el', `pgrid__el--${spans[k]}`]} data-reveal data-lb-oeffnen={f.i} aria-label={`${t.zoom(f.nr)}${f.cap ? `: ${f.cap}` : ''}`}>
                    <Bild src={f.src} alt="" widths={[480, 800, 1200]} sizes={spans[k] === 'ganz' ? '100vw' : '(min-width: 860px) 50vw, 100vw'} pos={f.pos} />
                    <span class="pgrid__nr">{f.nr}</span>
                  </button>
                ))}
              </div>
            </div>
          )}
          <dialog class="plb" aria-label={t.lightbox} data-lb>
            <div class="plb__kopf">
              <span class="plb__nr" data-lb-nr></span>
              <button type="button" class="plb__zu" data-lb-zu>{t.close} · Esc</button>
            </div>
            <div class="plb__mitte">
              <button type="button" class="plb__pfeil" aria-label={t.prev} data-lb-schritt="-1">←</button>
              <img class="plb__img" alt="" data-lb-img />
              <button type="button" class="plb__pfeil" aria-label={t.next} data-lb-schritt="1">→</button>
            </div>
            <div class="plb__fuss">
              <div class="plb__text"><span data-lb-cap></span><span class="plb__credit" data-lb-credit></span></div>
              <div class="plb__thumbs">
                {g.vollbild.map((v, i) => (
                  <button type="button" class="plb__thumb" data-lb-gehe={i} aria-label={`${t.photo} ${v.nr}`}><img src={v.klein} alt="" loading="lazy" /></button>
                ))}
              </div>
            </div>
            <script type="application/json" data-lb-daten set:html={JSON.stringify(g.vollbild.map((v) => ({ ...v, nr: `${v.nr} / ${pad(g.anzahl)}` }))).replace(/</g, '\\u003c')} />
          </dialog>
        </section>
      );
    })}

    <section id="ueber" class="psec pueber" aria-labelledby="ueber-h">
      <div class="wrap pueber__grid">
        {gEcht && gEcht.fotos.length >= 2 && (
          <div class="pueber__seite">
            <div class="pueber__bild" data-reveal>
              <Bild src={gEcht.fotos.at(-1)!.src} alt={gEcht.fotos.at(-1)!.alt} widths={[480, 720, 960]} sizes="(min-width: 860px) 480px, 100vw" pos={gEcht.fotos.at(-1)!.pos} />
              <span class="pueber__sq" aria-hidden="true"></span>
            </div>
          </div>
        )}
        <div class="pueber__text">
          <h2 class="pk" id="ueber-h"><span class="pk__nr" aria-hidden="true"></span><span class="pk__strich" aria-hidden="true"></span>{t.about} {vorname}</h2>
          {bio.length > 0 ? (
            <div class="pueber__bio">{bio.map((para) => <p>{para}</p>)}</div>
          ) : (
            <>
              <p class="pueber__bald demo-aus">{t.soon}</p>
              {demo.bio && <div class="pueber__bio demo-an">{demo.bio.map((para) => <p>{para}</p>)}</div>}
            </>
          )}
          {(angaben.length > 0 || links.length > 0 || (!pitch && p.tags.length > 0)) && (
            <dl class="pfakten">
              {!pitch && p.tags.length > 0 && <div class="pfakten__z demo-aus"><dt>{t.focus}</dt><dd>{p.tags.join(' · ')}</dd></div>}
              {angaben.map((a) => <div class="pfakten__z"><dt>{a.k}</dt><dd>{a.v}</dd></div>)}
              {links.map((l) => (
                <div class="pfakten__z pfakten__z--link"><dt>{l.k}</dt><dd><a href={l.href} target="_blank" rel="noopener me">{l.v}<span aria-hidden="true"> →</span></a></dd></div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </section>

    {abschnitte[3].art && (
      <section id="arbeiten" class:list={['psec', 'parb', demoKlasse(abschnitte[3].art)]} aria-labelledby="arbeiten-h">
        <div class="wrap">
          <div class="parb__kopf">
            <div class="pgal__titel">
              <div class="pk pk--hell"><span class="pk__nr" aria-hidden="true"></span><span class="pk__strich" aria-hidden="true"></span>{t.works}</div>
              <h2 class="pgross pgross--hell" id="arbeiten-h">{t.worksH[0]}{' '}<br /><span>{t.worksH[1]}</span></h2>
            </div>
            <span class="parb__n">{pad((arbeiten.length ? arbeiten : demo.works!).length)} {t.entries}</span>
          </div>
          <ul class="parb__liste">
            {(arbeiten.length ? arbeiten : demo.works!).map((w) => (
              <li class="parb__z">
                <span class="parb__jahr">{w.year}</span>
                <span class="parb__was">
                  <span class="parb__titel">{w.title}</span>
                  {w.place && <span class="parb__ort">{w.place}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <KeilBar class="ph__keil" />
      </section>
    )}

    {events.length > 0 && (
      <section id="termine" class="psec ptermine" aria-labelledby="termine-h">
        <div class="wrap">
          <div class="pk"><span class="pk__nr" aria-hidden="true"></span><span class="pk__strich" aria-hidden="true"></span>{t.events}</div>
          <h2 class="pgross ptermine__h" id="termine-h">{t.eventsH}</h2>
          <EventList events={events} id="profile-events" />
        </div>
      </section>
    )}

    {hatKontakt && (
      <section id="kontakt" class="psec pkontakt" aria-labelledby="kontakt-h">
        <div class="wrap pkontakt__grid">
          <div class="pkontakt__links">
            <div class="pk"><span class="pk__nr" aria-hidden="true"></span><span class="pk__strich" aria-hidden="true"></span>{t.contact}</div>
            <h2 class="pkontakt__h" id="kontakt-h">{t.contactH(vorname)[0]}{' '}<br />{t.contactH(vorname)[1]}</h2>
            {offen.length > 0 && (
              <div class="pkontakt__offen">
                <span class="visually-hidden">{t.open}:</span>
                <ul>{offen.map((o) => <li>{o}</li>)}</ul>
              </div>
            )}
            {!offen.length && demo.openFor && (
              <ul class="pkontakt__offen demo-an">{demo.openFor.map((o) => <li>{OFFEN_FUER[o][lang]}</li>)}</ul>
            )}
          </div>
          <div class="pkontakt__wege">
            {p.email && (
              <div class="pweg">
                <span class="pweg__k">{t.email}</span>
                <ProtectedEmail email={p.email} label={t.showEmail} subject={t.subject} body={t.body(vorname)} copy class="pweg__mail" />
              </div>
            )}
            {insta && (
              <a class="pweg" href={`https://ig.me/m/${encodeURIComponent(insta)}`} target="_blank" rel="noopener">
                <span class="pweg__k">Instagram</span>
                <span class="pweg__v">@{insta}</span>
                <span class="pweg__pfeil" aria-hidden="true">→</span>
              </a>
            )}
            {kontaktWebsite && (
              <a class="pweg" href={kontaktWebsite} target="_blank" rel="noopener">
                <span class="pweg__k">{t.website}</span>
                <span class="pweg__v">{linkText(kontaktWebsite)}</span>
                <span class="pweg__pfeil" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      </section>
    )}

    <section class="wrap pfuss">
      <a class="mono-link" href={url(lang, 'netzwerk')}>{t.back}</a>
      {!p.selfManaged && <p>{t.edit} <a href={url(lang, 'intern', 'profil/')}>{t.editCta}</a></p>}
    </section>
  </div>
</Page>

<script>
  import { initProfil } from '../scripts/profil';
  initProfil();
</script>

