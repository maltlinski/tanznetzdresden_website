---
import TextPageView from './TextPageView.astro';
import ProtectedEmail from '../components/ProtectedEmail.astro';
import { getVerein } from '../lib/settings';
import { getLang, url } from '../lib/i18n';
import { texte } from '../lib/texte';

const lang = getLang(Astro);
const v = getVerein(lang);
const t = texte(lang, 'barrierefreiheit', 'melden');
---
<TextPageView id="barrierefreiheit" route="barrierefreiheit" kicker={t.kicker} toc>
  <a slot="toc-after" class="mono-link" href={url('de', 'leichteSprache')} lang="de">{t.easy} →</a>
  <Fragment slot="after">
    <h2 id="barriere-melden">{t.h}</h2>
    <p>{t.p}</p>
    <p><ProtectedEmail email={v.emails.kontakt} label={t.mail} subject={t.subject} /></p>
  </Fragment>
</TextPageView>
