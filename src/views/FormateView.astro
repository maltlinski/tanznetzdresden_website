---
/**
 * Formate (Entwurf Formate v2, November 2026): Kopf als Netz – jedes Format ist ein Knoten mit Namen, Linien
 * verbinden sie, das Netz reagiert auf die Maus und lässt sich neu knüpfen; mit der Maus über einem Namen steht
 * dessen Kurzbeschreibung unter der Überschrift. Darunter jedes Format im Detail (großes Foto, Filter „Ich
 * möchte …“, nächster Termin aus dem Kalender), die Chronik, das Archiv abgeschlossener Projekte und „Mitmachen“.
 * Inhalte: src/content/formate/ und src/content/formate-archiv/ (docs/formate.md). Netz: src/lib/formate-netz.ts,
 * Bewegung: src/scripts/formate.ts.
 */
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Tag from '../components/ui/Tag.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import KeilBar from '../components/ui/KeilBar.astro';
import { formatFilter, getChronik, getFormatSeite, getProjekte, rubrikBadge, zahlwort } from '../lib/formate';
import { festerZufall, knuepfen, startLage, type Lage } from '../lib/formate-netz';
import { naechster, terminText } from '../lib/formate-termin';
import { istDatum } from '../lib/datum-schrift';
import { getNews, dateShort } from '../lib/news';
import { arbeitsgruppen } from '../settings/arbeitsgruppen';
import { dateLocale, getLang, tr, url } from '../lib/i18n';
import { abschnittZeigen, fuellen, texte, zeilen } from '../lib/texte';

const lang = getLang(Astro);
const k = texte(lang, 'formate', 'kopf');
const d = texte(lang, 'formate', 'detail');
const c = texte(lang, 'formate', 'chronik');
const ar = texte(lang, 'formate', 'archiv');
const m = texte(lang, 'formate', 'mitmachen');
// nur für Screenreader
const sr = tr(lang, {
  de: { netz: 'Formate', detail: 'Formate im Detail', filter: 'Formate filtern', neu: 'öffnet in neuem Tab' },
  en: { netz: 'Formats', detail: 'Formats in detail', filter: 'Filter formats', neu: 'opens in a new tab' },
});

const formate = await getFormatSeite(lang);
const projekte = await getProjekte(lang);
const chronik = await getChronik(lang);
// Abschnitte, die die Redaktion ausgeblendet hat oder die leer sind, fehlen ganz (src/lib/texte.ts)
const zeigen = {
  chronik: abschnittZeigen('formate', 'chronik') && chronik.length > 0,
  archiv: abschnittZeigen('formate', 'archiv') && projekte.length > 0,
  mitmachen: abschnittZeigen('formate', 'mitmachen'),
};
// Netz ohne JavaScript: feste Lage (breit/schmal) und Linien in Prozent; im Browser knüpft das Skript es neu
const lage = startLage(formate.map((f) => f.id));
// hoch: Höhe der Bühne im Verhältnis zur Breite (breit etwa 1224 × 700, schmal etwa 340 × 620), damit die Abstände stimmen
const linien = (l: Lage[], hoch: number) =>
  knuepfen(l.map((p) => [p.x, p.y * hoch]), festerZufall()).map(([a, b]) => ({ x1: `${l[a].x}%`, y1: `${l[a].y}%`, x2: `${l[b].x}%`, y2: `${l[b].y}%` }));
const netz = { breit: linien(lage.breit, 0.57), schmal: linien(lage.schmal, 1.8) };
const locale = dateLocale[lang];
const heute = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Berlin' }).format(new Date());
const gesamt = String(formate.length).padStart(2, '0');
const [h1a, h1b] = zeilen(fuellen(k.titel, { zahlwort: zahlwort(lang, formate.length) }));

const rubrikText = { buehne: d.buehne, training: d.training, diskurs: d.diskurs, stadt: d.stadt, residenz: d.residenz };
const newsletter = url(lang, 'home', '#newsletter');
/** Kasten unter einem Format: nächster Termin, sonst „Termin folgt“, bei beendeten Formaten der Rückblick */
const kasten = (f: (typeof formate)[number]) => {
  if (f.beendet && f.rueckblick) return { k: d.abgeschlossen, t: f.rueckblick.titel, w: dateShort(f.rueckblick.datum, lang), href: f.rueckblick.link, datum: 'w' };
  const n = naechster(f.termine, heute);
  return n ? { k: k.naechster, t: terminText(n, locale, k.heute, heute), w: n.wo, href: n.link, datum: 't' } : { k: k.naechster, t: k.folgt, w: d.folgtText, href: newsletter, datum: '' };
};
const filter = [
  { key: '', label: d.alle, n: formate.length },
  ...formatFilter.map(([text, rubrik]) => ({ key: rubrik, label: d[text], n: formate.filter((f) => f.rubriken.includes(rubrik)).length })),
].filter((x) => x.n > 0);

// nächste Ausschreibungen (News mit Frist); der Browser blendet abgelaufene aus
const calls = (await getNews(lang))
  .filter((p) => p.deadline && p.deadline >= heute)
  .sort((a, b) => a.deadline!.localeCompare(b.deadline!))
  .slice(0, 3);
const [m1, m2] = zeilen(m.titel);

const daten = JSON.stringify({
  locale,
  heute: k.heute,
  folgt: k.folgt,
  folgtText: d.folgtText,
  newsletter,
  termine: Object.fromEntries(formate.filter((f) => !f.beendet).map((f) => [f.id, f.termine])),
}).replace(/</g, '\\u003c');
---
<Page title={k.title} description={k.desc} route="formate" fortschritt>
  <section class="fo-kopf kopf" data-hero data-fo-kopf>
    <div class="wrap fo-kopf__inner">
      <div class="fo-intro" data-fo-intro>
        <Tag color="cyan" class="fo-kopf__tag kopf__kicker">{fuellen(k.kicker, { zahl: gesamt })}</Tag>
        <h1 class="fo-h1">
          <span class="fo-h1__zeile">{h1a.split(' ').map((w, i) => <>{i > 0 && ' '}<span data-kopf-wort>{w}</span></>)}</span>{' '}
          <span class="fo-h1__zeile fo-h1__akzent">{h1b.split(' ').map((w, i) => <>{i > 0 && ' '}<span data-kopf-wort>{w}</span></>)}</span>
        </h1>
        <div class="fo-info" aria-live="polite" data-kopf-folgt data-fo-info>
          <span class="fo-info__k"><span class="fo-quadrat" aria-hidden="true"></span><span data-fo-info-k>{k.netzKicker}</span></span>
          <p class="fo-info__text" data-fo-info-t>{k.netzText}</p>
        </div>
        <button type="button" class="fo-knuepfen" hidden data-kopf-folgt data-fo-knuepfen><span class="fo-quadrat fo-quadrat--klein" aria-hidden="true"></span>{k.neuKnuepfen}</button>
      </div>
      <nav class="fo-buehne" aria-label={sr.netz} data-fo-buehne>
        <svg class="fo-netz fo-netz--breit" aria-hidden="true">
          {netz.breit.map((l) => <line {...l} />)}
        </svg>
        <svg class="fo-netz fo-netz--schmal" aria-hidden="true">
          {netz.schmal.map((l) => <line {...l} />)}
        </svg>
        <ul class="fo-knoten-liste">
          {formate.map((f, i) => {
            const b = lage.breit[i];
            const s = lage.schmal[i];
            return (
              <li
                class="fo-knoten"
                style={`--xb:${b.x}%;--yb:${b.y}%;--xs:${s.x}%;--ys:${s.y}%`}
                data-sb={b.seite}
                data-ss={s.seite}
                data-knoten={i}
                data-kicker={`${f.n} · ${rubrikText[f.rubriken[0]]} · ${f.seit}`}
                data-text={f.kurz}
              >
                <span class="fo-knoten__in" data-pre>
                  <span class="fo-knoten__q" aria-hidden="true"></span>
                  <a class="fo-knoten__a" href={`#${f.id}`}>
                    <span class="fo-knoten__t">{f.titel}</span>
                    <span class="fo-knoten__m">{f.n} · {rubrikText[f.rubriken[0]]}</span>
                  </a>
                </span>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>
    <KeilBar color="var(--magenta)" height={10} class="fo-kopf__keil" />
  </section>

  <section class="fo-detail" aria-label={sr.detail}>
    <div class="wrap">
      <div class="fo-filter" role="group" aria-label={sr.filter} hidden data-fo-filter>
        <span class="fo-filter__k" aria-hidden="true">{d.ichMoechte}</span>
        <div class="fo-chips">
          {filter.map((x) => (
            <button type="button" class="fo-chip" aria-pressed={x.key === '' ? 'true' : 'false'} data-rubrik={x.key}>
              {x.label} <span class="fo-chip__n">{x.n}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="fo-kapitel">
        {formate.map((f) => {
          const b = kasten(f);
          return (
            <article id={f.id} class="fo-kap" data-kap={f.id} data-rubriken={f.rubriken.join(' ')} aria-labelledby={`${f.id}-h`}>
              <div class="fo-kap__bild">
                <div class="fo-kap__wisch" data-wipe>
                  <Image src={f.bild} alt={f.alt} widths={[640, 960, 1280, 1800]} sizes="(min-width: 1320px) 1224px, calc(100vw - 40px)" data-par />
                </div>
                <span class="fo-kap__ecke" aria-hidden="true"></span>
              </div>
              <div class="fo-kap__spalten">
                <div class="fo-kap__links">
                  <div class="fo-kap__meta">
                    <span class="fo-kap__n" aria-hidden="true">{f.n}</span>
                    <Badge variant={rubrikBadge[f.rubriken[0]]}>{rubrikText[f.rubriken[0]]}</Badge>
                    <span class="fo-kap__seit">{f.seit}</span>
                  </div>
                  <h2 class="fo-kap__h" id={`${f.id}-h`} data-reveal>{f.titel}</h2>
                  <p class="fo-kap__d">{f.text}</p>
                </div>
                <div class="fo-kap__rechts">
                  <dl class="fo-fakten">
                    <div><dt>{f.beendet ? d.laufzeit : d.seit}</dt><dd class:list={[{ datum: istDatum(f.seit) }]}>{f.seit}</dd></div>
                    {f.fakten.map((x) => <div><dt>{x.k}</dt><dd class:list={[{ datum: istDatum(x.v) }]}>{x.v}</dd></div>)}
                  </dl>
                  <a class="fo-cta" href={b.href} data-fo-cta={f.beendet ? undefined : f.id}>
                    <span class="fo-cta__text">
                      <span class="fo-cta__k">{b.k}</span>
                      <span class:list={['fo-cta__t', { datum: b.datum === 't' }]} data-t>{b.t}</span>
                      <span class:list={['fo-cta__w', { datum: b.datum === 'w' }]} data-w>{b.w}</span>
                    </span>
                    <span class="fo-cta__pfeil" aria-hidden="true">→</span>
                  </a>
                  <div class="fo-links">
                    {f.links.map((l) => (
                      <a class="fo-link" href={l.href} target={l.extern ? '_blank' : undefined} rel={l.extern ? 'noopener' : undefined}>
                        {l.text} →{l.extern && <span class="visually-hidden"> ({sr.neu})</span>}
                      </a>
                    ))}
                    {!f.beendet && <a class="fo-link" href={url(lang, 'termine')}>{d.alleTermine} →</a>}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
        <button type="button" class="fo-alle" hidden data-fo-alle>{fuellen(d.alleZeigen, { zahl: formate.length })}</button>
      </div>
    </div>
  </section>

  {zeigen.chronik && (
    <section class="fo-chronik" aria-labelledby="fo-chronik-h" data-abschnitt="formate.chronik">
      <KeilBar color="var(--cyan)" height={12} flip class="fo-chronik__keil" />
      <div class="wrap">
        <Tag color="cyan" class="fo-chronik__tag">{c.kicker}</Tag>
        <h2 class="fo-chronik__h" id="fo-chronik-h" data-split>{zeilen(c.titel)[0]}<br /><span>{zeilen(c.titel)[1]}</span></h2>
        <ol class="fo-meilensteine">
          {chronik.map((x) => (
            <li class="fo-meilenstein" data-inhalt={`chronik:${x.jahr}`}>
              <span class="fo-meilenstein__q" aria-hidden="true"></span>
              <span class="fo-meilenstein__j">{x.jahr}</span>
              <ul>{x.punkte.map((p) => <li>{p}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
  {zeigen.archiv && (
    <section class="fo-archiv" id="archiv" aria-labelledby="fo-archiv-h" data-abschnitt="formate.archiv">
      <div class="wrap">
        <div class="fo-archiv__kopf">
          <div>
            <Tag class="fo-archiv__tag">{ar.kicker}</Tag>
            <h2 class="fo-archiv__h" id="fo-archiv-h" data-split>{zeilen(ar.titel)[0]}<br /><span>{zeilen(ar.titel)[1]}</span></h2>
          </div>
          {ar.lead && <p class="fo-archiv__lead">{ar.lead}</p>}
        </div>
        <div class="fo-projekte">
          {projekte.map((p) => (
            <details class="fo-projekt" id={`archiv-${p.id}`} data-projekt>
              <summary class="fo-projekt__kopf">
                <span class="fo-projekt__jahre">{p.jahre}</span>
                <span class="fo-projekt__name"><span class="fo-projekt__t">{p.titel}</span><span class="fo-projekt__art">{p.art}</span></span>
                <span class="fo-projekt__zeichen" aria-hidden="true"></span>
              </summary>
              <div class="fo-projekt__inhalt" data-inhalt>
                <p class="fo-projekt__text">{p.text}</p>
                {p.partner && <p class="fo-projekt__partner"><span>{ar.mit}</span><span>{p.partner}</span></p>}
                {p.links.length > 0 && (
                  <div class="fo-links">
                    {p.links.map((l) => (
                      <a class="fo-link" href={l.href} target={l.extern ? '_blank' : undefined} rel={l.extern ? 'noopener' : undefined}>
                        {l.text} →{l.extern && <span class="visually-hidden"> ({sr.neu})</span>}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
  {zeigen.mitmachen && (
    <section class="fo-mit" id="mitmachen" aria-labelledby="fo-mit-h" data-abschnitt="formate.mitmachen">
      <KeilBar color="var(--purple)" height={14} flip class="fo-mit__keil" />
      <div class="wrap fo-mit__grid">
        <div>
          <Tag color="purple" class="fo-mit__tag">{m.kicker}</Tag>
          <h2 class="fo-mit__h" id="fo-mit-h" data-split>{m1}<br />{m2}</h2>
          {m.lead && <p class="fo-mit__lead">{m.lead}</p>}
          <div data-fo-calls>
            {calls.map((p, i) => (
              <a class="fo-call" href={url(lang, 'news', `${p.id}/`)} hidden={i > 0} data-frist={p.deadline}>
                <span class="fo-call__k">{fuellen(m.call, { datum: dateShort(p.deadline!, lang) })}</span>
                <span class="fo-call__t">{p.title}</span>
                <span class="fo-call__l">{m.zurCall}</span>
              </a>
            ))}
            <a class="fo-call" href={url(lang, 'news')} hidden={calls.length > 0} data-fo-keine>
              <span class="fo-call__k">{m.calls}</span>
              <span class="fo-call__t">{m.callsText}</span>
              <span class="fo-call__l">{m.zuCalls}</span>
            </a>
          </div>
        </div>
        <div class="fo-ags">
          <h3 class="fo-ags__h">{m.ags}</h3>
          <p class="fo-ags__text">{m.agsText}</p>
          <ul class="fo-ags__liste">
            {arbeitsgruppen.map((ag) => <li><span class="fo-quadrat fo-quadrat--mini" aria-hidden="true"></span>{ag.name}</li>)}
          </ul>
          <Button href={url(lang, 'mitglied')} size="lg" marker>{m.join}</Button>
        </div>
      </div>
    </section>
  )}
  <script type="application/json" id="fo-daten" set:html={daten} />
</Page>

<script>
  import { initFormate } from '../scripts/formate';
  initFormate();
</script>

<style>
  /* ---------- Kopf: Netz der Formate ---------- */
  .fo-kopf { position: relative; background: var(--purple); color: #fff; overflow: hidden; }
  /* Regel „Köpfe“: erste Zeile im Abstand --buehne-oben, Headline --kopf-kicker unter dem Kicker */
  .fo-kopf__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); padding-top: var(--buehne-oben); padding-bottom: clamp(44px, 5vw, 64px); }
  .fo-intro { grid-column: 1; grid-row: 1; align-self: start; position: relative; z-index: 4; margin-bottom: 28px; }
  .fo-h1 { margin: 0 0 clamp(20px, 2.4vw, 32px); font-family: var(--font-display); font-weight: 800; font-size: clamp(48px, 7vw, 112px); line-height: 0.92; letter-spacing: -0.035em; color: #fff; }
  .fo-h1__zeile { display: block; white-space: nowrap; }
  .fo-h1__zeile span { display: inline-block; }
  .fo-h1__akzent { color: var(--cyan); }
  .fo-info { max-width: 420px; min-height: 104px; }
  .fo-info__k { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); }
  .fo-info__text { margin: 0; font-size: clamp(15px, 1.25vw, 17px); line-height: 1.55; color: rgba(255, 255, 255, 0.88); text-wrap: pretty; }
  .fo-quadrat { width: 10px; height: 10px; background: var(--magenta); flex: none; }
  .fo-quadrat--klein { width: 8px; height: 8px; }
  .fo-quadrat--mini { width: 6px; height: 6px; }
  .fo-knuepfen {
    display: flex; align-items: center; gap: 10px; margin-top: 22px; padding: 9px 14px; background: transparent; border: 1.5px solid rgba(255, 255, 255, 0.4); border-radius: 0;
    color: #fff; cursor: pointer; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    transition: border-color var(--dur-base), color var(--dur-base);
  }
  .fo-knuepfen[hidden] { display: none; }
  .fo-knuepfen:hover { border-color: var(--magenta); color: var(--cyan); }

  /* Bühne: ohne JavaScript unter dem Text (feste Lage), mit JavaScript ab 720px dahinter (das Skript lässt den Text frei) */
  .fo-buehne { grid-column: 1; grid-row: 2; position: relative; min-width: 0; height: 620px; }
  .fo-netz { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }
  .fo-netz line { stroke: var(--cyan); stroke-opacity: 0.42; stroke-width: 1.5; }
  .fo-netz--breit { display: none; }
  :global(.js) .fo-netz--breit, :global(.js) .fo-netz--schmal { display: none; }
  /* Netz aus dem Skript (src/scripts/formate.ts) */
  .fo-buehne :global(.fo-netz--js) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }
  .fo-buehne :global(.fo-netz--js line) { stroke: var(--cyan); stroke-opacity: 0.42; stroke-width: 1.5; stroke-dasharray: 1; }
  .fo-knoten-liste { margin: 0; padding: 0; list-style: none; }
  .fo-knoten { --x: var(--xs); --y: var(--ys); position: absolute; z-index: 3; left: var(--x); top: var(--y); width: 0; height: 0; }
  .fo-knoten__in { position: absolute; left: 0; top: 0; width: 0; height: 0; }
  .fo-knoten__q { position: absolute; left: -6px; top: -6px; width: 12px; height: 12px; background: var(--magenta); transition: transform 400ms var(--ease-out), background var(--dur-base); }
  .fo-knoten__a {
    position: absolute; left: 12px; top: 0; transform: translateY(-50%); transform-origin: 0% 50%; display: flex; flex-direction: column; align-items: flex-start; gap: 6px;
    padding: 8px 10px; background: var(--purple); white-space: nowrap; color: #fff; transition: color var(--dur-base), transform 450ms var(--ease-out);
  }
  .fo-knoten[data-ss='l'] .fo-knoten__a { left: auto; right: 12px; align-items: flex-end; transform-origin: 100% 50%; }
  .fo-knoten__t { font-family: var(--font-display); font-weight: 800; font-size: clamp(22px, 2.6vw, 38px); line-height: 1; letter-spacing: -0.03em; }
  .fo-knoten__m { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); transition: color var(--dur-base); }
  .fo-knoten:is(:hover, :focus-within, .is-an) .fo-knoten__a { color: var(--cyan); transform: translateY(-50%) scale(1.12); }
  .fo-knoten:is(:hover, :focus-within, .is-an) .fo-knoten__m { color: #fff; }
  .fo-knoten:is(:hover, :focus-within, .is-an) .fo-knoten__q { background: var(--cyan); transform: scale(1.7); }
  /* bis das Skript die Knoten gesetzt hat */
  :global(.js) .fo-buehne:not(.is-da) .fo-knoten { visibility: hidden; }
  .fo-kopf :global(.fo-kopf__keil) { position: absolute; left: 0; bottom: 0; width: 34%; z-index: 6; }

  @media (min-width: 720px) {
    .fo-intro { max-width: min(64%, 820px); }
    .fo-buehne { height: 640px; }
    .fo-netz--breit { display: block; }
    .fo-netz--schmal { display: none; }
    .fo-knoten { --x: var(--xb); --y: var(--yb); }
    .fo-knoten[data-ss='l'] .fo-knoten__a { left: 12px; right: auto; align-items: flex-start; transform-origin: 0% 50%; }
    .fo-knoten[data-sb='l'] .fo-knoten__a { left: auto; right: 12px; align-items: flex-end; transform-origin: 100% 50%; }
    :global(.js) .fo-intro { margin-bottom: 0; }
    :global(.js) .fo-buehne { grid-row: 1; height: clamp(600px, calc(100vh - 150px), 820px); }
  }

  /* ---------- Formate im Detail ---------- */
  .fo-detail { background: var(--tint); padding: clamp(40px, 6vw, 80px) 0 clamp(64px, 8vw, 104px); }
  .fo-filter { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-bottom: clamp(28px, 4vw, 48px); }
  .fo-filter[hidden] { display: none; }
  .fo-filter__k { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); }
  .fo-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .fo-chip {
